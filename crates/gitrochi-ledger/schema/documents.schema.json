{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gitrochi/Gitrochi/crates/gitrochi-ledger/schema/documents.schema.json",
  "title": "DocumentEvidence",
  "type": "object",
  "required": [
    "project",
    "roots",
    "files",
    "ids",
    "entries",
    "relatedSessions",
    "total",
    "truncated"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line",
          "text",
          "kind",
          "status",
          "path",
          "root",
          "hash"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "root": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "task": {
            "type": "boolean"
          },
          "definition": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "relatedSessions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "total": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
