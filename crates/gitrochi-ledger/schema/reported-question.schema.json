{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gitrochi/Gitrochi/crates/gitrochi-ledger/schema/reported-question.schema.json",
  "title": "ReportedQuestion",
  "description": "A question from an agent, retaining optional choices and an editable suggestion.",
  "anyOf": [
    {
      "type": "string"
    },
    {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "required": [
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "recommended": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "multiSelect": {
          "type": "boolean"
        },
        "suggestedAnswer": {
          "type": "string",
          "description": "An editable draft; never sent without the person choosing to send."
        }
      }
    }
  ]
}
