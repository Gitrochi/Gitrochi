{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gitrochi/Gitrochi/crates/gitrochi-ledger/schema/insights.schema.json",
  "title": "Insights",
  "description": "The insights method's result: counts and durations over a period, never the text of a question, answer, report or note (CONTRACT.md: insights).",
  "type": "object",
  "required": [
    "range",
    "to",
    "questions",
    "autoAnswers",
    "sessions",
    "reports",
    "reportsPerDay"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "description": "Absent: every project"
    },
    "range": {
      "enum": [
        "7d",
        "30d",
        "all"
      ]
    },
    "from": {
      "type": "integer",
      "minimum": 0,
      "description": "The period's first moment; absent for all"
    },
    "to": {
      "type": "integer",
      "minimum": 0
    },
    "questions": {
      "type": "object",
      "required": [
        "asked",
        "answered",
        "dismissed",
        "resolvedByAgent",
        "wait",
        "open"
      ],
      "additionalProperties": false,
      "properties": {
        "asked": {
          "$ref": "#/$defs/count"
        },
        "answered": {
          "$ref": "#/$defs/count"
        },
        "dismissed": {
          "$ref": "#/$defs/count"
        },
        "resolvedByAgent": {
          "$ref": "#/$defs/count",
          "description": "Closed by their own agent (resolves); not part of the wait"
        },
        "wait": {
          "$ref": "#/$defs/spread",
          "description": "From asked to answered or dismissed, for questions settled in the period"
        },
        "open": {
          "$ref": "#/$defs/spread",
          "description": "Ages of the questions open now, in sessions that are not archived"
        }
      }
    },
    "autoAnswers": {
      "type": "object",
      "required": [
        "total",
        "reviewed",
        "corrected",
        "unreviewed",
        "byKind"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "$ref": "#/$defs/count"
        },
        "reviewed": {
          "$ref": "#/$defs/count"
        },
        "corrected": {
          "$ref": "#/$defs/count"
        },
        "unreviewed": {
          "$ref": "#/$defs/count"
        },
        "byKind": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "total",
              "reviewed",
              "corrected",
              "unreviewed"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "description": "stop_question, ask_user_question, exit_plan_mode or permission"
              },
              "total": {
                "$ref": "#/$defs/count"
              },
              "reviewed": {
                "$ref": "#/$defs/count"
              },
              "corrected": {
                "$ref": "#/$defs/count",
                "description": "Reviewed after a person's message to the session (Send correction… sends one)"
              },
              "unreviewed": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "sessions": {
      "type": "object",
      "required": [
        "total",
        "byVerdict",
        "byRole",
        "stale",
        "staleUnreported",
        "unreported"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "$ref": "#/$defs/count"
        },
        "byVerdict": {
          "type": "object",
          "required": [
            "needs_human",
            "confirm",
            "expirable",
            "pending_merge",
            "stale",
            "active",
            "shelved",
            "archived"
          ],
          "additionalProperties": false,
          "properties": {
            "needs_human": {
              "$ref": "#/$defs/count"
            },
            "confirm": {
              "$ref": "#/$defs/count"
            },
            "expirable": {
              "$ref": "#/$defs/count"
            },
            "pending_merge": {
              "$ref": "#/$defs/count"
            },
            "stale": {
              "$ref": "#/$defs/count"
            },
            "active": {
              "$ref": "#/$defs/count"
            },
            "shelved": {
              "$ref": "#/$defs/count"
            },
            "archived": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "byRole": {
          "type": "object",
          "required": [
            "decision",
            "implementation",
            "research",
            "document",
            "other"
          ],
          "additionalProperties": false,
          "properties": {
            "decision": {
              "$ref": "#/$defs/count"
            },
            "implementation": {
              "$ref": "#/$defs/count"
            },
            "research": {
              "$ref": "#/$defs/count"
            },
            "document": {
              "$ref": "#/$defs/count"
            },
            "other": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "stale": {
          "$ref": "#/$defs/count"
        },
        "staleUnreported": {
          "$ref": "#/$defs/count"
        },
        "unreported": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "reports": {
      "$ref": "#/$defs/count",
      "description": "Agent reports in the period"
    },
    "reportsPerDay": {
      "type": "array",
      "minItems": 1,
      "description": "Oldest first, zero days included: 7, 30, or the last 90 days for all",
      "items": {
        "type": "object",
        "required": [
          "day",
          "reports"
        ],
        "additionalProperties": false,
        "properties": {
          "day": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10,
            "description": "YYYY-MM-DD, local time"
          },
          "reports": {
            "$ref": "#/$defs/count"
          }
        }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "spread": {
      "type": "object",
      "required": [
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "$ref": "#/$defs/count"
        },
        "medianMs": {
          "$ref": "#/$defs/count"
        },
        "p90Ms": {
          "$ref": "#/$defs/count"
        },
        "maxMs": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
