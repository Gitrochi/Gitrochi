{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gitrochi/Gitrochi/crates/gitrochi-ledger/schema/work-state.schema.json",
  "title": "WorkState",
  "type": "object",
  "required": [
    "project",
    "items",
    "bundles",
    "warnings"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "project",
          "bundle",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "bundle": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "stem": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "bundles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
