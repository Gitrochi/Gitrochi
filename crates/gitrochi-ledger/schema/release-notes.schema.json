{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gitrochi/Gitrochi/crates/gitrochi-ledger/schema/release-notes.schema.json",
  "title": "ReleaseNotes",
  "description": "The release_notes method's result: a Markdown draft for one baseline from the sessions merged into it or absorbed by its release report. It never contains question answers, a person's messages, report bodies or notebook notes (CONTRACT.md: release_notes).",
  "type": "object",
  "required": [
    "project",
    "version",
    "releasedAt",
    "versions",
    "groups",
    "markdown"
  ],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "The baseline; HEAD when none was asked for"
    },
    "previous": {
      "type": "string",
      "description": "The baseline before it on the trunk"
    },
    "releasedAt": {
      "type": "integer",
      "minimum": 0,
      "description": "When the baseline appeared"
    },
    "releasedBy": {
      "type": "string",
      "description": "The session whose release report made it"
    },
    "note": {
      "type": "string",
      "description": "The baseline's note"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Every version of the project's trunk, newest (HEAD) first"
    },
    "groups": {
      "type": "array",
      "description": "Non-empty groups in the order decision, implementation, research, document, other",
      "items": {
        "type": "object",
        "required": [
          "role",
          "title",
          "sessions"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "decision",
              "implementation",
              "research",
              "document",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "description": "The English heading the Markdown uses"
          },
          "sessions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/entry"
            }
          }
        }
      }
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "how",
        "artifacts"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "how": {
          "enum": [
            "merged",
            "absorbed"
          ],
          "description": "absorbed: the release report absorbed it (it may have been reopened since); merged: otherwise merged into the version, by its own report or a person"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One line from its agent's newest done, decision or merged report"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "ver": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
