  s = out; n = length(s); q = ""; word = ""; inw = 0; nw = 0; skipnext = 0; redir = 0
  for (p = 1; p <= n; p++) {
    c = substr(s, p, 1)
    if (q == "'") { if (c == "'") q = ""; else word = word c; continue }
    if (q == "\"") {
      if (c == "\\") {
        d = substr(s, p + 1, 1)
        if (d == "\"" || d == "\\" || d == "$" || d == "`") { word = word d; p++; continue }
        if (d == "\n") { p++; continue }
      }
      if (c == "\"") { q = ""; continue }
      word = word c; continue
    }
    if (c == "\\") { d = substr(s, p + 1, 1); if (d != "\n") { word = word d; inw = 1 } p++; continue }
    if (c == "'" || c == "\"") { q = c; inw = 1; continue }
    if (c == " " || c == "\t") { endw(); continue }
    if (c == "\n" || c == ";" || c == "&" || c == "|" || c == "(" || c == ")" || c == "`") { endw(); endc(); continue }
    if (c == "$" && substr(s, p + 1, 1) == "(") { endw(); endc(); p++; continue }
