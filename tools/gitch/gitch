function ts_configs(   i) { for (i = 1; i <= NTSC; i++) ts_read(TSC[i], dirof(TSC[i]), 0) }
function ts_read(f, d, lvl,   all, line, v, base, blk, m, k, t, ext) {   # tsconfig 의 baseUrl · paths (extends 는 세 단계까지)
