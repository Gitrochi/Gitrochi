  if (NSKIP) printf "0\tnote\t파일이 %d개 넘게 바뀐 커밋 %d개는 뺐습니다 (정리 · 이름 바꾸기 같은 큰 커밋 — --max-files 로 바꿈).\n", maxf, NSKIP
  if (TRUNC) printf "0\tnote\t최근 커밋 %d개만 봤습니다 (--max-commits · --since 로 바꿈).\n", maxc
  if (shallow == "true") print "0\tnote\t얕은 복제의 로컬 이력만 분석했습니다. 원격의 더 오래된 커밋은 포함되지 않습니다."
  if (NRENAME) printf "0\tnote\t파일 이름 변경 %d건을 거슬러 옛 이력을 현재 파일에 합쳤습니다.\n", NRENAME
  if (INVALID) printf "0\tnote\t탭/줄바꿈 등 구분 문자가 든 이력 경로 %d건은 분석에서 뺐습니다.\n", INVALID
  for (f in LOCKS) { print "0\tnote\tlock 파일(package-lock.json · Cargo.lock 등)은 매니페스트와 늘 같이 바뀌므로 뺐습니다."; break }
}
