function py_from(p, mod, names,   lvl, rest, base, i, n, a, nm, t, done, miss) {
  gsub(/[()\\]/, " ", names)
  n = split(names, a, ",")
  if (mod !~ /^\./) {
    for (i = 1; i <= n; i++) { nm = py_name(a[i]); if (nm == "" || nm == "*") py_abs(p, mod, mod); else py_abs(p, mod "." nm, mod) }
    return
  }
  match(mod, /^\.+/); lvl = RLENGTH; rest = substr(mod, lvl + 1)
  base = dirof(p)
  for (i = 2; i <= lvl; i++) base = dirof(base)
  if (rest != "") { gsub(/\./, "/", rest); base = joinp(base, rest) }
  done = 0; miss = 0
  for (i = 1; i <= n; i++) {                       # from . import x — x 가 모듈(파일)이면 그 파일
    nm = py_name(a[i])
    if (nm == "" || nm == "*") continue
    t = py_file(joinp(base, nm))
    if (t != "") { fedge(p, t, "import", mod); done = 1 } else miss++
  }
  if (done && !miss) return
  t = (rest == "") ? py_file2(base) : py_file(base)    # 그 밖의 이름은 모듈 · 패키지 안에 있다
  if (t != "") fedge(p, t, "import", mod); else if (!done) unresolved(p, mod, "Python 상대 모듈을 추적 파일에서 찾지 못했습니다.")
}
function py_file2(b) { return ((joinp(b, "__init__.py")) in EX) ? joinp(b, "__init__.py") : "" }

# ----- Go: 모듈(go.mod) 안의 import → 패키지 폴더 -----
function go_mods(   i, f, line, m, inreq) {
  for (i = 1; i <= NGOMOD; i++) {
    f = GOMOD[i]; GOMD[i] = dirof(f); GOMP[i] = ""; inreq = 0
    while ((getline line < f) > 0) {
      sub(/\r$/, "", line); sub(/\/\/.*$/, "", line)
      if (match(line, /^module[ \t]+/)) { m = substr(line, RLENGTH + 1); gsub(/["\t ]/, "", m); GOMP[i] = m; continue }
      if (line ~ /^require[ \t]*\(/) { inreq = 1; continue }
      if (inreq) { if (line ~ /^[ \t]*\)/) { inreq = 0; continue }; m = trim(line); sub(/[ \t].*$/, "", m); if (m != "") GOREQ[m] = 1; continue }
      if (match(line, /^require[ \t]+/)) { m = trim(substr(line, RLENGTH + 1)); sub(/[ \t].*$/, "", m); if (m != "") GOREQ[m] = 1 }
    }
    close(f)
  }
}
function scan_go(p,   line, blk, done) {
  blk = 0; done = 0
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]
    if (done) continue                                  # import 는 파일 머리에만 — 나머지는 줄 수만 센다
    sub(/\r$/, "", line)
    if (blk) { if (line ~ /^[ \t]*\)/) blk = 0; else if (match(line, /"[^"]+"/)) go_dep(p, substr(line, RSTART + 1, RLENGTH - 2)); continue }
    if (line ~ /^import[ \t]*\(/) { blk = 1; continue }
    if (line ~ /^import[ \t]/) { if (match(line, /"[^"]+"/)) go_dep(p, substr(line, RSTART + 1, RLENGTH - 2)); continue }
    if (line ~ /^(func|type|var|const)[ \t(]/) done = 1
  }
  close(p)
}
function go_pkgdir(imp,   i, best, bl) {   # 저장소 안 모듈의 패키지면 그 폴더, 아니면 "\001"
  best = 0; bl = -1
  for (i = 1; i <= NGOMOD; i++)
    if (GOMP[i] != "" && (imp == GOMP[i] || index(imp, GOMP[i] "/") == 1) && length(GOMP[i]) > bl) { best = i; bl = length(GOMP[i]) }
  if (!best) return "\001"
  return joinp(GOMD[best], substr(imp, bl + 2))
}
function go_std(imp) { return !index(substr(imp, 1, index(imp "/", "/") - 1), ".") }
function go_modname(imp,   k, a, n) {   # 바깥 import → go.mod 의 require 모듈(가장 긴 것), 없으면 호스트/소유자/저장소
  k = imp
  while (k != "") { if (k in GOREQ) return k; if (!sub(/\/[^\/]*$/, "", k)) break }
  n = split(imp, a, "/")
  if (index(a[1], ".") && n >= 3) return a[1] "/" a[2] "/" a[3]
  return imp
}
function go_fid(d) { return d == "" ? "./" : d "/" }
function go_dep(p, imp,   d, src, sc) {
  d = go_pkgdir(imp)
  if (rel == "modules") {
    if (!(dirof(p) in GODIR)) return
    src = go_mnode(dirof(p)); sc = (p ~ /_test\.go$/) ? "test" : "import"
    if (d != "\001") { if ((d in GODIR) && d != dirof(p)) addedge(src, go_mnode(d), "depends", 1, 0, "", "\"scope\":" jstr(sc)); return }
    if (!go_std(imp)) pedge(src, "golang", go_modname(imp), "depends", "", "\"scope\":" jstr(sc))
    return
  }
  if (d != "\001") {
    if (!(d in GODIR)) { unresolved(p, imp, "Go 모듈 안에 추적하는 패키지 파일이 없습니다."); return }
    if (d == dirof(p)) return
    if (!(go_fid(d) in NK)) { GOFOLD[d] = 1; addnode(go_fid(d), "folder", (d == "" ? baseof(imp) : d), "go", "\"path\":" jstr(d == "" ? "." : d) ",\"importPath\":" jstr(imp)) }
    addedge(p, go_fid(d), "import", 1, 0, imp, "")
    return
  }
  pedge(p, "golang", go_modname(imp), "import", imp, "")
}
function go_contains(   d, n, a, i) {   # 가져온 패키지 폴더 → 그 안의 .go 파일
  for (d in GOFOLD) { n = split(GODIR[d], a, SUBSEP); for (i = 2; i <= n; i++) if (inscope(a[i])) fedge(go_fid(d), a[i], "contains", "") }
}

# ----- Rust: mod 선언 · use crate::/self::/super::/다른 crate → 파일 -----
function rs_crates(   i, f, line, sec, n) {
  for (i = 1; i <= NCARGO; i++) {
    f = CARGO[i]; CRATEDIR[dirof(f)] = 1; sec = ""
    while ((getline line < f) > 0) {
      if (line ~ /^[ \t]*\[/) { sec = line; gsub(/[ \t\r]|\[|\]/, "", sec); continue }
      if (sec == "package" && match(line, /^[ \t]*name[ \t]*=[ \t]*"[^"]*"/)) {
        n = substr(line, RSTART, RLENGTH); sub(/^[^"]*"/, "", n); sub(/"$/, "", n); gsub(/-/, "_", n); CRATE[n] = dirof(f)
      }
    }
    close(f)
  }
}
function rs_crate(p,   d, r) {   # 파일이 속한 crate 폴더(가장 가까운 Cargo.toml), 없으면 "\001"
  d = dirof(p)
  if (d in RSC) return RSC[d]
  r = d
  while (!(r in CRATEDIR)) { if (r == "") { r = "\001"; break }; r = dirof(r) }
  RSC[d] = r
  return r
}
function rs_rootfile(src) {
  if ((joinp(src, "lib.rs")) in EX) return joinp(src, "lib.rs")
  if ((joinp(src, "main.rs")) in EX) return joinp(src, "main.rs")
  return ""
}
function rs_info(p,   c, rel, st) {   # → RS_SRC(모듈 경로 기준 폴더) RS_MP(모듈 경로 a/b) RS_MD(mod 선언의 자식 폴더) RS_ROOT(crate 뿌리 파일)
  c = rs_crate(p); st = stemof(p)
  if (c != "\001" && index(p, joinp(c, "src") "/") == 1) {
    RS_SRC = joinp(c, "src"); RS_ROOT = rs_rootfile(RS_SRC)
    rel = substr(p, length(RS_SRC) + 2)
    if (rel == "lib.rs" || rel == "main.rs" || rel ~ /^bin\/[^\/]*\.rs$/ || rel ~ /^bin\/[^\/]*\/main\.rs$/) {
      RS_MP = ""; RS_MD = dirof(p)
      if (rel ~ /^bin\//) { RS_SRC = dirof(p); RS_ROOT = p }
      return
    }
    sub(/\.rs$/, "", rel)
    if (st == "mod") { sub(/\/?mod$/, "", rel); RS_MD = dirof(p) } else RS_MD = joinp(dirof(p), st)
    RS_MP = rel
    return
  }
  RS_SRC = dirof(p); RS_MP = ""; RS_MD = dirof(p); RS_ROOT = p     # tests/ · examples/ · build.rs 는 그 파일이 뿌리
}
function scan_rs(p,   line, s, inuse, stmt, depth, nm, o, c) {
  rs_info(p); inuse = 0; depth = 0; RSIN = 0       # RSIN: 지금 열려 있는 인라인 mod { } 수
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]
    sub(/\r$/, "", line)
    if (index(line, "//")) sub(/\/\/.*$/, "", line)
    if (inuse) { stmt = stmt " " line; if (index(line, ";")) { inuse = 0; rs_use(p, stmt) }; continue }
    s = line; sub(/^[ \t]*(#\[[^]]*\][ \t]*)*/, "", s); sub(/^pub(\([^)]*\))?[ \t]+/, "", s)
    if (s ~ /^mod[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*;/) { nm = s; sub(/^mod[ \t]+/, "", nm); sub(/[^A-Za-z0-9_].*$/, "", nm); rs_mod(p, nm) }
    else if (s ~ /^mod[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*\{/) RSOPEN[++RSIN] = depth      # 안의 super:: 는 한 단계 덜 올라간다
    else if (s ~ /^use[ \t]/) { stmt = s; if (index(s, ";")) rs_use(p, stmt); else inuse = 1 }
    else if (match(s, /^extern[ \t]+crate[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) { nm = substr(s, RSTART, RLENGTH); sub(/^.*[ \t]/, "", nm); if (!(nm in CRATE)) pedge(p, "cargo", nm, "use", nm, "") }
    o = gsub(/\{/, "{", line); c = gsub(/\}/, "}", line); depth += o - c
    while (RSIN > 0 && depth <= RSOPEN[RSIN]) RSIN--
  }
  close(p)
}
function rs_mod(p, nm,   t) {
  t = joinp(RS_MD, nm ".rs"); if (t in EX) { fedge(p, t, "mod", nm); return }
  t = joinp(RS_MD, nm "/mod.rs"); if (t in EX) { fedge(p, t, "mod", nm); return }
  unresolved(p, nm, "Rust mod 선언의 추적 파일을 찾지 못했습니다.")
}
function rs_use(p, s,   i, via) {
  sub(/^use[ \t]+/, "", s); sub(/;.*$/, "", s)
  gsub(/[ \t]+as[ \t]+[A-Za-z_][A-Za-z0-9_]*/, "", s); gsub(/[ \t]+/, "", s)
  RSN = 0; rs_expand(s, "")
  for (i = 1; i <= RSN; i++) { via = RSX[i]; rs_path(p, RSX[i], via) }
}
function rs_expand(s, pre,   i, j, d, st, n, c, head, item) {   # crate::{a::B, c::{D, E}} → crate::a::B, crate::c::D, crate::c::E
  i = index(s, "{")
  if (i == 0) { if (s != "") RSX[++RSN] = pre s; return }
  head = substr(s, 1, i - 1); d = 0; st = i + 1; n = length(s)
  for (j = i; j <= n; j++) {
    c = substr(s, j, 1)
    if (c == "{") d++
    else if (c == "}") { d--; if (d == 0) { item = substr(s, st, j - st); if (item != "") rs_expand(item, pre head); return } }
    else if (c == "," && d == 1) { item = substr(s, st, j - st); if (item != "") rs_expand(item, pre head); st = j + 1 }
  }
}
function rs_path(p, s, via,   n, seg, i, k, mp, src, root, ups, t) {
  sub(/::self$/, "", s); sub(/::\*$/, "", s); sub(/^::/, "", s)
  if (s == "" || s == "self") return
  n = split(s, seg, "::")
  src = RS_SRC; root = RS_ROOT; mp = RS_MP; k = 2
  if (seg[1] == "crate") mp = ""
  else if (seg[1] == "super") {
    ups = 0; k = 1
    while (k <= n && seg[k] == "super") { ups++; k++ }
    ups -= RSIN
    for (i = 1; i <= ups; i++) mp = dirof(mp)
  } else if (seg[1] in CRATE) { src = joinp(CRATE[seg[1]], "src"); root = rs_rootfile(src); mp = "" }
  else if (seg[1] != "self") {
    t = rs_find(src, mp, seg, 1, n, "")          # 2018 판: 지금 모듈 안의 이름일 수 있다
    if (t != "") { fedge(p, t, "use", via); return }
    pedge(p, "cargo", seg[1], "use", via, "")
    return
  }
  t = rs_find(src, mp, seg, k, n, root)
  if (t != "") fedge(p, t, "use", via)
}
