  }
  if (priv || !match(s, /^(class|struct|enum|protocol|actor|typealias)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) return
  s = substr(s, 1, RLENGTH); sub(/^[a-z]+[ \t]+/, "", s)
  if (!((p "\034" s) in SWD)) { SWD[p "\034" s] = 1; SWT[s] = SWT[s] "\034" p }
  if (pub) SWPUB[p "\034" s] = 1                                     # 다른 모듈에서 보이는 선언
}
function swift_resolve(   i, p, n, a, j, w, m, b, k, best, bc, br, c, r) {
  for (i = 1; i <= NSRC; i++) {
    p = SRC[i]
    if (LANG[p] != "swift" || !inscope(p) || swift_indexed(p)) continue
    if (swiftrc == "0") SWUNCOV++
    n = split(REF[p], a, "\034")
    for (j = 2; j <= n; j++) {
      w = a[j]
      if (!(w in SWT) || ((p "\034" w) in SWD)) continue     # 같은 파일에 선언된 이름이면 그것을 쓴다
      m = split(SWT[w], b, "\034"); best = ""; bc = -1; br = 0
      for (k = 2; k <= m; k++) {   # 같은 모듈 > import 한 모듈 > 모듈을 모르는 파일, 그 안에서는 가까운 폴더
        if (!(r = swift_reach(p, b[k], w))) continue
        c = closeness(b[k], p)
        if (r > br || (r == br && c > bc)) { br = r; bc = c; best = b[k] }
      }
      if (best != "") heur(p, best, w, "swift", br >= 2)
      else SWDROP++
    }
  }
}

function swift_covered(   line, r) {   # 도우미가 --covered 에 적은, 인덱스에 든 파일 — 목록을 쓰지 않았으면 모두 든 것으로
