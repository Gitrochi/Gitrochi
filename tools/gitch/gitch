BEGIN { US = "\037"; RD = "\036"; nl = 0 }
{ lines[++nl] = $0 }
function endw() {
  if (!inw) return
  gsub(/\n/, " ", word)
  if (skipnext) skipnext = 0
  else if (redir) { redir = 0; W[++nw] = RD word }
