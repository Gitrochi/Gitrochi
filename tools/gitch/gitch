function jvm_pkgname(s,   n, a, i, r) {   # 바깥 import → 패키지 이름(대문자로 시작하는 마디 앞, 세 마디까지)
  n = split(s, a, "."); r = ""
  for (i = 1; i <= n && i <= 3; i++) { if (index(UPPER, substr(a[i], 1, 1)) || a[i] == "*") break; r = r (i > 1 ? "." : "") a[i] }
  return r == "" ? s : r
}
function jvm_resolve(   i, p, n, a, j, imp, t, k, m, b, w, pk) {
  for (i = 1; i <= NSRC; i++) {
    p = SRC[i]
    if ((LANG[p] != "kotlin" && LANG[p] != "java") || !inscope(p)) continue
    n = split(JIMP[p], a, "\034")
    for (j = 2; j <= n; j++) {
      imp = a[j]
      if (imp ~ /\.\*$/) {
        pk = substr(imp, 1, length(imp) - 2)
        if (pk in JPF) { m = split(JPF[pk], b, "\034"); for (k = 2; k <= m; k++) fedge(p, b[k], "import", imp); continue }
        t = jvm_find(pk)
      } else t = jvm_find(imp)
      if (t != "") fedge(p, t, "import", imp); else pedge(p, "maven", jvm_pkgname(imp), "import", imp, "")
    }
    pk = JPKG[p]; n = split(REF[p], a, "\034")
    for (j = 2; j <= n; j++) { w = a[j]; k = pk "\034" w; if ((k in JPT) && JPT[k] != p) heur(p, JPT[k], w, "jvm", 1) }
  }
}

# ----- Swift: 파일끼리는 import 가 없다 → 다른 파일의 최상위 타입 이름을 쓰면 연결(추정), import 모듈은 모듈 노드 -----
function scan_swift(p, ins,   line, inc, ml, s) {
  inc = 0; ml = 0
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]
    sub(/\r$/, "", line)
    if (ml) { if (index(line, "\"\"\"")) ml = 0; continue }
    if (inc) { if (index(line, "*/")) inc = 0; continue }
    if (line ~ /^[ \t]*\/\*/) { if (!index(substr(line, index(line, "/*") + 2), "*/")) inc = 1; continue }
    if (line ~ /^[ \t]*\/\//) continue
    if (index(line, "\"\"\"") && count(line, "\"\"\"") % 2) { ml = 1; line = substr(line, 1, index(line, "\"\"\"") - 1) }
    if (line ~ /^[ \t]*(@[A-Za-z_]+[ \t]+)*import[ \t]+/) {
      s = line; sub(/^[ \t]*(@[A-Za-z_]+[ \t]+)*import[ \t]+((typealias|struct|class|enum|protocol|let|var|func|actor)[ \t]+)?/, "", s)
      if (match(s, /^[A-Za-z_][A-Za-z0-9_]*/)) {
        s = substr(s, 1, RLENGTH)
        if (!((p "\034" s) in FIMP)) { FIMP[p "\034" s] = 1; FIMPL[p] = FIMPL[p] "\034" s }   # 모듈 경계로 추정을 거를 때 쓴다
        if (line ~ /@_exported[ \t]/) swift_reexport(p, s)
        if (line ~ /@testable[ \t]/) FTEST[p "\034" s] = 1             # internal 타입까지 보인다
        if (ins) medge(p, s)
      }
      continue
    }
    if (line ~ /^[A-Za-z@]/) swift_decl(p, line)
    if (ins && !swift_indexed(p)) refs(p, line)                  # 인덱스로 읽은 파일은 이름 추정을 하지 않는다
  }
  close(p)
}
function swift_decl(p, line,   s, priv, pub) {
  s = line; priv = 0; pub = 0
  while (match(s, /^(@[A-Za-z_][A-Za-z0-9_]*(\([^)]*\))?|public|private|fileprivate|internal|package|open|final|indirect|nonisolated|dynamic|static|override|required|convenience|distributed)[ \t]+/)) {
    if (s ~ /^(private|fileprivate)[ \t]/) priv = 1
    else if (s ~ /^(public|open|package)[ \t]/) pub = 1
    s = substr(s, RLENGTH + 1)
  }
  if (priv || !match(s, /^(class|struct|enum|protocol|actor|typealias)[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) return
  s = substr(s, 1, RLENGTH); sub(/^[a-z]+[ \t]+/, "", s)
  if (!((p "\034" s) in SWD)) { SWD[p "\034" s] = 1; SWT[s] = SWT[s] "\034" p }
  if (pub) SWPUB[p "\034" s] = 1                                     # 다른 모듈에서 보이는 선언
}
function swift_resolve(   i, p, n, a, j, w, m, b, k, best, bc, br, c, r) {
  for (i = 1; i <= NSRC; i++) {
    p = SRC[i]
    if (LANG[p] != "swift" || !inscope(p) || swift_indexed(p)) continue
    if (swiftrc == "0") SWUNCOV++
    n = split(REF[p], a, "\034")
    for (j = 2; j <= n; j++) {
      w = a[j]
      if (!(w in SWT) || ((p "\034" w) in SWD)) continue     # 같은 파일에 선언된 이름이면 그것을 쓴다
      m = split(SWT[w], b, "\034"); best = ""; bc = -1; br = 0
      for (k = 2; k <= m; k++) {   # 같은 모듈 > import 한 모듈 > 모듈을 모르는 파일, 그 안에서는 가까운 폴더
        if (!(r = swift_reach(p, b[k], w))) continue
        c = closeness(b[k], p)
        if (r > br || (r == br && c > bc)) { br = r; bc = c; best = b[k] }
      }
      if (best != "") heur(p, best, w, "swift", br >= 2)
      else SWDROP++
    }
  }
}

function swift_covered(   line, r) {   # 도우미가 --covered 에 적은, 인덱스에 든 파일 — 목록을 쓰지 않았으면 모두 든 것으로
  while ((r = (getline line < swiftcov)) > 0) if (line != "") SWCOV[line] = 1
  if (r < 0) SWALL = 1
  close(swiftcov)
}
function swift_indexed(p) { return swiftrc == "0" && (SWALL || (p in SWCOV)) }
function swift_index(   line, a, n, i, s, t, v, k) {   # Xcode 인덱스 도우미의 "원본<TAB>대상<TAB>심볼,…" → 정확한 연결(ref)
  while ((getline line < swiftidx) > 0) {
    n = split(line, a, "\t"); s = a[1]; t = a[2]
    if (n < 2 || s == t || !(s in EX) || !(t in EX) || LANG[s] != "swift" || !inscope(s)) continue
    FREF[t] = 1; SWIDXN++
    k = split(a[3], v, ",")
    if (!k) addedge(s, t, "ref", 1, 0, "", "")
    for (i = 1; i <= k; i++) addedge(s, t, "ref", 1, 0, trim(v[i]), "")
  }
  close(swiftidx)
}

# ----- Swift 모듈 경계: Tuist · SwiftPM 매니페스트로 파일 → 모듈을 정하고, 다른 모듈의 타입은 그 모듈을 import 한 파일만 쓴다고 본다 -----
function swift_modmap(   i, f) {
  for (i = 1; i <= NSPM; i++) { f = SPM[i]; spm_manifest(f, dirof(f)) }
  for (i = 1; i <= SPN; i++) if (SPTYPE[i] != "binary" && SPTYPE[i] != "system-target") modsrc(SPNAME[i], joinp(SPPATH[i], "**"), SPDIR[i])
  for (i = 1; i <= NTUIST; i++) { f = TUIST[i]; tuist_srcs(f, dirof(f)) }
}
function tuist_srcs(f, d,   s, proj, e, j, args, n, IT, k, v, name, src, found) {
  s = swift_text(f); proj = ""; found = 0
  if (match(s, /Project[ \t]*(\.[A-Za-z_][A-Za-z0-9_]*)?[ \t]*\(/)) proj = strarg(substr(s, RSTART), "name")
  while (match(s, /(\.target|[^A-Za-z0-9_.]Target(\.target)?)[ \t]*\(/)) {
    j = RSTART + RLENGTH - 1; e = balanced(s, j)
    args = substr(s, j + 1, e - j - 1); s = substr(s, e + 1)
    if (args !~ /(product|bundleId|destinations|platform|sources)[ \t]*:/) continue      # .target(name:) 는 의존 참조
    name = ""; src = ""
    n = items(args, IT)
    for (k = 1; k <= n; k++) {
      if ((v = argval(IT[k], "name")) != "\001") name = unquote(v)
      else if ((v = argval(IT[k], "sources")) != "\001") src = v
    }
    if (name == "" || index(name, "\\(")) continue
    found++
    gsub(/excluding[ \t]*:[ \t]*(\[[^]]*\]|"[^"]*")/, "", src)                       # .glob("…", excluding: […]) 의 뺄 경로는 소스가 아니다
    while (match(src, /"[^"]*"/)) { modsrc(name, substr(src, RSTART + 1, RLENGTH - 2), d); src = substr(src, RSTART + RLENGTH) }
  }
  if (!found && proj != "" && !index(proj, "\\(")) { modsrc(proj, "Sources/**", d); modsrc(proj "Tests", "Tests/**", d) }   # 도우미 매니페스트: Tuist 의 흔한 틀
}
function modsrc(name, g, d,   pre) {   # 모듈 name 의 소스 glob(매니페스트 폴더 d 기준)
  g = normp(d == "" ? g : d "/" g)
  if (g == "\001" || g == "") return
  MODN++; MODNAME[MODN] = name; MODG[MODN] = g
  pre = g; sub(/[*?{[].*$/, "", pre); MODPRE[MODN] = pre                         # 첫 와일드카드 앞까지 — 대부분 이것만으로 거른다
  MODRE[MODN] = (pre == g) ? "" : globre(g)
  if (!(name in MODDIR)) { MODDIR[name] = pre; sub(/\/$/, "", MODDIR[name]) }
}
function swift_mods(p,   i, out) {   # 파일이 속한 모듈들 "\034A\034B" (여러 타깃이 같은 폴더를 쓰기도 한다)
  out = ""
  for (i = 1; i <= MODN; i++) {
    if (index(p, MODPRE[i]) != 1) continue
    if (MODRE[i] == "" ? (p == MODG[i] || index(p, MODG[i] "/") == 1) : (p ~ MODRE[i])) {
      if (!index(out "\034", "\034" MODNAME[i] "\034")) out = out "\034" MODNAME[i]
    }
  }
  return out
}
function swift_reexport(p, s,   n, a, i) {   # @_exported import s — 이 파일의 모듈을 가져오면 s 의 타입도 보인다
  n = split(FMOD[p], a, "\034")
  for (i = 2; i <= n; i++) if (!index(MREXP[a[i]] "\034", "\034" s "\034")) MREXP[a[i]] = MREXP[a[i]] "\034" s
}
function swift_imports(p, m,   n, a, i) {
  if ((p "\034" m) in FIMP) return 1
  n = split(FIMPL[p], a, "\034")
  for (i = 2; i <= n; i++) if (index(MREXP[a[i]] "\034", "\034" m "\034")) return 1
  return 0
}
function swift_modcount(   i, n, seen) { n = 0; for (i = 1; i <= MODN; i++) if (!(MODNAME[i] in seen)) { seen[MODNAME[i]] = 1; n++ }; return n }
function jlist(s,   n, a, i, r) { n = split(s, a, "\034"); r = ""; for (i = 2; i <= n; i++) r = r (r != "" ? "," : "") jstr(a[i]); return r }   # "\034A\034B" → "A","B"
function swift_reach(p, t, w,   n, a, i) {   # 3 같은 모듈 · 2 t 의 모듈을 import(공개 선언이거나 @testable) · 1 t 의 모듈을 모름 · 0 닿을 수 없음
  if (FMOD[t] == "") return 1
  n = split(FMOD[t], a, "\034")
  for (i = 2; i <= n; i++) if (index(FMOD[p] "\034", "\034" a[i] "\034")) return 3
  for (i = 2; i <= n; i++) if (swift_imports(p, a[i]) && (((t "\034" w) in SWPUB) || ((p "\034" a[i]) in FTEST))) return 2
  return 0
}

