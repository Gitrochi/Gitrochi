function gradle_text(f,   line, all) {   # 줄 주석을 뺀 내용(줄바꿈 유지)
  all = ""
  while ((getline line < f) > 0) { sub(/\r$/, "", line); if (line ~ /^[ \t]*\/\//) continue; sub(/[ \t]\/\/.*$/, "", line); all = all line "\n" }
  close(f)
  return all
}
function gradle_modules(   i, f, d, s, m, e, args, q, path, root, rname, n, mp, k, bf, id, before) {
  for (i = 1; i <= NGSET; i++) {
    f = GSET[i]; d = dirof(f); s = gradle_text(f)
    rname = (d == "") ? repo : baseof(d)
    if (match(s, /rootProject\.name[ \t]*=[ \t]*["'][^"']*["']/)) { m = substr(s, RSTART, RLENGTH); rname = unquote(substr(m, index(m, "=") + 1)) }
    n = 0
    while (match(s, /(^|[^A-Za-z0-9_.])include[ \t]*(\(|["'])/)) {           # include(":a", ":b:c") · include ':a', ':b'
      e = RSTART + RLENGTH - 1; s = substr(s, e)
      if (substr(s, 1, 1) == "(") { e = balanced(s, 1); args = substr(s, 2, e - 2) } else { e = index(s, "\n"); if (!e) e = length(s); args = substr(s, 1, e) }
      s = substr(s, e + 1)
      while (match(args, /["'][^"']*["']/)) {
        q = substr(args, RSTART + 1, RLENGTH - 2); args = substr(args, RSTART + RLENGTH)
        if (q !~ /^:/) q = ":" q
        n++; GMOD[i, n] = q; mp = substr(q, 2); gsub(/:/, "/", mp); GDIR[i, q] = joinp(d, mp)
      }
    }
    s = gradle_text(f)                                                        # project(":x").projectDir = file("…")
    while (match(s, /project[ \t]*\([ \t]*["'][^"']*["'][ \t]*\)[ \t]*\.projectDir[ \t]*=[^\n]*/)) {
      m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
      match(m, /["'][^"']*["']/); q = substr(m, RSTART + 1, RLENGTH - 2); if (q !~ /^:/) q = ":" q
      m = substr(m, index(m, "=") + 1); path = ""
      while (match(m, /["'][^"']*["']/)) { path = substr(m, RSTART + 1, RLENGTH - 2); m = substr(m, RSTART + RLENGTH) }
      if (path != "") { path = normp(joinp(d, path)); if (path != "\001") GDIR[i, q] = path }
    }
    GN[i] = n; GROOT[i] = rname
    for (k = 1; k <= n; k++) { q = GMOD[i, k]; GACC[i, gradle_key(substr(q, 2), ":")] = q }
    for (k = 1; k <= n; k++) {
      q = GMOD[i, k]; path = GDIR[i, q]
      if (!inscope(path "/")) continue
      GVIS[path] = 1; id = gradle_id(d, q); mnode(id, q, "gradle", path, "project")
      bf = joinp(path, "build.gradle.kts"); if (!(bf in EX)) bf = joinp(path, "build.gradle")
      if (bf in EX) gradle_deps(bf, id, i, d)
    }
    bf = joinp(d, "build.gradle.kts"); if (!(bf in EX)) bf = joinp(d, "build.gradle")      # 루트 프로젝트는 의존이 있을 때만
    if (inscope(joinp(d, "x"))) { GVIS[d] = 1; mnode(gradle_id(d, ":"), rname, "gradle", d, "root"); if (bf in EX) gradle_deps(bf, gradle_id(d, ":"), i, d) }
  }
  for (i = 1; i <= NGBUILD; i++) {
    f = GBUILD[i]; d = dirof(f); if ((d in GVIS) || !inscope(f)) continue
    GVIS[d] = 1; id = gradle_id(d, ":"); mnode(id, d == "" ? repo : d, "gradle", d, "project"); gradle_deps(f, id, 0, d)
  }
}
function gradle_id(d, q) { return "gradle:" (d == "" ? "" : d) q }
function gradle_key(s, sep) { s = tolower(s); gsub(/[-_]/, "", s); gsub(sep, ".", s); return s }
function gradle_deps(f, id, si, sd,   line, indep, depth, conf, s, m, q, k) {
  indep = 0; depth = 0
  while ((getline line < f) > 0) {
    sub(/\r$/, "", line); if (line ~ /^[ \t]*\/\//) continue; sub(/[ \t]\/\/.*$/, "", line)
    if (!indep) { if (line ~ /^[ \t]*dependencies[ \t]*\{/) { indep = 1; depth = 0 } else continue }
    depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
    conf = line; sub(/^[ \t]*/, "", conf); if (match(conf, /^[A-Za-z]+/)) conf = substr(conf, 1, RLENGTH); else conf = ""
    s = line
    while (match(s, /project[ \t]*\([ \t]*(path[ \t]*[:=][ \t]*)?["'][^"']*["']/)) {       # project(":core:data")
      m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
      match(m, /["'][^"']*["']/); q = substr(m, RSTART + 1, RLENGTH - 2); if (q !~ /^:/) q = ":" q
      dep(id, gradle_id(sd, q), conf, "")
    }
    s = line
    while (match(s, /projects\.[A-Za-z0-9_.]+/)) {                                     # projects.core.data (타입 안전 접근자)
      m = substr(s, RSTART + 9, RLENGTH - 9); s = substr(s, RSTART + RLENGTH)
      k = gradle_key(m, "\\.")
      if ((si, k) in GACC) dep(id, gradle_id(sd, GACC[si, k]), conf, "")
    }
    if (conf != "" && conf != "project" && match(line, /["'][A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+(:[^"']*)?["']/)) {   # "group:artifact:version"
      m = substr(line, RSTART + 1, RLENGTH - 2); sub(/:[^:]*$/, "", m); if (index(m, ":") == 0) m = substr(line, RSTART + 1, RLENGTH - 2)
      xdep(id, "maven", m, conf, "")
    }
    if (conf != "" && match(line, /libs\.[A-Za-z0-9_.]+/) && line !~ /libs\.(plugins|versions)\./) xdep(id, "gradle", substr(line, RSTART, RLENGTH), conf, "")
    if (depth <= 0) indep = 0
  }
  close(f)
}

# ----- Swift 매니페스트 읽기 도우미 (주석을 지운 한 덩어리 · 괄호 짝 · 맨 위 쉼표로 나누기) -----
function swift_text(f,   line, all, i, c, n, q, out, cm) {
  all = ""; cm = 0
  while ((getline line < f) > 0) {
    sub(/\r$/, "", line)
    if (!cm && !index(line, "/")) { all = all " " line; continue }
    out = ""; q = 0; n = length(line)
    for (i = 1; i <= n; i++) {
      c = substr(line, i, 1)
      if (cm) { if (c == "*" && substr(line, i + 1, 1) == "/") { cm = 0; i++ }; continue }
      if (q) { out = out c; if (c == "\\") { i++; out = out substr(line, i, 1) } else if (c == "\"") q = 0; continue }
      if (c == "\"") { q = 1; out = out c; continue }
      if (c == "/" && substr(line, i + 1, 1) == "/") break
      if (c == "/" && substr(line, i + 1, 1) == "*") { cm = 1; i++; continue }
      out = out c
    }
    all = all " " out
  }
  close(f)
  return all
}
function balanced(s, i,   d, n, c, q) {   # s 의 i 번째 여는 괄호와 짝인 닫는 괄호 위치 (문자열 안은 세지 않음)
  d = 0; n = length(s); q = 0
  for (; i <= n; i++) {
    c = substr(s, i, 1)
    if (q) { if (c == "\\") i++; else if (c == "\"") q = 0; continue }
    if (c == "\"") q = 1
    else if (c == "(" || c == "[" || c == "{") d++
    else if (c == ")" || c == "]" || c == "}") { d--; if (d == 0) return i }
  }
  return n
}
function items(s, arr,   n, i, d, c, q, st, len) {   # 맨 위 쉼표로 나눈 조각 → arr[1..n]
  n = 0; d = 0; q = 0; st = 1; len = length(s)
  for (i = 1; i <= len; i++) {
    c = substr(s, i, 1)
    if (q) { if (c == "\\") i++; else if (c == "\"") q = 0; continue }
    if (c == "\"") q = 1
    else if (c == "(" || c == "[" || c == "{") d++
    else if (c == ")" || c == "]" || c == "}") d--
    else if (c == "," && d == 0) { arr[++n] = trim(substr(s, st, i - st)); st = i + 1 }
  }
  if (trim(substr(s, st)) != "") arr[++n] = trim(substr(s, st))
  return n
}
function argval(it, key,   v) {   # 조각 "key: 값" 이면 값
  if (!match(it, "^" key "[ \t]*:")) return "\001"
  v = trim(substr(it, RLENGTH + 1))
  return v
}
function strarg(s, key,   m) {   # s 안의 key: "값"
  if (!match(s, "(^|[^A-Za-z0-9_])" key "[ \t]*:[ \t]*\"[^\"]*\"")) return ""
  m = substr(s, RSTART, RLENGTH); sub(/^[^"]*"/, "", m); sub(/"$/, "", m)
  return m
}
function inner(v) { sub(/^[ \t]*\[/, "", v); sub(/\][ \t]*$/, "", v); return v }

# ----- SwiftPM: swift package describe 의 JSON(있으면) 또는 Package.swift 를 직접 -----
function spm_modules(   line, a, i, f, d, j, n, D, k, nm, pk, id) {
  while ((getline line < spm) > 0) { split(line, a, "\t"); SPMJ[a[1]] = a[2] }
  close(spm)
  for (i = 1; i <= NSPM; i++) {
    f = SPM[i]; d = dirof(f)
    if (!inscope(f)) continue
    if (d in SPMJ) spm_json(SPMJ[d], d); else spm_manifest(f, d)
  }
  for (i = 1; i <= SPN; i++) {
    id = "swift:" SPNAME[i]
    mnode(id, SPNAME[i], "swift", joinp(SPDIR[i], SPPATH[i]), SPTYPE[i])
    n = split(SPDEPS[i], D, "\034")
    for (j = 2; j <= n; j++) {
      k = substr(D[j], 1, 1); nm = substr(D[j], 3); pk = ""
      if (k == "p" && index(nm, "\035")) { pk = substr(nm, index(nm, "\035") + 1); nm = substr(nm, 1, index(nm, "\035") - 1) }
      if (k == "t" || (nm in SPLOCAL)) dep(id, "swift:" nm, (k == "p" ? "product" : "target"), "")
      else xdep(id, "swiftpm", nm, "product", pk)
    }
  }
}
function spm_add(d, name, path, typ, deps) {
  SPN++; SPNAME[SPN] = name; SPPATH[SPN] = path; SPTYPE[SPN] = typ; SPDEPS[SPN] = deps; SPDIR[SPN] = d; SPLOCAL[name] = 1
}
function spm_json(f, d,   line, intg, arr, name, path, typ, deps, v) {   # 정렬된 키 · 두 칸 들여쓰기 모양
  intg = 0; arr = ""
  while ((getline line < f) > 0) {
    if (line ~ /^  "targets" : \[/) { intg = 1; continue }
    if (!intg) continue
    if (line ~ /^  \]/) { intg = 0; continue }
    if (line ~ /^    \{/) { name = ""; path = ""; typ = ""; deps = ""; arr = ""; continue }
    if (line ~ /^    \}/) { if (name != "") spm_add(d, name, path, typ, deps); continue }
    v = line; sub(/^[^:]*:[ \t]*"?/, "", v); sub(/"?,?[ \t]*$/, "", v)
    if (line ~ /^      "name" : "/) name = v
    else if (line ~ /^      "path" : "/) path = v
    else if (line ~ /^      "type" : "/) typ = v
    else if (line ~ /^      "target_dependencies" : \[/) arr = "t"
    else if (line ~ /^      "product_dependencies" : \[/) arr = "p"
    else if (line ~ /^      "/) arr = ""
    else if (arr != "" && line ~ /^        "/) { v = line; sub(/^[ \t]*"/, "", v); sub(/",?[ \t]*$/, "", v); deps = deps "\034" arr ":" v }
  }
  close(f)
}
function spm_manifest(f, d,   s, fn, i, e, args, n, IT, j, v, name, path, typ, deps, m, DI, k, x, pk) {
  s = swift_text(f)
  while (match(s, /\.(target|executableTarget|testTarget|macro|plugin|binaryTarget|systemLibrary)[ \t]*\(/)) {
    fn = substr(s, RSTART + 1, RLENGTH - 1); sub(/[ \t]*\($/, "", fn)
    i = RSTART + RLENGTH - 1; e = balanced(s, i)
    args = substr(s, i + 1, e - i - 1); s = substr(s, e + 1)       # 안의 .target(name:) 참조는 건너뛴다
    if (args ~ /(^|[^A-Za-z0-9_])targets[ \t]*:/) continue               # products 의 .plugin(name:targets:) 은 타깃이 아니다
    name = ""; path = ""; deps = ""
    n = items(args, IT)
    for (j = 1; j <= n; j++) {
      if ((v = argval(IT[j], "name")) != "\001") name = unquote(v)
      else if ((v = argval(IT[j], "path")) != "\001") path = unquote(v)
      else if ((v = argval(IT[j], "dependencies")) != "\001") {
        m = items(inner(v), DI)
        for (k = 1; k <= m; k++) {
          x = DI[k]
          if (x ~ /^"/) deps = deps "\034b:" unquote(x)
          else if (x ~ /^\.target[ \t]*\(/) deps = deps "\034t:" strarg(x, "name")
          else if (x ~ /^\.product[ \t]*\(/) { pk = strarg(x, "package"); deps = deps "\034p:" strarg(x, "name") (pk != "" ? "\035" pk : "") }
          else if (x ~ /^\.byName[ \t]*\(/) deps = deps "\034b:" strarg(x, "name")
        }
      }
    }
    if (name == "") continue
    typ = (fn == "target") ? "library" : (fn == "executableTarget") ? "executable" : (fn == "testTarget") ? "test" : (fn == "binaryTarget") ? "binary" : (fn == "systemLibrary") ? "system-target" : fn
    if (path == "") path = ((fn == "testTarget") ? "Tests/" : (fn == "plugin") ? "Plugins/" : "Sources/") name
    spm_add(d, name, path, typ, deps)
  }
  # 이름만 쓴 의존("X")은 같은 매니페스트의 타깃이면 타깃, 아니면 제품
}

# ----- Tuist Project.swift: Target 선언(product · bundleId 가 있는 것)과 의존 -----
function tuist_modules(   i, f, d, s, all, proj, e, j, args, n, IT, v, name, typ, deps, m, DI, k, x, found, id, D, nd, t, kk) {
  for (i = 1; i <= NTUIST; i++) {
    f = TUIST[i]; d = dirof(f)
    if (!inscope(f)) continue
    all = swift_text(f); s = all; proj = ""; found = 0
    if (match(s, /Project[ \t]*(\.[A-Za-z_][A-Za-z0-9_]*)?[ \t]*\(/)) proj = strarg(substr(s, RSTART), "name")   # Project( 또는 도우미 Project.module(
    while (match(s, /(\.target|[^A-Za-z0-9_.]Target(\.target)?)[ \t]*\(/)) {
      j = RSTART + RLENGTH - 1; e = balanced(s, j)
      args = substr(s, j + 1, e - j - 1); s = substr(s, e + 1)
      if (args !~ /(product|bundleId|destinations|platform|sources)[ \t]*:/) continue      # .target(name:) 는 의존 참조
      name = ""; typ = ""; deps = ""
      n = items(args, IT)
      for (k = 1; k <= n; k++) {
        if ((v = argval(IT[k], "name")) != "\001") name = unquote(v)
        else if ((v = argval(IT[k], "product")) != "\001") { typ = v; sub(/^\./, "", typ) }
        else if ((v = argval(IT[k], "dependencies")) != "\001") deps = tuist_deps(inner(v))
      }
      if (name == "") continue
      found++; tuist_node(name, d, typ, deps)
    }
    if (!found && proj != "") tuist_node(proj, d, "project", tuist_deps(all))   # 도우미 함수로 만든 매니페스트 — 파일 안의 참조를 모은다
  }
  for (i = 1; i <= TUN; i++) {
    id = "tuist:" TUNAME[i]
    nd = split(TUDEPS[i], D, "\034")
    for (j = 2; j <= nd; j++) {
      t = substr(D[j], 1, 1); x = substr(D[j], 3)
      if (t == "t") dep(id, "tuist:" x, "target", "")
      else if (t == "j") dep(id, "tuist:" x, "project", "")
      else xdep(id, (t == "s") ? "sdk" : (t == "f") ? "framework" : "swiftpm", x, (t == "s") ? "sdk" : (t == "f") ? "framework" : "external", "")
    }
  }
}
function tuist_node(name, d, typ, deps) { TUN++; TUNAME[TUN] = name; TUDEPS[TUN] = deps; mnode("tuist:" name, name, "tuist", d, typ) }
function tuist_deps(s,   out, m, x, k, n, DI, b) {
  out = ""
  n = items(s, DI)
  if (n == 1 && DI[1] !~ /^\./) { n = 0 }
  for (k = 1; k <= n; k++) {
    x = DI[k]
    if (x ~ /^\.target[ \t]*\(/) out = out "\034t:" strarg(x, "name")
    else if (x ~ /^\.project[ \t]*\(/) out = out "\034j:" strarg(x, "target")
    else if (x ~ /^\.external[ \t]*\(/) out = out "\034e:" strarg(x, "name")
    else if (x ~ /^\.package[ \t]*\(/) out = out "\034e:" strarg(x, "product")
    else if (x ~ /^\.sdk[ \t]*\(/) out = out "\034s:" strarg(x, "name")
    else if (x ~ /^\.(framework|xcframework|library)[ \t]*\(/) { b = baseof(strarg(x, "path")); sub(/\.[A-Za-z]+$/, "", b); if (b != "") out = out "\034f:" b }
  }
  if (out != "" || n > 1) return out
  while (match(s, /\.(target|project|external)[ \t]*\([^()]*\)/)) {          # 도우미 매니페스트: 파일 전체에서 참조를 찾는다
    x = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
    if (x ~ /^\.project/) out = out "\034j:" strarg(x, "target")
    else if (x ~ /^\.external/) out = out "\034e:" strarg(x, "name")
    else if (x !~ /(product|bundleId)[ \t]*:/) out = out "\034t:" strarg(x, "name")
  }
  return out
}
AWKEOF
}

# changes: NUL 로그를 정규화한 상태/경로 → 현재 파일의 rename 계보 · 같이 바뀜 · 근거 커밋
graph_awk_changes() {
  cat <<'AWKEOF'
BEGIN {
  while ((getline p < list) > 0) if (p != "" && !index(p, "\t")) { TR[p] = 1; ACTIVE[p] = p }
  close(list)
  PLIMIT = 20
}
/^\001/ {
  flush()
  if (NCOM >= maxc) { TRUNC = 1; IGNORE = 1; next }
  h = substr($0, 2); at = index(h, "\t"); CSHA = substr(h, 1, at - 1); h = substr(h, at + 1)
  at = index(h, "\t"); CDATE = substr(h, 1, at - 1); h = substr(h, at + 1)
  at = index(h, "\t"); CTIME = substr(h, 1, at - 1) + 0; CSUBJECT = substr(h, at + 1)
  next
}
/^\002/ { INVALID = substr($0, 2) + 0; next }
$0 != "" && !IGNORE {
  n = split($0, a, "\t"); status = substr(a[1], 1, 1); p = a[2]
  if (status == "R") {
    # 逆순: new 의 현재 파일 정체성을 old 로 옮긴다. 현재 이름을 재사용한 옛 파일과 섞이지 않게 new 를 닫는다.
    old = p; p = a[3]; id = ACTIVE[p]
    if (id != "") { addchange(id); MOVES[old] = id; NRENAME++ }
    else MOVES[old] = ""
    CLOSED[p] = 1
  } else if (status == "C") {
    p = a[3]; addchange(ACTIVE[p]); CLOSED[p] = 1      # 복사는 새 파일이며 원본 이력을 물려받지 않는다
  } else {
    if (status != "D") addchange(ACTIVE[p])
    if (status == "A" || status == "D") CLOSED[p] = 1
  }
}
END { flush(); changes_out() }
function addchange(p) {
  if (p == "" || !(p in TR) || !inscope(p) || (p in SEEN) || !langok(p)) return
  if (p ~ ENVIRON["GITSW_LOCKRE"]) { LOCKS[p] = 1; return }
  SEEN[p] = 1; FL[++NFC] = p
}
function flush(   i, j, x, y, t, k, p) {   # 큰 커밋도 rename 계보는 적용하고 통계/쌍에서만 뺀다
  if (CSHA != "") {
    NCOM++
    if (!HFROM || CTIME < HFROM) { HFROM = CTIME; HFROMDATE = CDATE }
    if (!HTO || CTIME > HTO) { HTO = CTIME; HTODATE = CDATE }
    if (NFC > maxf) NSKIP++
    else if (NFC > 0) {
      NUSED++
      if (!AFROM || CTIME < AFROM) { AFROM = CTIME; AFROMDATE = CDATE }
      if (!ATO || CTIME > ATO) { ATO = CTIME; ATODATE = CDATE }
      for (i = 1; i <= NFC; i++) {
        p = FL[i]; CH[p]++
        if (!(p in LASTTIME) || CTIME > LASTTIME[p]) { LASTTIME[p] = CTIME; LAST[p] = substr(CDATE, 1, 10) }
      }
      for (i = 1; i < NFC; i++) for (j = i + 1; j <= NFC; j++) {
        x = FL[i] ""; y = FL[j] ""
        if (x > y) { t = x; x = y; y = t }
        k = x "\034" y; PR[k]++
        if (PR[k] <= PLIMIT) PROOF[k] = PROOF[k] (PR[k] > 1 ? "," : "") "{\"sha\":" jstr(CSHA) ",\"date\":" jstr(CDATE) ",\"subject\":" jstr(CSUBJECT) "}"
      }
    }
    for (p in CLOSED) delete ACTIVE[p]
    for (p in MOVES) { if (MOVES[p] != "") ACTIVE[p] = MOVES[p]; else delete ACTIVE[p] }
  }
  CSHA = ""; NFC = 0; split("", SEEN); split("", CLOSED); split("", MOVES)
}
function changes_out(   k, a, c, f, g, extra) {
  for (k in PR) {
    c = PR[k]
    if (c < min) continue
    split(k, a, "\034")
    extra = "\"degree\":" int(200 * c / (CH[a[1]] + CH[a[2]]) + 0.5) ",\"method\":\"git-history\",\"commitCount\":" c ",\"commitsTruncated\":" (c > PLIMIT ? "true" : "false") ",\"commits\":[" PROOF[k] "]"
    addedge(a[1], a[2], "cochange", c, 0, "", extra)
    KEEP[a[1]] = 1; KEEP[a[2]] = 1
  }
  for (f in CH) {
    if (CH[f] < min && !(f in KEEP)) continue
    g = langof(f); if (g == "") g = tolower(extof(f)); if (g == "") g = "file"
    addnode(f, "file", baseof(f), g, "\"path\":" jstr(f) ",\"lang\":" jstr(g) ",\"changes\":" CH[f] ",\"lastChanged\":" jstr(LAST[f]))
  }
  emit()
  printf "0\tcommits\t%d\n0\tanalyzedCommits\t%d\n0\tskippedLargeCommits\t%d\n", NCOM, NUSED, NSKIP
  printf "0\tmaxCommits\t%d\n0\tmaxFiles\t%d\n0\tminCount\t%d\n0\tsince\t%s\n", maxc, maxf, min, (since == "" ? "null" : jstr(since))
  printf "0\thistoryFrom\t%s\n0\thistoryTo\t%s\n", (HFROMDATE == "" ? "null" : jstr(HFROMDATE)), (HTODATE == "" ? "null" : jstr(HTODATE))
  printf "0\tanalyzedFrom\t%s\n0\tanalyzedTo\t%s\n", (AFROMDATE == "" ? "null" : jstr(AFROMDATE)), (ATODATE == "" ? "null" : jstr(ATODATE))
  printf "0\thistoryTruncated\t%s\n0\tshallowHistory\t%s\n0\tfollowedRenames\t%d\n0\tprovenanceLimit\t%d\n0\tskippedHistoryPaths\t%d\n", (TRUNC ? "true" : "false"), (shallow == "true" ? "true" : "false"), NRENAME, PLIMIT, INVALID
  printf "0\tnote\t한 커밋에 같이 바뀐 파일 쌍입니다. weight = 같이 바뀐 커밋 수, degree = 두 파일이 바뀐 횟수 평균에 대한 비율(%%), 노드의 changes = 바뀐 횟수(핫스팟).\n"
  printf "0\tnote\t이름 변경을 거슬러 현재 추적 경로로 합쳤습니다. 추가/삭제 경계에서 끊어 같은 이름으로 다시 만든 파일의 옛 이력은 합치지 않습니다. 되돌리기는 독립적인 변경 커밋으로 셉니다.\n"
  if (NSKIP) printf "0\tnote\t파일이 %d개 넘게 바뀐 커밋 %d개는 뺐습니다 (정리 · 이름 바꾸기 같은 큰 커밋 — --max-files 로 바꿈).\n", maxf, NSKIP
  if (TRUNC) printf "0\tnote\t최근 커밋 %d개만 봤습니다 (--max-commits · --since 로 바꿈).\n", maxc
  if (shallow == "true") print "0\tnote\t얕은 복제의 로컬 이력만 분석했습니다. 원격의 더 오래된 커밋은 포함되지 않습니다."
  if (NRENAME) printf "0\tnote\t파일 이름 변경 %d건을 거슬러 옛 이력을 현재 파일에 합쳤습니다.\n", NRENAME
  if (INVALID) printf "0\tnote\t탭/줄바꿈 등 구분 문자가 든 이력 경로 %d건은 분석에서 뺐습니다.\n", INVALID
  for (f in LOCKS) { print "0\tnote\tlock 파일(package-lock.json · Cargo.lock 등)은 매니페스트와 늘 같이 바뀌므로 뺐습니다."; break }
}
AWKEOF
}

# tree: "<blob> <크기> <경로>" 줄들 → 폴더 노드(파일 수 · 바이트 · 많은 확장자)와 포함 관계
graph_awk_tree() {
  cat <<'AWKEOF'
BEGIN { root = scope; sub(/\/$/, "", root); RID = (root == "") ? "./" : root "/"; RLABEL = (root == "") ? repo : root; if(safeList!="") { while((getline p < safeList)>0) SAFE[p]=1; close(safeList) } }
{
  if (NF == 2 && $2 == "missing") next
  sz = $2 + 0; p = $0; sub(/^[^ ]+ [^ ]+ /, "", p)
  if(safeList!="" && !(p in SAFE)) next
  if (p == "" || index(p, "\t") || (p in SEEN) || !inscope(p) || !langok(p)) next
  SEEN[p] = 1; NFILES++; TOTAL += sz
  e = tolower(extof(p)); if (e == "") e = "none"
  rel = (root == "") ? p : substr(p, length(root) + 2)
  n = split(rel, seg, "/")
  tnode(RID, RLABEL, 0, root); acc(RID, sz, e)
  par = RID; at = RID; d = root
  lim = (maxd > 0 && n - 1 > maxd) ? maxd : n - 1        # --depth 보다 깊은 폴더는 노드 없이 그 위 폴더에 합쳐 센다
  for (i = 1; i < n; i++) {
    d = joinp(d, seg[i]); id = d "/"
    if (!((par "\034" id) in LINK)) { LINK[par "\034" id] = 1; SUBD[par]++; if (i <= lim) addedge(par, id, "contains", 1, 0, "", "") }
    if (i <= lim) { tnode(id, seg[i], i, d); acc(id, sz, e); at = id }
    par = id
  }
  if (lim == n - 1) {
    HERE[at]++
    if (withfiles) { g = langof(p); if (g == "") g = e; addnode(p, "file", seg[n], g, "\"path\":" jstr(p) ",\"bytes\":" sz); addedge(at, p, "contains", 1, 0, "", "") }
  }
}
END {
  for (i = 1; i <= NT; i++) {
    id = TORD[i]
    addnode(id, "folder", TL[id], "folder", "\"path\":" jstr(TP[id]) ",\"depth\":" TD[id] ",\"files\":" TF[id] ",\"bytes\":" TB[id] ",\"filesHere\":" (HERE[id] + 0) ",\"dirs\":" (SUBD[id] + 0) ",\"exts\":" topext(id))
  }
  emit()
  printf "0\tfiles\t%d\n0\tbytes\t%d\n0\tmaxDepth\t%d\n", NFILES, TOTAL, maxd
  print "0\tnote\t폴더마다 files = 아래 모든 파일 수, bytes = 그 크기 합(" (treeSnapshot ? "선택한 비교 범위의 내용 기준" : "인덱스의 내용 기준") "), filesHere = 바로 아래 파일 수, exts = 많은 확장자 다섯 개."
}
function tnode(id, label, depth, path) { if (id in TD) return; TD[id] = depth; TL[id] = label; TP[id] = (path == "") ? "." : path; NT++; TORD[NT] = id }
function acc(id, sz, e) { TF[id]++; TB[id] += sz; if (!((id "\034" e) in TE)) TEL[id] = TEL[id] "\034" e; TE[id "\034" e]++ }
function topext(id,   n, a, i, j, best, bi, out, used, c) {   # 많은 확장자 다섯 개 → {"ts":12,...}
  n = split(TEL[id], a, "\034"); out = ""
  for (j = 1; j <= 5; j++) {
    best = -1; bi = 0
    for (i = 2; i <= n; i++) {
      if (a[i] in used) continue
      c = TE[id "\034" a[i]]
      if (c > best || (c == best && a[i] "" < a[bi] "")) { best = c; bi = i }
    }
    if (!bi) break
    used[a[bi]] = 1; out = out (out == "" ? "" : ",") jstr(a[bi]) ":" best
  }
  return "{" out "}"
}
AWKEOF
}

