function cargo_read(f,   line, sec, k, v, n, m) {   # Cargo.toml: [package] name, [*dependencies] (표 · 인라인 표 · 점 키), [workspace.dependencies]
  CN[f] = ""; CDN[f] = 0; sec = ""
  while ((getline line < f) > 0) {
    sub(/\r$/, "", line); sub(/[ \t]#.*$/, "", line); if (line ~ /^[ \t]*#/) continue
    if (line ~ /^[ \t]*\[/) {
      sec = line; gsub(/[ \t]|\[|\]/, "", sec)
      if (sec == "workspace") CWS[f] = 1
      if (match(sec, /(^|\.)(dev-|build-)?dependencies\.[A-Za-z0-9_-]+$/)) {          # [dependencies.foo]
        k = sec; sub(/^.*\./, "", k); v = sec; sub(/\.[A-Za-z0-9_-]+$/, "", v); sub(/^.*\./, "", v)
        CDN[f]++; n = CDN[f]; CDNAME[f, n] = k; CDSC[f, n] = v; sec = "\001table"
      }
      continue
    }
    if (sec == "package") { if (match(line, /^[ \t]*name[ \t]*=[ \t]*"[^"]*"/)) { m = substr(line, RSTART, RLENGTH); sub(/^[^"]*"/, "", m); sub(/"$/, "", m); CN[f] = m }; continue }
    if (sec == "\001table") { n = CDN[f]; cargo_attrs(f, n, line); continue }
    if (sec !~ /(^|\.)(dev-|build-)?dependencies$/) continue
    if (!match(line, /^[ \t]*[A-Za-z0-9_-]+[ \t]*(\.[ \t]*[A-Za-z]+[ \t]*)?=/)) continue
    k = substr(line, RSTART, RLENGTH); v = substr(line, RSTART + RLENGTH)
    sub(/=$/, "", k); k = trim(k); m = ""
    if (index(k, ".")) { m = k; sub(/^[^.]*\.[ \t]*/, "", m); sub(/[ \t]*\..*$/, "", k) }    # foo.workspace = true · foo.path = "…"
    if (sec == "workspace.dependencies") { if (match(v, /path[ \t]*=[ \t]*"[^"]*"/) || m == "path") { WSP[f, k] = cargo_str(m == "path" ? "path=" v : substr(v, RSTART, RLENGTH)) }; continue }
    CDN[f]++; n = CDN[f]; CDNAME[f, n] = k; CDSC[f, n] = sec; sub(/^.*\./, "", CDSC[f, n])
    if (m == "workspace" || m == "path" || m == "package") cargo_attrs(f, n, m " = " v); else cargo_attrs(f, n, v)
