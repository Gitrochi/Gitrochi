  for ev in $HOOK_EVENTS; do git config --global --remove-section "hook.gitsw-$ev" 2>/dev/null; done
  rm -f "$HOOK_DISPATCHER"
  [ ${#ACC_IDS[@]} -gt 0 ] && remove_managed_rules "${ACC_IDS[*]}"
  if grep -q '# >>> gitsw >>>' "$SHELL_RC" 2>/dev/null; then backup_file "$SHELL_RC"; remove_marked_block "$SHELL_RC" "# >>> gitsw >>>" "# <<< gitsw <<<"; fi
  [ -n "$IS_WINDOWS" ] && remove_windows_shims
  ai_remove
