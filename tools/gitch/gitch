menu_cmd() {
  load_config >/dev/null 2>&1
  say "${BOLD}gitch${RESET}  ($(account_names))"
  echo "  1) 이 저장소 계정 전환 + 잠금"
  echo "  2) clone"
  echo "  3) fork 해서 clone"
  echo "  4) 현재 저장소 상태"
  echo "  5) 등록된 계정 (접속 확인)"
  echo "  6) 저장소 전체 점검 ($CFG_SCAN_ROOT)"
  echo "  7) 문제 진단"
  echo "  8) 계정 추가"
  echo "  9) 전체 설치/갱신"
  echo "  h) 전체 명령 보기"
  local menu src
  read -r -p "번호: " menu
  case "$menu" in
    1) need_config; select_account; use_cmd "$SA_ID" ;;
    2) clone_cmd ;;
    3) need_config; select_account; read -r -p "원본 저장소 (owner/repo 또는 주소): " src; fork_cmd "$SA_ID" "$src" ;;
    4) status_cmd ;;
    5) list_cmd --check ;;
    6) scan_cmd ;;
    7) doctor_cmd ;;
    8) add_cmd ;;
    9) install_cmd ;;
    h|H) help_cmd ;;
    *) die "잘못된 선택입니다." ;;
  esac
}

# ================= flow: 조립형 테스트 · CI 흐름 (gitch-flow 엔진에 위임) =================

flow_engine() {   # 엔진 위치: GITCH_FLOW → gitch 옆(앱 Resources · ~/.local/share/gitch) → PATH
  local d e
  if [ -n "${GITCH_FLOW:-}" ]; then printf '%s' "$GITCH_FLOW"; return 0; fi
  d=$(dirname "$(self_path)")
  for e in "$d/gitch-flow" "$d/gitch-flow.exe" "${XDG_DATA_HOME:-$HOME/.local/share}/gitch/gitch-flow" "${XDG_DATA_HOME:-$HOME/.local/share}/gitch/gitch-flow.exe"; do
    [ -x "$e" ] && { printf '%s' "$e"; return 0; }
  done
  e=$(command -v gitch-flow 2>/dev/null) && [ -n "$e" ] && { printf '%s' "$e"; return 0; }
  return 1
}

flow_bash() {   # 엔진(네이티브 실행 파일)이 부를 bash. Windows 는 Git Bash 의 Windows 경로로 넘긴다.
  if [ -n "$IS_WINDOWS" ] && command -v cygpath >/dev/null 2>&1; then cygpath -w "${BASH:-/usr/bin/bash}"; else printf '%s' "${BASH:-bash}"; fi
}

flow_settings() { printf '%s/flow/settings.json' "$(dirname "$CFG")"; }

flow_cmd() {   # gitch flow … · gitch test … · gitch ci <하위 명령> → gitch-flow
  local engine
  if ! engine=$(flow_engine); then
    if [ -n "$MACHINE_JSON" ]; then machine_error GITCH_ERROR 1 "흐름 엔진(gitch-flow)을 찾지 못했습니다. 앱을 업데이트하거나 gitch self-update 를 실행하세요."
    else err "흐름 엔진(gitch-flow)을 찾지 못했습니다. 앱을 업데이트하거나 gitch self-update 를 실행하세요."; fi
    return 1
  fi
  # 엔진이 영향 그래프 등을 gitch 에 되물을 때 쓰는 경로.
  GITCH_PATH=$(self_path) GITCH_BASH=$(flow_bash) exec "$engine" "$@"
}

hook_flow_gate() {   # pre-push: 이 저장소에 게이트를 켰을 때만 흐름 결과로 막는다
  local engine settings
  settings=$(flow_settings)
  [ -f "$settings" ] && grep -q '"prePush"' "$settings" 2>/dev/null || return 0
  engine=$(flow_engine) || return 0
  GITCH_PATH=$(self_path) GITCH_BASH=$(flow_bash) "$engine" gate prepush 1>&2
}

flow_preflight_line() {   # preflight 에 덧붙이는 FLOW=… 한 줄(게이트를 켠 저장소만, 기존 PREFLIGHT= 는 그대로)
  local engine settings out
  settings=$(flow_settings)
  [ -f "$settings" ] && grep -q '"prePush"' "$settings" 2>/dev/null || return 0
  engine=$(flow_engine) || return 0
  out=$("$engine" gate status 2>/dev/null | head -1)
  case "$out" in FLOW=*) printf '%s' "${out#FLOW=}" ;; esac
}

