  graph_languages | awk -F'|' "$(graph_awk_lib)"'
    function words(s,   n, a, i, out) { n = split(s, a, " "); out = ""; for (i = 1; i <= n; i++) if (a[i] != "") out = out (out != "" ? "," : "") jstr(a[i]); return "[" out "]" }
    function manifests(s,   n, a, i, out, m) {
      n = split(s, a, " "); out = ""
      for (i = 1; i <= n; i++) {
        m = ""
        if (a[i] == "npm") m = "package.json"
        else if (a[i] == "swift") m = "Package.swift"
        else if (a[i] == "tuist") m = "Project.swift"
        else if (a[i] == "pypi") m = "pyproject.toml requirements*.txt requirements*.in setup.cfg Pipfile"
        else if (a[i] == "go") m = "go.mod"
        else if (a[i] == "cargo") m = "Cargo.toml"
        else if (a[i] == "gradle") m = "settings.gradle settings.gradle.kts build.gradle build.gradle.kts"
        else if (a[i] == "maven") m = "pom.xml"
        else if (a[i] == "dotnet") m = "*.csproj *.fsproj *.vbproj"
        else if (a[i] == "composer") m = "composer.json"
        else if (a[i] == "gem") m = "Gemfile *.gemspec"
        else if (a[i] == "pub") m = "pubspec.yaml"
        else if (a[i] == "cmake") m = "CMakeLists.txt"
        if (m != "") out = out (out != "" ? " " : "") m
      }
      return words(out)
    }
    BEGIN { printf "{\"schemaVersion\":1,\"tool\":\"gitch graph languages\",\"languages\":[" }
    {
      static = $1 ~ /^(ts|js|vue|svelte|astro|mdx|swift|python|go|rust|java|kotlin|c|cpp|objc|objcpp|protobuf|ruby|php|lua|shell|css|scss|less|dart|solidity)$/
