function heur(s, t, w, fam, chk) {   # 이름으로 추정한 연결 — 같은 두 파일에 정확한 연결이 있으면 더하지 않는다
  if (s == t || ((s "\034" t) in PAIR)) return
  FREF[t] = 1; HEUR[fam]++
  addedge(s, t, "type-ref", 1, 1, w, "")
  if (chk) ECHK[s "\034" t "\034" "type-ref"] = 1   # 모듈 · 패키지로 확인한 추정(같은 모듈, import 한 모듈의 공개 타입, 같은 패키지)
}
function refs(p, s,   w) {   # 대문자로 시작하는 이름들(문자열 · 줄 주석 빼고) — Swift · Kotlin · Java 의 타입 추정용
  if (index(s, "\"")) gsub(/"([^"\\]|\\.)*"/, " ", s)
  if (index(s, "//")) sub(/\/\/.*$/, "", s)
  while (match(s, /(^|[^A-Za-z0-9_])[A-Z][A-Za-z0-9_]*/)) {   # 낱말을 모두 나누는 것보다 대문자 이름만 찾는 쪽이 빠르다
    w = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
    if (!index(UPPER, substr(w, 1, 1))) w = substr(w, 2)
    if (!((p "\034" w) in RF)) { RF[p "\034" w] = LINES[p]; REF[p] = REF[p] "\034" w }
  }
}

# ----- TypeScript / JavaScript: import · export … from · require() · import() -----
function scan_ts(p,   line, inc, st, open, allow, rest, m, spec, kw, kind) {
  inc = 0; st = "import"; open = 0
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]
    if (inc) { if (index(line, "*/")) inc = 0; continue }
    if (line ~ /^[ \t]*\/\*/) { if (!index(substr(line, index(line, "/*") + 2), "*/")) inc = 1; continue }
    if (line ~ /^[ \t]*\/\//) continue
    if (!index(line, "import") && !index(line, "require") && !index(line, "from")) { if (open && index(line, "}")) open = 0; continue }
    # from '…' 은 import/export 문 안에서만(여러 줄 import { … } from 의 끝 줄 포함) — 문자열 속 "from 'x'" 를 잡지 않게
    allow = open
    if (line ~ /^[ \t]*(import|export)([ \t{*]|$)/) { allow = 1; st = (line ~ /^[ \t]*export/) ? "reexport" : "import" }
    rest = line
    while (match(rest, /(^|[^A-Za-z0-9_$.])(from|import|require)[ \t]*\(?[ \t]*["'][^"']+["']/)) {
      m = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
      spec = m; sub(/^[^"']*["']/, "", spec); sub(/["']$/, "", spec)
      kw = m; sub(/^[^a-z]*/, "", kw); sub(/[^a-z].*$/, "", kw)
      if (kw == "require") { if (m !~ /\(/) continue; kind = "require" }
      else if (kw == "import") { if (m ~ /\(/) kind = "dynamic-import"; else if (allow) kind = "import"; else continue }
      else { if (!allow) continue; kind = st }
      ts_dep(p, spec, kind)
    }
    if (allow && index(line, "{") && !index(line, "}")) open = 1
    else if (open && index(line, "}")) open = 0
  }
  close(p)
}
function ts_dep(p, spec, kind,   s, t, ck) {
  s = spec
  if (s ~ /^#/) { unresolved(p, spec, "package.json imports 별칭은 빠른 분석에서 해석하지 못했습니다. SCIP 인덱스를 사용하세요."); return }
  sub(/[?#].*$/, "", s)
  if (s == "") return
  ck = dirof(p) "\034" s                     # 같은 폴더의 같은 import 는 한 번만 푼다
  if (ck in TSRES) t = TSRES[ck]
  else { t = ts_resolve(p, s); TSRES[ck] = t }
  if (t == "\001") unresolved(p, spec, "추적 파일에서 경로를 찾지 못했습니다. 생성 파일·별칭·확장자를 확인하세요.")
  else if (substr(t, 1, 1) == "\002") pedge(p, "npm", substr(t, 2), kind, spec, "")
  else fedge(p, t, kind, spec)
}
function ts_resolve(p, s,   t) {   # → 파일 경로 · "\001"(못 찾음) · "\002패키지"
  if (s ~ /^\.\.?(\/|$)/) {
    t = normp(joinp(dirof(p), s))
    t = (t == "\001") ? "" : ts_try(t)
    return (t == "") ? "\001" : t
  }
  t = ts_alias(p, s)
  if (t != "") return t
  if (s ~ /^\//) return "\001"
  return "\002" npm_name(s)
}
function ts_try(b,   i, s, pre) {   # 확장자 · index 파일 · .js 로 쓴 .ts
  if (b in EX) return b
  for (i = 1; i <= NTSX; i++) if ((b TSX[i]) in EX) return b TSX[i]
  pre = (b == "") ? "" : b "/"
  for (i = 1; i <= NTSX; i++) if ((pre "index" TSX[i]) in EX) return pre "index" TSX[i]
  if (match(b, /\.[cm]?jsx?$/)) { s = substr(b, 1, RSTART - 1); for (i = 1; i <= 4; i++) if ((s TSJ[i]) in EX) return s TSJ[i] }
  return ""
}
function npm_name(s,   a, n) {
  if (s ~ /^@/) { n = split(s, a, "/"); return n >= 2 ? a[1] "/" a[2] : s }
  sub(/\/.*$/, "", s)
  return s
}

# 새 언어는 먼저 파일을 빠짐없이 보여 주고, 정적인 경로 선언만 잇는다. 실행·평가로 의존을 알아내지는 않는다.
function scan_extra(p, lg,   line, inc, s, spec, kind, eco, relative) {
  inc = 0
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]; sub(/\r$/, "", line); s = trim(line)
    if (inc) { if (index(s, "*/")) inc = 0; continue }
    if (s ~ /^\/\*/) { if (!index(substr(s, 3), "*/")) inc = 1; continue }
    if (s ~ /^(\/\/|--)/) continue
    spec = ""; kind = "import"; eco = lg; relative = 0
    if (lg ~ /^(c|cpp|objc|objcpp)$/ && s ~ /^#[ \t]*(include|import)[ \t]*[<"]/) {
      sub(/^#[ \t]*(include|import)[ \t]*[<"]/, "", s); sub(/[>"].*$/, "", s); spec = s; kind = "include"; eco = "system"
    } else if (lg == "protobuf" && s ~ /^import[ \t]+((public|weak)[ \t]+)?"/) {
      sub(/^import[ \t]+((public|weak)[ \t]+)?/, "", s); spec = quoted(s); eco = "protobuf"; relative = 1
    } else if (lg == "ruby" && s ~ /^(require|require_relative|load)[ \t(]+["']/) {
      relative = s ~ /^require_relative/; spec = quoted(s); kind = "require"; eco = "gem"
    } else if (lg == "php" && s ~ /^(require|require_once|include|include_once)[ \t(]+["']/) {
      spec = quoted(s); kind = "include"; eco = "composer"; relative = 1
    } else if (lg == "lua" && s ~ /^(local[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*)?require[ \t(]+["']/) {
      spec = quoted(s); gsub(/\./, "/", spec); kind = "require"
    } else if (lg == "shell" && s ~ /^(source|\.)[ \t]+["']/) {
      spec = quoted(s); kind = "source"; relative = 1
    } else if (lg ~ /^(css|scss|less)$/ && s ~ /^@(import|use|forward)[ \t]+["']/) {
      spec = quoted(s); eco = "npm"
    } else if (lg == "dart" && s ~ /^(import|export|part)[ \t]+["']/) {
      spec = quoted(s); eco = "pub"; relative = spec !~ /^(package|dart):/
      if (spec ~ /^dart:/) { pedge(p, "dart", spec, kind, spec, ""); continue }
      if (spec ~ /^package:/) { sub(/^package:/, "", spec); sub(/\/.*$/, "", spec); pedge(p, eco, spec, kind, spec, ""); continue }
    } else if (lg == "solidity" && s ~ /^import[ \t]/) { spec = quoted(s); eco = "npm" }
    if (spec != "" && spec !~ /[$`]/) path_dep(p, spec, lg, eco, kind, relative)
  }
  close(p)
}
function quoted(s) { if (!match(s, /["'][^"']+["']/)) return ""; return substr(s, RSTART + 1, RLENGTH - 2) }
function path_try(b, lg,   n, a, i, t) {
  if (b in EX) return b
  n = split(LANGEXT[lg], a, " ")
  for (i = 1; i <= n; i++) {
    if ((b "." a[i]) in EX) return b "." a[i]
    t = joinp(dirof(b), "_" baseof(b) "." a[i]); if (lg == "scss" && (t in EX)) return t
    t = joinp(b, "init." a[i]); if (lg == "lua" && (t in EX)) return t
  }
  return ""
}
function path_dep(p, spec, lg, eco, kind, relative,   b, t) {
  b = normp(joinp(dirof(p), spec)); t = (b == "\001") ? "" : path_try(b, lg)
  if (t == "" && !relative && spec !~ /^\.\.?\//) t = path_try(spec, lg)
  if (t == "" && lg ~ /^(c|cpp|objc|objcpp)$/) t = path_try(joinp("include", spec), lg)
  if (t != "") fedge(p, t, kind, spec)
