}
function mkdirs(d,   par, b) {   # 위 폴더를 모두 DIRS 에 — Swift 의 Sources/<모듈> 폴더를 같이 찾는다
  while (!(d in DIRS)) {
    DIRS[d] = 1
    if (d == "") break
    par = dirof(d); b = baseof(d)
    if (baseof(par) == "Sources" && !(b in SRCMOD)) SRCMOD[b] = d
