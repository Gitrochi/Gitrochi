function tuist_srcs(f, d,   s, proj, e, j, args, n, IT, k, v, name, src, found) {
  s = swift_text(f); proj = ""; found = 0
  if (match(s, /Project[ \t]*(\.[A-Za-z_][A-Za-z0-9_]*)?[ \t]*\(/)) proj = strarg(substr(s, RSTART), "name")
  while (match(s, /(\.target|[^A-Za-z0-9_.]Target(\.target)?)[ \t]*\(/)) {
    j = RSTART + RLENGTH - 1; e = balanced(s, j)
    args = substr(s, j + 1, e - j - 1); s = substr(s, e + 1)
