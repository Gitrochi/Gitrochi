# ================= 셸 자동완성 =================
# 후보는 한 줄 하나, 스크립트가 인자로 넘긴 낱말만 읽는다. eval/네트워크/상태 변경은 하지 않는다.
completion_repositories() {
  local i=0 root d
  load_config >/dev/null 2>&1
  while [ $i -lt ${#F_RAW[@]} ]; do
    root=$(expand_path "${F_RAW[$i]}"); root=${root%/}
    for d in "$root"/* "$root"/*/*; do
      [ -e "$d/.git" ] || continue
      printf '%s\n%s/%s\n' "${d##*/}" "${F_ACC[$i]}" "${d##*/}"
    done
    i=$((i + 1))
  done
}
completion_commands() {
  printf '%s\n' preflight ck c p cp pl up l d b undo amend continue abort rescue o app pr ci flow test publish status use unlock ignore protect clone fork sync fix scan audit prune wt report g graph list add remove org config setup login auto sign ai ssh install uninstall migrate export import doctor version self-update completion schema help
}
completion_candidates() {   # _complete -- 이후: 실행 파일 이름을 뺀 낱말들(마지막은 입력 중인 낱말)
  local empty_current=""
  [ "${1:-}" != --empty-current ] || { empty_current=1; shift; }
  [ "${1:-}" = -- ] && shift
  local words=("$@") cur="" prev="" cmd="" n=0 stem="" candidate="" langs="" i e=""
  [ -z "$empty_current" ] || words+=("")
  n=${#words[@]}
  [ "$n" -gt 0 ] && { cmd=${words[0]}; cur=${words[$((n - 1))]}; }
  [ "$n" -gt 1 ] && prev=${words[$((n - 2))]}
  {
    if [ "$n" -le 1 ]; then completion_commands
    elif [ "$prev" = --lang ] || [[ "$cur" == --lang=* ]]; then
      langs=${cur#--lang=}; [ "$langs" != "$cur" ] && stem=--lang=
      case "$langs" in *,*) stem="$stem${langs%,*}," ;; esac
      graph_languages | cut -d'|' -f1 | while IFS= read -r candidate; do printf '%s%s\n' "$stem" "$candidate"; done
      printf '%sweb\n%sjvm\n' "$stem" "$stem"
    elif [ "$prev" = --format ]; then printf '%s\n' html json dot svg png
    elif [ "$prev" = --view ]; then printf '%s\n' graph files modules changes tree affected precise diff
    elif [ "$prev" = --language ]; then printf '%s\n' ts js python java kotlin scala
    elif [ "$prev" = --interval ]; then printf '%s\n' 1 2 5 10 30 60
    elif [ "$prev" = --commit ]; then git log -10 --format='%H' 2>/dev/null
    elif [ "$prev" = --base ] || [ "$cmd" = b ] || [ "$cmd" = branch ] || { [ "$cmd" = wt ] && [ "${words[1]:-}" = new ]; } || { { [ "$cmd" = g ] || [ "$cmd" = graph ]; } && [ "${words[1]:-}" = diff ] && [ "$n" -eq 3 ]; }; then
      git for-each-ref --format='%(refname:short)' refs/heads refs/remotes 2>/dev/null
      [ "${words[1]:-}" = diff ] && printf '%s\n' HEAD files modules tree
    elif [ "$prev" = --out ] || [ "$prev" = --path ] || [ "$prev" = --repo ] || [ "$prev" = --rules ] || [ "$prev" = --index ] || [ "$prev" = --file ] || [ "$prev" = --folder ]; then
      compgen -f -- "$cur"
    elif [ "$prev" = --via ]; then load_config >/dev/null 2>&1; for i in "${ACC_IDS[@]}"; do printf '%s\n' "$i"; done
    elif [[ "$cur" == -* ]]; then
      case "$cmd" in
        g|graph)
          printf '%s\n' --help --json --format --out --open --no-open --lang --no-external --since --max-commits --max-files --min --depth --files --base --rules --init --precise --index --no-cache
          [ "${words[1]:-}" != watch ] || printf '%s\n' --detach --interval
          [ "${words[1]:-}" != index ] || printf '%s\n' --language --project-name ;;
        ck|check) printf '%s\n' --json --fetch --no-fetch ;;
        status|st) printf '%s\n' --json --strict --ssh ;;
        preflight|pf) printf '%s\n' --json --no-fetch ;;
        c|commit|cp) printf '%s\n' -a -m -F --trailer ;;
        pr|mr) printf '%s\n' --title --body --base --draft --web --json ;;
        app) printf '%s\n' --help --path --repo --file --line --commit --view ;;
        doctor) printf '%s\n' --json --no-net ;;
        list|ls) printf '%s\n' --json --check ;;
        scan) printf '%s\n' --json --fix ;;
        audit) printf '%s\n' --json --since ;;
        report) printf '%s\n' --json --today --days --since ;;
        version) printf '%s\n' --json ;;
        add) printf '%s\n' --id --email --host --port --folder --no-folder --via --no-setup --json --yes ;;
        setup) printf '%s\n' --inspect --generate --check --json --yes ;;
        login) printf '%s\n' --start --status --cancel --json --yes ;;
        flow|test) printf '%s\n' --json --affected --env --only --jobs --fail-fast --no-fail-fast --no-cache --keep-services --detach --events --summary --ci --yes --dry-run --follow --since --format --out --idempotency-key --watch --lang ;;
      esac
    else
      case "$cmd" in
        use|remove|rm|setup|clone|fork) load_config >/dev/null 2>&1; for i in "${ACC_IDS[@]}"; do printf '%s\n' "$i"; done ;;
        g|graph)
          [ "$n" -eq 2 ] && printf '%s\n' files modules changes tree precise affected watch index diff review check languages
          { [ "${words[1]:-}" = watch ] && [ "$n" -eq 3 ]; } && printf '%s\n' files modules changes tree precise affected
          completion_repositories
          compgen -d -- "$cur" ;;
        completion) printf '%s\n' bash zsh fish powershell ;;
        flow)
          if [ "$n" -eq 2 ]; then printf '%s\n' init doctor validate list plan run status events logs report rerun cancel trust hold watch blocks block explain gc export import connect gate schema version help
          elif [ "$n" -eq 3 ]; then
            case "${words[1]:-}" in
              plan|run|watch) e=$(flow_engine) && "$e" _names flows 2>/dev/null ;;
              export|import) printf '%s\n' github gitlab jenkins ;;
              connect) printf '%s\n' list add test remove ;;
              hold) printf '%s\n' list release ;;
              gate) printf '%s\n' status prepush ;;
              status|events|logs|report|rerun|cancel) printf '%s\n' last ;;
            esac
          fi ;;
        test) e=$(flow_engine) && "$e" _names suites 2>/dev/null ;;
        schema) printf '%s\n' public graph error languages status ck preflight rules version list doctor scan audit report pr view watch index account login review ;;
        login) [ "$n" -ne 2 ] || printf '%s\n' github ;;
        config) printf '%s\n' show path get set add unset edit ;;
        wt|worktree) printf '%s\n' ls new rm ;;
        pr|mr) printf '%s\n' status ;;
        sign) printf '%s\n' on off ;;
        org) printf '%s\n' add rm ;;
        ssh) printf '%s\n' prune ;;
      esac
    fi
  } | LC_ALL=C sort -u | while IFS= read -r candidate; do
    [[ "$candidate" == "$cur"* ]] && [ -n "$candidate" ] && printf '%s\n' "$candidate"
  done
  return 0
}

completion_cmd() {
  case "${1:-}" in
    bash) cat <<'COMPLETION'
# gitch completion bash — source <(gitch completion bash)
_gitch_completion() {
  local candidate
  COMPREPLY=()
  while IFS= read -r candidate; do COMPREPLY+=("$candidate"); done < <(command gitch _complete -- "${COMP_WORDS[@]:1:COMP_CWORD}" 2>/dev/null)
}
complete -o bashdefault -o default -o filenames -F _gitch_completion gitch gitsw
COMPLETION
      ;;
    zsh) cat <<'COMPLETION'
#compdef gitch gitsw
# compinit 후 source <(gitch completion zsh)
_gitch_completion() {
  local -a candidates
  candidates=("${(@f)$(command gitch _complete -- "${words[@]:1:$((CURRENT - 1))}" 2>/dev/null)}")
  if (( ${#candidates} )) && [[ -n ${candidates[1]} ]]; then compadd -a candidates; else _files; fi
}
compdef _gitch_completion gitch gitsw
COMPLETION
      ;;
    fish) cat <<'COMPLETION'
# gitch completion fish | source
function __gitch_complete
  set -l words (commandline -opc)
  set -e words[1]
  set -l current (commandline -ct)
  command gitch _complete -- $words "$current" 2>/dev/null | string escape
end
complete -c gitch -f -a '(__gitch_complete)'
complete -c gitsw -f -a '(__gitch_complete)'
COMPLETION
      ;;
    powershell|pwsh) cat <<'COMPLETION'
# gitch completion powershell | Out-String | Invoke-Expression
Register-ArgumentCompleter -Native -CommandName gitch,gitsw -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $arguments = @()
  foreach ($element in @($commandAst.CommandElements | Select-Object -Skip 1)) {
    if ($element.Extent.EndOffset -ge $cursorPosition) { break }
    if ($element -is [System.Management.Automation.Language.StringConstantExpressionAst]) { $arguments += $element.Value }
    else { $arguments += $element.Extent.Text }
  }
  $currentWord = $wordToComplete.Trim([char]39, [char]34)
  $nativeArguments = @('_complete')
  # gitch.cmd uses legacy native argument passing, which discards empty arguments.
  if ($currentWord.Length -eq 0) { $nativeArguments += '--empty-current' }
  else { $arguments += $currentWord }
  $nativeArguments += '--'
  $nativeArguments += $arguments
  & gitch @nativeArguments 2>$null | ForEach-Object {
    $candidate = [string]$_
    $quoted = $candidate
    if ($candidate -match '[^a-zA-Z0-9_./:-]') { $quoted = "'" + $candidate.Replace("'", "''") + "'" }
    [System.Management.Automation.CompletionResult]::new($quoted, $candidate, 'ParameterValue', $candidate)
  }
}
COMPLETION
      ;;
    --help|-h|"") say '사용법: gitch completion bash|zsh|fish|powershell — 스크립트를 표준출력에 생성 (설정 파일은 직접 바꾸지 않음)' ;;
    *) die '지원하는 셸: bash · zsh · fish · powershell' ;;
  esac
}

