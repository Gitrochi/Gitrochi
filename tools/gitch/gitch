  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return
  local a; a=$(git config --get gitswitch.account)
  if [ -n "$a" ]; then printf '\033[32m[%s]\033[0m' "$a"; else printf '\033[33m[계정?]\033[0m'; fi
}
case "$PS1" in
  *_gitsw_prompt*) ;;
  *'\n$ ') PS1="${PS1%'\n$ '} \$(_gitsw_prompt)"'\n$ ' ;;
  *) PS1="\$(_gitsw_prompt) $PS1" ;;
esac
# <<< gitsw <<<
EOF

install_hint() {   # $1 brew 이름 $2 winget 아이디 → 설치 명령 안내
  if [ -n "$IS_WINDOWS" ]; then printf 'winget install %s' "$2"; else printf 'brew install %s' "$1"; fi
}

# ----- Windows: PowerShell · cmd · Codex 에서도 gitch 를 부르게 -----
PS_BIN="${GITSW_POWERSHELL:-powershell.exe}"
WIN_PATH_MARK="$STATE_DIR/windows-path"   # 사용자 PATH 에 ~/bin 을 gitch 가 넣었다는 표시 (uninstall 이 그때만 뺀다)

win_bash() {   # Git Bash 를 여는 bash.exe (Git for Windows 의 bin\bash.exe 는 PATH 를 갖춰 준다), Windows 경로
  local root
  root=$(cygpath -w / 2>/dev/null) || return 1
  root=${root%\\}
  if [ -f "$root\\bin\\bash.exe" ]; then printf '%s' "$root\\bin\\bash.exe"
  else cygpath -w /usr/bin/bash.exe 2>/dev/null; fi
}

write_cmd_shim() {   # $1 ~/bin/gitch 같은 셸 명령 → 옆에 .cmd (PowerShell · cmd 는 PATHEXT 로 이것을 부른다)
  local bash t
  bash=$(win_bash) || return 1
  t=$(mktemp "$1.cmd.XXXXXX") || return 1
  if printf '@echo off\r\nrem gitch-link (gitch install 이 관리합니다)\r\n"%s" "%s" %%*\r\n' "$bash" "$(cygpath -m "$1")" > "$t" && mv -f "$t" "$1.cmd"; then return 0; fi
  rm -f "$t"; return 1
}

win_user_path() {   # add|remove|has — 사용자 PATH(레지스트리, %VAR% 는 펼치지 않고 그대로)에 %USERPROFILE%\bin → added|same|removed|yes|no
  local dir enc
  dir=$(cygpath -w "$HOME/bin" 2>/dev/null) || return 1
  # 따옴표가 명령줄을 거치며 바뀌지 않게 -EncodedCommand(UTF-16LE base64)로 넘긴다
  enc=$(printf '%s' "$WIN_PATH_PS" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n') || return 1
  GITSW_PATH_DIR="$dir" GITSW_PATH_OP="$1" "$PS_BIN" -NoProfile -NonInteractive -EncodedCommand "$enc" 2>/dev/null | tr -d '\r'
}
# shellcheck disable=SC2016  # PowerShell 스크립트 — $ 는 PowerShell 이 읽는다
WIN_PATH_PS='
    $d = $env:GITSW_PATH_DIR.TrimEnd("\"); $op = $env:GITSW_PATH_OP
    $k = [Microsoft.Win32.Registry]::CurrentUser.CreateSubKey("Environment")
    $p = [string]$k.GetValue("Path", "", "DoNotExpandEnvironmentNames")
    $parts = @($p -split ";" | Where-Object { $_ -ne "" })
    $same = { [Environment]::ExpandEnvironmentVariables($args[0]).TrimEnd("\") -ieq $d }
    $has = @($parts | Where-Object { & $same $_ }).Count -gt 0
    if ($op -eq "has") { if ($has) { "yes" } else { "no" }; exit 0 }
    if ($op -eq "add") { if ($has) { "same"; exit 0 }; $parts = @($d) + $parts }
    elseif ($has) { $parts = @($parts | Where-Object { -not (& $same $_) }) } else { exit 0 }
    $k.SetValue("Path", ($parts -join ";"), "ExpandString")
    # 열려 있는 탐색기 · 새 터미널이 바뀐 PATH 를 받게 알린다 (임시 변수를 지우면 WM_SETTINGCHANGE 를 보낸다)
    [Environment]::SetEnvironmentVariable("GITSW_PATH_REFRESH", $null, "User")
    if ($op -eq "add") { "added" } else { "removed" }
'

install_windows_shims() {   # gitch install 1단계(Windows): .cmd + 사용자 PATH
  local n r
  for n in "$BIN_LINK" "$SHIM_LINK"; do
    if [ -e "$n.cmd" ] && ! grep -q 'gitch-link' "$n.cmd" 2>/dev/null; then
      say "  ${YELLOW}⚠ $(tilde "$n").cmd 가 gitch 가 만든 파일이 아니라 그대로 뒀습니다${RESET}"; continue
    fi
    is_link "$n" && write_cmd_shim "$n"
  done
  r=$(win_user_path add)
  case "$r" in
    added) mkdir -p "$STATE_DIR" && : > "$WIN_PATH_MARK"
           say "  ${GREEN}✔${RESET} 사용자 PATH 에 $(cygpath -w "$HOME/bin") 추가 — PowerShell · cmd 는 새 창에서 gitch" ;;
    same) say "  ${GREEN}✔${RESET} PowerShell · cmd 에서도 gitch (~/bin/gitch.cmd, 사용자 PATH 에 ~/bin 이 있음)" ;;
    *) say "  ${YELLOW}⚠ 사용자 PATH 에 $(cygpath -w "$HOME/bin" 2>/dev/null) 를 넣지 못했습니다 — PowerShell · cmd 에서 쓰려면 직접 추가하세요${RESET}" ;;
  esac
}

remove_windows_shims() {   # gitch uninstall(Windows): gitch 가 넣은 사용자 PATH 만 뺀다 (~/bin/gitch.cmd 는 ~/bin/gitch 처럼 남긴다)
  [ -f "$WIN_PATH_MARK" ] || return 0
  win_user_path remove >/dev/null
  rm -f "$WIN_PATH_MARK"
}

windows_install_ok() {   # $1 연결할 gitch — 설치 프로그램으로 깐 Gitrochi(옆에 uninstall.exe) 밖의 앱 폴더면 이유와 할 일을 알리고 거짓
  local p="$1" dir why=""
  dir=$(dirname "$p")
  if [ -f "$dir/Gitrochi.exe" ]; then
    [ -f "$dir/uninstall.exe" ] || why="설치하지 않은(포터블 · 빌드) Gitrochi"
  else
    case "$(lower "$p")" in */appdata/local/temp/*|*/windows/temp/*|/tmp/*) why="임시 폴더" ;; esac
  fi
  [ -z "$why" ] && return 0
  err "gitch 를 연결하지 않았습니다: ${why}에서 실행 중이라, 폴더를 옮기거나 지우면 ~/bin/gitch 와 검사 훅이 끊깁니다."
  err "  지금: $(tilde "$p")"
  if [ -f "$dir/Gitrochi.exe" ]; then
    err "  설치 파일(Gitrochi_<버전>_x64-setup.exe)로 설치한 Gitrochi 를 연 뒤 설정 > CLI 에서 설치하거나, 터미널(Git Bash)에서:"
    err "    ~/AppData/Local/Gitrochi/gitch install"
  else
    err "  gitch 파일을 오래 둘 곳(예: ~/.local/share/gitch/)에 복사한 뒤 그 복사본으로 install 하세요."
  fi
  return 1
}

on_disk_image() {   # $1 이 붙여 둔 디스크 이미지(.dmg) 안이면 참 — 맥만 (hdiutil info 의 마운트 위치와 비교)
  local mp
  command -v hdiutil >/dev/null 2>&1 || return 1
  while IFS= read -r mp; do
    case "$1" in "$mp"/*) return 0 ;; esac
  done < <(hdiutil info 2>/dev/null | awk -F'\t' '/^\/dev\/disk/ && $3 != "" { print $3 }')
  return 1
}

install_location_ok() {   # $1 연결할 gitch — 디스크를 꺼내거나 앱을 옮기면 끊길 곳이면 이유와 할 일을 알리고 거짓
  local p="$1" app="" why=""
  if [ -n "$IS_WINDOWS" ]; then windows_install_ok "$p"; return; fi
  case "$p" in *.app/Contents/*) app="${p%%.app/Contents/*}.app" ;; esac
  case "$p" in
    */AppTranslocation/*) why="임시 위치(App Translocation)" ;;
    *)
      if on_disk_image "$p"; then why="디스크 이미지"
      elif [ -n "$app" ]; then
        case "$(lower "$app")" in /applications/*|"$(lower "$HOME")"/applications/*) ;; *) why="응용 프로그램 폴더 밖의 앱" ;; esac
      fi ;;
  esac
  [ -z "$why" ] && return 0
  err "gitch 를 연결하지 않았습니다: ${why}에서 실행 중이라, 디스크를 꺼내거나 앱을 옮기면 ~/bin/gitch 와 검사 훅이 끊깁니다."
  err "  지금: $(tilde "$p")"
  if [ -n "$app" ]; then
    err "  앱을 응용 프로그램 폴더로 옮겨 연 뒤 설정 > CLI 에서 설치하거나, 터미널에서:"
    err "    /Applications/${app##*/}/Contents/Resources/gitch install"
  else
    err "  gitch 파일을 디스크 이미지 밖(예: ~/.local/share/gitch/)에 복사한 뒤 그 복사본으로 install 하세요."
  fi
  return 1
}

install_cmd() {
  local self n=0 d fancy="" noacc="" total=5
  self=$(self_path)
  install_location_ok "$self" || exit 1
  git_version_ok || die "git 2.36 이상이 필요합니다. 지금: git ${GIT_VER:-?} ($(install_hint git Git.Git))"
  # 계정이 아직 없으면 명령 · 터미널만 — gitch g 처럼 계정이 필요 없는 명령은 바로 쓰고, 자동 규칙 · 검사 훅은 계정을 만든 뒤에
  # (계정 없이 useConfigOnly · 훅을 깔면 모든 저장소의 커밋이 막힌다)
  if load_config; then need_config; else noacc=1; total=2; fi
  fancy_out && { fancy=1; banner; }
  chmod +x "$self"
  step 1 "명령" "$total"
  mkdir -p "$HOME/bin"
  [ "$(resolve_link "$BIN_LINK" 2>/dev/null)" != "$self" ] && make_link "$self" "$BIN_LINK"
  # 예전 이름 ~/bin/gitsw 도 같은 파일로(링크가 아닌 파일이면 사용자 것이라 그대로 둔다)
  if is_link "$SHIM_LINK" || [ ! -e "$SHIM_LINK" ]; then
    [ "$(resolve_link "$SHIM_LINK" 2>/dev/null)" != "$self" ] && make_link "$self" "$SHIM_LINK"
  else
    say "  ${YELLOW}⚠ ~/bin/gitsw 가 링크가 아닌 파일이라 그대로 뒀습니다 (gitsw 로 부르면 그 파일이 돕니다)${RESET}"
  fi
  is_link "$HOME/bin/gitswitch" && rm -f "$HOME/bin/gitswitch"
  say "  ${GREEN}✔${RESET} gitch 명령 연결: ~/bin/gitch → $(tilde "$self") (예전 이름 ~/bin/gitsw 도)"
  [ -n "$IS_WINDOWS" ] && install_windows_shims
  step 2 "터미널" "$total"
  backup_file "$SHELL_RC"
  if [ -n "$IS_WINDOWS" ]; then
