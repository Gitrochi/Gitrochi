# 순환 찾기(diff · check 공용): arc(그래프, 시작, 끝) 로 쌓고 scc(그래프) — 반복형 Tarjan, 큰 그래프에서도 재귀 깊이 없이
graph_awk_scc() {
  cat <<'AWKEOF'
function arc(g, s, t) {
  if (!((g, s) in SEEN)) { SEEN[g, s] = 1; NLS[g, ++NNL[g]] = s }
  if (!((g, t) in SEEN)) { SEEN[g, t] = 1; NLS[g, ++NNL[g]] = t }
  ARC[g, s, ++ARCN[g, s]] = t
}
function scc(g,   i, r, sp, n, t, cnt, ns, x, c) {
  cnt = 0; ns = 0; NC[g] = 0
  for (i = 1; i <= NNL[g]; i++) {
    r = NLS[g, i]
    if ((g, r) in IDX) continue
    sp = 1; SN[1] = r; SJ[1] = 0
    IDX[g, r] = LOW[g, r] = ++cnt; STK[++ns] = r; ONS[g, r] = 1
    while (sp > 0) {
      n = SN[sp]
      if (SJ[sp] < ARCN[g, n]) {
        t = ARC[g, n, ++SJ[sp]]
        if (!((g, t) in IDX)) { IDX[g, t] = LOW[g, t] = ++cnt; STK[++ns] = t; ONS[g, t] = 1; SN[++sp] = t; SJ[sp] = 0 }
        else if (ONS[g, t] && IDX[g, t] < LOW[g, n]) LOW[g, n] = IDX[g, t]
      } else {
        if (LOW[g, n] == IDX[g, n]) {
          c = ++NC[g]; CS[g, c] = 0
          do { x = STK[ns--]; ONS[g, x] = 0; COMP[g, x] = c; CM[g, c, ++CS[g, c]] = x } while (x != n)
        }
        if (--sp > 0 && LOW[g, n] < LOW[g, SN[sp]]) LOW[g, SN[sp]] = LOW[g, n]
      }
    }
  }
}
function ckey(g, c,   i, n, M, j, t, out) {   # 순환의 노드를 정렬해 \034 로 이은 키
  n = CS[g, c]
  for (i = 1; i <= n; i++) M[i] = CM[g, c, i]
  for (i = 2; i <= n; i++) { t = M[i]; for (j = i - 1; j >= 1 && M[j] > t; j--) M[j + 1] = M[j]; M[j + 1] = t }
  out = M[1]; for (i = 2; i <= n; i++) out = out "\034" M[i]
  return out
}
function cyctrust(g, c, gt,   i, x, cc) {   # 확실한 연결(정확 + 모듈로 확인한 추정)만으로도 한 순환인가
  cc = ""
  for (i = 1; i <= CS[g, c]; i++) {
    x = CM[g, c, i]
    if (!((gt, x) in COMP)) return 0
    if (cc == "") cc = COMP[gt, x]; else if (COMP[gt, x] != cc) return 0
  }
  return CS[gt, cc] > 1
}
function trusted(h, attrs) { return h != "h" || index(attrs, "\"checked\":true") > 0 }
AWKEOF
}

# diff: 기준(첫 파일) · 지금(둘째 파일)의 레코드 → 합친 레코드. 바뀐 노드 · 연결에 "status", 순환 비교는 3 레코드(새 · 없어짐)
graph_awk_merge() {
  cat <<'AWKEOF'
BEGIN { FS = "\t" }
FNR == 1 { side++ }
$1 == "0" { if (side == 2) print; next }
$1 == "1" { if (side == 1) BN[$2] = $0; else AN[$2] = $0; next }
$1 == "2" {
  k = $2 "\034" $3 "\034" $4
  if (side == 1) BE[k] = $0; else AE[k] = $0
  arc(side, $2, $3); if (trusted($6, $7)) arc(side + 2, $2, $3)
  next
}
END {
  for (k in AN) {
    if (!(k in BN)) { print stat(AN[k], 6, "added"); NADD++; continue }
    if (rel == "tree") {   # 폴더는 그대로여도 파일 수 · 크기가 바뀐다
      df = num(AN[k], "files") - num(BN[k], "files"); db = num(AN[k], "bytes") - num(BN[k], "bytes")
      if (df || db) { print stat(AN[k], 6, "changed", "\"filesDelta\":" df ",\"bytesDelta\":" db); NCHG++; continue }
    }
    print AN[k]
  }
  for (k in BN) if (!(k in AN)) { print stat(BN[k], 6, "removed"); NRM++ }
  for (k in AE) if (k in BE) print AE[k]; else { print stat(AE[k], 7, "added"); EA++; if (fld(AE[k], 6) == "h") EAH++ }
  for (k in BE) if (!(k in AE)) { print stat(BE[k], 7, "removed"); ER++; if (fld(BE[k], 6) == "h") ERH++ }
  scc(1); scc(2); scc(3); scc(4)
  for (c = 1; c <= NC[2]; c++) if (CS[2, c] > 1) AK[ckey(2, c)] = c
  for (c = 1; c <= NC[1]; c++) if (CS[1, c] > 1) BK[ckey(1, c)] = c
  for (key in AK) {   # 같은 노드면 그대로, 둘 넘게 겹치는 기준 순환이 있으면 커지거나 줄어든 순환, 아니면 새 순환
    if (key in BK) { print "3\texisting\t" (cyctrust(2, AK[key], 4) ? "" : "h") "\t" key; continue }
    best = ""; bo = 0
    for (k2 in BK) if (!(k2 in AK) && !(k2 in USED) && (o = common(key, k2)) > bo) { bo = o; best = k2 }
    if (bo >= 2) { USED[best] = 1; print "3\tchanged\t" (cyctrust(2, AK[key], 4) ? "" : "h") "\t" key "\t" best; CC++ }
    else { print "3\tnew\t" (cyctrust(2, AK[key], 4) ? "" : "h") "\t" key; CN++ }
  }
  for (key in BK) if (!(key in AK) && !(key in USED)) { print "3\tgone\t" (cyctrust(1, BK[key], 3) ? "" : "h") "\t" key; CG++ }
  if (rel == "tree") printf "0\tchangedNodes\t%d\n", NCHG
  printf "0\taddedNodes\t%d\n0\tremovedNodes\t%d\n0\taddedEdges\t%d\n0\tremovedEdges\t%d\n0\taddedGuesses\t%d\n0\tremovedGuesses\t%d\n0\tnewCycles\t%d\n0\tgoneCycles\t%d\n0\tchangedCycles\t%d\n", NADD, NRM, EA, ER, EAH, ERH, CN, CG, CC
}
function fld(rec, f,   F) { split(rec, F, "\t"); return F[f] }
function common(a, b,   n, A, i, c) { n = split(a, A, "\034"); c = 0; for (i = 1; i <= n; i++) if (index("\034" b "\034", "\034" A[i] "\034")) c++; return c }
function num(rec, key,   F, a) { split(rec, F, "\t"); if (!match(F[6], "\"" key "\":-?[0-9]+")) return 0; a = substr(F[6], RSTART, RLENGTH); sub(/^[^:]*:/, "", a); return a + 0 }
function stat(rec, f, s, extra,   F, n, i, out) {   # 레코드의 f 번째 칸(속성)에 "status"(와 extra)를 더한다
  n = split(rec, F, "\t")
  for (i = n + 1; i <= f; i++) F[i] = ""
  if (n < f) n = f
  F[f] = (F[f] == "" ? "" : F[f] ",") "\"status\":\"" s "\"" (extra != "" ? "," extra : "")
  out = F[1]; for (i = 2; i <= n; i++) out = out "\t" F[i]
  return out
}
AWKEOF
}

# diff --format json: 바뀐 것만 — status 가 있는 노드 · 연결, 바뀐 연결의 끝점 노드, 통계 · 안내 · 순환
graph_awk_diffonly() {
  cat <<'AWKEOF'
$1 == "0" || $1 == "3" { print; next }
$1 == "1" { N[$2] = $0; if (index($6, "\"status\":")) KEEP[$2] = 1; next }
$1 == "2" { if (index($7, "\"status\":")) { print; KEEP[$2] = 1; KEEP[$3] = 1 }; next }
END { for (k in KEEP) if (k in N) print N[k] }
AWKEOF
}

# diff 요약(사람용): 합친 레코드 → 몇 줄
graph_awk_difftext() {
  cat <<'AWKEOF'
$1 == "0" { S[$2] = $3; next }
$1 == "1" { L[$2] = $4; if (rel == "tree" && index($6, "\"status\":\"changed\"")) CHG[++NCH] = $2 "\t" jnum($6, "filesDelta") "\t" jnum($6, "bytesDelta"); next }
$1 == "2" { if (index($7, "\"status\":\"added\"")) ADD[++NAE] = $0; else if (index($7, "\"status\":\"removed\"")) REM[++NRM] = $0; next }
$1 == "3" { if ($2 == "new") CNEW[++NCN] = $0; else if ($2 == "changed") CCHG[++NCC] = $0; else if ($2 == "gone") CGONE[++NCG] = $0; next }
function nm(id) { return (rel == "modules" && (id in L)) ? L[id] : id }
function jnum(a, key,   v) { if (!match(a, "\"" key "\":-?[0-9]+")) return 0; v = substr(a, RSTART, RLENGTH); sub(/^[^:]*:/, "", v); return v + 0 }
function sz(b,   m) { m = b < 0 ? -b : b; return (b < 0 ? "−" : "+") (m >= 1048576 ? sprintf("%.1f MB", m / 1048576) : m >= 1024 ? sprintf("%d KB", m / 1024) : m " B") }
function kname(k) { return k == "import" ? "import" : k == "type-ref" ? "타입 이름" : k == "ref" ? "참조" : k == "depends" ? "의존" : k == "contains" ? "포함" : k == "reexport" ? "다시 내보내기" : k == "dynamic-import" ? "동적 import" : k }
function edge(rec, mark, col,   F) { split(rec, F, "\t"); printf "    %s%s %s → %s%s %s(%s%s)%s\n", col, mark, nm(F[2]), nm(F[3]), reset, dim, kname(F[4]), (F[6] != "h" ? "" : index(F[7], "\"checked\":true") ? " · 모듈 확인" : " · 추정"), reset }
function cycd(rec,   F, n, a, m, b, i, j, add, del) {   # 커지거나 줄어든 순환: 개수 변화와 더해진 · 빠진 노드
  split(rec, F, "\t"); n = split(F[4], a, "\034"); m = split(F[5], b, "\034"); add = ""; del = ""
  for (i = 1; i <= n; i++) if (!index("\034" F[5] "\034", "\034" a[i] "\034")) add = add (add != "" ? " · " : "") nm(a[i])
  for (j = 1; j <= m; j++) if (!index("\034" F[4] "\034", "\034" b[j] "\034")) del = del (del != "" ? " · " : "") nm(b[j])
  printf "    %s~ %d → %d개%s %s(%s%s%s%s)%s\n", yellow, m, n, reset, dim, (add != "" ? "+ " add : ""), (add != "" && del != "" ? ", " : ""), (del != "" ? "− " del : ""), (F[3] == "h" ? ", 추정 연결 포함" : ""), reset
}
function cyc(rec, mark, col,   F, n, a, i, s) {
  split(rec, F, "\t"); n = split(F[4], a, "\034"); s = ""
  for (i = 1; i <= n && i <= 8; i++) s = s (i > 1 ? " · " : "") nm(a[i])
  if (n > 8) s = s " 외 " (n - 8) "개"
  printf "    %s%s %s%s %s(%d개%s)%s\n", col, mark, s, reset, dim, n, (F[3] == "h" ? ", 추정 연결 포함" : ""), reset
}
END {
  printf "%s의존 비교 (%s)%s: %s(%s) → %s\n", bold, relword, reset, base, bsha, (diffscope == "staged" ? "스테이지" : diffscope == "committed" ? "커밋된 브랜치" : "지금 작업 트리")
  printf "  연결 %s+%d%s %s−%d%s", green, S["addedEdges"], reset, red, S["removedEdges"], reset
  if (S["addedGuesses"] + S["removedGuesses"]) printf " %s(그중 추정 +%d −%d)%s", dim, S["addedGuesses"], S["removedGuesses"], reset
  printf " · %s +%d −%d\n", (rel == "modules" ? "모듈" : rel == "tree" ? "폴더 · 파일" : "노드"), S["addedNodes"], S["removedNodes"]
  if (NCH) {
    printf "  폴더 크기 변화 %d곳\n", NCH
    for (i = 1; i <= NCH && i <= 40; i++) { split(CHG[i], C, "\t"); printf "    ~ %s %s파일 %s%d · 크기 %s%s\n", C[1], dim, (C[2] >= 0 ? "+" : ""), C[2], sz(C[3]), reset }
  }
  if (NCN) { printf "  %s새 순환 %d개%s\n", red, NCN, reset; for (i = 1; i <= NCN; i++) cyc(CNEW[i], "↻", red) }
  if (NCC) { printf "  %s커지거나 줄어든 순환 %d개%s\n", yellow, NCC, reset; for (i = 1; i <= NCC; i++) cycd(CCHG[i]) }
  if (NCG) { printf "  %s없어진 순환 %d개%s\n", green, NCG, reset; for (i = 1; i <= NCG; i++) cyc(CGONE[i], "✓", green) }
  if (NAE) { printf "  더한 연결\n"; for (i = 1; i <= NAE && i <= 40; i++) edge(ADD[i], "+", green); if (NAE > 40) printf "    %s… %d개 더%s\n", dim, NAE - 40, reset }
  if (NRM) { printf "  뺀 연결\n"; for (i = 1; i <= NRM && i <= 40; i++) edge(REM[i], "−", red); if (NRM > 40) printf "    %s… %d개 더%s\n", dim, NRM - 40, reset }
  if (!NAE && !NRM && !NCN && !NCG && !NCC && !NCH && !S["addedNodes"] && !S["removedNodes"]) printf "  %s바뀐 의존이 없습니다%s\n", dim, reset
  else printf "  %s자세히: --format html (그래프) · --format json (AI · 스크립트)%s\n", dim, reset
}
AWKEOF
}

# check: 규칙 파일(rules)의 [rel] 절을 레코드에 맞춘다. 줄: R<TAB>규칙 수 · V<TAB>세기<TAB>줄<TAB>규칙 글<TAB>종류<TAB>시작(순환이면 노드들)<TAB>끝 · X<TAB>줄<TAB>틀린 까닭
graph_awk_check() {
  cat <<'AWKEOF'
BEGIN {
  FS = "\t"; sec = "files"
  while ((getline line < rules) > 0) {
    ln++
    sub(/\r$/, "", line); sub(/(^|[ \t])#.*$/, "", line); line = trim(line)
    if (line == "") continue
    if (line ~ /^\[[^]]*\]$/) {
      sec = trim(substr(line, 2, length(line) - 2))
      if (sec != "files" && sec != "modules") print "X\t" ln "\t모르는 절 [" sec "] — [files] 나 [modules] 를 씁니다"
      continue
    }
    kind = line; sub(/[ \t].*$/, "", kind); rest = trim(substr(line, length(kind) + 1))
    if (kind == "forbid" || kind == "allow") {
      if (!index(rest, "->")) { print "X\t" ln "\t" kind " 에는 「A -> B」가 필요합니다"; continue }
      a = trim(substr(rest, 1, index(rest, "->") - 1)); b = trim(substr(rest, index(rest, "->") + 2))
      if (a == "" || b == "") { print "X\t" ln "\t" kind " 의 양쪽 패턴이 비었습니다"; continue }
    } else if (kind == "layers") {
      n = split(rest, LP, ">")
      if (n < 2) { print "X\t" ln "\tlayers 에는 「A > B」처럼 두 층 이상이 필요합니다"; continue }
      for (i = 1; i <= n; i++) if (trim(LP[i]) == "") { print "X\t" ln "\tlayers 에 빈 층이 있습니다"; n = 0; break }
      if (!n) continue
    } else if (kind != "no-cycles") { print "X\t" ln "\t모르는 규칙 「" kind "」 — forbid · allow · layers · no-cycles"; continue }
    nall++
    if (sec != rel) continue
    nr++; RK[nr] = kind; RL[nr] = ln; RTX[nr] = line
    if (kind == "forbid" || kind == "allow") { RA[nr] = a; RB[nr] = b }
    else if (kind == "layers") { RN[nr] = n; for (i = 1; i <= n; i++) RLY[nr, i] = trim(LP[i]) }
    else RA[nr] = rest
  }
  close(rules)
  print "R\t" nall
}
$1 == "1" { NLB[$2] = $4; next }
$1 == "2" { if ($4 == "contains") next; ne++; ES[ne] = $2; ET[ne] = $3; ETR[ne] = trusted($6, $7); next }
END {
  for (e = 1; e <= ne; e++) {
    s = ES[e]; t = ET[e]; ok = 0
    for (r = 1; r <= nr; r++) if (RK[r] == "allow" && pm(RA[r], s) != "" && pm(RB[r], t) != "") { ok = 1; break }
    if (ok) continue
    for (r = 1; r <= nr; r++) {
      if (RK[r] == "forbid") {
        if ((ia = pm(RA[r], s)) == "" || (ib = pm(RB[r], t)) == "") continue
        if (RA[r] == RB[r] && ia == ib) continue        # 같은 패턴이면 같은 곳(같은 모듈 · 같은 폴더)끼리는 괜찮다
        viol(r, e)
      } else if (RK[r] == "layers") {
        li = layer(r, s); lj = layer(r, t)
        if (li && lj && li > lj) viol(r, e)
      }
    }
  }
  for (r = 1; r <= nr; r++) if (RK[r] == "no-cycles") cycles(r)
}
function viol(r, e) { print "V\t" (ETR[e] ? "error" : "warning") "\t" RL[r] "\t" RTX[r] "\t" RK[r] "\t" ES[e] "\t" ET[e] }
function layer(r, x,   i) { for (i = 1; i <= RN[r]; i++) if (pm(RLY[r, i], x) != "") return i; return 0 }
function pm(pat, id,   k, re, lb, i, r) {   # 패턴이 맞으면 맞은 부분(같은 곳인지 볼 때), 아니면 ""
  k = pat SUBSEP id
  if (k in PMC) return PMC[k]
  if (!(pat in PRE)) PRE[pat] = globre(pat ~ /\/$/ ? pat "**" : pat)
  re = PRE[pat]; r = ""
  if (rel == "modules") {
    lb = (id in NLB) ? NLB[id] : id
    if (lb ~ re) r = lb; else if (id ~ re) r = id
  } else if (id ~ re) r = id
  else for (i = 1; i <= length(id); i++) if (substr(id, i, 1) == "/" && substr(id, 1, i - 1) ~ re) { r = substr(id, 1, i - 1); break }   # 폴더가 맞으면 그 아래 전부
  return (PMC[k] = r)
}
function cycles(r,   e, g, gt, c) {
  g = 100 + 2 * r; gt = g + 1
  for (e = 1; e <= ne; e++) {
    if (RA[r] != "" && (pm(RA[r], ES[e]) == "" || pm(RA[r], ET[e]) == "")) continue
    arc(g, ES[e], ET[e]); if (ETR[e]) arc(gt, ES[e], ET[e])
  }
  scc(g); scc(gt)
  for (c = 1; c <= NC[g]; c++) if (CS[g, c] > 1) print "V\t" (cyctrust(g, c, gt) ? "error" : "warning") "\t" RL[r] "\t" RTX[r] "\tno-cycles\t" ckey(g, c) "\t"
}
AWKEOF
}

# 레코드 → graphviz DOT (svg · png 는 dot 이 그린다). 파일은 폴더별 묶음(cluster), 추정 연결은 점선
graph_awk_dot() {
  cat <<'AWKEOF'
BEGIN {
  FS = "\t"
  pal("ts", "#dce9fb", "#3178c6"); pal("js", "#fbf3cc", "#b59500"); pal("vue", "#dcf5e9", "#3fb27f"); pal("svelte", "#ffe3d9", "#ff3e00")
  pal("python", "#dfe8f3", "#3572a5"); pal("go", "#d9f3f9", "#00a7d0"); pal("rust", "#f6e1d8", "#c0532a"); pal("kotlin", "#ece3fd", "#8f5bea")
  pal("java", "#f3e8d9", "#b07219"); pal("swift", "#fde4de", "#f05138"); pal("package", "#eef0f4", "#8a94a6"); pal("module", "#ddf3e6", "#2fa36b")
  pal("folder", "#f8efd5", "#c39b2e"); pal("npm", "#f9dede", "#cb3837"); pal("cargo", "#f6e1d8", "#c0532a"); pal("gradle", "#dbf0ef", "#2d9c96")
  pal("tuist", "#e7e2ff", "#6a4cff")
}
function pal(g, f, l) { PF[g] = f; PL[g] = l }
function dq(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return "\"" s "\"" }
function dq2(a, b) { gsub(/\\/, "\\\\", a); gsub(/"/, "\\\"", a); gsub(/\\/, "\\\\", b); gsub(/"/, "\\\"", b); return "\"" a "\\n" b "\"" }
function num(a, k,   m) { if (match(a, "\"" k "\":[0-9]+")) { m = substr(a, RSTART, RLENGTH); sub(/^.*:/, "", m); return m + 0 }; return 0 }
function hsize(b) { if (b >= 1048576) return sprintf("%.1fMB", b / 1048576); if (b >= 1024) return sprintf("%.0fKB", b / 1024); return b "B" }
function relname(r) { return r == "files" ? "파일 import" : r == "modules" ? "모듈 의존" : r == "changes" ? "같이 바뀌는 파일" : "폴더 구조" }
$1 == "1" { n++; ID[n] = $2; KD[n] = $3; LB[n] = $4; GR[n] = $5; AT[n] = $6; next }
$1 == "2" { m++; ES[m] = $2; ET[m] = $3; EK[m] = $4; EW[m] = $5 + 0; EH[m] = $6; EA[m] = $7; next }
function nodeattrs(i,   g, lab, s) {
  g = GR[i]; s = ""; lab = dq(LB[i])
  if (KD[i] == "folder") { s = ", shape=folder"; if (rel == "tree") lab = dq2(LB[i], num(AT[i], "files") "개 · " hsize(num(AT[i], "bytes"))) }
  else if (KD[i] == "package") s = ", style=\"rounded,filled,dashed\""
  else if (KD[i] == "module") s = (rel == "modules") ? ", shape=box3d" : ", shape=component"
  if (rel == "changes") lab = dq2(LB[i], num(AT[i], "changes") "번")
  return "label=" lab ", fillcolor=" dq((g in PF) ? PF[g] : "#f3f5f9") ", color=" dq((g in PL) ? PL[g] : "#9aa3b2") s ", tooltip=" dq(ID[i])
}
function edgeattrs(k,   w) {
  if (EH[k] == "h") return "style=dashed, color=\"#a3abb8\""
  if (EK[k] == "dynamic-import") return "style=dotted"
  if (EK[k] == "reexport") return "color=\"#3d6df2\""
  if (EK[k] == "contains") return "arrowhead=none, color=\"#c4cad4\""
  if (EK[k] == "cochange") { w = EW[k]; return sprintf("penwidth=%.1f, tooltip=%s", (w > 1 ? 0.6 + log(w) * 1.2 : 0.6), dq(ES[k] " ↔ " ET[k] " · " w "번")) }
  if (EA[k] ~ /"scope":"[^"]*([Tt]est|[Dd]ev)/) return "style=dashed"
  return ""
}
END {
  print "digraph gitch {"
  printf "  graph [rankdir=%s, fontname=\"Helvetica\", fontsize=12, labelloc=t, labeljust=l, label=%s, bgcolor=\"white\", pad=0.3, nodesep=0.2, ranksep=0.6%s];\n", (rel == "modules" ? "TB" : "LR"), dq(repo (scope != "" ? "/" scope : "") " · " relname(rel) (langs != "" ? " · " langs : "") " · 노드 " (n + 0) " · 연결 " (m + 0)), (rel == "changes" ? ", layout=neato, overlap=false, splines=true, sep=\"+8\"" : "")
  print "  node [shape=box, style=\"rounded,filled\", fontname=\"Helvetica\", fontsize=10, penwidth=0.8, margin=\"0.12,0.04\", height=0.3];"
  print "  edge [color=\"#7d8799\", arrowsize=0.6, penwidth=0.8];"
  if (rel == "changes") print "  edge [dir=none];"
  cl = (rel == "files" && n <= 400)                       # 많으면 묶음이 dot 을 느리게 한다
  for (i = 1; i <= n; i++) {
    line = dq(ID[i]) " [" nodeattrs(i) "];"
    if (cl && KD[i] == "file") { d = dirof(ID[i]); if (!(d in CLN)) CLORD[++ncl] = d; CLN[d] = CLN[d] "\n    " line }
    else print "  " line
  }
  for (j = 1; j <= ncl; j++) {
    d = CLORD[j]
    printf "  subgraph %s {\n    label=%s; style=\"rounded\"; color=\"#dfe3ea\"; fontcolor=\"#6b7385\"; fontsize=10;%s\n  }\n", dq("cluster_" j), dq(d == "" ? "./" : d), CLN[d]
  }
  for (k = 1; k <= m; k++) printf "  %s -> %s [%s];\n", dq(ES[k]), dq(ET[k]), edgeattrs(k)
  print "}"
}
AWKEOF
}

# 표준입력 JSON({"initial", "views": {관계: json}}) → 오프라인 한 페이지(CDN 없음).
# 생김새는 Gitrochi 앱 아이콘의 느낌만 따른다: 검정(밝게는 흰) 바탕, git 노드처럼 가운데가 빈 은색 고리, 고른 것은 초록 빛.
# 회색은 모두 R=G=B — 바탕 · 창 · 선 어디에도 푸른 기가 없게.
# 위 탭으로 네 관계(파일 · 모듈 · 같이 바뀜 · 폴더)를 바꾸고, 단위(파일 · 폴더) · 언어 · 그리기(점 · 상자 = tuist 같은 다이어그램) ·
# 색(언어 · 종류 · 바뀐 횟수) · 크기를 고른다. 분석 창은 순환 의존 · 많이 쓰이는 것 · 안 쓰이는 것 · 가장 긴 사슬 · 핫스팟 ·
# 숨은 결합(같이 바뀌는데 import 는 없음) 등을 찾아 누르면 그래프에 강조한다. 노드에서는 영향 범위 · 전체 의존 · 경로 찾기.
# 노드 색은 세 칸만 언어 계열에 준다: 가장 많은 언어는 은색(밝게는 흑연색), 다음 둘은 검증한 주황 · 초록, 나머지는 회색 —
# 그래프는 어느 두 노드든 붙을 수 있어 칸이 많으면 서로 구별이 안 된다. 바뀐 횟수는 주황 한 색의 네 단계. JSON 의 < 는 < 로 — 데이터 속 </script> 가 페이지를 끊지 않게
