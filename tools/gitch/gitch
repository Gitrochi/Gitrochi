    gsub(/excluding[ \t]*:[ \t]*(\[[^]]*\]|"[^"]*")/, "", src)                       # .glob("…", excluding: […]) 의 뺄 경로는 소스가 아니다
    while (match(src, /"[^"]*"/)) { modsrc(name, substr(src, RSTART + 1, RLENGTH - 2), d); src = substr(src, RSTART + RLENGTH) }
  }
  if (!found && proj != "" && !index(proj, "\\(")) { modsrc(proj, "Sources/**", d); modsrc(proj "Tests", "Tests/**", d) }   # 도우미 매니페스트: Tuist 의 흔한 틀
