read -r -d '' ZSH_BLOCK <<'EOF'
# >>> gitsw >>>  ('gitch install' 이 관리합니다)
[[ ":$PATH:" != *":$HOME/bin:"* ]] && export PATH="$HOME/bin:$PATH"
alias gitch='noglob gitch'
alias gitsw='noglob gitsw'
_gitsw_prompt() {
  git rev-parse --is-inside-work-tree &>/dev/null || return
  local a; a=$(git config --get gitswitch.account)
  if [[ -n $a ]]; then print -n "%F{green}[$a]%f"; else print -n "%F{yellow}[계정?]%f"; fi
}
setopt PROMPT_SUBST
[[ $RPROMPT == *_gitsw_prompt* ]] || RPROMPT='$(_gitsw_prompt)'"$RPROMPT"
# <<< gitsw <<<
EOF

# Windows 의 Git Bash(~/.bashrc): PATH + 프롬프트의 마지막 줄 앞에 이 저장소의 계정 (Git Bash 기본 프롬프트는 '\n$ ' 로 끝난다)
# shellcheck disable=SC2028  # \n · \$ 는 PS1 이 해석한다
read -r -d '' BASH_BLOCK <<'EOF'
# >>> gitsw >>>  ('gitch install' 이 관리합니다)
case ":$PATH:" in *":$HOME/bin:"*) ;; *) export PATH="$HOME/bin:$PATH" ;; esac
