    allow) echo "- push 와 PR 생성은 확인 없이 진행된다. 그래도 검사 훅(작성자/강제 push/비밀값)은 그대로 적용된다." ;;
    *) echo "- push 와 PR 생성 전에는 사용자 확인 창이 뜬다." ;;
  esac
  echo "- PR(GitLab 은 MR): \`gitch pr --title \"...\" --body \"...\"\`, 상태 \`gitch pr status\`, CI \`gitch ci\`."
  echo "- 테스트: 코드를 바꾼 뒤 \`gitch test --affected --summary\` 로 영향받은 테스트를 확인한다(흐름 파일 .gitch/flow.yml 이 있을 때). 없으면 \`gitch flow init --dry-run\` 결과를 보여 주고 만들지 사용자에게 묻는다. 0개 실행 · 판정 불가는 통과가 아니다."
  echo "- 저장소 받기는 \`git clone\` 대신 \`gitch clone [계정] <주소>\`, 포크 \`gitch fork [계정] <원본>\`, 포크 최신화 \`gitch sync\`."
  echo "- 원격이 없는 새 저장소를 처음 올릴 때는 \`gitch publish [이름]\` (기본 비공개, 사용자 확인 후)."
  echo "- 충돌·진행 중 작업은 \`gitch ck\` 로 보고 \`gitch continue\` 로 이어간다 (\`gitch abort\` 는 사용자 확인 후). 실수 복구 지점은 \`gitch rescue\`."
  echo ""
  echo "금지/확인:"
  echo "- 잠긴 저장소(LOCKED_ACCOUNT)의 계정을 다른 계정으로 바꾸거나(\`gitch use <다른계정>\`) 잠금을 풀지(\`gitch unlock\`) 않는다. 사용자가 명시적으로 요청한 경우만 예외. 같은 계정을 다시 적용하는 \`gitch use <LOCKED_ACCOUNT>\` 는 괜찮다."
  echo "- \`--no-verify\`, \`git push --force\`, \`GITSW_SKIP\`·\`GIT_AUTHOR_*\` 같은 환경변수, \`git -c user.*\`·\`core.hooksPath\` 로 검사를 우회하지 않는다. 강제 push 가 꼭 필요하면 사용자에게 요청한다."
  echo "- commit/push 가 \`[gitch]\` 메시지로 거부되면 우회하지 말고 메시지를 그대로 사용자에게 보고한다. 비밀값으로 막힌 파일은 커밋에서 빼고 사용자에게 알린다."
  echo "- \`gitch undo\`·\`amend\`·\`fix --yes\`·\`rescue --restore\` 는 사용자가 요청했을 때만, push 전 커밋에만 쓴다."
  echo "- ~/.gitconfig, ~/.ssh, ~/.config/gitsw 를 직접 수정하지 않는다. HTTPS 비밀번호/토큰 인증을 시도하지 않는다."
  echo "- 계정 추가, GitHub 브라우저 로그인, SSH 설정은 사용자가 Gitrochi 앱의 계정 설정 또는 터미널에서 직접 진행한다. AI는 사용자의 명시적인 요청 없이 계정·인증·SSH 키를 만들거나 변경하지 않는다."
  echo "- \`gitch remove\`·\`sign on|off\`·\`import\` 와 \`gh auth login\` 은 사용자가 터미널에서 직접 실행하도록 안내한다."
  echo "- 흐름 파일을 고치면 신뢰가 풀려 사람이 다시 승인한다(\`gitch flow trust\` · \`gitch flow hold release\` 는 사람이 실행). 흐름 실행 기록(.git/gitch/flow)을 직접 만들거나 고치지 않고, \`--yes\` 로 확인을 건너뛰지 않는다."
  for id in "${ACC_IDS[@]}"; do acc_idx "$id"; [ "${ACC_TRAILER[$ACC_I]}" = strip ] && strip="$strip${strip:+, }$id"; done
  [ -n "$strip" ] && echo "- $strip 계정 저장소의 커밋 메시지에는 AI 표기(Co-Authored-By: Claude 등)를 넣지 않는다."
  echo "- git 계정 문제가 생기면 \`gitch doctor\` 결과를 사용자에게 보여준다."
  echo "<!-- gitsw:end -->"
}

