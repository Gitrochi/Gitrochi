function swift_mods(p,   i, out) {   # 파일이 속한 모듈들 "\034A\034B" (여러 타깃이 같은 폴더를 쓰기도 한다)
  out = ""
  for (i = 1; i <= MODN; i++) {
    if (index(p, MODPRE[i]) != 1) continue
    if (MODRE[i] == "" ? (p == MODG[i] || index(p, MODG[i] "/") == 1) : (p ~ MODRE[i])) {
      if (!index(out "\034", "\034" MODNAME[i] "\034")) out = out "\034" MODNAME[i]
    }
