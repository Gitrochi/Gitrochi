  close(f)
}
function cargo_str(s) { sub(/^[^"]*"/, "", s); sub(/".*$/, "", s); return s }
function cargo_attrs(f, n, s) {
  if (match(s, /(^|[^A-Za-z_-])path[ \t]*=[ \t]*"[^"]*"/)) CDPATH[f, n] = cargo_str(substr(s, RSTART, RLENGTH))
  if (match(s, /(^|[^A-Za-z_-])package[ \t]*=[ \t]*"[^"]*"/)) CDPKG[f, n] = cargo_str(substr(s, RSTART, RLENGTH))
  if (s ~ /(^|[^A-Za-z_-])workspace[ \t]*=[ \t]*true/) CDWS[f, n] = 1
}
function cargo_wsroot(f,   d, r) {   # [workspace] 가 있는 Cargo.toml — 자기 자신 또는 위 폴더
  if (f in CWS) return f
  d = dirof(f)
