          print
        }' "$tmp/result"
    else cat "$tmp/result"; say '경고 · INPUT_CHANGED: 분석 중 추적 파일 또는 저장소 상태가 바뀌었습니다. 다시 실행하세요.'; fi
    return 1
  fi
  cat "$tmp/result"
  return "$rc"
)

module_audit_fingerprint() (
  local tmp=$1 path
  set -o pipefail
  {
    git ls-files --cached --stage -z -- || exit 1
    cat "$tmp/files.z" "$tmp/files"
    : > "$tmp/hash.paths"
    while IFS= read -r path; do
      if [ -f "$path" ] && [ ! -L "$path" ]; then printf '%s\0' "$path" >> "$tmp/hash.paths"
      else printf 'missing-or-link:%s\0' "$path"; fi
    done < "$tmp/files"
    xargs -0 git hash-object --no-filters -- < "$tmp/hash.paths" || exit 1
  } | git hash-object --stdin
)

