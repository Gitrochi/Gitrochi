  }
}
function count(s, t,   n, i) { n = 0; while ((i = index(s, t)) > 0) { n++; s = substr(s, i + length(t)) }; return n }
function unquote(s) { s = trim(s); sub(/^["']/, "", s); sub(/["'][ \t]*$/, "", s); return s }

# ---------- files: 파일 노드와 연결 ----------
function files_main(   i, p, lg, ins, k, n, K, e) {
  ts_configs(); go_mods(); rs_crates(); py_index()
  for (i = 1; i <= NPKGJ; i++) { pj_read(PKGJ[i]); if (PJN[PKGJ[i]] != "") NPMDIR[PJN[PKGJ[i]]] = dirof(PKGJ[i]) }
  if (NSPM || NTUIST) swift_modmap()
  if (swiftrc == "0") swift_covered()
  for (i = 1; i <= NSRC; i++) {
    p = SRC[i]; lg = LANG[p]; ins = inscope(p)
    if (ins) { FREF[p] = 1; LCNT[lg]++ }
    # Swift · Kotlin · Java 는 범위 밖 파일에서도 선언을 모은다 — 다른 폴더에 선언된 타입으로도 이어지게
    if (lg == "swift") { if (MODN) FMOD[p] = swift_mods(p); scan_swift(p, ins) }
    else if (lg == "kotlin" || lg == "java") scan_jvm(p, ins)
    else if (!ins) continue
    else if (lg == "python") scan_py(p)
    else if (lg == "go") scan_go(p)
    else if (lg == "rust") scan_rs(p)
    else if (lg ~ /^(ts|js|vue|svelte|astro|mdx)$/) scan_ts(p)
    else scan_extra(p, lg)
  }
  SCAN_FILE = ""; SCAN_LINE = 0
  if (swiftrc == "0") swift_index()
  swift_resolve()                                                    # 인덱스에 없는 파일(빌드하지 않은 타깃 · 새 파일)은 이름으로
  jvm_resolve(); go_contains()
  for (p in FREF) filenode(p)
  n = sortkeys(LCNT, K); k = ""
  for (i = 1; i <= n; i++) k = k (i > 1 ? "," : "") jstr(K[i]) ":" LCNT[K[i]]
  printf "0\tlanguages\t{%s}\n", k
  printf "0\tunresolved\t%d\n", UNRES
  if (swiftrc == "0") printf "0\tnote\tSwift: Xcode 인덱스(gitch-swift-index)로 읽은 정확한 참조입니다 (연결 %d개%s).\n", SWIDXN, (SWUNCOV ? sprintf(", 인덱스에 없는 파일 %d개는 타입 이름으로 추정", SWUNCOV) : "")
  if (swiftrc == "0" && swifterr != "") { e = clean(swifterr); sub(/^gitch-swift-index:[ \t]*/, "", e); printf "0\tnote\tSwift: %s\n", e }   # 오래된 인덱스 경고 등
  else if (swiftrc == "3") print "0\tnote\tSwift: Xcode 인덱스가 없어(Xcode 로 한 번 빌드하면 생긴다) 타입 이름으로 추정했습니다."
  else if (swiftrc != "") printf "0\tnote\tSwift: gitch-swift-index 가 실패해(%s) 타입 이름으로 추정했습니다.\n", (swifterr != "" ? clean(swifterr) : "종료 코드 " swiftrc)
  if (HEUR["swift"]) print "0\tnote\tSwift: 파일끼리 import 하지 않아서, 다른 파일에 선언된 최상위 타입(class · struct · enum · protocol · actor · typealias) 이름을 쓰면 연결로 추정했습니다 (heuristic: true, 그림에서는 점선)."
  if (MODN && LCNT["swift"]) printf "0\tnote\tSwift: Tuist · SwiftPM 매니페스트로 파일의 모듈을 정해, 다른 모듈의 타입은 그 모듈을 import 했고 public · open · package 로 선언됐을 때만 이었습니다(@testable 이면 internal 도) (모듈 %d개%s).\n", swift_modcount(), (SWDROP ? sprintf(", 그래서 뺀 이름 %d개", SWDROP) : "")
  if (HEUR["jvm"]) print "0\tnote\tKotlin/Java: 같은 패키지의 타입은 import 없이 쓰므로, 그 이름을 쓰면 연결로 추정했습니다 (heuristic: true, 그림에서는 점선)."
  if (UNRES) printf "0\tnote\t상대 경로 import · mod 중 %d개는 추적하는 파일에서 찾지 못해 뺐습니다 (빌드 때 생기는 파일 등).\n", UNRES
}
function filenode(p,   lg, a) {
  lg = (p in LANG) ? LANG[p] : langof(p)
  if (lg == "") lg = tolower(extof(p))
  if (lg == "") lg = "file"
  a = "\"path\":" jstr(p) ",\"lang\":" jstr(lg)
  a = a ",\"analysis\":" jstr(swift_indexed(p) ? "compiler-index" : lg ~ /^(swift|kotlin|java|python|go|rust|ts|js|vue|svelte|astro|mdx|c|cpp|objc|objcpp|protobuf|ruby|php|lua|shell|css|scss|less|dart|solidity)$/ ? "static-import" : "file-detection")
  if (p in LINES) a = a ",\"lines\":" LINES[p]
  if (FMOD[p] != "") a = a ",\"modules\":[" jlist(FMOD[p]) "]"
  if (!inscope(p)) a = a ",\"outside\":true"
  addnode(p, "file", baseof(p), lg, a)
}
function fedge(s, t, kind, via) { FREF[t] = 1; addedge(s, t, kind, 1, 0, via, "") }
function unresolved(p, spec, reason) {
  UNRES++
  printf "0\tdiagnostic\t{\"code\":\"UNRESOLVED_IMPORT\",\"severity\":\"warning\",\"file\":%s,\"line\":%s,\"declaration\":%s,\"method\":\"static-import\",\"message\":%s}\n", jstr(p), (SCAN_FILE == p ? SCAN_LINE : "null"), jstr(spec), jstr(reason)
}
function pedge(s, eco, name, kind, via, extra,   id, a) {   # 저장소 밖 패키지(npm · PyPI · Go · crates · Maven …)
  if (noext || name == "") return
  id = "pkg:" eco "/" name
  a = "\"ecosystem\":" jstr(eco) ",\"name\":" jstr(name)
  if (eco == "npm" && (name in NPMDIR)) a = a ",\"local\":" jstr(NPMDIR[name] == "" ? "." : NPMDIR[name])
  addnode(id, "package", name, "package", a)
  addedge(s, id, kind, 1, 0, via, extra)
}
function medge(s, name,   id, a) {   # Swift 의 import 모듈
  if (noext || name == "") return
  id = "module:" name; a = "\"name\":" jstr(name)
  if (name in SRCMOD) a = a ",\"local\":" jstr(SRCMOD[name])
  else if (name in MODDIR) a = a ",\"local\":" jstr(MODDIR[name] == "" ? "." : MODDIR[name])
  addnode(id, "module", name, "module", a)
  addedge(s, id, "import", 1, 0, "", "")
}
function heur(s, t, w, fam, chk) {   # 이름으로 추정한 연결 — 같은 두 파일에 정확한 연결이 있으면 더하지 않는다
  if (s == t || ((s "\034" t) in PAIR)) return
  FREF[t] = 1; HEUR[fam]++
  addedge(s, t, "type-ref", 1, 1, w, "")
  if (chk) ECHK[s "\034" t "\034" "type-ref"] = 1   # 모듈 · 패키지로 확인한 추정(같은 모듈, import 한 모듈의 공개 타입, 같은 패키지)
}
function refs(p, s,   w) {   # 대문자로 시작하는 이름들(문자열 · 줄 주석 빼고) — Swift · Kotlin · Java 의 타입 추정용
  if (index(s, "\"")) gsub(/"([^"\\]|\\.)*"/, " ", s)
  if (index(s, "//")) sub(/\/\/.*$/, "", s)
  while (match(s, /(^|[^A-Za-z0-9_])[A-Z][A-Za-z0-9_]*/)) {   # 낱말을 모두 나누는 것보다 대문자 이름만 찾는 쪽이 빠르다
    w = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
    if (!index(UPPER, substr(w, 1, 1))) w = substr(w, 2)
    if (!((p "\034" w) in RF)) { RF[p "\034" w] = LINES[p]; REF[p] = REF[p] "\034" w }
  }
}

# ----- TypeScript / JavaScript: import · export … from · require() · import() -----
function scan_ts(p,   line, inc, st, open, allow, rest, m, spec, kw, kind) {
  inc = 0; st = "import"; open = 0
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]
    if (inc) { if (index(line, "*/")) inc = 0; continue }
    if (line ~ /^[ \t]*\/\*/) { if (!index(substr(line, index(line, "/*") + 2), "*/")) inc = 1; continue }
    if (line ~ /^[ \t]*\/\//) continue
    if (!index(line, "import") && !index(line, "require") && !index(line, "from")) { if (open && index(line, "}")) open = 0; continue }
    # from '…' 은 import/export 문 안에서만(여러 줄 import { … } from 의 끝 줄 포함) — 문자열 속 "from 'x'" 를 잡지 않게
    allow = open
    if (line ~ /^[ \t]*(import|export)([ \t{*]|$)/) { allow = 1; st = (line ~ /^[ \t]*export/) ? "reexport" : "import" }
    rest = line
    while (match(rest, /(^|[^A-Za-z0-9_$.])(from|import|require)[ \t]*\(?[ \t]*["'][^"']+["']/)) {
      m = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
      spec = m; sub(/^[^"']*["']/, "", spec); sub(/["']$/, "", spec)
      kw = m; sub(/^[^a-z]*/, "", kw); sub(/[^a-z].*$/, "", kw)
      if (kw == "require") { if (m !~ /\(/) continue; kind = "require" }
      else if (kw == "import") { if (m ~ /\(/) kind = "dynamic-import"; else if (allow) kind = "import"; else continue }
      else { if (!allow) continue; kind = st }
      ts_dep(p, spec, kind)
    }
    if (allow && index(line, "{") && !index(line, "}")) open = 1
    else if (open && index(line, "}")) open = 0
  }
  close(p)
}
function ts_dep(p, spec, kind,   s, t, ck) {
  s = spec
  if (s ~ /^#/) { unresolved(p, spec, "package.json imports 별칭은 빠른 분석에서 해석하지 못했습니다. SCIP 인덱스를 사용하세요."); return }
  sub(/[?#].*$/, "", s)
  if (s == "") return
  ck = dirof(p) "\034" s                     # 같은 폴더의 같은 import 는 한 번만 푼다
  if (ck in TSRES) t = TSRES[ck]
  else { t = ts_resolve(p, s); TSRES[ck] = t }
  if (t == "\001") unresolved(p, spec, "추적 파일에서 경로를 찾지 못했습니다. 생성 파일·별칭·확장자를 확인하세요.")
  else if (substr(t, 1, 1) == "\002") pedge(p, "npm", substr(t, 2), kind, spec, "")
  else fedge(p, t, kind, spec)
}
function ts_resolve(p, s,   t) {   # → 파일 경로 · "\001"(못 찾음) · "\002패키지"
  if (s ~ /^\.\.?(\/|$)/) {
    t = normp(joinp(dirof(p), s))
    t = (t == "\001") ? "" : ts_try(t)
    return (t == "") ? "\001" : t
  }
  t = ts_alias(p, s)
  if (t != "") return t
  if (s ~ /^\//) return "\001"
  return "\002" npm_name(s)
}
function ts_try(b,   i, s, pre) {   # 확장자 · index 파일 · .js 로 쓴 .ts
  if (b in EX) return b
  for (i = 1; i <= NTSX; i++) if ((b TSX[i]) in EX) return b TSX[i]
  pre = (b == "") ? "" : b "/"
  for (i = 1; i <= NTSX; i++) if ((pre "index" TSX[i]) in EX) return pre "index" TSX[i]
  if (match(b, /\.[cm]?jsx?$/)) { s = substr(b, 1, RSTART - 1); for (i = 1; i <= 4; i++) if ((s TSJ[i]) in EX) return s TSJ[i] }
  return ""
}
function npm_name(s,   a, n) {
  if (s ~ /^@/) { n = split(s, a, "/"); return n >= 2 ? a[1] "/" a[2] : s }
  sub(/\/.*$/, "", s)
  return s
}

# 새 언어는 먼저 파일을 빠짐없이 보여 주고, 정적인 경로 선언만 잇는다. 실행·평가로 의존을 알아내지는 않는다.
function scan_extra(p, lg,   line, inc, s, spec, kind, eco, relative) {
  inc = 0
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]; sub(/\r$/, "", line); s = trim(line)
    if (inc) { if (index(s, "*/")) inc = 0; continue }
    if (s ~ /^\/\*/) { if (!index(substr(s, 3), "*/")) inc = 1; continue }
    if (s ~ /^(\/\/|--)/) continue
    spec = ""; kind = "import"; eco = lg; relative = 0
    if (lg ~ /^(c|cpp|objc|objcpp)$/ && s ~ /^#[ \t]*(include|import)[ \t]*[<"]/) {
      sub(/^#[ \t]*(include|import)[ \t]*[<"]/, "", s); sub(/[>"].*$/, "", s); spec = s; kind = "include"; eco = "system"
    } else if (lg == "protobuf" && s ~ /^import[ \t]+((public|weak)[ \t]+)?"/) {
      sub(/^import[ \t]+((public|weak)[ \t]+)?/, "", s); spec = quoted(s); eco = "protobuf"; relative = 1
    } else if (lg == "ruby" && s ~ /^(require|require_relative|load)[ \t(]+["']/) {
      relative = s ~ /^require_relative/; spec = quoted(s); kind = "require"; eco = "gem"
    } else if (lg == "php" && s ~ /^(require|require_once|include|include_once)[ \t(]+["']/) {
      spec = quoted(s); kind = "include"; eco = "composer"; relative = 1
    } else if (lg == "lua" && s ~ /^(local[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*=[ \t]*)?require[ \t(]+["']/) {
      spec = quoted(s); gsub(/\./, "/", spec); kind = "require"
    } else if (lg == "shell" && s ~ /^(source|\.)[ \t]+["']/) {
      spec = quoted(s); kind = "source"; relative = 1
    } else if (lg ~ /^(css|scss|less)$/ && s ~ /^@(import|use|forward)[ \t]+["']/) {
      spec = quoted(s); eco = "npm"
    } else if (lg == "dart" && s ~ /^(import|export|part)[ \t]+["']/) {
      spec = quoted(s); eco = "pub"; relative = spec !~ /^(package|dart):/
      if (spec ~ /^dart:/) { pedge(p, "dart", spec, kind, spec, ""); continue }
      if (spec ~ /^package:/) { sub(/^package:/, "", spec); sub(/\/.*$/, "", spec); pedge(p, eco, spec, kind, spec, ""); continue }
    } else if (lg == "solidity" && s ~ /^import[ \t]/) { spec = quoted(s); eco = "npm" }
    if (spec != "" && spec !~ /[$`]/) path_dep(p, spec, lg, eco, kind, relative)
  }
  close(p)
}
function quoted(s) { if (!match(s, /["'][^"']+["']/)) return ""; return substr(s, RSTART + 1, RLENGTH - 2) }
function path_try(b, lg,   n, a, i, t) {
  if (b in EX) return b
  n = split(LANGEXT[lg], a, " ")
  for (i = 1; i <= n; i++) {
    if ((b "." a[i]) in EX) return b "." a[i]
    t = joinp(dirof(b), "_" baseof(b) "." a[i]); if (lg == "scss" && (t in EX)) return t
    t = joinp(b, "init." a[i]); if (lg == "lua" && (t in EX)) return t
  }
  return ""
}
function path_dep(p, spec, lg, eco, kind, relative,   b, t) {
  b = normp(joinp(dirof(p), spec)); t = (b == "\001") ? "" : path_try(b, lg)
  if (t == "" && !relative && spec !~ /^\.\.?\//) t = path_try(spec, lg)
  if (t == "" && lg ~ /^(c|cpp|objc|objcpp)$/) t = path_try(joinp("include", spec), lg)
  if (t != "") fedge(p, t, kind, spec)
  else if (relative || spec ~ /^\.\.?\//) unresolved(p, spec, "추적 파일에서 상대 경로를 찾지 못했습니다.")
  else pedge(p, eco, spec, kind, spec, "")
}
function ts_configs(   i) { for (i = 1; i <= NTSC; i++) ts_read(TSC[i], dirof(TSC[i]), 0) }
function ts_read(f, d, lvl,   all, line, v, base, blk, m, k, t, ext) {   # tsconfig 의 baseUrl · paths (extends 는 세 단계까지)
  all = ""
  while ((getline line < f) > 0) if (line !~ /^[ \t]*\/\//) all = all " " line
  close(f)
  TSHAS[d] = 1; base = dirof(f)
  if (match(all, /"baseUrl"[ \t]*:[ \t]*"[^"]*"/)) {
    v = substr(all, RSTART, RLENGTH); sub(/^"baseUrl"[ \t]*:[ \t]*"/, "", v); sub(/"$/, "", v)
    v = normp(joinp(dirof(f), v))
    if (v != "\001") { base = v; if (!(d in TSBASE)) TSBASE[d] = v }
  }
  if (match(all, /"paths"[ \t]*:[ \t]*\{/)) {
    blk = substr(all, RSTART + RLENGTH)
    if (index(blk, "}")) blk = substr(blk, 1, index(blk, "}") - 1)
    while (match(blk, /"[^"]*"[ \t]*:[ \t]*\[[ \t]*"[^"]*"/)) {
      m = substr(blk, RSTART, RLENGTH); blk = substr(blk, RSTART + RLENGTH)
      k = m; sub(/^"/, "", k); sub(/".*$/, "", k)
      t = m; sub(/"$/, "", t); sub(/^.*"/, "", t)
      TSN[d]++; TSP[d, TSN[d]] = k; TST[d, TSN[d]] = t; TSB[d, TSN[d]] = base
    }
  }
  if (lvl < 3 && match(all, /"extends"[ \t]*:[ \t]*"\.[^"]*"/)) {
    v = substr(all, RSTART, RLENGTH); sub(/^"extends"[ \t]*:[ \t]*"/, "", v); sub(/"$/, "", v)
    ext = normp(joinp(dirof(f), v)); if (ext !~ /\.json$/) ext = ext ".json"
    if ((ext in EX) && ext != f) ts_read(ext, d, lvl + 1)
  }
}
function ts_cfg(p,   d, r) {   # 파일에 맞는 tsconfig 폴더(가장 가까운 위 폴더), 없으면 "\001"
  d = dirof(p)
  if (d in TSFOR) return TSFOR[d]
  r = d
  while (!(r in TSHAS)) { if (r == "") { r = "\001"; break }; r = dirof(r) }
  TSFOR[d] = r
  return r
}
function ts_alias(p, s,   d, i, best, bl, pat, pre, suf, t, r, j) {   # tsconfig paths(가장 긴 접두사) → baseUrl
  d = ts_cfg(p)
  if (d == "\001") return ""
  best = 0; bl = -1
  for (i = 1; i <= TSN[d]; i++) {
    pat = TSP[d, i]; j = index(pat, "*")
    if (j) {
      pre = substr(pat, 1, j - 1); suf = substr(pat, j + 1)
      if (length(s) >= length(pre) + length(suf) && substr(s, 1, length(pre)) == pre && (suf == "" || substr(s, length(s) - length(suf) + 1) == suf) && length(pre) > bl) { best = i; bl = length(pre) }
    } else if (s == pat && length(pat) > bl) { best = i; bl = length(pat) }
  }
  if (best) {
    pat = TSP[d, best]; t = TST[d, best]; j = index(pat, "*")
    if (j && index(t, "*")) {
      pre = substr(pat, 1, j - 1); suf = substr(pat, j + 1)
      r = substr(s, length(pre) + 1, length(s) - length(pre) - length(suf))
      t = substr(t, 1, index(t, "*") - 1) r substr(t, index(t, "*") + 1)
    }
    r = normp(joinp(TSB[d, best], t))
    if (r != "\001") { r = ts_try(r); if (r != "") return r }
  }
  if (d in TSBASE) { r = normp(joinp(TSBASE[d], s)); if (r != "\001") { r = ts_try(r); if (r != "") return r } }
  return ""
}

