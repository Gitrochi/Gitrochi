    v = substr(all, RSTART, RLENGTH); sub(/^"baseUrl"[ \t]*:[ \t]*"/, "", v); sub(/"$/, "", v)
    v = normp(joinp(dirof(f), v))
    if (v != "\001") { base = v; if (!(d in TSBASE)) TSBASE[d] = v }
  }
  if (match(all, /"paths"[ \t]*:[ \t]*\{/)) {
    blk = substr(all, RSTART + RLENGTH)
    if (index(blk, "}")) blk = substr(blk, 1, index(blk, "}") - 1)
    while (match(blk, /"[^"]*"[ \t]*:[ \t]*\[[ \t]*"[^"]*"/)) {
      m = substr(blk, RSTART, RLENGTH); blk = substr(blk, RSTART + RLENGTH)
