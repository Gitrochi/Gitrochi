# XML · TOML · JSON 매니페스트는 읽기만 한다. 빌드 도구·setup.py·Gemfile 을 실행하지 않아도 모듈이 나와야 한다.
function manifest_text(f,   line, s) {
  s = ""; while ((getline line < f) > 0) { sub(/\r$/, "", line); s = s line "\n" }; close(f); return s
}
function xml_text(f,   s, a, b) {
  s = manifest_text(f)
  while ((a = index(s, "<!--"))) { b = index(substr(s, a + 4), "-->"); if (!b) return substr(s, 1, a - 1); s = substr(s, 1, a - 1) substr(s, a + b + 6) }
  return s
}
function xml_value(s, tag,   a, b) {
  if (!match(s, "<" tag "([ \t\n][^>]*)?>")) return ""
  a = RSTART + RLENGTH; b = index(substr(s, a), "</" tag ">")
  return b ? trim(substr(s, a, b - 1)) : ""
}
function xml_drop(s, tag,   a, b) {
  while (match(s, "<" tag "([ \t\n][^>]*)?>")) { a = RSTART; b = index(substr(s, a), "</" tag ">"); if (!b) break; s = substr(s, 1, a - 1) substr(s, a + b + length(tag) + 2) }
  return s
}
function xml_attr(s, key,   v) {
  if (!match(s, "[ \t\n]" key "[ \t\n]*=[ \t\n]*[\"\047][^\"\047]*[\"\047]")) return ""
  v = substr(s, RSTART, RLENGTH); sub(/^[^=]*=[ \t\n]*["']/, "", v); sub(/["']$/, "", v); return v
}
function maven_expand(f, s,   n, key, v) {
  for (n = 0; n < 12 && match(s, /\$\{[^}]+\}/); n++) {
    key = substr(s, RSTART + 2, RLENGTH - 3)
    v = (key == "project.groupId" || key == "pom.groupId") ? MVGROUP[f] : (key == "project.artifactId") ? MVART[f] : MVPROP[f, key]
    if (v == "") break
    s = substr(s, 1, RSTART - 1) v substr(s, RSTART + RLENGTH)
  }
  return s
}
function maven_modules(   i, f, s, own, par, props, tag, val, id, block, group, art, sc, t) {
  for (i = 1; i <= NPOM; i++) {
    f = POM[i]; s = xml_text(f); MVTEXT[f] = s; par = xml_value(s, "parent")
    own = xml_drop(xml_drop(xml_drop(xml_drop(xml_drop(s, "parent"), "dependencies"), "dependencyManagement"), "build"), "profiles")
    MVGROUP[f] = xml_value(own, "groupId"); if (MVGROUP[f] == "") MVGROUP[f] = xml_value(par, "groupId")
    MVART[f] = xml_value(own, "artifactId"); props = xml_value(s, "properties")
    while (match(props, /<[A-Za-z_][A-Za-z0-9_.-]*>/)) { tag = substr(props, RSTART + 1, RLENGTH - 2); val = xml_value(props, tag); MVPROP[f, tag] = val; props = xml_drop(props, tag) }
    MVGROUP[f] = maven_expand(f, MVGROUP[f]); MVART[f] = maven_expand(f, MVART[f])
    id = MVGROUP[f] ":" MVART[f]
    if (MVART[f] == "" || id ~ /\$\{/) continue
    MVID[f] = "maven:" id; MVLOCAL[id] = f
  }
  for (i = 1; i <= NPOM; i++) {
    f = POM[i]; id = MVID[f]; if (id == "" || !inscope(f)) continue
    mnode(id, MVGROUP[f] ":" MVART[f], "maven", dirof(f), "project")
    s = xml_drop(xml_drop(xml_drop(MVTEXT[f], "dependencyManagement"), "build"), "profiles"); s = xml_value(s, "dependencies")
    while (match(s, /<dependency[ \t\n>]/)) {
      block = xml_value(s, "dependency"); s = substr(s, RSTART + RLENGTH); t = index(s, "</dependency>"); if (!t) break; s = substr(s, t + 13)
      group = maven_expand(f, xml_value(block, "groupId")); art = maven_expand(f, xml_value(block, "artifactId")); sc = xml_value(block, "scope"); if (sc == "") sc = "compile"
      if (group == "" || art == "" || (group art) ~ /\$\{/) continue
      t = group ":" art
      if (t in MVLOCAL) { mnode(MVID[MVLOCAL[t]], t, "maven", dirof(MVLOCAL[t]), "project"); dep(id, MVID[MVLOCAL[t]], sc, f) }
      else xdep(id, "maven", t, sc, f)
    }
  }
}
function dotnet_node(f,   id) {
  id = "dotnet:" f
  if (!(id in NK)) { mnode(id, stemof(f), "dotnet", dirof(f), "project"); NA[id] = NA[id] ",\"lang\":" jstr(f ~ /\.fsproj$/ ? "fsharp" : f ~ /\.vbproj$/ ? "vb" : "csharp") }
}
function dotnet_modules(   i, f, id, s, block, name, t) {
  for (i = 1; i <= NDOTNET; i++) {
    f = DOTNET[i]; if (!inscope(f)) continue
    id = "dotnet:" f; dotnet_node(f)
    s = xml_text(f)
    while (match(s, /<(ProjectReference|PackageReference)[ \t\n][^>]*>/)) {
      block = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH); name = xml_attr(block, "Include"); if (name == "" || name ~ /\$\(/) continue
      if (block ~ /^<ProjectReference/) {
        gsub(/\\/, "/", name); t = normp(joinp(dirof(f), name))
        if (t in EX) { dotnet_node(t); dep(id, "dotnet:" t, "ProjectReference", f) }
      } else xdep(id, "nuget", name, "PackageReference", f)
    }
  }
}
function py_normal(s) { s = tolower(s); gsub(/[-_.]+/, "-", s); return s }
function py_reqfile(p) { return baseof(p) ~ /^requirements.*\.(txt|in)$/ || p ~ /(^|\/)requirements\/.*\.(txt|in)$/ }
function py_requirement(f, s, sc,   nm) {
  s = trim(s); sub(/^["']/, "", s)
  if (!match(s, /^[A-Za-z0-9][A-Za-z0-9_.-]*/)) return
  nm = py_normal(substr(s, RSTART, RLENGTH)); if (nm == "python") return
  PYDN[f]++; PYDNM[f, PYDN[f]] = nm; PYDS[f, PYDN[f]] = sc
}
function py_strings(f, s, sc,   v, q, i, c, skip) {
  while (match(s, /["']/)) {
    skip = substr(s, 1, RSTART - 1) ~ /include-group[ \t]*=[ \t]*$/
    q = substr(s, RSTART, 1); s = substr(s, RSTART + 1); v = ""
    for (i = 1; i <= length(s); i++) { c = substr(s, i, 1); if (c == q) break; if (q == "\"" && c == "\\") c = substr(s, ++i, 1); v = v c }
    s = substr(s, i + 1); if (!skip) py_requirement(f, v, sc)
  }
}
function py_brackets(s,   i, c, q, n) {
  q = ""; n = 0
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (q != "") { if (c == "\\" && q == "\"") i++; else if (c == q) q = ""; continue }
    if (c == "\"" || c == "\047") q = c
    else if (c == "#") break
    else if (c == "[") n++; else if (c == "]") n--
  }
  return n
}
function python_read(f, req,   s, sec, line, key, val, arr, sc, target, level) {
  if (f in PYREAD) return; PYREAD[f] = 1; sec = ""; arr = 0
  while ((getline line < f) > 0) {
    sub(/\r$/, "", line); if (line ~ /^[ \t]*#/) continue; sub(/[ \t]+#.*$/, "", line)
    s = trim(line)
    if (req) {
      if (s ~ /^(-r[ \t]*|--requirement[ =])/) { sub(/^(-r[ \t]*|--requirement[ =]+)/, "", s); target = normp(joinp(dirof(f), trim(s))); if (target in EX) { python_read(target, 1); PYIN[f] = PYIN[f] "\034" target } }
      else if (s !~ /^-/) py_requirement(f, s, "requirements")
      continue
    }
    if (!arr && s ~ /^\[/) { sec = s; sub(/^\[/, "", sec); sub(/\].*$/, "", sec); arr = 0; continue }
    if (arr == 2 && s !~ /^[A-Za-z_][A-Za-z0-9_]*[ \t]*=[^=]/) { py_requirement(f, s, sc); continue }
    if (arr == 2) arr = 0
    if (arr) { py_strings(f, s, sc); level += py_brackets(s); if (level <= 0) arr = 0; continue }
    if (sec == "options" && s ~ /^install_requires[ \t]*=/) { arr = 2; sc = "dependencies"; val = s; sub(/^[^=]*=/, "", val); py_requirement(f, val, sc); continue }
    if (index(s, "=")) {
      key = trim(substr(s, 1, index(s, "=") - 1)); val = trim(substr(s, index(s, "=") + 1)); key = unquote(key)
      if ((sec == "project" || sec == "tool.poetry" || sec == "metadata") && key == "name") PYNAME[dirof(f)] = unquote(val)
      else if ((sec == "project" && key == "dependencies") || sec == "project.optional-dependencies" || sec == "dependency-groups") {
        sc = sec == "project" ? "dependencies" : sec "." key; py_strings(f, val, sc); level = py_brackets(val); if (level > 0) arr = 1
      } else if (sec ~ /^tool\.poetry(\.group\.[^.]+)?\.(dev-)?dependencies$/ || sec == "packages" || sec == "dev-packages") py_requirement(f, key, sec)
    }
  }
