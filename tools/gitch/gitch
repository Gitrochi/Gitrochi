    if (ml) { if (index(line, "\"\"\"")) ml = 0; continue }
    if (inc) { if (index(line, "*/")) inc = 0; continue }
    if (line ~ /^[ \t]*\/\*/) { if (!index(substr(line, index(line, "/*") + 2), "*/")) inc = 1; continue }
    if (line ~ /^[ \t]*\/\//) continue
    if (index(line, "\"\"\"") && count(line, "\"\"\"") % 2) { ml = 1; line = substr(line, 1, index(line, "\"\"\"") - 1) }
    if (line ~ /^[ \t]*(@[A-Za-z_]+[ \t]+)*import[ \t]+/) {
      s = line; sub(/^[ \t]*(@[A-Za-z_]+[ \t]+)*import[ \t]+((typealias|struct|class|enum|protocol|let|var|func|actor)[ \t]+)?/, "", s)
      if (match(s, /^[A-Za-z_][A-Za-z0-9_]*/)) {
        s = substr(s, 1, RLENGTH)
        if (!((p "\034" s) in FIMP)) { FIMP[p "\034" s] = 1; FIMPL[p] = FIMPL[p] "\034" s }   # 모듈 경계로 추정을 거를 때 쓴다
        if (line ~ /@_exported[ \t]/) swift_reexport(p, s)
        if (line ~ /@testable[ \t]/) FTEST[p "\034" s] = 1             # internal 타입까지 보인다
        if (ins) medge(p, s)
      }
      continue
    }
    if (line ~ /^[A-Za-z@]/) swift_decl(p, line)
    if (ins && !swift_indexed(p)) refs(p, line)                  # 인덱스로 읽은 파일은 이름 추정을 하지 않는다
  }
  close(p)
}
function swift_decl(p, line,   s, priv, pub) {
  s = line; priv = 0; pub = 0
  while (match(s, /^(@[A-Za-z_][A-Za-z0-9_]*(\([^)]*\))?|public|private|fileprivate|internal|package|open|final|indirect|nonisolated|dynamic|static|override|required|convenience|distributed)[ \t]+/)) {
    if (s ~ /^(private|fileprivate)[ \t]/) priv = 1
