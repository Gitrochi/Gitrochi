}
g_path() { local p; p=$(posix_path "$(expand_path "$1")"); case "$p" in /*) ;; *) p="$G_CWD/$p" ;; esac; printf '%s' "$p"; }
# Windows 의 Claude Code 는 경로를 C:\Users\… 로 보낸다 → Git Bash 경로(/c/Users/…)로 바꿔야 ~/.ssh 등과 비교된다
posix_path() { if [ -n "$IS_WINDOWS" ]; then case "$1" in [A-Za-z]:[\\/]*|[A-Za-z]:) cygpath -u "$1" 2>/dev/null && return ;; esac; fi; printf '%s' "$1"; }
g_has() { local i=$1 w; shift; for w in "${GW[@]:$i}"; do [ "$w" = "$1" ] && return 0; done; return 1; }
g_has_prefix() { local i=$1 w; shift; for w in "${GW[@]:$i}"; do case "$w" in "$1"*) return 0 ;; esac; done; return 1; }
g_in_list() { local x="$1" w; shift; for w in "$@"; do [ "$w" = "$x" ] && return 0; done; return 1; }

g_protected() {   # gitch 가 관리하는 파일인지 (Windows 는 대소문자를 가리지 않는 파일 시스템이라 소문자로 비교)
  local p h="$HOME" c="$CFG" dd="$DATA_DIR"; p=$(g_path "$1")
  if [ -n "$IS_WINDOWS" ]; then p=$(lower "$p"); h=$(lower "$h"); c=$(lower "$c"); dd=$(lower "$dd"); fi
  case "$p" in
    "$h/.ssh"|"$h/.ssh/"*|"$h/.gitconfig"|"$h/.gitconfig-"*|"$h/.config/git/config") return 0 ;;
    "$c"|"$(dirname "$c")"|"$(dirname "$c")/"*|"$dd"|"$dd/"*) return 0 ;;
    */.git/config|*/.git/hooks|*/.git/hooks/*) return 0 ;;
  esac
  return 1
}

g_sensitive_key() {
  case "$1" in
    user.*|author.*|committer.*|gitswitch.*|core.hookspath|hook.*|url.*|includeif.*|include.*|core.sshcommand) return 0 ;;
    remote.*.url|remote.*.pushurl|alias.*|gpg.*|commit.gpgsign) return 0 ;;
  esac
  return 1
}

g_push_mode() {   # gitsw.aiPush → ask(매번 확인) | branch(기본/보호 브랜치만 확인) | allow(확인 안 함)
  local p; p=$(lower "$(git config -f "$CFG" --get gitsw.aipush 2>/dev/null)")
  case "$p" in allow|branch) printf '%s' "$p" ;; *) printf 'ask' ;; esac
}
g_cur_branch() { git -C "$G_CWD" symbolic-ref --short HEAD 2>/dev/null; }
g_remote_default() {   # $1 원격 → 그 원격의 기본 브랜치 (모르면 main)
  local r="${1:-origin}" d
  d=$(git -C "$G_CWD" symbolic-ref --short "refs/remotes/$r/HEAD" 2>/dev/null)
  if [ -n "$d" ]; then printf '%s' "${d#"$r"/}"; return 0; fi
  for d in main master; do
    git -C "$G_CWD" show-ref -q --verify "refs/remotes/$r/$d" 2>/dev/null && { printf '%s' "$d"; return 0; }
  done
  printf 'main'
}

g_push_check() {   # $1 설명 $2 원격 $3.. 올라갈 브랜치 (빈 값 = 알 수 없음)
  local what="$1" remote="${2:-origin}" mode b def
  shift 2
  mode=$(g_push_mode)
  case "$mode" in
    allow) return 0 ;;
    branch)
      if [ $# -eq 0 ]; then g_decide ask "$what — 어느 브랜치로 올라가는지 알 수 없어 사용자 확인을 받습니다."; return 0; fi
      def=$(g_remote_default "$remote")
      for b in "$@"; do
        if [ -z "$b" ] || [ "$b" = "$def" ] || [ "$b" = main ] || [ "$b" = master ] || \
           git -C "$G_CWD" config --get-all gitswitch.protect 2>/dev/null | grep -qx -- "$b"; then
          g_decide ask "$what — 기본/보호 브랜치(${b:-?})에 올리기 전에 사용자 확인을 받습니다. (작업 브랜치는 확인 없이 push 됩니다)"
          return 0
        fi
      done
      return 0 ;;
    *) g_decide ask "$what — 원격에 올리기 전에 사용자 확인을 받습니다. (작업 브랜치는 자동으로 하려면 사용자가: gitch config set gitsw.aiPush branch)" ;;
  esac
}

g_pr_check() {   # PR/MR 생성: allow 가 아니면 확인
  [ "$(g_push_mode)" = allow ] && return 0
  g_decide ask "$1 — PR/MR 을 만들기 전에 사용자 확인을 받습니다."
}

guard_env() {   # NAME=값
  local name="${1%%=*}"
  G_ENVS="$G_ENVS $name"
  case "$name" in
    GITCH_FLOW|GITCH_FLOW_NO_KEYSTORE|GITCH_FLOW_CACHE|GITCH_FLOW_DETACHED|GITCH_FLOW_OUT_DIR|GITCH_FLOW_GIT|GITCH_PATH|GITCH_BASH|GITCH_DOCKER)
      g_decide deny "흐름 엔진의 위치 · 동작을 바꾸는 환경변수($name)는 AI 가 쓸 수 없습니다. 필요하면 사용자에게 요청하세요." ;;
    GITSW_SKIP|GITSW_ALLOW_FORCE|GITSW_CONFIG|GITSW_ACTOR|GITSW_INTERNAL|GITSW_NOLOG_PUSH)
      g_decide deny "gitch 검사를 바꾸는 환경변수($name)는 AI 가 쓸 수 없습니다. 필요하면 사용자에게 요청하세요." ;;
    GIT_AUTHOR_NAME|GIT_AUTHOR_EMAIL|GIT_COMMITTER_NAME|GIT_COMMITTER_EMAIL|GIT_SSH|GIT_SSH_COMMAND|GIT_CONFIG|GIT_CONFIG_GLOBAL|GIT_CONFIG_SYSTEM|GIT_CONFIG_NOSYSTEM|GIT_CONFIG_COUNT|GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*|GIT_CONFIG_PARAMETERS)
      g_decide deny "환경변수($name)로 작성자/SSH/git 설정을 바꾸면 gitch 검사를 우회하게 됩니다. 'gitch use <계정>' 을 쓰세요." ;;
  esac
}

guard_git_cfgkv() {   # "키=값"
  local k; k=$(lower "${1%%=*}")
  g_sensitive_key "$k" && g_decide deny "git -c $k 로 계정/훅/주소 설정을 바꿀 수 없습니다 (gitch 검사 우회)."
  return 0
}

guard_git_commit() {
  local i=$1 n=${#GW[@]} w c j
  while [ $i -lt $n ]; do
    w=${GW[$i]}
    case "$w" in
      --no-verify) g_decide deny "--no-verify 는 쓸 수 없습니다 (gitch 검사 우회). 검사에 걸리면 그 메시지를 사용자에게 보고하세요." ;;
      --amend) g_decide ask "마지막 커밋을 고칩니다 (amend). 사용자가 요청한 경우에만 하세요." ;;
      --author|--author=*) g_decide ask "다른 작성자로 커밋합니다 (--author)." ;;
      -m|-F|-c|-C|-t|--message|--file|--template|--reuse-message|--reedit-message|--fixup|--squash|--trailer|--date|--cleanup|--pathspec-from-file) i=$((i+1)) ;;
      --) break ;;
      --*) ;;
      -?*)
        j=1
        while [ $j -lt ${#w} ]; do
          c=${w:$j:1}
          case "$c" in
            n) g_decide deny "--no-verify(-n) 는 쓸 수 없습니다 (gitch 검사 우회)."; break ;;
            m|F|c|C|t) [ $((j+1)) -eq ${#w} ] && i=$((i+1)); break ;;
            S|u) break ;;
          esac
          j=$((j+1))
        done ;;
    esac
    i=$((i+1))
  done
}

guard_git_push() {
  local i=$1 n=${#GW[@]} w c j force="" del="" big="" tags="" pos=() dests=() r d
  while [ $i -lt $n ]; do
    w=${GW[$i]}
    case "$w" in
      --no-verify) g_decide deny "--no-verify 는 쓸 수 없습니다 (gitch push 검사 우회)." ;;
      -f|--force|--force-with-lease|--force-with-lease=*|--force-if-includes) force=1 ;;
      -d|--delete) del=1 ;;
      --mirror|--all|--branches|--prune) big=1 ;;
      --tags) tags=1 ;;
      -o|--push-option|--repo|--receive-pack|--exec) i=$((i+1)) ;;
      --*) ;;
      -?*)
        j=1
        while [ $j -lt ${#w} ]; do
          c=${w:$j:1}
          case "$c" in f) force=1 ;; d) del=1 ;; o) [ $((j+1)) -eq ${#w} ] && i=$((i+1)); break ;; esac
          j=$((j+1))
        done ;;
      *) pos+=("$w") ;;
    esac
    i=$((i+1))
  done
  # 첫 번째는 원격, 나머지는 refspec (+ 는 강제, :브랜치 는 삭제, 원본:대상)
  for r in "${pos[@]:1}"; do
    case "$r" in +*) force=1; r=${r#+} ;; esac
    case "$r" in
      :*) del=1; continue ;;
      *:*) d=${r#*:} ;;
      *) d=$r ;;
    esac
    case "$d" in
      HEAD|@) d=$(g_cur_branch) ;;
      refs/heads/*) d=${d#refs/heads/} ;;
      refs/*) tags=1; continue ;;
    esac
    dests+=("$d")
  done
  [ ${#pos[@]} -le 1 ] && dests=("$(g_cur_branch)")   # 브랜치를 안 적으면 지금 브랜치
  if [ -n "$force" ]; then g_decide deny "강제 push 는 'gitch p --force' 로만 합니다 (사용자 확인 필요). 원격에 새 커밋이 있으면 gitch pl 후 다시 push 하세요."
  elif [ -n "$del" ]; then g_decide ask "원격 브랜치/태그를 지웁니다."
  elif [ -n "$big" ]; then g_decide ask "여러 브랜치를 한 번에 push 합니다 (--mirror/--all/--prune)."
  elif [ -n "$tags" ]; then g_decide ask "태그/참조를 push 합니다."
  else g_push_check "git push" "${pos[0]:-origin}" "${dests[@]}"; fi
}

guard_git_config() {
  local i=$1 n=${#GW[@]} w scope="" write="" rd="" edit="" file="" pos=() key
  while [ $i -lt $n ]; do
    w=${GW[$i]}
    case "$w" in
      --global|--system) scope=global ;;
      --local|--worktree) ;;
      -f|--file) file=${GW[$((i+1))]:-}; i=$((i+1)) ;;
      --file=*) file=${w#--file=} ;;
      --blob|--type|--default|--comment|--value|--url) i=$((i+1)) ;;
      --get|--get-all|--get-regexp|--get-urlmatch|--get-color|--get-colorbool|-l|--list|--show-origin|--show-scope|--name-only) rd=1 ;;
      --unset|--unset-all|--add|--replace-all|--rename-section|--remove-section) write=1 ;;
      -e|--edit) edit=1; write=1 ;;
      -*) ;;
      *) pos+=("$w") ;;
    esac
    i=$((i+1))
  done
  case "${pos[0]:-}" in
    get|list) rd=1; pos=("${pos[@]:1}") ;;
    set|unset|rename-section|remove-section) write=1; pos=("${pos[@]:1}") ;;
    edit) edit=1; write=1; pos=("${pos[@]:1}") ;;
  esac
  [ -z "$rd" ] && [ -z "$write" ] && [ ${#pos[@]} -ge 2 ] && write=1
  [ -z "$write" ] && return 0
  if [ -n "$file" ]; then
    g_protected "$file" && g_decide deny "$(tilde "$(g_path "$file")") 는 gitch 가 관리하는 설정 파일이라 직접 바꿀 수 없습니다."
    return 0
  fi
  if [ "$scope" = global ]; then g_decide deny "전역 git 설정(--global)은 gitch 가 관리합니다. 필요하면 사용자에게 요청하세요."; return 0; fi
  if [ -n "$edit" ]; then g_decide ask "저장소 git 설정을 편집합니다."; return 0; fi
  key=$(lower "${pos[0]:-}")
  g_sensitive_key "$key" && g_decide deny "작성자/원격/훅 설정($key)은 직접 바꾸지 말고 'gitch use <계정>' 을 쓰세요."
  return 0
}

guard_git_clone() {
  local i=$1 n=${#GW[@]} w url=""
  while [ $i -lt $n ]; do
    w=${GW[$i]}
    case "$w" in
      -c|--config) guard_git_cfgkv "${GW[$((i+1))]:-}"; i=$((i+2)); continue ;;
      --config=*) guard_git_cfgkv "${w#--config=}" ;;
      -b|--branch|-o|--origin|--depth|--reference|--reference-if-able|--separate-git-dir|-u|--upload-pack|-j|--jobs|--filter|--template|--shallow-since|--shallow-exclude|--bundle-uri|--server-option) i=$((i+2)); continue ;;
      -*) ;;
      *) [ -z "$url" ] && url=$w ;;
    esac
    i=$((i+1))
  done
  [ -z "$url" ] && return 0
  load_config >/dev/null 2>&1 || return 0
  parse_url "$url" || return 0
  host_is_managed "$U_HOST" || return 0
  D_ACC=""
  derive_account "$G_CWD" >/dev/null 2>&1
  if [ -n "$U_ALIAS" ] || [ "$U_KIND" = ssh ] || [ -n "$D_ACC" ] || [ "$U_HOST" != github.com ]; then
    g_decide deny "저장소는 'gitch clone ${D_ACC:+$D_ACC }$url' 로 받으세요 (계정 자동 선택 + 잠금)."
  fi
}

guard_git_checkout() {
  local i=$1 w dd=""
  for w in "${GW[@]:$i}"; do
    case "$w" in
      --) dd=1 ;;
      -f|--force) g_decide ask "git checkout --force 가 수정 내용을 버립니다." ;;
      .|./) g_decide ask "git checkout . 이 수정 내용을 되돌립니다." ;;
      -*) ;;
      *) [ -z "$dd" ] && [ -e "$(g_path "$w")" ] && [ -f "$(g_path "$w")" ] && g_decide ask "git checkout <파일> 이 그 파일의 수정 내용을 되돌립니다." ;;
    esac
  done
  [ -n "$dd" ] && g_decide ask "git checkout -- <파일> 이 수정 내용을 되돌립니다."
  return 0
}

guard_git_branch() {
  local w del="" force=""
  for w in "${GW[@]:$1}"; do
    case "$w" in
      -D) del=1; force=1 ;;
      -d|--delete) del=1 ;;
      -f|--force) force=1 ;;
      -M|-C) g_decide ask "브랜치를 강제로 이름변경/복사합니다." ;;
      --*) ;;
      -*) case "$w" in *D*) del=1; force=1 ;; esac ;;
    esac
  done
  [ -n "$del" ] && [ -n "$force" ] && g_decide ask "합쳐지지 않은 브랜치도 지웁니다 (git branch -D)."
  return 0
}

guard_git() {
  local i=$1 n=${#GW[@]} w sub
  local G_CWD="$G_CWD"   # git -C 는 이 명령에만 적용
  while [ $i -lt $n ]; do
    w=${GW[$i]}
    case "$w" in
      -C) G_CWD=$(g_path "${GW[$((i+1))]:-.}"); i=$((i+2)) ;;
      -c) guard_git_cfgkv "${GW[$((i+1))]:-}"; i=$((i+2)) ;;
      --config-env) guard_git_cfgkv "${GW[$((i+1))]:-}"; i=$((i+2)) ;;
      --config-env=*) guard_git_cfgkv "${w#--config-env=}"; i=$((i+1)) ;;
      --git-dir|--work-tree|--namespace|--exec-path|--super-prefix) i=$((i+2)) ;;
      -*) i=$((i+1)) ;;
      *) break ;;
    esac
  done
  [ $i -ge $n ] && return 0
  sub=${GW[$i]}; i=$((i+1))
  case "$sub" in
    commit) guard_git_commit $i ;;
    push) guard_git_push $i ;;
    reset) g_has $i --hard && g_decide ask "git reset --hard 는 수정 내용을 지웁니다. 사용자 확인이 필요합니다." ;;
    clean)
      local cw force="" dry=""
      for cw in "${GW[@]:$i}"; do
        case "$cw" in -n|--dry-run) dry=1 ;; -f|--force) force=1 ;; --*) ;; -*) case "$cw" in *n*) dry=1 ;; esac; case "$cw" in *f*) force=1 ;; esac ;; esac
      done
      [ -n "$force" ] && [ -z "$dry" ] && g_decide ask "git clean 이 추적 안 되는 파일을 지웁니다." ;;
    checkout) guard_git_checkout $i ;;
    restore)
      local rw staged="" worktree=""
      for rw in "${GW[@]:$i}"; do case "$rw" in -S|--staged) staged=1 ;; -W|--worktree) worktree=1 ;; -SW|-WS) staged=1; worktree=1 ;; esac; done
      { [ -z "$staged" ] || [ -n "$worktree" ]; } && g_decide ask "git restore 가 수정 내용을 되돌립니다." ;;
    switch) { g_has $i --discard-changes || g_has $i -f || g_has $i --force; } && g_decide ask "git switch 가 수정 내용을 버립니다." ;;
    branch) guard_git_branch $i ;;
    stash) case "${GW[$i]:-}" in drop|clear) g_decide ask "stash 를 지웁니다 (git stash ${GW[$i]})." ;; esac ;;
    remote) case "${GW[$i]:-}" in add|set-url|rename|remove|rm) g_decide ask "원격 주소를 바꿉니다. 계정 전환은 'gitch use <계정>' 이 안전합니다." ;; esac ;;
    config) guard_git_config $i ;;
    clone) guard_git_clone $i ;;
    filter-branch|filter-repo|replace) g_decide ask "git $sub 는 기록을 다시 씁니다. 사용자 확인이 필요합니다." ;;
    update-ref) { g_has $i -d || g_has $i --stdin; } && g_decide ask "git update-ref 로 참조를 지우거나 바꿉니다." ;;
    reflog) case "${GW[$i]:-}" in expire|delete) g_decide ask "reflog 를 지우면 복구가 어려워집니다." ;; esac ;;
    gc) g_has_prefix $i --prune && g_decide ask "git gc --prune 은 복구 가능한 기록을 지웁니다." ;;
    worktree) [ "${GW[$i]:-}" = remove ] && { g_has $i -f || g_has $i --force; } && g_decide ask "수정 중인 워크트리를 강제로 지웁니다." ;;
  esac
  return 0
}

guard_gitsw() {
  local i=$1 sub="${GW[$1]:-}" rest=() lock acc k o
  rest=("${GW[@]:$((i+1))}")
  case "$sub" in
    unlock) g_decide ask "저장소 계정 잠금을 풉니다. 사용자가 명시적으로 요청한 경우에만 하세요." ;;
    use)
      acc=${rest[0]:-}
      case "$acc" in ""|-*) return 0 ;; esac
      lock=$(git -C "$G_CWD" config --get gitswitch.account 2>/dev/null)
      [ -n "$lock" ] && [ "$lock" != "$acc" ] && g_decide ask "잠긴 저장소($lock)의 계정을 $acc 로 바꿉니다. 사용자가 요청한 경우에만 하세요." ;;
    p|push|cp)
      if g_in_list --force "${rest[@]}" || g_in_list -f "${rest[@]}" || g_in_list --force-with-lease "${rest[@]}"; then
        g_decide ask "강제 push(원격의 기존 커밋 덮어쓰기)입니다. 사용자 확인이 필요합니다."
      else g_push_check "gitch $sub" origin "$(g_cur_branch)"; fi ;;
    pr|mr) case "${rest[0]:-}" in status|view) ;; *) g_pr_check "gitch $sub" ;; esac ;;
    fix) g_in_list --yes "${rest[@]}" && g_decide ask "push 안 한 커밋의 작성자를 고칩니다 (기록 다시 쓰기)." ;;
    undo) g_decide ask "마지막 커밋을 취소합니다. 사용자가 요청한 경우에만 하세요." ;;
    amend) g_decide ask "마지막 커밋을 고칩니다. 사용자가 요청한 경우에만 하세요." ;;
    abort) g_decide ask "진행 중인 rebase/merge 를 취소합니다 (고치던 충돌 내용이 사라짐)." ;;
    rescue) g_in_list --restore "${rest[@]}" && g_decide ask "백업 시점으로 브랜치를 되돌립니다." ;;
    prune) g_in_list --yes "${rest[@]}" && g_decide ask "로컬 브랜치를 지웁니다." ;;
    scan) g_in_list --fix "${rest[@]}" && g_decide ask "여러 저장소의 계정 설정을 한 번에 고칩니다." ;;
    wt|worktree) [ "${rest[0]:-}" = rm ] && g_in_list --force "${rest[@]}" && g_decide ask "수정 중인 워크트리를 강제로 지웁니다." ;;
    add|remove|rm|setup|import) g_decide deny "'gitch $sub' 는 사용자가 터미널에서 직접 실행해야 합니다." ;;
    flow|test)
      case " $G_ENVS " in
        *" HOME "*|*" XDG_CONFIG_HOME "*|*" XDG_STATE_HOME "*|*" CI "*)
          g_decide deny "흐름 실행의 설정 위치 · CI 여부를 환경변수로 바꿀 수 없습니다(신뢰 · 서명 우회)." ;;
      esac
      case "$sub:${rest[0]:-}" in
        flow:trust) g_in_list --show "${rest[@]}" || g_in_list --revoke "${rest[@]}" || g_decide deny "흐름 파일 신뢰는 사람이 터미널에서 'gitch flow trust' 로 승인합니다." ;;
        flow:hold) [ "${rest[1]:-}" = release ] && g_decide deny "잠긴 환경(hold)은 사람이 상태를 확인한 뒤 직접 풉니다." ;;
        flow:connect) case "${rest[1]:-list}" in list|ls|test) ;; *) g_decide ask "흐름 연결(CI 주소 · 인증)을 바꿉니다." ;; esac ;;
        flow:init|flow:export|flow:import) g_in_list --force "${rest[@]}" && g_decide ask "이미 있는 흐름 · CI 파일을 덮어씁니다." ;;
        flow:run|flow:rerun|flow:watch|test:*)
          { g_in_list --yes "${rest[@]}" || g_in_list -y "${rest[@]}"; } && g_decide ask "흐름의 사람 확인 단계를 --yes 로 건너뜁니다. 사용자가 확인했을 때만 쓰세요." ;;
      esac ;;
    ci) case "${rest[0]:-}" in ""|status|logs|report) ;; *) g_decide ask "원격 CI 를 실행하거나 취소합니다." ;; esac ;;
    sign) case "${rest[0]:-}" in on|off) g_decide deny "'gitch sign ${rest[0]}' 은 사용자가 터미널에서 직접 실행해야 합니다." ;; esac ;;
    org) case "${rest[0]:-list}" in list|ls) ;; *) g_decide ask "gitch 조직 규칙을 바꿉니다." ;; esac ;;
    config) case "${rest[0]:-show}" in path|show|cat|get|check) ;; *) g_decide ask "gitch 설정을 바꿉니다." ;; esac ;;
    protect) [ ${#rest[@]} -gt 0 ] && [ "${rest[0]}" != --list ] && g_decide ask "보호 브랜치 설정을 바꿉니다." ;;
    ignore) g_decide ask "이 저장소의 gitch 검사를 끄거나 켭니다." ;;
    install|auto|uninstall|migrate) g_decide ask "gitch 전역 설정(gitconfig, 훅, AI 규칙 등)을 바꿉니다." ;;
    self-update) g_decide ask "gitch 를 릴리스에서 받은 새 버전으로 바꿉니다." ;;
    publish) g_decide ask "원격 저장소를 새로 만들고 push 합니다." ;;
    ai) case "${rest[0]:-}" in --print|--skill) ;; *) g_decide ask "AI 도구 설정(CLAUDE.md, settings.json 등)을 바꿉니다." ;; esac ;;
    ssh) g_decide ask "~/.ssh/config 를 정리합니다." ;;
    graph|g)   # 읽기 명령(허용 목록)이지만 --out(과 check --init 의 --rules)으로 gitch 가 관리하는 파일을 쓰지 못하게 (g 는 graph 의 짧은 이름)
      for ((k = 0; k < ${#rest[@]}; k++)); do
        o=""
        case "${rest[$k]}" in
          --out|-o) o=${rest[$((k + 1))]:-} ;;
          --out=*) o=${rest[$k]#--out=} ;;
          --rules|-r) case " ${rest[*]} " in *" --init "*) o=${rest[$((k + 1))]:-} ;; esac ;;
          --rules=*) case " ${rest[*]} " in *" --init "*) o=${rest[$k]#--rules=} ;; esac ;;
        esac
        [ -n "$o" ] && g_protected "$o" && g_decide deny "$(tilde "$(g_path "$o")") 는 gitch 가 관리하는 파일이라 gitch graph 로 쓸 수 없습니다."
      done ;;
  esac
  return 0
}

guard_fileops() {   # $1 프로그램 $2 시작 위치
  local prog="$1" i=$2 n=${#GW[@]} w inplace="" targets=() last=""
  while [ $i -lt $n ]; do
    w=${GW[$i]}
    case "$w" in
      $'\036'*) ;;
      -i|-i*|--in-place*|-pi|-pi*) inplace=1 ;;
      of=*) targets+=("${w#of=}"); last=${w#of=} ;;
      -*) ;;
      *) targets+=("$w"); last=$w ;;
    esac
    i=$((i+1))
  done
  case "$prog" in
    sed|gsed|perl) [ -z "$inplace" ] && return 0 ;;
    cp|rsync|install|ln) targets=("$last") ;;
  esac
  for w in "${targets[@]}"; do
    [ -n "$w" ] || continue
    if g_protected "$w"; then
      g_decide deny "$(tilde "$(g_path "$w")") 는 gitch 가 관리하는 파일입니다. 직접 바꾸지 말고 gitch 명령을 쓰거나 사용자에게 요청하세요."
      return 0
    fi
  done
}

guard_simple() {   # GW 배열(단순 명령 하나) 검사
  local n=${#GW[@]} i=0 w prog
  G_ENVS=""
  for w in "${GW[@]}"; do
    case "$w" in
      $'\036'*) g_protected "${w#$'\036'}" && g_decide deny "$(tilde "$(g_path "${w#$'\036'}")") 는 gitch 가 관리하는 파일이라 직접 쓸 수 없습니다." ;;
    esac
  done
  while [ $i -lt $n ]; do
    w=${GW[$i]}
    case "$w" in
      $'\036'*|if|then|else|elif|fi|do|done|while|until|'{'|'}'|'!'|time|nohup|command|builtin|exec|noglob|'[['|xargs) i=$((i+1)); continue ;;
      sudo|doas) i=$((i+1)); while [ $i -lt $n ] && [ "${GW[$i]#-}" != "${GW[$i]}" ]; do i=$((i+1)); done; continue ;;
      env)
        i=$((i+1))
        while [ $i -lt $n ]; do
          case "${GW[$i]}" in -u|--unset|-C|--chdir) i=$((i+2)) ;; -*) i=$((i+1)) ;; *=*) guard_env "${GW[$i]}"; i=$((i+1)) ;; *) break ;; esac
        done
        continue ;;
      nice|timeout|caffeinate|stdbuf)
        i=$((i+1))
        while [ $i -lt $n ]; do case "${GW[$i]}" in -*|[0-9]*) i=$((i+1)) ;; *) break ;; esac; done
        continue ;;
      *=*)
        case "${w%%=*}" in ""|[0-9]*|*[!A-Za-z0-9_]*) break ;; esac
        guard_env "$w"; i=$((i+1)); continue ;;
      *) break ;;
    esac
  done
  [ $i -ge $n ] && return 0
  prog=${GW[$i]##*/}
  i=$((i+1))
  case "$prog" in
    git) guard_git $i ;;
    gitch|gitsw) guard_gitsw $i ;;   # gitsw 는 예전 이름(같은 명령)
    cd|pushd) [ $i -lt $n ] && case "${GW[$i]}" in -*) ;; *) G_CWD=$(g_path "${GW[$i]}") ;; esac ;;
    export|declare|typeset|local|readonly)
      while [ $i -lt $n ]; do case "${GW[$i]}" in *=*) guard_env "${GW[$i]}" ;; esac; i=$((i+1)); done ;;
    cp|mv|rm|ln|tee|sed|gsed|perl|chmod|chown|truncate|install|rsync|dd|touch|unlink|shred) guard_fileops "$prog" $i ;;
    ssh-keygen)
      g_has $i -l || g_has $i -y || g_has $i -F || g_has $i -Y || g_has $i -L || g_has $i -lf || \
        g_decide ask "SSH 키를 만들거나 바꿉니다. 계정 키는 사용자가 'gitch setup' 으로 관리합니다." ;;
    ssh-add) { g_has $i -D || g_has $i -d || g_has $i -x || g_has $i -X; } && g_decide ask "ssh-agent 의 키를 지우거나 잠급니다." ;;
  esac
  return 0
}

guard_bash() {   # $1 명령 문자열
  local line
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    GW=()
    IFS=$'\037' read -r -a GW <<< "$line"
    guard_simple
  done < <(printf '%s\n' "$1" | awk "$GUARD_AWK")
}

guard_file_edit() {   # Edit/Write 도구의 파일 경로
  local p="$1"
  [ -z "$p" ] && return 0
  if g_protected "$p"; then
    g_decide deny "$(tilde "$(g_path "$p")") 는 gitch 가 관리하는 파일이라 직접 고칠 수 없습니다. gitch 명령을 쓰거나 사용자에게 요청하세요."
    return 0
  fi
  [ "$(g_path "$p")" = "$CLAUDE_DIR/settings.json" ] && g_decide ask "Claude Code 설정(~/.claude/settings.json)을 바꿉니다. gitch 검사 훅이 빠지지 않게 주의하세요."
  return 0
}

guard_cmd() {   # gitch guard --claude  (Claude Code PreToolUse 훅)
  [ "${1:-}" = --claude ] || die "사용법: gitch guard --claude  (Claude Code 훅 전용, 표준입력 JSON)"
  local input tool="" cwd="" arg=""
  input=$(cat)
  command -v jq >/dev/null 2>&1 || return 0
  case "$input" in *git*|*GIT*|*.ssh*|*ssh-*|*hooks*) ;; *) return 0 ;; esac
  { IFS= read -r -d '' tool; IFS= read -r -d '' cwd; IFS= read -r -d '' arg; } < <(printf '%s' "$input" | \
    jq -j '(.tool_name // ""), "\u0000", (.cwd // ""), "\u0000", (.tool_input.command // .tool_input.file_path // .tool_input.notebook_path // ""), "\u0000"' 2>/dev/null)
  G_DEC=""; G_REASON=""; G_CWD=$(posix_path "${cwd:-$PWD}")
  case "$tool" in
    Bash) guard_bash "$arg" ;;
    Edit|Write|MultiEdit|NotebookEdit) guard_file_edit "$arg" ;;
    *) return 0 ;;
  esac
  [ -z "$G_DEC" ] && return 0
  jq -cn --arg d "$G_DEC" --arg r "[gitch] $G_REASON" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: $d, permissionDecisionReason: $r}}'
  return 0
}


