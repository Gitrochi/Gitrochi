      if (substr(s, p + 1, 2) == "<<") { p += 2; skipnext = 1; continue }
      if (substr(s, p + 1, 1) == "<") { p++; if (substr(s, p + 1, 1) == "-") p++; skipnext = 1; continue }
      if (substr(s, p + 1, 1) == "(") { endc(); p++; continue }
      skipnext = 1; continue
    }
