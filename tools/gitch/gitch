read -r -d '' REPORT_AWK <<'AWKEOF'
function jget(l, k,   re, v) {
  re = "\"" k "\":\"([^\"\\\\]|\\\\.)*\""
  if (match(l, re)) {
    v = substr(l, RSTART + length(k) + 4, RLENGTH - length(k) - 5)
    gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v)
    return v
  }
  return ""
}
{
  ts = jget($0, "ts"); if (ts < s) next
  ev = jget($0, "event"); ac = jget($0, "actor"); repo = jget($0, "repo"); acc = jget($0, "account")
  if (index(repo, home) == 1) repo = "~" substr(repo, length(home) + 1)
  if (repo == "") repo = "(저장소 밖)"
  cnt[ac SUBSEP ev]++; actors[ac] = 1
  if (!(repo in seen)) { seen[repo] = 1; order[++nr] = repo }
  det = ""
  if (ev == "commit") det = jget($0, "sha") " \"" jget($0, "subject") "\""
  else if (ev == "push") det = jget($0, "remote")
  else if (ev == "pr" || ev == "clone") det = jget($0, "url")
  else if (ev == "fix") det = jget($0, "count") "개"
  t = substr(ts, 6, 5) " " substr(ts, 12, 5)
  rows[repo] = rows[repo] sprintf("    %s  %-7s %-8s %-12s %s\n", t, ac, ev, acc, det)
  total++
}
END {
  if (total == 0) { print "기록 없음 (" s " 이후)"; exit }
  print "gitch 작업 기록 (" s " 이후, " total "건)"
  for (a in actors) {
    line = "  " a ":"
    for (k in cnt) { split(k, p, SUBSEP); if (p[1] == a) line = line " " p[2] " " cnt[k] }
    print line
  }
  for (i = 1; i <= nr; i++) { print ""; print "  " order[i]; printf "%s", rows[order[i]] }
}
AWKEOF

report_cmd() {   # [--today | --days N | --since YYYY-MM-DD] [--json]
  local since json=""
  since=$(date +%Y-%m-%d)
  while [ $# -gt 0 ]; do
    case "$1" in
      --today) since=$(date +%Y-%m-%d) ;;
      --days) shift; is_number "$1" || die "--days 뒤에 숫자가 필요합니다."; since=$(date -v-"$1"d +%Y-%m-%d 2>/dev/null || date -d "-$1 days" +%Y-%m-%d) ;;
      --since) shift; since="$1" ;;
      --json) json=1 ;;
      *) die "사용법: gitch report [--today | --days N | --since YYYY-MM-DD] [--json]" ;;
    esac
    shift
  done
  if [ ! -f "$ACTION_LOG" ]; then
    if [ -n "$json" ]; then echo "[]"; else say "아직 기록이 없습니다. ($(tilde "$ACTION_LOG"))"; fi
    return 0
  fi
  if [ -n "$json" ]; then
    awk -v s="$since" 'BEGIN { printf "["; n = 0 } { if (match($0, /"ts":"[^"]*"/)) { ts = substr($0, RSTART + 6, RLENGTH - 7); if (ts >= s) { printf "%s%s", (n++ ? "," : ""), $0 } } } END { print "]" }' "$ACTION_LOG"
    return 0
  fi
  awk -v s="$since" -v home="$HOME" "$REPORT_AWK" "$ACTION_LOG"
}

version_cmd() {
  case "${1:-}" in
    --json) printf '{"schemaVersion":1,"tool":"gitch","version":%s,"versionScheme":%s,"graphApi":%s,"flowApi":%s}\n' "$(json_str "$GITSW_VERSION")" "$(json_str "$GITCH_VERSION_SCHEME")" "$GITCH_GRAPH_API" "$GITCH_FLOW_API"; return 0 ;;
    "") ;;
    *) die "사용법: gitch version [--json]" ;;
  esac
  say "gitch $GITSW_VERSION — $(tilde "$(self_path)")"
}

GITCH_RELEASES="Gitrochi/Gitrochi"   # 따로 받은 gitch 가 업데이트를 받는 곳 (tools/gitch/install.sh 와 같음)

# 릴리스 목록(GitHub API)에서 초안·시험판이 아니고 gitch 가 든 첫(가장 새) 릴리스 → "태그 주소"
# Windows 만 고친 릴리스가 최신일 수 있어서 releases/latest 를 쓰지 않는다. tools/gitch/install.sh 와 같은 내용.
RELEASE_AWK='
/^[[:space:]]*"tag_name":/ { tag = $0; sub(/^[^:]*:[[:space:]]*"/, "", tag); sub(/".*/, "", tag); skip = 0 }
/^[[:space:]]*"(draft|prerelease)":[[:space:]]*true/ { skip = 1 }
/^[[:space:]]*"browser_download_url":.*\/gitch"/ && !skip { url = $0; sub(/^[^:]*:[[:space:]]*"/, "", url); sub(/".*/, "", url); print tag, url; exit }'

curl_get() { curl -fsSL --connect-timeout 15 --max-time 120 "$@"; }
sha256_of() { { shasum -a 256 "$1" 2>/dev/null || sha256sum "$1"; } | awk '{ print $1 }'; }
ver_lt() {   # $1 이 $2 보다 낮은 버전인지 (3.0.9 < 3.0.10)
  local IFS=. i x y a b
  read -r -a a <<< "$1"; read -r -a b <<< "$2"
  for i in 0 1 2 3; do
    x=${a[$i]:-0}; y=${b[$i]:-0}
    is_number "$x" || x=0; is_number "$y" || y=0
    [ "$x" -lt "$y" ] && return 0
    [ "$x" -gt "$y" ] && return 1
  done
  return 1
}

self_update_cmd() {   # 따로 받은 gitch 만 바꾼다 — 앱에 든 것은 앱과 함께, 저장소(git)의 것은 그 저장소와 함께(git pull 은 앱 저장소 전체를 바꾸므로 하지 않음)
  local self dir
  self=$(self_path); dir=$(dirname "$self")
  case "$self" in
    *.app/Contents/*) ;;
    *) [ -f "$dir/Gitrochi.exe" ] || git -C "$dir" ls-files --error-unmatch -- "$(basename "$self")" >/dev/null 2>&1 || { self_update_standalone "$self"; return $?; } ;;
  esac
  say "gitch 는 Gitrochi 앱과 함께 업데이트됩니다(앱의 자동 업데이트). 저장소(tools/gitch)에서 쓰고 있다면 그 저장소를 직접 받으세요."
  say "지금: $(tilde "$self") (v$GITSW_VERSION)"
}

# Helper scripts come only from the selected gitch release directory and need their own matching checksum.
# Every download is verified before any installed file is promoted.
release_stage_helpers() {   # $1 staging directory $2 selected gitch URL $3 helper API (empty = historical optional release)
  local stage=$1 base=${2%/gitch} api=$3 name want have missing=""
  STAGED_HELPERS=""
  case "$api" in ""|1) ;; *) die "알 수 없는 그래프 도우미 배포 방식: $api" ;; esac
  for name in gitch-scip-index gitch-graph-watch; do
    if ! curl_get -o "$stage/$name" "$base/$name" 2>/dev/null; then
      [ -z "$api" ] || die "릴리스의 필수 도우미를 받지 못했습니다: $base/$name (설치 파일은 바꾸지 않았습니다)"
      rm -f "$stage/$name"; missing=1; continue
    fi
    curl_get -o "$stage/$name.sha256" "$base/$name.sha256" || die "도우미 체크섬을 받지 못했습니다: $name.sha256 (설치 파일은 바꾸지 않았습니다)"
    want=$(awk -v name="$name" '$2 == name || $2 == "*" name { print $1; exit }' "$stage/$name.sha256")
    have=$(sha256_of "$stage/$name")
    [ -n "$want" ] && [ "$want" = "$have" ] || die "SHA-256 이 $name.sha256 과 맞지 않아 설치 파일을 바꾸지 않았습니다."
    [ "$(head -1 "$stage/$name")" = '#!/usr/bin/env python3' ] || die "받은 파일이 그래프 도우미가 아닙니다: $name"
    if command -v python3 >/dev/null 2>&1; then
      python3 -c 'import ast,sys; ast.parse(open(sys.argv[1], encoding="utf-8").read())' "$stage/$name" 2>/dev/null || die "그래프 도우미 문법이 잘못되어 설치하지 않았습니다: $name"
    fi
    STAGED_HELPERS="$STAGED_HELPERS $name"
  done
  [ -z "$missing" ] || say "이전 릴리스에는 선택적 그래프 도우미가 없습니다. 기본 CLI는 설치하며 정밀 분석·자동 갱신은 도우미가 포함된 최신 Gitrochi 배포본에서 사용하세요."
}
release_promote() {   # $1 staging directory $2 destination directory $3 CLI destination basename
  local stage=$1 dir=$2 cli=$3 name rollback_name promoted="" existed=""
  mkdir "$stage/rollback" || die "업데이트 복구 폴더를 만들지 못했습니다."
  for name in $STAGED_HELPERS "$cli"; do
    [ ! -L "$dir/$name" ] && { [ ! -e "$dir/$name" ] || [ -f "$dir/$name" ]; } || die "도우미/CLI 대상이 링크나 폴더라 덮어쓰지 않았습니다: $dir/$name"
    if [ -f "$dir/$name" ]; then cp -p "$dir/$name" "$stage/rollback/$name" || die "기존 파일을 보존하지 못했습니다: $name"; existed="$existed $name"; fi
    if [ "$name" = "$cli" ]; then chmod 755 "$stage/gitch"; else chmod 755 "$stage/$name"; fi || die "실행 권한을 설정하지 못했습니다: $name"
  done
  # Helpers first, CLI last. All checksums and rollback copies already passed.
  for name in $STAGED_HELPERS "$cli"; do
    if { [ "$name" = "$cli" ] && mv -f "$stage/gitch" "$dir/$name"; } || { [ "$name" != "$cli" ] && mv -f "$stage/$name" "$dir/$name"; }; then
      promoted="$promoted $name"
    else
      for rollback_name in $promoted; do
        case " $existed " in *" $rollback_name "*) mv -f "$stage/rollback/$rollback_name" "$dir/$rollback_name" ;; *) rm -f "$dir/$rollback_name" ;; esac
      done
      die "설치 파일 교체에 실패해 이전 파일로 되돌렸습니다."
    fi
  done
}

UPDATE_TMP=""
self_update_standalone() {   # $1 이 파일 — 릴리스의 gitch 를 gitch.sha256 과 맞춰 본 뒤 같은 폴더의 임시 파일 → mv (돌고 있는 셸은 원래 파일을 계속 읽음)
  local self="$1" dir json tag url want have new scheme helper_api
  dir=$(dirname "$self")
  command -v curl >/dev/null 2>&1 || die "curl 이 필요합니다."
  json=$(curl_get -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$GITCH_RELEASES/releases?per_page=20") \
    || die "릴리스 목록을 받지 못했습니다: https://github.com/$GITCH_RELEASES/releases"
  read -r tag url <<< "$(printf '%s\n' "$json" | tr ',' '\n' | awk "$RELEASE_AWK")"
  [ -n "$url" ] || die "gitch 가 든 릴리스가 아직 없습니다: https://github.com/$GITCH_RELEASES/releases"
  UPDATE_TMP=$(mktemp -d "$dir/.gitch-update.XXXXXX") || die "$(tilde "$dir") 에 쓸 수 없어 바꾸지 못했습니다."
  trap 'rm -rf "$UPDATE_TMP"' EXIT
  curl_get -o "$UPDATE_TMP/gitch" "$url" && curl_get -o "$UPDATE_TMP/gitch.sha256" "$url.sha256" || die "받지 못했습니다: $url"
  want=$(awk '$2 == "gitch" || $2 == "*gitch" { print $1; exit }' "$UPDATE_TMP/gitch.sha256")
  have=$(sha256_of "$UPDATE_TMP/gitch")
  [ -n "$want" ] && [ "$want" = "$have" ] || die "SHA-256 이 gitch.sha256 과 맞지 않아 바꾸지 않았습니다 ($tag)"
  new=$(sed -n 's/^GITSW_VERSION="\([^"]*\)".*/\1/p' "$UPDATE_TMP/gitch" | head -1)
  [ -n "$new" ] && "${BASH:-bash}" -n "$UPDATE_TMP/gitch" 2>/dev/null || die "받은 파일이 gitch 가 아닙니다: $url"
  scheme=$(sed -n 's/^GITCH_VERSION_SCHEME="\([^"]*\)".*/\1/p' "$UPDATE_TMP/gitch" | head -1)
  if [ "$scheme" = gitrochi ]; then
    [ "$new" = "${tag#v}" ] || die "릴리스 태그($tag)와 gitch 버전($new)이 달라 바꾸지 않았습니다."
  elif [ -n "$scheme" ]; then
    die "알 수 없는 gitch 버전 방식($scheme)이라 바꾸지 않았습니다."
  elif [ "${GITCH_VERSION_SCHEME:-}" = gitrochi ]; then
    say "릴리스 $tag 는 이전 독립 CLI 버전 방식이라 그대로 뒀습니다. Gitrochi 와 같은 버전의 릴리스를 기다리세요."
    return 0
  fi
  if { [ "$scheme" != gitrochi ] || [ "${GITCH_VERSION_SCHEME:-}" = gitrochi ]; } && ver_lt "$new" "$GITSW_VERSION"; then
    say "지금 gitch($GITSW_VERSION)가 릴리스 $tag 의 gitch($new)보다 새 버전이라 그대로 뒀습니다."
    return 0
  fi
  helper_api=$(sed -n 's/^GITCH_HELPER_API="\([^"]*\)".*/\1/p' "$UPDATE_TMP/gitch" | head -1)
  release_stage_helpers "$UPDATE_TMP" "$url" "$helper_api"
  if [ "$have" = "$(sha256_of "$self")" ]; then
    release_promote "$UPDATE_TMP" "$dir" "$(basename "$self")"
    ok "이미 최신입니다: gitch $GITSW_VERSION ($tag)"; return 0
  fi
  release_promote "$UPDATE_TMP" "$dir" "$(basename "$self")"
  ok "gitch $GITSW_VERSION → $new ($tag): $(tilde "$self")"
  dim "  AI 규칙·스킬·검사 훅도 새 버전으로 쓰려면: gitch install"
  log_action self-update "from=$GITSW_VERSION" "to=$new" "release=$tag"
}

# ================= 데스크톱 앱 =================

APP_USAGE='사용법: gitch app [저장소|폴더] [--repo 폴더] [--file 상대경로] [--line 줄] [--commit 해시] [--view 보기] [--path 앱경로]
  Gitrochi 데스크톱 앱을 엽니다 (macOS · Windows).
  앱에 든 CLI 는 함께 배포된 앱을, 소스 저장소의 CLI 는 개발 빌드를 먼저 엽니다.
  그 밖에는 사용자/시스템에 설치한 Gitrochi 를 찾습니다.
  --path 앱경로  직접 지정: macOS 의 Gitrochi.app 또는 Windows 의 Gitrochi.exe
  --repo 폴더    지정한 저장소를 앱의 탭으로 엽니다 (저장소 이름도 가능).
  --file 경로    저장소 안의 파일 히스토리를 엽니다. --line N 은 blame 의 해당 줄로 이동합니다.
  --view 보기    graph · files · modules · changes · tree · affected · precise · diff (diff 는 --file 필요)
  --commit 해시  전체 커밋 해시(40/64자)로 이동. --file 도 주면 그 커밋의 파일 diff 를 엽니다.
  예: gitch app .
      gitch app --repo ~/code/project --file src/main.ts --line 25
      gitch app --path "/Applications/Gitrochi.app"'

# URL 쿼리는 UTF-8 바이트 단위로 인코딩한다. 셸·PowerShell 코드에 경로를 넣지 않는다.
app_urlencode() {
  local LC_ALL=C input=$1 char i byte
  for ((i=0; i<${#input}; i++)); do
    char=${input:i:1}
    case "$char" in [a-zA-Z0-9.~_-]) printf '%s' "$char" ;; *) printf -v byte '%d' "'$char"; printf '%%%02X' "$((byte & 255))" ;; esac
  done
}

app_route() { # 저장소 · 상대 파일 · 줄 · 보기 · 커밋 → APP_ROUTE
  local repo=$1 file=$2 line=$3 view=$4 commit=$5 parent native
  APP_ROUTE=""
  [ -n "$repo$file$line$view$commit" ] || return 0
  graph_pick_dir "${repo:-.}"
  repo=$(git -C "$GRAPH_DIR" rev-parse --show-toplevel) || return 1
  repo=$(real_dir "$repo") || return 1
  if [ -n "$file" ]; then
    case "$file" in /*|*\\*|*:*|../*|*/../*|*/..|..|./*|*/./*|*/.|.|*$'\n'*|*$'\r'*) die "--file 은 저장소 안의 상대 파일 경로여야 합니다: $file" ;; esac
    # 사라진 파일도 이력을 열 수 있다. 존재하는 부모/심볼릭 링크가 밖을 가리키면 거부한다.
    parent="$repo/$file"
    if [ -L "$parent" ]; then die "--file 에 심볼릭 링크 파일을 지정할 수 없습니다: $file"; fi
    while [ ! -d "$parent" ] && [ "$parent" != / ]; do parent=$(dirname "$parent"); done
    parent=$(real_dir "$parent") || return 1
    case "$parent/" in "$repo/"*) ;; *) die "--file 이 저장소 밖을 가리킵니다: $file" ;; esac
  fi
  [ -z "$line" ] || { [ -n "$file" ] || die "--line 은 --file 과 함께 사용하세요."; }
  case "$line" in "") ;; *[!0-9]*|0|0*) die "--line 은 1 이상의 정수여야 합니다." ;; esac
  [ ${#line} -le 9 ] || die "--line 이 너무 큽니다."
  case "$view" in ""|graph|files|modules|changes|tree|affected|precise) ;; diff) [ -n "$file" ] || die "--view diff 는 --file 과 함께 사용하세요." ;; *) die "알 수 없는 보기: $view" ;; esac
  if [ -n "$commit" ]; then
    case "$commit" in *[!a-fA-F0-9]*) die "--commit 은 전체 커밋 해시(40/64자)여야 합니다." ;; esac
    [ ${#commit} -eq 40 ] || [ ${#commit} -eq 64 ] || die "--commit 은 전체 커밋 해시(40/64자)여야 합니다."
  fi
  native=$repo
  [ -z "$IS_WINDOWS" ] || native=$(cygpath -w "$repo" 2>/dev/null || printf '%s' "$repo")
  APP_ROUTE="gitrochi://open?repo=$(app_urlencode "$native")"
  [ -z "$file" ] || APP_ROUTE="$APP_ROUTE&file=$(app_urlencode "$file")"
  [ -z "$line" ] || APP_ROUTE="$APP_ROUTE&line=$line"
  [ -z "$view" ] || APP_ROUTE="$APP_ROUTE&view=$view"
  [ -z "$commit" ] || APP_ROUTE="$APP_ROUTE&commit=$commit"
}

app_candidate() {   # $1 후보 → APP_FOUND (경로를 코드로 해석하지 않는다)
  local p
  p=$(posix_path "$(expand_path "$1")")
  p=${p%/}
  if [ -n "$IS_WINDOWS" ]; then
    [ -f "$p" ] || return 1
    case "$p" in *.[eE][xX][eE]) ;; *) return 1 ;; esac
    APP_FOUND="$(real_dir "$(dirname "$p")")/$(basename "$p")"
  else
    case "$p" in *.[aA][pP][pP]) [ -d "$p/Contents/MacOS" ] || return 1 ;; *) return 1 ;; esac
    APP_FOUND=$(real_dir "$p")
  fi
}

app_find() {   # 번들 → 이 소스 저장소의 빌드 → 설치 위치
  local dir root candidate base
  APP_FOUND=""
  dir=$(dirname "$(self_path)")
  if [ -n "$IS_WINDOWS" ]; then
    app_candidate "$dir/Gitrochi.exe" && return 0
    case "$dir" in
      */tools/gitch)
        root=${dir%/tools/gitch}
        for candidate in "$root/windows/src-tauri/target/release/gitrochi.exe" "$root/windows/src-tauri/target/debug/gitrochi.exe"; do
          app_candidate "$candidate" && return 0
        done ;;
    esac
    for base in "${LOCALAPPDATA:-}" "$HOME/AppData/Local" "${PROGRAMFILES:-${ProgramFiles:-}}" "${PROGRAMW6432:-}"; do
      [ -n "$base" ] || continue
      base=$(posix_path "$base")
      app_candidate "${base%/}/Gitrochi/Gitrochi.exe" && return 0
      app_candidate "${base%/}/Programs/Gitrochi/Gitrochi.exe" && return 0
    done
  else
    case "$dir" in *.app/Contents/Resources) app_candidate "${dir%/Contents/Resources}" && return 0 ;; esac
    case "$dir" in */tools/gitch) app_candidate "${dir%/tools/gitch}/macos/build/Gitrochi.app" && return 0 ;; esac
    for candidate in "$HOME/Applications/Gitrochi.app" /Applications/Gitrochi.app; do
      app_candidate "$candidate" && return 0
    done
  fi
  return 1
}

app_cmd() {
  local explicit="" encoded native repo="" file="" line="" view="" commit="" key
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) say "$APP_USAGE"; return 0 ;;
      --path) [ $# -ge 2 ] && [ -n "$2" ] || die "--path 뒤에 앱 경로를 주세요."; explicit=$2; shift ;;
      --path=*) explicit=${1#--path=}; [ -n "$explicit" ] || die "--path 뒤에 앱 경로를 주세요." ;;
      --repo|--file|--line|--view|--commit)
        key=${1#--}; [ $# -ge 2 ] && [ -n "$2" ] || die "--$key 뒤에 값을 주세요."
        case "$key" in repo) [ -z "$repo" ] || die "저장소는 한 번만 지정하세요."; repo=$2 ;; file) file=$2 ;; line) line=$2 ;; view) view=$2 ;; commit) commit=$2 ;; esac; shift ;;
      --repo=*|--file=*|--line=*|--view=*|--commit=*)
        key=${1%%=*}; key=${key#--}; [ -n "${1#*=}" ] || die "--$key 뒤에 값을 주세요."
        case "$key" in repo) [ -z "$repo" ] || die "저장소는 한 번만 지정하세요."; repo=${1#*=} ;; file) file=${1#*=} ;; line) line=${1#*=} ;; view) view=${1#*=} ;; commit) commit=${1#*=} ;; esac ;;
      -*) die "알 수 없는 app 인자: $1"$'\n'"$APP_USAGE" ;;
      *) [ -z "$repo" ] || die "저장소는 한 번만 지정하세요."; repo=$1 ;;
    esac
    shift
  done
  if [ -z "$IS_WINDOWS" ]; then
    case "${GITSW_OS:-${OSTYPE:-}}" in darwin*) ;; *) die "gitch app 은 macOS · Windows 에서 지원합니다." ;; esac
  fi
  app_route "$repo" "$file" "$line" "$view" "$commit" || return 1
  if [ -n "$explicit" ]; then
    app_candidate "$explicit" || die "Gitrochi 앱을 찾을 수 없습니다: $explicit (gitch app --help)"
  else
    app_find || die "Gitrochi 앱을 찾을 수 없습니다. 앱을 설치하거나 gitch app --path <앱경로> 로 지정하세요."
  fi
  if [ -n "$IS_WINDOWS" ]; then
    native=$(cygpath -w "$APP_FOUND" 2>/dev/null || printf '%s' "$APP_FOUND")
    # 경로는 환경변수로 전달하고 PowerShell 코드는 고정한다 — 공백·따옴표·$ 등을 그대로 보존.
    encoded=$(printf '%s' '$ErrorActionPreference = "Stop"; try { if ($env:GITCH_APP_ROUTE) { Start-Process -FilePath $env:GITCH_APP_PATH -ArgumentList $env:GITCH_APP_ROUTE -ErrorAction Stop | Out-Null } else { Start-Process -FilePath $env:GITCH_APP_PATH -ErrorAction Stop | Out-Null }; exit 0 } catch { [Console]::Error.WriteLine($_.Exception.Message); exit 1 }' | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n') || return 1
    GITCH_APP_PATH="$native" GITCH_APP_ROUTE="$APP_ROUTE" "$PS_BIN" -NoProfile -NonInteractive -EncodedCommand "$encoded" || { err "Gitrochi 앱을 열지 못했습니다: $APP_FOUND"; return 1; }
  else
    if [ -n "$APP_ROUTE" ]; then open -a "$APP_FOUND" "$APP_ROUTE"; else open -a "$APP_FOUND"; fi || { err "Gitrochi 앱을 열지 못했습니다: $APP_FOUND"; return 1; }
  fi
  ok "Gitrochi 앱을 열었습니다: $(tilde "$APP_FOUND")"
}

# ================= 구조 그래프 =================
# gitch graph — tuist graph 처럼 저장소의 구조와 관계를 그린다. 사람은 html · svg · png 로 보고, AI · 스크립트는 json(nodes/edges)을 읽는다.
#   files    파일 → 파일 import. TS/JS · Python · Go · Rust · Kotlin/Java 는 import 문을 경로로 풀어 정확히 잇고,
#            Swift 는 파일끼리 import 하지 않으므로 다른 파일에 선언된 최상위 타입 이름을 쓰는지로 추정한다(heuristic 표시)
#   modules  모듈/타깃 의존: Package.swift · Tuist Project.swift · package.json · Cargo.toml · go.mod · Gradle
#   changes  git 기록에서 자주 같이 커밋되는 파일 쌍 + 바뀐 횟수(핫스팟)
#   tree     폴더 구조와 크기 · 파일 수
# 추적하는 파일(git ls-files)만 본다. 큰 저장소에서도 파일마다 프로세스를 띄우지 않게 언어 해석은 awk 한 번에 하고,
# 결과 레코드(0 통계·안내 / 1 노드 / 2 연결, 탭 구분)를 sort 로 순서를 고정한 뒤 json · dot 으로 바꾼다. html 은 json 을 품은 오프라인 한 페이지.

GRAPH_USAGE='사용법: gitch graph [files|modules|changes|tree] [--format html|json|svg|png|dot] [--out 파일] [--open|--no-open] [폴더|저장소]
       gitch graph diff [기준] …  ·  gitch graph review …  ·  gitch graph check …   (각각 --help, graph 는 짧게 g)
  files    여러 언어의 소스 파일과 import/include (Swift · JVM 타입 이름 참조는 추정) — 기본
  modules  모듈/타깃 의존 (SwiftPM · Tuist · npm · Cargo · Go · Gradle · Maven · Python · .NET · Composer · Bundler · Pub · CMake)
  changes  자주 같이 커밋되는 파일 쌍과 바뀐 횟수(핫스팟)
  tree     폴더 구조와 크기 · 파일 수
  --format   기본: 사람이 보는 터미널이면 html(만들고 열기), 아니면 json(표준출력). svg · png 는 graphviz 의 dot
  --out 파일 확장자로 형식을 고른다(- 는 표준출력). 없으면 html · svg · png 는 임시 폴더, json · dot 은 표준출력
  --json = --format json · --no-external 저장소 밖 패키지 · 모듈 빼기 · [폴더] 그 폴더 아래만
  [저장소]   폴더가 아니면 계정 폴더(설정의 folder) 바로 아래에서 그 이름의 저장소(대소문자 무시, 겹치면 계정/이름) —
             어디서든 gitch g my-app · 저장소 밖에서 그냥 부르면 계정 폴더의 저장소를 알려 준다
  --lang 언어[,언어]  그 언어만: java · ts · python · c · cpp · csharp · php · ruby 등 (web · jvm 묶음, 확장자·별칭도 가능)
  --precise / --index 파일  SCIP 컴파일러 인덱스의 실제 참조 추가 (Python 3 필요, 생성 방법: gitch g index --language ts|python|java)
  gitch g languages --json  언어별 파일 인식 · 정적 import · 모듈 · 정밀 분석 지원 수준
  gitch g affected [--base 기준]  변경 파일에서 역방향 의존을 따라 영향 파일·모듈 분석(삭제 전 연결 포함)
  gitch g watch [files|modules|changes|tree|precise|affected]  변경 시 브라우저 자동 갱신 (--detach --json, --interval 초)
  빠른 분석 결과는 추적 파일 내용으로 캐시한다. --no-cache로 다시 분석한다 (정밀 인덱스는 매번 유효성 확인).
  html 은 네 관계를 한 페이지에 담는다(위 탭으로 바꿈) — 파일 · 폴더 단위, 언어, 점 · 상자(다이어그램) 그리기, 필터,
       폴더 원(멀리서 접히고 가까이서 펼쳐짐), 분석(순환 의존 · 영향 범위 · 안 쓰는 것 · 핫스팟 · 숨은 결합 …), 노드 사이 경로
       연결 근거에서 파일·줄·커밋을 열고, 설정 > 저장한 보기에서 필터·배치·선택·확대 위치를 저장·가져오기·내보내기
  changes: --since 날짜 · --max-commits N(1000) · --max-files N(30, 더 큰 커밋은 뺌) · --min N(2)
       이름 변경 전 이력도 현재 파일로 합치며, 연결마다 근거 커밋(최신 20개)과 실제 분석 기간 · 잘린 이력을 표시
  tree: --depth N(0 = 끝까지) · --files(파일도 노드로)'

graph_rel_word() { case "$1" in files) echo "파일 import" ;; modules) echo "모듈 의존" ;; changes) echo "같이 바뀌는 파일" ;; *) echo "폴더 구조" ;; esac; }

graph_empty_hint() {   # $1 관계 $2 고른 언어
  [ -n "${2:-}" ] && { echo "고른 언어($2)로는 그릴 것이 없습니다 — --lang 을 빼거나 다른 언어를 고르세요."; return 0; }
  case "$1" in
    files) echo "그릴 파일이 없습니다 — 추적하는 소스 파일을 찾지 못했습니다 (Java · TS/JS · Python · C/C++ · C# · PHP 등)." ;;
    modules) echo "모듈 설정이 없습니다 — package.json · pom.xml · build.gradle(.kts) · pyproject.toml · requirements.txt · *.csproj · composer.json · Gemfile · pubspec.yaml · CMakeLists.txt · Package.swift 등을 찾지 못했습니다." ;;
    changes) echo "같이 바뀐 파일이 없습니다 — 커밋이 적거나 조건(--since · --min · --max-files)이 좁습니다." ;;
    *) echo "추적하는 파일이 없습니다." ;;
  esac
}

graph_find_repos() {   # $1 이름 [$2 계정] → 계정 폴더 바로 아래(없으면 한 단계 더 아래)에서 이름이 같은(대소문자 무시) 저장소, 줄마다 "계정<TAB>경로"
  local want=$1 only=${2:-} depth i root d out="" nc
  load_config >/dev/null 2>&1
  nc=$(shopt -p nocasematch); shopt -s nocasematch
  for depth in 1 2; do
    i=0
    while [ $i -lt ${#F_RAW[@]} ]; do
      root=$(expand_path "${F_RAW[$i]}"); root=${root%/}
      if [ -d "$root" ] && { [ -z "$only" ] || [ "${F_ACC[$i]}" = "$only" ]; }; then
        if [ "$depth" = 1 ]; then set -- "$root"/*; else set -- "$root"/*/*; fi
        for d in "$@"; do
          [[ "${d##*/}" == "$want" ]] && [ -e "$d/.git" ] && out="$out${F_ACC[$i]}"$'\t'"$(real_dir "$d")"$'\n'
        done
      fi
      i=$((i + 1))
    done
    [ -n "$out" ] && break
  done
  eval "$nc"
  printf '%s' "$out" | awk -F'\t' 'NF == 2 && !seen[$2]++'
}

graph_find_one() {   # $1 저장소 이름(이름이 겹치면 계정/이름) → GRAPH_FOUND. 없으면 1, 경로처럼 생겼으면 2, 여럿이면 고르는 법을 알리고 멈춘다
  local name=$1 acct="" hits
  GRAPH_FOUND=""
  load_config >/dev/null 2>&1   # 계정 이름 · 계정 폴더
  case "$name" in ""|.*|-*|*/*/*|/*) return 2 ;; */*) acct=${name%%/*}; name=${name#*/}; is_account "$acct" || return 2 ;; esac
  hits=$(graph_find_repos "$name" "$acct")
  [ -n "$hits" ] || return 1
  if [ "$(printf '%s\n' "$hits" | grep -c .)" -gt 1 ]; then
    die "이름이 「$name」인 저장소가 여럿입니다 — 계정을 붙이거나 폴더로 주세요:"$'\n'"$(printf '%s\n' "$hits" | while IFS=$'\t' read -r a d; do printf '  gitch g %s/%s   (%s)\n' "$a" "$name" "$(tilde "$d")"; done)"
  fi
  GRAPH_FOUND=${hits#*$'\t'}
}

graph_repo_hint() {   # 저장소 밖에서 폴더 없이 부른 때: 이름으로 부르는 법과 계정 폴더의 저장소 몇 개
  local names n
  load_config >/dev/null 2>&1
  names=$(i=0; while [ $i -lt ${#F_RAW[@]} ]; do root=$(expand_path "${F_RAW[$i]}"); i=$((i + 1)); for d in "${root%/}"/*; do [ -e "$d/.git" ] && printf '%s\n' "${d##*/}"; done; done | LC_ALL=C sort -fu)
  n=$(printf '%s' "$names" | grep -c .)
  if [ "$n" -eq 0 ]; then printf '  저장소 안에서 실행하거나 저장소 폴더를 주세요 (예: gitch g ~/code/my-app)'; return 0; fi
  printf '  저장소 안에서 실행하거나 이름을 주세요 — 예: gitch g %s\n' "$(printf '%s\n' "$names" | head -1)"
  printf '  계정 폴더의 저장소: %s' "$(printf '%s\n' "$names" | head -12 | paste -sd, - | sed 's/,/, /g')"
  [ "$n" -gt 12 ] && printf ' 외 %d개' $((n - 12))
  return 0
}

graph_pick_dir() {   # $1 [폴더|저장소] 자리의 값(없으면 지금 폴더) → GRAPH_DIR. 폴더가 아니면 계정 폴더에서 그 이름의 저장소 — 어디서든 gitch g 이름
  local rc
  GRAPH_DIR=${1:-.}
  if [ ! -d "$GRAPH_DIR" ]; then
    graph_find_one "$1"; rc=$?
    [ $rc -eq 2 ] && die "폴더가 아닙니다: $1"
    [ $rc -eq 1 ] && die "폴더가 아닙니다 — 계정 폴더에서 찾은 저장소 이름도 아닙니다: $1"$'\n'"$(graph_repo_hint)"
    GRAPH_DIR=$GRAPH_FOUND
  fi
  git -C "$GRAPH_DIR" rev-parse --show-toplevel >/dev/null 2>&1 && return 0
  [ -n "$1" ] && die "git 저장소 안의 폴더가 아닙니다: $GRAPH_DIR"
  die "git 저장소 안의 폴더가 아닙니다: $(tilde "$PWD")"$'\n'"$(graph_repo_hint)"
}

