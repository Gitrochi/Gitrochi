function modsrc(name, g, d,   pre) {   # 모듈 name 의 소스 glob(매니페스트 폴더 d 기준)
  g = normp(d == "" ? g : d "/" g)
  if (g == "\001" || g == "") return
  MODN++; MODNAME[MODN] = name; MODG[MODN] = g
  pre = g; sub(/[*?{[].*$/, "", pre); MODPRE[MODN] = pre                         # 첫 와일드카드 앞까지 — 대부분 이것만으로 거른다
  MODRE[MODN] = (pre == g) ? "" : globre(g)
