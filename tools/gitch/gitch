    v = substr(all, RSTART, RLENGTH); sub(/^"extends"[ \t]*:[ \t]*"/, "", v); sub(/"$/, "", v)
    ext = normp(joinp(dirof(f), v)); if (ext !~ /\.json$/) ext = ext ".json"
