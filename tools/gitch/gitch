graph_open() {   # $1 파일 — 기본 앱(브라우저 · 그림 보기)으로 연다
  if [ -n "$IS_WINDOWS" ]; then rundll32 url.dll,FileProtocolHandler "$(cygpath -w "$1" 2>/dev/null || printf '%s' "$1")" >/dev/null 2>&1
  elif [ "$(uname -s)" = Darwin ]; then open "$1" 2>/dev/null
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1 &
  else return 1; fi
}

# 범위 안 Package.swift 마다 swift package describe 의 JSON → $1/spm.list ("폴더<TAB>JSON 파일")
# 매니페스트를 컴파일해서 몇 초 걸리지만 변수 · 조건 · 기본 경로까지 정확하다. 실패하거나 swift 가 없으면 awk 가 Package.swift 를 직접 읽는다.
graph_spm_describe() {   # $1 임시 폴더 $2 범위(접두사) $3 고른 언어 — 매니페스트마다 몇 초라 동시에 돌린다
  local d n=0
  [ "${GITSW_SWIFT_DESCRIBE:-1}" = 0 ] && return 0
  [ -n "${3:-}" ] && ! in_list swift "${3//,/ }" && return 0
  command -v swift >/dev/null 2>&1 || return 0
  while IFS= read -r d; do
    n=$((n + 1))
    { swift package --package-path "${d:-.}" describe --type json > "$1/spm-$n.json" 2>/dev/null && printf '%s\t%s\n' "$d" "$1/spm-$n.json" >> "$1/spm.list"; } &
  done < <(awk -v s="$2" '(s == "" || index($0, s) == 1) && ($0 == "Package.swift" || $0 ~ /\/Package\.swift$/) { sub(/\/?Package\.swift$/, ""); print }' "$1/files")
  wait
}

# 앱에 포함된 Rust 도우미. 단독 셸 설치는 기존 분석기를 계속 쓸 수 있다.
graph_core() {
  if [ -n "${GITCH_CORE+x}" ]; then [ -n "$GITCH_CORE" ] && [ -x "$GITCH_CORE" ] && printf '%s' "$GITCH_CORE"; return 0; fi
  local dir
  dir=$(dirname "$(self_path)")
  if [ -x "$dir/gitch-core" ]; then printf '%s' "$dir/gitch-core"
  elif [ -x "$dir/gitch-core.exe" ]; then printf '%s' "$dir/gitch-core.exe"
  else command -v gitch-core 2>/dev/null || true; fi
}

# 기존 -v 메타데이터 계약을 유지해 diff·review·HTML도 같은 변환기를 쓴다.
graph_json() {
  local helper
  helper=$(graph_core)
  if [ -n "$helper" ]; then "$helper" graph-json "$@"; return $?; fi
  local vars=() files=()
  while [ $# -gt 0 ]; do
    if [ "$1" = -v ]; then vars+=("$1" "$2"); shift 2
    else files+=("$1"); shift; fi
  done
  awk ${vars[@]+"${vars[@]}"} "$(graph_awk_lib)$(graph_awk_json)" ${files[@]+"${files[@]}"}
}

# Swift 파일끼리의 정확한 참조는 Xcode 인덱스에 있다 — 그것을 읽는 도우미(앱이 gitch 옆에 둔다)의 경로, 없으면 빈 값
# 약속: gitch-swift-index --repo <저장소> --covered <파일> → 표준출력 "원본<TAB>대상<TAB>심볼,…"(저장소 기준 경로), --covered 에는 인덱스에 든 추적 .swift 경로,
# 종료 0 성공(표준오류 첫 줄은 오래된 인덱스 같은 경고) · 3 인덱스 없음 · 그 밖은 실패
graph_swift_index() {
  if [ -n "${GITCH_SWIFT_INDEX+x}" ]; then [ -n "$GITCH_SWIFT_INDEX" ] && [ -x "$GITCH_SWIFT_INDEX" ] && printf '%s' "$GITCH_SWIFT_INDEX"; return 0; fi   # 빈 값이면 끔
  if [ -x "$(dirname "$(self_path)")/gitch-swift-index" ]; then printf '%s' "$(dirname "$(self_path)")/gitch-swift-index"; return 0; fi
  command -v gitch-swift-index 2>/dev/null || true
}

graph_python_runtime() {
  local name candidate
  for name in python3 python; do
    candidate=$(command -v "$name" 2>/dev/null) || continue
    if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then printf '%s' "$candidate"; return 0; fi
  done
  die "정밀 분석과 자동 갱신에는 Python 3.8 이상이 필요합니다. python.org에서 설치하세요. 일반 정적 그래프는 계속 사용할 수 있습니다."
}

graph_scip_helper() {
  local helper
  helper="$(dirname "$(self_path)")/gitch-scip-index"
  [ -f "$helper" ] || die "정밀 분석 도우미가 없습니다. 최신 Gitrochi 또는 gitch 배포본을 설치하세요."
  printf '%s' "$helper"
}

graph_index_cmd() {
  local lang="" project="my-project" helper runtime
  while [ $# -gt 0 ]; do
    case "$1" in
      --language|--lang|-l) shift; lang=${1:-} ;;
      --project-name) shift; project=${1:-} ;;
      --json) ;;
      -h|--help) say 'gitch g index --language ts|python|java [--project-name 이름] — 공식 인덱서 명령 안내(JSON). 만든 index.scip는 gitch g --precise 또는 --index 파일로 읽습니다.'; return 0 ;;
      *) die "알 수 없는 index 옵션: $1" ;;
    esac
    shift
  done
  [ -n "$lang" ] || die "--language ts|python|java를 지정하세요."
  helper=$(graph_scip_helper) || return 1
  runtime=$(graph_python_runtime) || return 1
  "$runtime" "$helper" --guide "$lang" --project-name "$project"
}

graph_scip_merge() {   # covered, scanner records, SCIP records → additive compiler references
  awk -F'\t' -v covered="$1" -v base="$2" -v idx="$3" 'BEGIN { OFS="\t" }
    FILENAME == covered { C[$0]=1; next }
    FILENAME == base {
      if ($1 == 2 && $4 == "type-ref" && ($2 in C)) next
      if ($1 == 1) { N[$2]=1; if ($2 in C) sub(/"analysis":"[^"]*"/, "\"analysis\":\"compiler-index\"", $6) }
      print; next
    }
    FILENAME == idx { if ($1 == 1 && ($2 in N)) next; print }
  ' "$1" "$2" "$3"
}

graph_content_key() (   # tracked source bytes, index, HEAD and analyzer options; never trust Git's stat cache
  local tmp=$1 path rel=$2 shallow
  shift
  set -o pipefail
  {
    printf 'gitch-graph-cache-3\n%s\n' "$GITSW_VERSION"
    printf '%s\0' "$@"
    git hash-object --no-filters -- "$(self_path)" || exit 1
    local core
    core=$(graph_core)
    [ -z "$core" ] || git hash-object --no-filters -- "$core" || exit 1
    git rev-parse HEAD 2>/dev/null
    git ls-files -s -z
    cat "$tmp/files.z"
    cat "$tmp/files"
    if [ "$rel" = files ] || [ "$rel" = modules ]; then
      : > "$tmp/cache-hash.paths"
      while IFS= read -r path; do
        if [ -f "$path" ]; then printf '%s\0' "$path" >> "$tmp/cache-hash.paths"
        else printf 'missing:%s\0' "$path"; fi
      done < "$tmp/files"
      # Batched hashing preserves every filename boundary, including spaces and newlines.
      # It also notices assume-unchanged files and same-size writes with restored timestamps.
      xargs -0 git hash-object --no-filters -- < "$tmp/cache-hash.paths" || exit 1
      printf 'swift-describe:%s\0' "${GITSW_SWIFT_DESCRIBE:-1}"
    fi
    git for-each-ref --format='%(refname) %(objectname)' refs/replace
    shallow=$(git rev-parse --git-path shallow)
    [ ! -f "$shallow" ] || git hash-object --no-filters -- "$shallow"
    [ ! -f "$GRAPH_RULES_FILE" ] || git hash-object -- "$GRAPH_RULES_FILE"
    [ -z "${GRAPH_INDEX:-}" ] || git hash-object -- "$GRAPH_INDEX"
  } | git hash-object --stdin
)

graph_cached_collect() {
  local tmp=$1 rel=$2 key cache dir hit=""
  # Swift compiler indexes live outside the repository; their own freshness checks must run on every request.
  if [ "${GRAPH_CACHE:-1}" = 0 ] || [ -n "${GRAPH_INDEX:-}" ] || { [ "$rel" = files ] && grep -q '\.swift$' "$tmp/files" && [ -n "$(graph_swift_index)" ]; }; then
    graph_collect "$@" || return $?
    [ ! -f "$tmp/unsafe-paths.records" ] || cat "$tmp/unsafe-paths.records"
    return 0
  fi
  # The temp directory is not part of the stable request key.
  key=$(graph_content_key "$tmp" "${@:2}" "${GRAPH_INDEX:-}" "$([ "$rel" = changes ] && [ -n "$5" ] && date +%Y%m%d%H%M)") || return 1
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/gitch/graphs/$(printf '%s' "$PWD" | git hash-object --stdin)"
  cache="$dir/$key.records"
  if [ -f "$cache" ]; then cat "$cache"; hit=true
  else
    graph_collect "$@" > "$tmp/cache.$rel" || return 1
    cat "$tmp/cache.$rel"; hit=false
    if mkdir -p "$dir" 2>/dev/null; then
      # Atomic replacement; concurrent app and CLI requests never read a half-written entry.
      local staging
      staging=$(mktemp "$dir/.entry.XXXXXX") && { cat "$tmp/cache.$rel" > "$staging" && mv -f "$staging" "$cache"; }
      # Bound stale content entries without deleting another active writer.
      find "$dir" -type f -name '*.records' -mtime +7 -delete 2>/dev/null
    fi
  fi
  printf '0\tcache\t{"hit":%s,"strategy":"content"}\n' "$hit"
  [ ! -f "$tmp/unsafe-paths.records" ] || cat "$tmp/unsafe-paths.records"
}

# NUL filenames must be validated before converting to the tab/newline record format.
# Splitting first would turn one newline-containing filename into another (possibly outside) path.
graph_safe_file_list() {   # $1 original NUL list $2 safe LF list $3 diagnostics records [$4 file root]
  local LC_ALL=C   # Bash 문자 범위가 UTF-8 로캘의 정렬 규칙을 따르지 않게 바이트로 검사한다.
  local path probe root=${4:-$PWD} ignored=0 links=0
  : > "$2"
  while IFS= read -r -d '' path; do
    case "$path" in *[$'\001'-$'\037'$'\177']*) ignored=$((ignored + 1)); continue ;; esac
    probe=$path
    while [ -n "$probe" ]; do
      if [ -L "$root/$probe" ]; then links=$((links + 1)); ignored=$((ignored + 1)); break; fi
      case "$probe" in */*) probe=${probe%/*} ;; *) probe="" ;; esac
    done
    [ -z "$probe" ] || continue
    printf '%s\n' "$path" >> "$2"
  done < "$1"
  : > "$3"
  if [ "$ignored" -gt 0 ]; then
    printf '0\tignoredPaths\t%d\n' "$ignored" > "$3"
    printf '0\tignoredSymlinkPaths\t%d\n' "$links" >> "$3"
    printf '0\tdiagnostic\t{"code":"UNSUPPORTED_PATH","severity":"warning","count":%d,"message":"Paths containing control characters or symbolic links were omitted before reading source files, preserving filename boundaries and repository containment."}\n' "$ignored" >> "$3"
    printf '0\tnote\t제어 문자 또는 심볼릭 링크가 든 파일 경로 %d개는 안전하게 제외했습니다.\n' "$ignored" >> "$3"
  fi
}

graph_affected_cmd() {
  local GRAPH_AFFECTED=1 GRAPH_AFFECTED_BASE="" a
  local -a args=()
  while [ $# -gt 0 ]; do
    a=$1
    case "$a" in
      --base) shift; GRAPH_AFFECTED_BASE=${1:-}; [ -n "$GRAPH_AFFECTED_BASE" ] || die "--base 뒤에 커밋이 필요합니다." ;;
      --base=*) GRAPH_AFFECTED_BASE=${a#*=} ;;
      -h|--help) say 'gitch g affected [--base 기준] [--json|--format html] [폴더] — 변경 파일과 역방향 의존 영향 범위. 삭제한 파일은 기준 커밋의 연결도 따라갑니다. 기본 기준은 기본 브랜치와 갈라진 곳이며 커밋하지 않은 변경도 포함합니다.'; return 0 ;;
      *) args+=("$a") ;;
    esac
    shift
  done
  graph_cmd files ${args[@]+"${args[@]}"}
}

graph_affected_prepare() {   # entire repo dependency closure, including deleted files in the base
  local tmp=$1 base=${GRAPH_AFFECTED_BASE:-} sha path output_path="" output_dir
  if [ -z "$base" ]; then graph_default_base || return 1; base=$GRAPH_BASE; fi
  sha=$(git rev-parse --verify "$base^{commit}" 2>/dev/null) || die "영향 범위 기준 커밋이 아닙니다: $base"
  git diff --name-only --no-renames -z "$sha" -- > "$tmp/changed.z" || return 1
  git ls-files --others --exclude-standard -z > "$tmp/untracked-all.z" || return 1
  if [ -n "${out:-}" ] && [ "$out" != - ]; then
    output_dir=$(real_dir "$(dirname "$out")") && output_path="$output_dir/$(basename "$out")"
  fi
  : > "$tmp/untracked.z"
  while IFS= read -r -d '' path; do
    [ -z "$output_path" ] || [ "$PWD/$path" != "$output_path" ] || continue
    printf '%s\0' "$path" >> "$tmp/untracked.z"
  done < "$tmp/untracked-all.z"
  cat "$tmp/untracked.z" >> "$tmp/changed.z"
  graph_safe_file_list "$tmp/changed.z" "$tmp/changed" "$tmp/changed-unsafe.records"
  graph_safe_file_list "$tmp/untracked.z" "$tmp/untracked" "$tmp/untracked-unsafe.records"
  # Impact analysis includes new files so their imports and reverse dependencies are meaningful.
  # Ordinary `graph files` continues to use tracked files only.
  cat "$tmp/files.z" "$tmp/untracked.z" > "$tmp/affected-files.z"
  mv "$tmp/affected-files.z" "$tmp/files.z"
  graph_safe_file_list "$tmp/files.z" "$tmp/files" "$tmp/unsafe-paths.records"
  # Deleted manifests must not become fallback modules in the current graph. Their nodes
  # and dependencies come from the base graph, where their actual names are still known.
  while IFS= read -r path; do [ ! -f "$path" ] || printf '%s\n' "$path"; done < "$tmp/files" > "$tmp/affected-existing.files"
  mv "$tmp/affected-existing.files" "$tmp/files"
  : > "$tmp/deleted"
  while IFS= read -r path; do
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then printf '%s\n' "$path" >> "$tmp/deleted"; fi
  done < "$tmp/changed"
  mkdir -p "$tmp/affected-base"
  graph_base_extract "$sha" "$tmp/affected-base" || return 1
  GITSW_SWIFT_DESCRIBE=0 GITCH_SWIFT_INDEX='' GRAPH_INDEX='' graph_side "$tmp/affected-base" files "" 1 "$repo" "" "$sha" > "$tmp/affected-before" || return 1
  GITSW_SWIFT_DESCRIBE=0 GITCH_SWIFT_INDEX='' GRAPH_INDEX='' graph_side "$tmp/affected-base" modules "" 1 "$repo" "" "$sha" > "$tmp/affected-modules-before" || return 1
  GITSW_SWIFT_DESCRIBE=0 GITCH_SWIFT_INDEX='' graph_side "$tmp" files "" 1 "$repo" "" > "$tmp/affected-now" || return 1
  graph_side "$tmp" modules "" 1 "$repo" "" > "$tmp/affected-modules" || return 1
  local core
  core=$(graph_core)
  if [ -n "$core" ]; then
    "$core" graph-affected "$tmp" "$sha" > "$tmp/affected.ids" || return $?
    return 0
  fi
  awk -F'\t' -v seeds="$tmp/changed" -v now="$tmp/affected-now" -v before="$tmp/affected-before" -v beforemods="$tmp/affected-modules-before" -v mods="$tmp/affected-modules" -v untracked="$tmp/untracked" -v deleted="$tmp/deleted" -v base="$sha" "$(graph_awk_lib)"'
    FILENAME == seeds { if ($0 != "") { CH[$0]=1; A[$0]=1; Q[++nq]=$0 }; next }
    FILENAME == untracked { UT[$0]=1; next }
    FILENAME == deleted { DEL[$0]=1; next }
    $1 == 1 {
      KIND[$2]=$3; ECO[$2]=$5
      if (FILENAME == before) { BF[$2]=$0; BFK[$2]=$3 }
      if (FILENAME == beforemods) BM[$2]=$0
      if (FILENAME == now || FILENAME == mods) CURRENT[$2]=1
      next
    }
    $1 == 2 {
      REV[$3, ++NRV[$3]]=$2
      if (FILENAME == before) BE[++nbe]=$0
      if (FILENAME == beforemods) BME[++nbme]=$0
      next
    }
    $1 == 4 { MP[$2, $3]=1; next }
    END {
      for (q=1;q<=nq;q++) { t=Q[q]; for (i=1;i<=NRV[t];i++) { s=REV[t,i]; if (!(s in A)) { A[s]=1; Q[++nq]=s } } }
      # Choose the nearest containing module separately for each ecosystem. A workspace root
      # does not own every child package merely because it is an ancestor folder.
      for (f in A) {
        for (key in MP) {
          split(key, parts, SUBSEP); id=parts[1]; p=parts[2]; if (p == ".") p=""
          if (p == "" || f == p || index(f,p "/") == 1) {
            eco=ECO[id]; len=length(p)
            if (!((f,eco) in BEST) || len>BEST[f,eco]) BEST[f,eco]=len
          }
        }
        for (key in MP) {
          split(key, parts, SUBSEP); id=parts[1]; p=parts[2]; if (p == ".") p=""
          if ((p == "" || f == p || index(f,p "/") == 1) && length(p)==BEST[f,ECO[id]] && !(id in AM)) { AM[id]=1; MQ[++nm]=id }
        }
      }
      for (q=1;q<=nm;q++) { t=MQ[q]; for (i=1;i<=NRV[t];i++) { s=REV[t,i]; if (!(s in AM) && KIND[s] == "module") { AM[s]=1; MQ[++nm]=s } } }
      nc=0; nf=0; nu=0; c=""; a=""; u=""; ms=""
      n=sortkeys(CH,K); for(i=1;i<=n;i++) { f=K[i]; c=c (nc++ ? "," : "") jstr(f); if (!(f in KIND)) u=u (nu++ ? "," : "") jstr(f) }
      n=sortkeys(A,K); for(i=1;i<=n;i++) { f=K[i]; if (KIND[f] == "file" || f in CH) {
        a=a (nf++ ? "," : "") jstr(f); print "A\t" f "\t" ((f in CH) ? "true" : "false")
        if (f in DEL) print "D\t" f
        if (f in UT) print "U\t" f
        if (f in BF) print "G\tfiles\t" BF[f]
        else if (!(f in CURRENT)) print "G\tfiles\t1\t" f "\tfile\t" baseof(f) "\tunknown\t\"path\":" jstr(f) ",\"analysis\":\"unresolved\""
      } }
      n=sortkeys(AM,K); for(i=1;i<=n;i++) { id=K[i]; ms=ms (i>1 ? "," : "") jstr(id); print "A\t" id "\tfalse"; if (!(id in CURRENT)) print "D\t" id; if (id in BM) print "G\tmodules\t" BM[id] }
      for (i=1;i<=nbe;i++) print "E\tfiles\t" BE[i]
      for (i=1;i<=nbme;i++) print "E\tmodules\t" BME[i]
      print "B\t" base
      print "0\taffected\t{\"base\":" jstr(base) ",\"changedFiles\":[" c "],\"files\":[" a "],\"modules\":[" ms "],\"unresolvedFiles\":[" u "],\"includesBaseDependencies\":true}"
      print "0\tnote\t영향 범위는 변경 파일에서 역방향 의존을 따라갑니다. 삭제한 파일은 기준 커밋도 분석합니다. 인식하지 못한 언어·동적 참조·미추적 파일의 영향은 완전하지 않을 수 있습니다."
    }' "$tmp/changed" "$tmp/untracked" "$tmp/deleted" "$tmp/affected-before" "$tmp/affected-modules-before" "$tmp/affected-now" "$tmp/affected-modules" > "$tmp/affected.ids"
}

graph_affected_mark() {
  local rel=${2##*/}; rel=${rel#raw.}
  awk -F'\t' -v ids="$1" -v rel="$rel" -v scope="${prefix:-}" -v langs="${langs:-}" "$(graph_awk_lib)"'
    BEGIN{OFS="\t"}
    function marked(id, attrs) { return attrs (attrs!=""?",":"") "\"affected\":true,\"changed\":" (C[id]=="true"?"true":"false") (id in D?",\"deleted\":true":"") (id in U?",\"untracked\":true":"") }
    FILENAME==ids {
      if($1=="A") { A[$2]=1; C[$2]=$3 }
      else if($1=="D") D[$2]=1
      else if($1=="U") U[$2]=1
      else if($1=="B") base=$2
      else if($1=="G" && $2==rel) { id=$4; text=$0; sub(/^[^\t]*\t[^\t]*\t/,"",text); G[id]=text }
      else if($1=="E" && $2==rel) { text=$0; sub(/^[^\t]*\t[^\t]*\t/,"",text); E[++ne]=text }
      else if($1=="0") META=META $0 "\n"
      next
    }
    $1==1 { N[$2]=1; if($2 in A) $6=marked($2,$6) }
    $1==2 { SEEN[$2,$3,$4]=1 }
    { print }
    END {
      for(id in G) if(!(id in N)) {
        split(G[id],v,"\t")
        if(rel=="files" && (!inscope(id) || !langok(id))) continue
        if(rel=="modules" && !ecook(v[5])) continue
        v[6]=marked(id,v[6]); N[id]=1; print v[1],v[2],v[3],v[4],v[5],v[6]
      }
      for(i=1;i<=ne;i++) {
        split(E[i],v,"\t"); s=v[2]; t=v[3]
        if(!(s in A) || !(t in A) || !(s in N) || !(t in N) || ((s,t,v[4]) in SEEN)) continue
        if(rel=="files" && !(s in D) && !(t in D)) continue
        v[7]=v[7] (v[7]!=""?",":"") "\"impactFromBase\":true,\"baseCommit\":" jstr(base)
        print v[1],v[2],v[3],v[4],v[5],v[6],v[7]; SEEN[s,t,v[4]]=1
      }
      printf "%s",META
    }' "$1" "$2"
}

graph_watch_cmd() {
  local rel=files dir="" out="" detach="" json="" opn=auto interval=2 a top helper reply url pid prefix value runtime bashpath watch_rc=0 watch_error
  local -a opts=() extra=() render=()
  while [ $# -gt 0 ]; do
    a=$1
    case "$a" in
      files|modules|changes|tree|precise|affected) rel=$a ;;
      --out|-o) shift; out=${1:-}; [ -n "$out" ] || die "--out 뒤에 HTML 파일이 필요합니다." ;;
      --out=*) out=${a#*=} ;;
      --interval) shift; interval=${1:-} ;;
      --detach) detach=1 ;;
      --json) json=1 ;;
      --open) opn=1 ;;
      --no-open) opn=0 ;;
      --lang|-l|--index|--base|--since|--max-commits|--max-files|--min|--depth)
        shift; [ -n "${1:-}" ] || die "$a 뒤에 값이 필요합니다."; value=$1
        if [ "$a" = --index ]; then value=$(posix_path "$value"); case "$value" in /*) ;; *) value="$PWD/$value" ;; esac; fi
        opts+=("$a" "$value") ;;
      --no-external|--no-cache|--files|--precise) opts+=("$a") ;;
      -h|--help) say 'gitch g watch [files|modules|changes|tree|precise|affected] [--out 파일.html] [--interval 초] [--detach --json] [폴더] — 소스 변경 시 자동 갱신. Python 3 필요. 브라우저를 닫으면 감시도 자동 종료합니다.'; return 0 ;;
      -*) die "알 수 없는 watch 옵션: $a" ;;
      *) [ -z "$dir" ] || die "감시할 폴더는 하나만 지정하세요."; dir=$a ;;
    esac
    shift
  done
  is_number "$interval" && [ "$interval" -ge 1 ] && [ "$interval" -le 60 ] || die "--interval은 1~60초입니다."
  graph_pick_dir "$dir"; dir=$GRAPH_DIR
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || die "git 저장소가 아닙니다: $dir"
  prefix=$(git -C "$dir" rev-parse --show-prefix 2>/dev/null)
  runtime=$(graph_python_runtime) || return 1
  helper="$(dirname "$(self_path)")/gitch-graph-watch"
  [ -f "$helper" ] || die "자동 갱신 도우미가 없습니다. 최신 Gitrochi 또는 gitch를 설치하세요."
  if [ -z "$out" ]; then out="${TMPDIR:-/tmp}/gitch-graph/$(basename "$top")-$rel-live.html"; fi
  out=$(posix_path "$out")
  case "$out" in /*) ;; -) die "자동 갱신은 --out에 HTML 파일을 지정해야 합니다." ;; *) out="$PWD/$out" ;; esac
  case "$out" in *.html|*.htm) ;; *) die "자동 갱신 출력은 .html 파일이어야 합니다." ;; esac
  render=("$rel"); [ "$rel" != precise ] || render=(files --precise)
  # A child shell owns graph temporary files and its EXIT trap; this command owns only the watcher.
  ( graph_cmd "${render[@]}" ${opts[@]+"${opts[@]}"} --format html --out "$out" --no-open "$dir" ) >&2 || return 1
  for a in ${opts[@]+"${opts[@]}"}; do extra+=("--graph-arg=$a"); done
  [ -z "$prefix" ] || extra+=("--graph-arg=${prefix%/}")
  bashpath=$BASH
  if [ -n "$IS_WINDOWS" ]; then
    bashpath=$(cygpath -m "$BASH" 2>/dev/null || printf '%s' "$BASH")
    case "$(lower "$bashpath")" in *.exe) ;; *) bashpath="$bashpath.exe" ;; esac
  fi
  reply=$("$runtime" "$helper" --repo "$top" --cli "$(self_path)" --out "$out" --relation "$rel" --interval "$interval" --bash "$bashpath" --serve --detach ${extra[@]+"${extra[@]}"}) || watch_rc=$?
  if [ "$watch_rc" -ne 0 ]; then
    watch_error=$(printf '%s' "$reply" | "$runtime" -c 'import json,sys; value=json.load(sys.stdin); print(str(value.get("message", ""))[:2000])' 2>/dev/null) || watch_error=""
    die "자동 갱신 서버를 시작하지 못했습니다: ${watch_error:-도우미 종료 코드 $watch_rc}"
  fi
  url=$(printf '%s\n' "$reply" | sed -n 's/.*"url"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
  pid=$(printf '%s\n' "$reply" | sed -n 's/.*"pid"[ ]*:[ ]*\([0-9][0-9]*\).*/\1/p')
  [ -n "$url" ] && is_number "$pid" || die "자동 갱신 서버 응답을 읽지 못했습니다."
  if [ -n "$json" ]; then printf '%s\n' "$reply"; else say "자동 갱신: $url"; fi
  if [ "$opn" = 1 ] || { [ "$opn" = auto ] && [ -z "$json" ]; }; then browse "$url" || true; fi
  if [ -z "$detach" ]; then
    trap 'kill "$pid" 2>/dev/null; exit 0' INT TERM
    while kill -0 "$pid" 2>/dev/null; do sleep 2; done
    trap - INT TERM
  fi
}

# git log -z 의 상태/경로를 탭 레코드로 바꾼다. 공백 · 따옴표 · 역슬래시는 그대로,
# 탭/줄바꿈 등 레코드 구분자가 있는 경로만 건너뛰고 개수를 알린다.
graph_changes_stream() {   # $1 NUL 구분 git log 파일
  local entry status path old invalid=0
  while IFS= read -r -d '' entry; do
    while [[ "$entry" == $'\n'* ]]; do entry=${entry#$'\n'}; done
    case "$entry" in
      $'\001'*) entry=${entry//$'\r'/ }; entry=${entry//$'\n'/ }; printf '%s\n' "$entry" ;;
      R[0-9]*|C[0-9]*)
        status=$entry
        IFS= read -r -d '' old && IFS= read -r -d '' path || break
        case "$old$path" in *[$'\001\002\t\r\n\034\035']*) invalid=$((invalid + 1)); continue ;; esac
        printf '%s\t%s\t%s\n' "$status" "$old" "$path" ;;
      A|M|D|T|U|X|B)
        status=$entry
        IFS= read -r -d '' path || break
        case "$path" in *[$'\001\002\t\r\n\034\035']*) invalid=$((invalid + 1)); continue ;; esac
        printf '%s\t%s\n' "$status" "$path" ;;
    esac
  done < "$1"
  printf '\002%d\n' "$invalid"
}

# Keep tree filenames NUL-delimited until the complete path has been checked.
graph_tree_stream() {   # $1 index | tree — stdin git ls-files -s -z / ls-tree -r -l -z
  local LC_ALL=C
  local entry header path mode kind oid bytes stage
  while IFS= read -r -d '' entry; do
    header=${entry%%$'\t'*}; path=${entry#*$'\t'}
    [ "$header" != "$entry" ] || continue
    case "$path" in ""|*[$'\001'-$'\037'$'\177']*) continue ;; esac
    if [ "$1" = tree ]; then
      read -r mode kind oid bytes <<< "$header"
      [ "$kind" = blob ] || continue
      case "$mode" in 120000|160000) continue ;; esac
      printf '%s %s %s\n' "$oid" "$bytes" "$path"
    else
      read -r mode oid stage <<< "$header"
      case "$mode" in 120000|160000) continue ;; esac
      printf '%s %s\n' "$oid" "$path"
    fi
  done
}

graph_collect() {   # $1 임시 폴더 $2 관계 $3 범위 $4 외부 빼기 $5 since $6 커밋 수 $7 큰 커밋 기준 $8 최소 횟수 $9 깊이 ${10} 파일 포함 ${11} 저장소 이름 ${12} 언어 → 레코드
  local tmp=$1 rel=$2 scope=$3 repo=${11} langs=${12} sx="" sxrc="" sxerr=""
  case "$rel" in
    files|modules)
      : > "$tmp/spm.list"; : > "$tmp/swiftidx"
      [ "$rel" = modules ] && graph_spm_describe "$tmp" "$scope" "$langs"
      if [ "$rel" = files ] && { [ -z "$langs" ] || in_list swift "${langs//,/ }"; } && grep -q '\.swift$' "$tmp/files" && sx=$(graph_swift_index) && [ -n "$sx" ]; then
        rm -f "$tmp/swiftidx.covered"
        "$sx" --repo "$PWD" --covered "$tmp/swiftidx.covered" > "$tmp/swiftidx" 2> "$tmp/swiftidx.err"; sxrc=$?
        sxerr=$(head -n 1 "$tmp/swiftidx.err" 2>/dev/null)
      fi
      GITSW_SWIFTERR="$sxerr" awk -v rel="$rel" -v list="$tmp/files" -v scope="$scope" -v noext="$4" -v spm="$tmp/spm.list" -v repo="$repo" -v langs="$langs" \
        -v swiftidx="$tmp/swiftidx" -v swiftcov="$tmp/swiftidx.covered" -v swiftrc="$sxrc" \
        "$(graph_awk_lib)$(graph_awk_scan)" > "$tmp/scan.$rel" || return 1
      if [ "$rel" = files ] && [ -n "${GRAPH_INDEX:-}" ]; then
        local helper runtime
        helper=$(graph_scip_helper 2> "$tmp/scip.setup.err") || { GRAPH_ANALYSIS_ERROR=$(cat "$tmp/scip.setup.err"); return 1; }
        runtime=$(graph_python_runtime 2> "$tmp/scip.setup.err") || { GRAPH_ANALYSIS_ERROR=$(cat "$tmp/scip.setup.err"); return 1; }
        "$runtime" "$helper" --repo "$PWD" --index "$GRAPH_INDEX" --tracked "$tmp/files.z" --scope "$scope" --lang "$langs" --covered "$tmp/scip.covered" --format records > "$tmp/scip.records" || {
          GRAPH_ANALYSIS_ERROR="SCIP 인덱스를 적용하지 못했습니다. 현재 소스로 인덱스를 다시 생성하세요. $(awk -F'\t' '$2 == "diagnostic" { print $3; exit }' "$tmp/scip.records")"
          [ -n "$MACHINE_JSON" ] || cat "$tmp/scip.records" >&2
          return 1;
        }
        graph_scip_merge "$tmp/scip.covered" "$tmp/scan.$rel" "$tmp/scip.records"
      else cat "$tmp/scan.$rel"; fi ;;
    changes)
      # 현재 경로로 범위를 제한하면 폴더 밖에서 이름을 바꿔 들어온 파일의 옛 이력이 사라진다.
      # 전체 로그를 최신부터 읽고, rename 을 거슬러 현재 추적 경로에 대응시킨 다음 범위를 적용한다.
      # N+1개를 읽어 정확히 N개인 이력과 --max-commits 로 잘린 이력을 구별한다.
      git -c core.quotepath=off log --no-merges --topo-order --find-renames --name-status -z \
        --format='%x01%H%x09%cI%x09%ct%x09%s' ${5:+"--since=$5"} -n "$(($6 + 1))" > "$tmp/changes.log" 2>/dev/null || true
      graph_changes_stream "$tmp/changes.log" | \
        GITSW_LOCKRE="$LOCKFILE_RE" awk -v rel="$rel" -v list="$tmp/files" -v scope="$scope" -v maxf="$7" -v min="$8" -v maxc="$6" -v since="$5" -v langs="$langs" \
          -v shallow="$(git rev-parse --is-shallow-repository 2>/dev/null)" "$(graph_awk_lib)$(graph_awk_changes)" ;;
    tree)
      # 크기는 인덱스의 blob 크기(git cat-file 한 번) — 파일마다 stat 하지 않는다. 서브모듈(160000)은 뺀다
      if [ -n "${GRAPH_REV:-}" ]; then   # diff 의 기준 커밋: 크기까지 git ls-tree 한 번
        git ls-tree -r -l -z "$GRAPH_REV" -- ${scope:+"$scope"} | graph_tree_stream tree
      else
        git ls-files -s -z -- ${scope:+"$scope"} | graph_tree_stream index | \
          git cat-file --batch-check='%(objectname) %(objectsize) %(rest)'
      fi | \
        awk -v rel="$rel" -v safeList="$([ ! -f "$tmp/files" ] || printf '%s' "$tmp/files")" -v scope="$scope" -v maxd="$9" -v withfiles="${10}" -v repo="$repo" -v langs="$langs" "$(graph_awk_lib)$(graph_awk_tree)" ;;
  esac
}

graph_cmd() {   # [files|modules|changes|tree] [옵션...] [폴더] · diff … · check …
  # BSD awk는 일부 UTF-8 로캘에서 서로 다른 한글 경로도 같다고 비교한다.
  # 경로 키·구분자는 모든 분석 단계에서 같은 바이트 순서로 다룬다.
  local LC_ALL=C
  export LC_ALL
  case "${1:-}" in
    review) shift; graph_review_cmd "$@"; return $? ;;
    watch) shift; graph_watch_cmd "$@"; return $? ;;
    affected) shift; graph_affected_cmd "$@"; return $? ;;
    index) shift; graph_index_cmd "$@"; return $? ;;
    languages) shift; graph_languages_cmd "$@"; return $? ;;
    diff) shift; graph_diff_cmd "$@"; return $? ;;
    check) shift; graph_check_cmd "$@"; return $? ;;
  esac
  local rel="" fmt="" out="" opn=auto dir="" since="" maxc=1000 maxf=30 min=2 depth=0 withfiles="" noext="" langs="" a
  local top prefix repo tmp n_nodes=0 n_edges=0 n_heur=0 fancy="" rels i precise="" indexfile=""
  local GRAPH_INDEX="" GRAPH_CACHE=1 GRAPH_ANALYSIS_ERROR=""
  local -a meta
  while [ $# -gt 0 ]; do
    a=$1
    case "$a" in
      files|file) rel=files ;;
      modules|module) rel=modules ;;
      changes|change) rel=changes ;;
      tree) rel=tree ;;
      --format|-f) shift; fmt=${1:-} ;;
      --format=*) fmt=${a#*=} ;;
      --json) fmt=json ;;
      --precise) precise=1 ;;
      --no-cache) GRAPH_CACHE=0 ;;
      --index) shift; indexfile=${1:-}; [ -n "$indexfile" ] || die "--index 뒤에 SCIP 파일 경로가 필요합니다."; precise=1 ;;
      --index=*) indexfile=${a#*=}; precise=1 ;;
      --out|-o) shift; out=${1:-}; [ -n "$out" ] || die "--out 뒤에 파일 이름이 필요합니다 (- 는 표준출력)." ;;
      --out=*) out=${a#*=} ;;
      --open) opn=1 ;;
      --no-open) opn=0 ;;
      --since) shift; since=${1:-}; [ -n "$since" ] || die "--since 뒤에 날짜가 필요합니다 (예: 2026-01-01, \"3 months ago\")." ;;
      --since=*) since=${a#*=} ;;
      --max-commits|-n) shift; maxc=${1:-} ;;
      --max-files) shift; maxf=${1:-} ;;
      --min) shift; min=${1:-} ;;
      --depth) shift; depth=${1:-} ;;
      --files) withfiles=1 ;;
      --no-external) noext=1 ;;
      --lang|-l) shift; langs=${1:-}; [ -n "$langs" ] || die "--lang 뒤에 언어가 필요합니다 (예: swift, ts,js)." ;;
      --lang=*) langs=${a#*=} ;;
      -h|--help) say "$GRAPH_USAGE"; return 0 ;;
      -*) die "알 수 없는 옵션: $a"$'\n'"$GRAPH_USAGE" ;;
      *) [ -z "$dir" ] || die "폴더는 하나만 줄 수 있습니다: $dir, $a"$'\n'"$GRAPH_USAGE"; dir=$a ;;
    esac
    shift
  done
  for a in "$maxc" "$maxf" "$min"; do
    { is_number "$a" && [ "$a" -gt 0 ]; } || die "--max-commits · --max-files · --min 은 1 이상의 숫자입니다."
  done
  is_number "$depth" || die "--depth 는 숫자입니다 (0 = 끝까지)."
  if [ -n "$langs" ]; then
    langs=$(graph_langs "$langs") && [ -n "$langs" ] || die "--lang 은 Java · TS · Python · C · C++ · C# · PHP · Ruby 등 언어 이름이나 확장자로 고릅니다 (쉼표로 여럿, graph --help)."
  fi
  rel=${rel:-files}; graph_pick_dir "$dir"; dir=$GRAPH_DIR
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ] || die "git 저장소 안의 폴더가 아닙니다: $dir"
  prefix=$(git -C "$dir" rev-parse --show-prefix 2>/dev/null)
  repo=$(graph_repo_name "$dir" "$top")
  if [ -n "$precise" ]; then
    if [ -z "$indexfile" ]; then
      if [ -f "$top/.gitch/index.scip" ]; then indexfile="$top/.gitch/index.scip"
      elif [ -f "$top/index.scip" ]; then indexfile="$top/index.scip"
      else die "SCIP 인덱스가 없습니다. gitch g index --language ts|python|java로 생성 방법을 확인한 뒤 --index 파일을 지정하세요."; fi
    fi
    indexfile=$(posix_path "$indexfile")
    case "$indexfile" in /*) ;; *) indexfile="$PWD/$indexfile" ;; esac
    [ -f "$indexfile" ] || die "SCIP 인덱스를 읽지 못했습니다: $indexfile"
    GRAPH_INDEX=$indexfile
  fi

  # 형식: --format > --out 의 확장자 > 사람이 보는 터미널이면 html(열기), 아니면 json(표준출력)
  out=$(posix_path "$out")   # Windows 의 C:\… · C:/… 도 절대 경로(아니면 저장소 안에 C: 폴더가 생긴다)
  case "$out" in ""|-|/*) ;; *) out="$PWD/$out" ;; esac
  if [ -z "$fmt" ]; then
    case "$(lower "$out")" in
      *.json) fmt=json ;; *.html|*.htm) fmt=html ;; *.svg) fmt=svg ;; *.png) fmt=png ;; *.dot|*.gv) fmt="dot" ;;
      *) if fancy_out; then fmt=html; else fmt=json; fi ;;
    esac
  fi
  fmt=$(lower "$fmt")
  case "$fmt" in
    json|html|dot) ;;
    svg|png) command -v dot >/dev/null 2>&1 || die "$fmt 그림은 graphviz 의 dot 으로 만듭니다 → $(install_hint graphviz Graphviz.Graphviz)  (설치 없이 보려면 --format html)" ;;
    *) die "--format 은 html, json, svg, png, dot 중 하나입니다: $fmt" ;;
  esac
  if [ -z "$out" ]; then
    case "$fmt" in
      json|dot) out=- ;;
      *) out="${TMPDIR:-/tmp}"; out="${out%/}/gitch-graph/$repo-$rel${prefix:+-$(printf '%s' "${prefix%/}" | tr '/ ' '--')}.$fmt" ;;
    esac
  fi

  cd "$top" || die "저장소로 이동하지 못했습니다: $top"
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/gitch-graph.XXXXXX") || die "임시 폴더를 만들지 못했습니다."
  GRAPH_TMP=$tmp
  trap 'rm -rf "$GRAPH_TMP"' EXIT
  [ "$out" != - ] && fancy_out && fancy=1
  [ -n "$fancy" ] && printf '  %s' "${DIM}$(graph_rel_word "$rel") 모으는 중…${RESET}"
  # -z: 따옴표 · 역슬래시가 든 이름도 그대로 (레코드가 탭 구분이라 탭 · 줄바꿈이 든 이름은 awk 가 건너뛴다)
  git ls-files -z > "$tmp/files.z" && graph_safe_file_list "$tmp/files.z" "$tmp/files" "$tmp/unsafe-paths.records" || die "추적하는 파일 목록을 읽지 못했습니다 (git ls-files)."
  if [ -n "${GRAPH_AFFECTED:-}" ]; then graph_affected_prepare "$tmp" || die "변경 영향 범위를 분석하지 못했습니다."; fi
  rels=$rel
  [ "$fmt" = html ] && for a in files modules changes tree; do [ "$a" = "$rel" ] || rels="$rels $a"; done
  for a in $rels; do
    graph_cached_collect "$tmp" "$a" "$prefix" "$noext" "$since" "$maxc" "$maxf" "$min" "$depth" "$withfiles" "$repo" "$langs" > "$tmp/raw.$a" \
      || die "${GRAPH_ANALYSIS_ERROR:-그래프를 만들지 못했습니다 ($a).}"
    if [ -n "${GRAPH_AFFECTED:-}" ]; then graph_affected_mark "$tmp/affected.ids" "$tmp/raw.$a" > "$tmp/marked.$a"; mv "$tmp/marked.$a" "$tmp/raw.$a"; fi
    LC_ALL=C sort -u "$tmp/raw.$a" > "$tmp/rec.$a"
  done
  if [ "$fmt" = html ] && git rev-parse --verify HEAD >/dev/null 2>&1; then
    graph_default_base
    graph_review_prepare "$tmp/review" "$GRAPH_BASE" "$GRAPH_BASE_NAME" true worktree "$prefix" "$langs" "$repo" "$noext" "${GRAPH_AFFECTED:+$tmp/untracked.z}" || die "변경 리뷰를 만들지 못했습니다."
  fi
  cp "$tmp/rec.$rel" "$tmp/rec"
  read -r n_nodes n_edges n_heur <<< "$(awk -F'\t' '$1 == 1 { n++ } $1 == 2 { e++; if ($6 == "h") h++ } END { print n + 0, e + 0, h + 0 }' "$tmp/rec")"
  local nativeTop="$top"
  [ -z "$IS_WINDOWS" ] || nativeTop=$(cygpath -m "$top" 2>/dev/null || printf '%s' "$top")
  meta=(-v rel="$rel" -v repo="$repo" -v branch="$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD 2>/dev/null)" -v repoPath="$nativeTop" -v scope="${prefix%/}" -v commit="$(git rev-parse --short HEAD 2>/dev/null)" -v ver="$GITSW_VERSION" -v when="$(now_iso)" -v langs="$langs")
  case "$fmt" in
    json) graph_json "${meta[@]}" "$tmp/rec" > "$tmp/out" ;;
    html)   # {"initial": 처음 탭, "views": {관계: 그 관계의 json, …}}
      { printf '{"initial":"%s","views":{' "$rel"; i=0
        for a in $rels; do
          [ $i -gt 0 ] && printf ','
          printf '"%s":' "$a"; graph_json "${meta[@]}" -v rel="$a" "$tmp/rec.$a"; i=$((i + 1))
        done
        printf '}'
        [ ! -f "$tmp/review/review.json" ] || { printf ',"review":'; cat "$tmp/review/review.json"; }
        [ -f "$GRAPH_RULES_FILE" ] && { printf ',"rules":'; graph_rules_eval "$tmp" "$GRAPH_RULES_FILE"; }   # 분석 창의 「규칙 위반」
        printf '}\n'; } | graph_html > "$tmp/out" ;;
    dot) awk "${meta[@]}" "$(graph_awk_lib)$(graph_awk_dot)" "$tmp/rec" > "$tmp/out" ;;
    *)
      [ -n "$fancy" ] && [ "$n_nodes" -gt 1500 ] && printf '\r\033[K  %s' "${DIM}노드가 ${n_nodes}개라 dot 이 오래 걸릴 수 있습니다 (빠르게 보려면 --format html)…${RESET}"
      awk "${meta[@]}" "$(graph_awk_lib)$(graph_awk_dot)" "$tmp/rec" > "$tmp/g.dot" && dot -T"$fmt" -o "$tmp/out" "$tmp/g.dot" 2> "$tmp/dot.err" \
        || { [ -n "$fancy" ] && printf '\r\033[K'; sed 's/^/  /' "$tmp/dot.err" >&2; die "dot 이 그림을 만들지 못했습니다."; } ;;
  esac
  [ -n "$fancy" ] && printf '\r\033[K'

  if [ "$out" = - ]; then
    cat "$tmp/out"
    [ "$n_nodes" = 0 ] && warn "$(graph_empty_hint "$rel" "$langs")" >&2
    return 0
  fi
  graph_copy_atomic "$tmp/out" "$out"
  if [ "$fmt" = json ] && [ -n "$MACHINE_JSON" ]; then
    [ "$n_nodes" != 0 ] || warn "$(graph_empty_hint "$rel" "$langs")" >&2
    [ "$opn" != 1 ] || graph_open "$out" >/dev/null 2>&1
    cat "$tmp/out"; return 0
  fi
  [ "$n_nodes" = 0 ] && warn "$(graph_empty_hint "$rel" "$langs")"
  ok "구조 그래프 ($(graph_rel_word "$rel")): 노드 ${n_nodes}개 · 연결 ${n_edges}개$( [ "$n_heur" -gt 0 ] && printf ' (추정 %s개)' "$n_heur")"
  say "  $(tilde "$out")"
  if [ "$opn" = 1 ] || { [ "$opn" = auto ] && [ -n "$fancy" ] && [ "$fmt" != json ] && [ "$fmt" != dot ]; }; then
    graph_open "$out" && dim "  열었습니다. (열지 않으려면 --no-open)"
  fi
  say "GRAPH_FILE=$out NODES=$n_nodes EDGES=$n_edges"
}

GRAPH_DIFF_USAGE='사용법: gitch graph diff [기준] [files|modules|tree] [--format text|json|html] [--out 파일] [폴더|저장소]
  기준(커밋 · 브랜치)의 그래프와 지금 작업 트리의 그래프를 비교한다 — 더하거나 뺀 연결 · 파일, 새로 생긴 · 커지거나 줄어든 · 없어진 순환
  --scope worktree|staged|committed (기본 worktree: 기준 → 현재 추적 파일, staged 포함, 미추적 제외)
  기준을 주지 않으면 기본 브랜치(upstream > origin)와 갈라진 곳(merge-base). 기준... (예: origin/main...) 은 그 기준과 갈라진 곳
  --format   기본: 사람이 보는 터미널이면 text(요약), 아니면 json(바뀐 것만). html 은 바뀐 것을 색으로 보여 주는 그래프
  --lang · --no-external 은 gitch graph 와 같다. 양쪽을 같은 방법으로 읽으려고 Package.swift 는 swift 없이 직접 읽고 Xcode 인덱스 도우미는 쓰지 않는다'

GRAPH_CHECK_USAGE='사용법: gitch graph check [--rules 파일] [--base 기준] [--format text|json|html] [--init] [폴더|저장소]
  규칙 파일(기본: 저장소의 .gitch/graph.rules)대로 의존을 검사한다. 위반이 있으면 종료 코드 1 — CI 에 넣기 좋다
  [files] 나 [modules] 아래에 한 줄에 하나 (# 뒤는 주석):
    forbid  A -> B       A 가 B 에 기대면 위반 (A 와 B 가 같은 패턴이면 같은 곳끼리는 괜찮다)
    allow   A -> B       위반의 예외
    layers  A > B > C    왼쪽이 오른쪽에 기대는 것만 된다 (C 가 A 에 기대면 위반)
    no-cycles [패턴]     순환 의존 금지 (패턴을 주면 그 안에서만)
  패턴: files 는 경로(* 한 마디 · ** 여러 폴더 · 폴더 이름만 쓰면 그 아래 전부), modules 는 모듈 이름(*Feature)
  --base 기준  그 커밋에도 있던 위반은 「기존」으로 따로 적고 실패로 세지 않는다 (오래된 저장소에 들일 때)
  이름만으로 추정한 연결의 위반은 경고다. 모듈 · 패키지로 확인한 추정(checked)과 정확한 연결은 위반으로 센다
  --init  예시가 든 규칙 파일을 만든다'

GRAPH_RULES_FILE=.gitch/graph.rules

graph_default_base() {   # 기본 브랜치와 갈라진 곳(merge-base): upstream(포크) > origin > 로컬 main · master, 없으면 HEAD → GRAPH_BASE · GRAPH_BASE_NAME
  local r d
  for r in upstream origin; do
    git remote get-url "$r" >/dev/null 2>&1 || continue
    d=$(default_branch "$r")
    git show-ref -q --verify "refs/remotes/$r/$d" || continue
    GRAPH_BASE=$(git merge-base HEAD "refs/remotes/$r/$d" 2>/dev/null) && [ -n "$GRAPH_BASE" ] && { GRAPH_BASE_NAME="$r/$d"; return 0; }
  done
  for d in main master; do
    git show-ref -q --verify "refs/heads/$d" || continue
    GRAPH_BASE=$(git merge-base HEAD "refs/heads/$d" 2>/dev/null) && [ -n "$GRAPH_BASE" ] && { GRAPH_BASE_NAME=$d; return 0; }
  done
  GRAPH_BASE=$(git rev-parse HEAD 2>/dev/null) && [ -n "$GRAPH_BASE" ] && GRAPH_BASE_NAME=HEAD
}

graph_base_extract() {   # $1 커밋 $2 폴더 → 그 커밋의 추적 파일을 $2/src 에 풀고 목록을 $2/files 에 (저장소는 건드리지 않는다)
  mkdir -p "$2/src" || return 1
  if [ -z "$1" ]; then : > "$2/files.z"; : > "$2/files"; return 0; fi
  git archive --format=tar "$1" | tar -x -C "$2/src" 2>/dev/null || return 1
  git ls-tree -r --name-only -z "$1" > "$2/files.z" && graph_safe_file_list "$2/files.z" "$2/files" "$2/unsafe-paths.records" "$2/src"
}

graph_side() {   # $1 임시 폴더 $2 관계 $3 범위 $4 외부 빼기 $5 저장소 $6 언어 [$7 기준 커밋] → 정렬한 레코드 (diff · check 가 양쪽을 같은 방법으로)
  local tmp=$1 rel=$2
  {
  if [ -z "${7:-}" ]; then
    graph_collect "$tmp" "$rel" "$3" "$4" "" 1000 30 2 0 "" "$5" "$6"
  elif [ "$rel" = tree ]; then
    GRAPH_REV=$7 graph_collect "$tmp" tree "$3" "$4" "" 1000 30 2 0 "" "$5" "$6"
  else
    ( cd "$tmp/src" && graph_collect "$tmp" "$rel" "$3" "$4" "" 1000 30 2 0 "" "$5" "$6" )
  fi
  [ ! -f "$tmp/unsafe-paths.records" ] || cat "$tmp/unsafe-paths.records"
  } | LC_ALL=C sort -u
}

graph_meta() {   # JSON 머리에 쓰는 awk 변수들 → GRAPH_META 배열
  local nativeTop="$PWD"
  [ -z "$IS_WINDOWS" ] || nativeTop=$(cygpath -m "$PWD" 2>/dev/null || printf '%s' "$PWD")
  GRAPH_META=(-v rel="$1" -v repo="$2" -v branch="$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD 2>/dev/null)" -v repoPath="$nativeTop" -v scope="${3%/}" -v commit="$(git rev-parse --short HEAD 2>/dev/null)" -v ver="$GITSW_VERSION" -v when="$(now_iso)" -v langs="$4")
}

graph_review_progress() {   # Human stderr only; never pollute JSON/app stdout.
  [ -t 2 ] && [ -z "$MACHINE_JSON" ] || return 0
  printf '  변경 리뷰 · %s…\n' "$1" >&2
}

graph_review_tree() {   # safe file list, source root, prefix, repo, languages
  local path bytes
  while IFS= read -r path; do
    [ -f "$2/$path" ] && [ ! -L "$2/$path" ] || continue
    bytes=$(wc -c < "$2/$path" | tr -d ' ')
    printf 'snapshot %s %s\n' "$bytes" "$path"
  done < "$1" | awk -v scope="$3" -v repo="$4" -v langs="$5" -v rel=tree -v maxd=0 -v withfiles='' -v treeSnapshot=1 "$(graph_awk_lib)$(graph_awk_tree)"
}

# Review snapshots are read-only and use the same scanner on both sides. No compiler
# index or manifest execution is used when comparing historical source bytes.
graph_review_prepare() {   # tmp base selectedRef mergeBase scope prefix langs repo
  local tmp=$1 base=$2 ref=$3 merge=$4 scope=$5 prefix=$6 langs=$7 repo=$8
  local status path old rel side head="worktree" started=$SECONDS noext=${9:-} untracked=${10:-} untrackedPolicy=excluded
  mkdir -p "$tmp/b" "$tmp/a"
  graph_review_progress "기준 소스 읽기"
  graph_base_extract "$base" "$tmp/b" || return 1
  graph_review_progress "$scope 소스 읽기"
  if [ "$scope" = committed ]; then
    head=$(git rev-parse HEAD)
    graph_base_extract "$head" "$tmp/a" || return 1
    git diff --name-status -M -z "$base" HEAD -- > "$tmp/status.z" || return 1
  elif [ "$scope" = staged ]; then
    head=index
    # Reading stage zero blobs does not write a tree or alter the real index.
    git ls-files -u -z > "$tmp/conflicts.z"
    [ ! -s "$tmp/conflicts.z" ] || { err '충돌 중인 인덱스는 staged 그래프로 분석할 수 없습니다.'; return 1; }
    git ls-files -s -z > "$tmp/index.z"
    : > "$tmp/a/files.z"
    local entry header mode skipped=0
    while IFS= read -r -d '' entry; do
      header=${entry%%$'\t'*}; path=${entry#*$'\t'}; mode=${header%% *}
      case "$mode" in 100644|100755) printf '%s\0' "$path" >> "$tmp/a/files.z" ;; *) skipped=$((skipped+1)) ;; esac
    done < "$tmp/index.z"
    mkdir -p "$tmp/a/src"
    graph_safe_file_list "$tmp/a/files.z" "$tmp/a/files" "$tmp/a/unsafe-paths.records" "$tmp/a/src"
    [ "$skipped" = 0 ] || printf '0\tdiagnostic\t{"code":"UNSUPPORTED_INDEX_MODE","severity":"warning","count":%s,"message":"Symlink or submodule entries were excluded from the staged source snapshot."}\n' "$skipped" >> "$tmp/a/unsafe-paths.records"
    while IFS= read -r path; do
      mkdir -p "$tmp/a/src/$(dirname "$path")" || return 1
      git show ":$path" > "$tmp/a/src/$path" || return 1
    done < "$tmp/a/files"
    if [ -n "$base" ]; then git diff --cached --name-status -M -z "$base" -- > "$tmp/status.z"
    else git diff --cached --name-status -M -z -- > "$tmp/status.z"; fi || return 1
  else
    git ls-files -z > "$tmp/a/files.z"
    graph_safe_file_list "$tmp/a/files.z" "$tmp/a/files" "$tmp/a/unsafe-paths.records"
    git diff --name-status -M -z "$base" -- > "$tmp/status.z" || return 1
  fi
  if [ "$scope" = worktree ] && [ -f "$untracked" ]; then
    untrackedPolicy=included
    cat "$untracked" >> "$tmp/a/files.z"
    graph_safe_file_list "$tmp/a/files.z" "$tmp/a/files" "$tmp/a/unsafe-paths.records"
    while IFS= read -r -d '' path; do printf 'U\0%s\0' "$path" >> "$tmp/status.z"; done < "$untracked"
  fi
  : > "$tmp/changes"
  while IFS= read -r -d '' status && IFS= read -r -d '' path; do
    old=""
    case "$status" in R*|C*) old=$path; IFS= read -r -d '' path || return 1 ;; esac
    # Keep the established LF/TAB record boundary safe; scanner diagnostics describe omissions.
    case "$path$old" in *[$'\001'-$'\037'$'\177']*) continue ;; esac
    [ -z "$prefix" ] || case "$path" in "$prefix"*) ;; *) case "$old" in "$prefix"*) ;; *) continue ;; esac ;; esac
    printf '%s\t%s\t%s\n' "$status" "$path" "$old" >> "$tmp/changes"
  done < "$tmp/status.z"
  graph_meta files "$repo" "$prefix" "$langs"
  for side in a b; do
    for rel in files modules; do
      graph_review_progress "$side · $(graph_rel_word "$rel") 해석"
      if [ "$side" = a ] && [ "$scope" = worktree ]; then
        GITSW_SWIFT_DESCRIBE=0 GITCH_SWIFT_INDEX='' GRAPH_INDEX='' graph_side "$tmp/a" "$rel" "$prefix" "$noext" "$repo" "$langs" > "$tmp/$side/rec.$rel" || return 1
      else
        (cd "$tmp/$side/src" && GITSW_SWIFT_DESCRIBE=0 GITCH_SWIFT_INDEX='' GRAPH_INDEX='' graph_side "$tmp/$side" "$rel" "$prefix" "$noext" "$repo" "$langs") > "$tmp/$side/rec.$rel" || return 1
      fi
      graph_json "${GRAPH_META[@]}" -v rel="$rel" "$tmp/$side/rec.$rel" > "$tmp/$side/$rel.json"
    done
    if [ -f "$GRAPH_RULES_FILE" ]; then graph_rules_eval "$tmp/$side" "$GRAPH_RULES_FILE" > "$tmp/$side/rules.json"; else printf 'null' > "$tmp/$side/rules.json"; fi
  done
  graph_review_progress "변경 · 순환 · 규칙 근거 정리"
  # Rename the old graph identities before SCC comparison: a move alone is not a new cycle.
  awk -F'\t' -v changes="$tmp/changes" 'BEGIN { OFS="\t"; while((getline < changes)>0) if($1~/^R/) R[$3]=$2 }
    $1==1 && ($2 in R) {$2=R[$2]} $1==2 {if($2 in R)$2=R[$2]; if($3 in R)$3=R[$3]} {print}' "$tmp/b/rec.files" > "$tmp/b/normalized"
  awk -v rel=files "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_merge)" "$tmp/b/normalized" "$tmp/a/rec.files" > "$tmp/merged"
  # Also mark content-only changes; dependency equality must not hide them in diff.
  graph_review_mark "$tmp/changes" "$tmp/merged" > "$tmp/review.records"
  graph_json "${GRAPH_META[@]}" -v diffbase="$base" -v diffname="$ref" "$tmp/review.records" > "$tmp/diff.json"
  {
    printf '{"schemaVersion":1,"scope":%s,"untracked":%s,"selectedRef":%s,"baseSha":%s,"headSha":%s,"snapshot":%s,"mergeBase":%s,"branch":%s,"seconds":%s,"changes":' "$(json_str "$scope")" "$(json_str "$untrackedPolicy")" "$(json_str "$ref")" "$(json_str "$base")" "$(json_str "$(git rev-parse --verify HEAD 2>/dev/null || true)")" "$(json_str "$head")" "$merge" "$(json_str "$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD)")" "$((SECONDS-started))"
    awk -F'\t' "$(graph_awk_lib)"'BEGIN{printf "["} {printf "%s{\"status\":%s,\"path\":%s,\"oldPath\":%s}", (n++?",":""),jstr($1),jstr($2),($3!=""?jstr($3):"null")} END{printf "]"}' "$tmp/changes"
    printf ',"before":'; cat "$tmp/b/files.json"
    printf ',"current":'; cat "$tmp/a/files.json"
    printf ',"modules":'; cat "$tmp/a/modules.json"
    printf ',"beforeModules":'; cat "$tmp/b/modules.json"
    printf ',"diff":'; cat "$tmp/diff.json"
    printf ',"rules":'; cat "$tmp/a/rules.json"
    printf ',"beforeRules":'; cat "$tmp/b/rules.json"
    printf '}\n'
  } > "$tmp/review.json"
}

# 스테이지 내용과 HEAD만 식별해 인덱스 stat 갱신이나 작업 트리 수정에는 바뀌지 않는다.
graph_review_stamp() {
  { printf '%s\0' "$(git rev-parse --verify HEAD 2>/dev/null || true)"; git ls-files --stage -z; } | git hash-object --stdin
}

graph_review_cmd() {
  local fmt=json out="" opn=auto dir="" stampOnly="" langs="" a top repo tmp startStamp endStamp head branch
  while [ $# -gt 0 ]; do
    a=$1
    case "$a" in
      --json) fmt=json ;;
      --stamp) stampOnly=1 ;;
      --format|-f) shift; fmt=${1:-} ;;
      --format=*) fmt=${a#*=} ;;
      --out|-o) shift; out=${1:-}; [ -n "$out" ] || die "--out 뒤에 파일 이름이 필요합니다." ;;
      --out=*) out=${a#*=} ;;
      --open) opn=1 ;;
      --no-open) opn=0 ;;
      --lang|-l) shift; langs=${1:-}; [ -n "$langs" ] || die "--lang 뒤에 언어가 필요합니다." ;;
      --lang=*) langs=${a#*=} ;;
      --scope) shift; [ "${1:-}" = staged ] || die "커밋 영향 분석은 --scope staged 만 지원합니다." ;;
      --scope=staged) ;;
      -h|--help) say '사용법: gitch graph review [--json|--format html --out 파일] [--stamp --json] [폴더]
  HEAD와 스테이지 내용을 비교해 변경 파일 · 직접/간접 확인 대상 · 테스트 후보를 읽기 전용으로 분석한다.
  --stamp 는 HEAD와 스테이지 내용의 식별자만 반환한다. 작업 트리 수정과 인덱스 stat 갱신에는 바뀌지 않는다.
  테스트 후보는 의존 경로나 파일 이름으로 추정하며 테스트를 실행하지 않는다.'; return 0 ;;
      -*) die "알 수 없는 커밋 영향 분석 옵션: $a" ;;
      *) [ -z "$dir" ] || die "폴더는 하나만 지정하세요."; dir=$a ;;
    esac
    shift
  done
  case "$fmt" in json|html) ;; *) die "--format 은 json 또는 html 입니다." ;; esac
  [ -z "$stampOnly" ] || { [ "$fmt" = json ] && [ -z "$out" ]; } || die "--stamp 는 파일 출력 없이 JSON으로만 읽습니다."
  graph_pick_dir "$dir"; top=$(git -C "$GRAPH_DIR" rev-parse --show-toplevel) || return 1
  out=$(posix_path "$out")
  case "$out" in ""|-|/*) ;; *) out="$PWD/$out" ;; esac
  cd "$top" || return 1
  head=$(git rev-parse --verify HEAD 2>/dev/null || true)
  startStamp=$(graph_review_stamp) || die "스테이지 식별자를 읽지 못했습니다."
  if [ -n "$stampOnly" ]; then
    printf '{"schemaVersion":1,"scope":"staged","stamp":%s,"headSha":%s}\n' "$(json_str "$startStamp")" "$(json_str "$head")"
    return 0
  fi
  if [ "$fmt" = html ]; then
    local -a args=(files --scope staged --format html)
    [ -z "$langs" ] || args+=(--lang "$langs")
    [ -z "$out" ] || args+=(--out "$out")
    case "$opn" in 0) args+=(--no-open) ;; 1) args+=(--open) ;; esac
    if [ -n "$head" ]; then graph_diff_cmd --base HEAD "${args[@]}"
    else GRAPH_REVIEW_EMPTY_BASE=1 graph_diff_cmd "${args[@]}"; fi
    return $?
  fi
  if [ -n "$langs" ]; then langs=$(graph_langs "$langs") && [ -n "$langs" ] || die "알 수 없는 분석 언어입니다."; fi
  repo=$(graph_repo_name "$top" "$top")
  branch=$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD 2>/dev/null)
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/gitch-review.XXXXXX") || die "임시 폴더를 만들지 못했습니다."
  GRAPH_TMP=$tmp; trap 'rm -rf "$GRAPH_TMP"' EXIT
  graph_review_prepare "$tmp/review" "$head" HEAD false staged "" "$langs" "$repo" || die "커밋 영향 분석을 만들지 못했습니다."
  endStamp=$(graph_review_stamp) || die "스테이지 식별자를 다시 읽지 못했습니다."
  awk -F'\t' -v changes="$tmp/review/changes" -v current="$tmp/review/a/rec.files" -v before="$tmp/review/b/rec.files" \
      -v stamp="$startStamp" -v stale="$([ "$startStamp" = "$endStamp" ] && echo false || echo true)" \
      -v head="$head" -v branch="$branch" "$(graph_awk_lib)$(graph_awk_commit_impact)" \
      "$tmp/review/changes" "$tmp/review/a/rec.files" "$tmp/review/b/rec.files" > "$tmp/out" || die "커밋 영향 분석을 정리하지 못했습니다."
  graph_write "$tmp/out" "${out:--}" json "$opn" ""
}

graph_awk_commit_impact() {
  cat <<'AWKEOF'
function testpath(p, b) {
  p=tolower(p); b=baseof(p)
  return p ~ /(^|\/)(tests?|__tests__|specs?)(\/|$)/ || p ~ /[._](test|spec)\.[^\/]+$/ || b ~ /^test_/ || b ~ /tests?\.[^.]+$/
}
function teststem(p, s) {
  s=tolower(stemof(p)); sub(/^test_/, "", s); sub(/([._-](test|spec)|tests?)$/, "", s); return s
}
function route(id, s, at, count) {
  s=""; at=id; count=0
  while (at!="" && count++<=nq) {s=s (s!=""?",":"") jstr(at); at=NEXT[at]}
  return "[" s "]"
}
function impactrow(id) {
  return "{\"path\":" jstr(id) ",\"depth\":" DEPTH[id] ",\"via\":" route(id) ",\"heuristic\":" (HEUR[id]?"true":"false") "}"
}
FILENAME==changes {
  CH[$2]=$1; OLD[$2]=$3; ORDER[++nc]=$2
  if ($1~/^R/ && $3!="") RENAME[$3]=$2
  if ($1=="D") DELETED[$2]=1
  next
}
$1==1 {
  id=$2
  if (FILENAME==before && id in RENAME) id=RENAME[id]
  if (!(id in KIND)) NORDER[++nn]=id
  if (FILENAME==current || !(id in KIND)) {
    KIND[id]=$3
    ANALYZED[id]=($3=="file" && $6 ~ /"analysis":"(static-import|compiler-index|name-heuristic|swift-index)"/)
  }
  if (FILENAME==current) CURRENT[id]=1
  next
}
$1==2 {
  s=$2; t=$3
  if (FILENAME==before) {
    if (!(s in DELETED) && !(t in DELETED) && !(s in RENAME) && !(t in RENAME)) next
    if (s in RENAME) s=RENAME[s]
    if (t in RENAME) t=RENAME[t]
  }
  if (!((s,t) in EDGE)) {EDGE[s,t]=1; REV[t,++NREV[t]]=s; EH[s,t]=($6=="h")}
  else if ($6!="h") EH[s,t]=0
  next
}
END {
  for(i=1;i<=nc;i++) {
    id=ORDER[i]; SEED[id]=1; DEPTH[id]=0; Q[++nq]=id; STEM[teststem(id)]=1
    if(ANALYZED[id]) analyzed++
  }
  # 파일의 역방향 의존을 다중 시작점 BFS로 따라가며 순환과 중복을 한 번만 방문한다.
  for(q=1;q<=nq;q++) {
    t=Q[q]
    for(i=1;i<=NREV[t];i++) {
      s=REV[t,i]; if(s in DEPTH || KIND[s]!="file") continue
      DEPTH[s]=DEPTH[t]+1; NEXT[s]=t; HEUR[s]=HEUR[t]||EH[s,t]; Q[++nq]=s
    }
  }
  printf "{\"schemaVersion\":1,\"tool\":\"gitch graph review\",\"scope\":\"staged\",\"stamp\":%s,\"snapshot\":%s,\"headSha\":%s,\"branch\":%s,\"stale\":%s,\"changed\":[", jstr(stamp),jstr(stamp),jstr(head),jstr(branch),stale
  for(i=1;i<=nc;i++) {
    id=ORDER[i]
    printf "%s{\"path\":%s,\"status\":%s,\"analyzed\":%s%s}",(i>1?",":""),jstr(id),jstr(CH[id]),(ANALYZED[id]?"true":"false"),(OLD[id]!=""?",\"oldPath\":" jstr(OLD[id]):"")
  }
  printf "],\"direct\":["; emitted=0
  for(i=1;i<=nq;i++) if(DEPTH[Q[i]]==1) printf "%s%s",(emitted++?",":""),impactrow(Q[i])
  printf "],\"indirect\":["; emitted=0
  for(i=1;i<=nq;i++) if(DEPTH[Q[i]]>1) printf "%s%s",(emitted++?",":""),impactrow(Q[i])
  printf "],\"tests\":["; emitted=0
  for(i=1;i<=nn;i++) {
    id=NORDER[i]; if(!CURRENT[id] || KIND[id]!="file" || !testpath(id)) continue
    if (id in DEPTH) {kind="dependency"; depth=DEPTH[id]; h=HEUR[id]}
    else if (nc && teststem(id) in STEM) {kind="name"; depth=0; h=1}
    else continue
    printf "%s{\"path\":%s,\"kind\":%s,\"depth\":%d,\"heuristic\":%s}",(emitted++?",":""),jstr(id),jstr(kind),depth,(h?"true":"false")
  }
  printf "],\"coverage\":{\"changed\":%d,\"analyzed\":%d,\"unsupported\":%d},\"limitations\":[",nc,analyzed,nc-analyzed
  printf "%s,%s,%s]}\n",jstr("Static dependencies may omit dynamic references and unsupported syntax."),jstr("Test candidates are inferred from dependency paths or file names; tests have not been run."),jstr("Only staged files are selected; unstaged edits and untracked files are excluded.")
}
AWKEOF
}

graph_review_mark() {
  awk -F'\t' -v changes="$1" "$(graph_awk_lib)"'BEGIN {OFS="\t"; while((getline < changes)>0) {CH[$2]=$1; OLD[$2]=$3}}
    $1==1 {N[$2]=1}
    $1==1 && ($2 in CH) { $6=$6 ($6!=""?",":"") "\"changed\":true,\"changeStatus\":" jstr(CH[$2]); if(OLD[$2]!="") $6=$6 ",\"oldPath\":" jstr(OLD[$2]); if($6!~/"status":/) $6=$6 ",\"status\":\"changed\"" } {print}
    END {for(id in CH)if(!(id in N)) {
      attrs="\"path\":" jstr(id) ",\"analysis\":\"unresolved\",\"changed\":true,\"changeStatus\":" jstr(CH[id]) ",\"status\":" jstr(CH[id]=="D"?"removed":"changed")
      if(CH[id]=="D")attrs=attrs ",\"deleted\":true"
      if(OLD[id]!="")attrs=attrs ",\"oldPath\":" jstr(OLD[id])
      print "1",id,"file",baseof(id),"unknown",attrs
      print "0","diagnostic","{\"code\":\"UNANALYZED_CHANGE\",\"severity\":\"warning\",\"file\":" jstr(id) ",\"message\":\"Changed file is listed, but its dependency syntax is not supported by this analysis.\"}"
    }}' "$2"
}

graph_diff_cmd() {   # [기준] [files|modules|tree] [옵션] [폴더]
  local rel="" base="" fmt="" out="" opn=auto dir="" noext="" langs="" a bpend=""
  local -a pend=()
  local top prefix repo tmp bsha bname shortbase fancy="" analysisScope=worktree merge=false
  while [ $# -gt 0 ]; do
    a=$1
    case "$a" in
      files|file) rel=files ;;
      modules|module) rel=modules ;;
      tree) rel=tree ;;
      changes|change) die "changes 는 비교하지 않습니다 — files · modules · tree 중에서 고릅니다." ;;
      --scope) shift; analysisScope=${1:-} ;;
      --scope=*) analysisScope=${a#*=} ;;
      --base) shift; base=${1:-}; [ -n "$base" ] || die "--base 뒤에 커밋이나 브랜치가 필요합니다." ;;
      --base=*) base=${a#*=} ;;
      --format|-f) shift; fmt=${1:-} ;;
      --format=*) fmt=${a#*=} ;;
      --json) fmt=json ;;
      --out|-o) shift; out=${1:-}; [ -n "$out" ] || die "--out 뒤에 파일 이름이 필요합니다 (- 는 표준출력)." ;;
      --out=*) out=${a#*=} ;;
      --open) opn=1 ;;
      --no-open) opn=0 ;;
      --no-external) noext=1 ;;
      --lang|-l) shift; langs=${1:-}; [ -n "$langs" ] || die "--lang 뒤에 언어가 필요합니다 (예: swift, ts,js)." ;;
      --lang=*) langs=${a#*=} ;;
      -h|--help) say "$GRAPH_DIFF_USAGE"; return 0 ;;
      -*) die "알 수 없는 옵션: $a"$'\n'"$GRAPH_DIFF_USAGE" ;;
      *)
        if [ -z "$base" ] && git rev-parse --verify --quiet "$a^{commit}" >/dev/null 2>&1; then base=$a
        elif [ -z "$dir" ] && [ -d "$a" ]; then dir=$a
        else pend+=("$a"); fi ;;
    esac
    shift
  done
  for a in ${pend[@]+"${pend[@]}"}; do   # 지금 폴더에서 커밋도 폴더도 아닌 것: 계정 폴더의 저장소 이름이면 그 저장소, 아니면 (그 저장소의) 기준
    if [ -z "$dir" ] && graph_find_one "$a"; then dir=$GRAPH_FOUND
    elif [ -z "$base" ]; then base=$a; bpend=1
    else die "커밋도 폴더도 아닙니다: $a"$'\n'"$GRAPH_DIFF_USAGE"; fi
  done
  if [ -n "$langs" ]; then
    langs=$(graph_langs "$langs") && [ -n "$langs" ] || die "--lang 은 Java · TS · Python · C · C++ · C# · PHP · Ruby 등 언어 이름이나 확장자로 고릅니다 (쉼표로 여럿, graph --help)."
  fi
  case "$analysisScope" in worktree|staged|committed) ;; *) die "--scope 은 worktree, staged, committed 중 하나입니다." ;; esac
  rel=${rel:-files}; graph_pick_dir "$dir"; dir=$GRAPH_DIR
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ] || die "git 저장소 안의 폴더가 아닙니다: $dir"
  prefix=$(git -C "$dir" rev-parse --show-prefix 2>/dev/null)
  repo=$(graph_repo_name "$dir" "$top")
  out=$(posix_path "$out")   # Windows 의 C:\… · C:/… 도 절대 경로
  case "$out" in ""|-|/*) ;; *) out="$PWD/$out" ;; esac
  if [ -z "$fmt" ]; then
    case "$(lower "$out")" in
      *.json) fmt=json ;; *.html|*.htm) fmt=html ;; *.txt) fmt=text ;;
      *) if fancy_out; then fmt=text; else fmt=json; fi ;;
    esac
  fi
  fmt=$(lower "$fmt")
  case "$fmt" in text|json|html) ;; *) die "--format 은 text, json, html 중 하나입니다: $fmt" ;; esac
  [ -z "$out" ] && case "$fmt" in html) out="${TMPDIR:-/tmp}"; out="${out%/}/gitch-graph/$repo-$rel-diff.html" ;; *) out=- ;; esac

  cd "$top" || die "저장소로 이동하지 못했습니다: $top"
  if [ "${GRAPH_REVIEW_EMPTY_BASE:-}" = 1 ] && [ "$analysisScope" = staged ]; then
    bsha=""; bname="Empty tree"
  elif [ -z "$base" ]; then
    graph_default_base || die "비교할 기준을 정하지 못했습니다 — 커밋이나 브랜치를 주세요 (예: gitch graph diff main)."
    base=$GRAPH_BASE; bname=$GRAPH_BASE_NAME; merge=true
  elif [ "${base%...}" != "$base" ]; then   # 기준... — 그 기준과 이 브랜치가 갈라진 곳(merge-base). 기준이 그 뒤로 앞서 나가도 그 커밋이 뺀 것으로 보이지 않게, 이름은 기준 그대로
    bname=${base%...}; merge=true
    git rev-parse --verify --quiet "$bname^{commit}" >/dev/null 2>&1 || die "커밋이 아닙니다: $bname"
    base=$(git merge-base HEAD "$bname" 2>/dev/null) && [ -n "$base" ] || die "$bname 와(과) 이 브랜치에는 공통 커밋이 없습니다."
  else bname=$base; fi
  if [ "${GRAPH_REVIEW_EMPTY_BASE:-}" != 1 ]; then
    bsha=$(git rev-parse --verify "$base^{commit}" 2>/dev/null) || { [ -n "$bpend" ] && die "커밋도 폴더도 아닙니다: $base"$'\n'"$GRAPH_DIFF_USAGE"; die "커밋이 아닙니다: $base"; }
  fi
  shortbase=$(git rev-parse --short "$bsha" 2>/dev/null) || shortbase=empty
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/gitch-graph.XXXXXX") || die "임시 폴더를 만들지 못했습니다."
  GRAPH_TMP=$tmp
  trap 'rm -rf "$GRAPH_TMP"' EXIT
  fancy_out && [ "$fmt" != json ] && fancy=1
  [ -n "$fancy" ] && printf '  %s' "${DIM}$(graph_rel_word "$rel") 비교하는 중 ($bname → 작업 트리)…${RESET}"
  git ls-files -z > "$tmp/files.z" && graph_safe_file_list "$tmp/files.z" "$tmp/files" "$tmp/unsafe-paths.records" || die "추적하는 파일 목록을 읽지 못했습니다 (git ls-files)."
  graph_review_prepare "$tmp/review" "$bsha" "$bname" "$merge" "$analysisScope" "$prefix" "$langs" "$repo" "$noext" || die "변경 리뷰를 만들지 못했습니다."
  if [ "$rel" = files ]; then
    cp "$tmp/review/review.records" "$tmp/rec"
  elif [ "$rel" = modules ]; then
    awk -v rel=modules "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_merge)" "$tmp/review/b/rec.modules" "$tmp/review/a/rec.modules" | LC_ALL=C sort > "$tmp/rec"
  else
    local sourceRoot=$PWD
    [ "$analysisScope" = worktree ] || sourceRoot="$tmp/review/a/src"
    graph_review_tree "$tmp/review/a/files" "$sourceRoot" "$prefix" "$repo" "$langs" > "$tmp/rec.a"
    graph_review_tree "$tmp/review/b/files" "$tmp/review/b/src" "$prefix" "$repo" "$langs" > "$tmp/rec.b"
    awk -v rel=tree "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_merge)" "$tmp/rec.b" "$tmp/rec.a" | LC_ALL=C sort > "$tmp/rec"

  fi
  [ -n "$fancy" ] && printf '\r\033[K'
  graph_meta "$rel" "$repo" "$prefix" "$langs"
  case "$fmt" in
    text) awk -F'\t' -v rel="$rel" -v relword="$(graph_rel_word "$rel")" -v base="$bname" -v bsha="$bsha" \
            -v diffscope="$analysisScope" -v bold="$BOLD" -v green="$GREEN" -v red="$RED" -v yellow="$YELLOW" -v dim="$DIM" -v reset="$RESET" \
            "$(graph_awk_lib)$(graph_awk_difftext)" "$tmp/rec" > "$tmp/out" ;;
    json) awk -F'\t' "$(graph_awk_lib)$(graph_awk_diffonly)" "$tmp/rec" | \
            graph_json "${GRAPH_META[@]}" -v diffhead="$analysisScope" -v reviewfile="$tmp/review/review.json" -v diffbase="$shortbase" -v diffname="$bname" > "$tmp/out" ;;
    html)
      # Keep all existing navigation tabs in a diff report. Every structural view
      # uses the same selected source snapshot; co-change remains observed HEAD history.
      local r sourceRoot=$PWD
      [ "$analysisScope" = worktree ] || sourceRoot="$tmp/review/a/src"
      for r in files modules tree changes; do
        if [ "$r" = "$rel" ]; then cp "$tmp/rec" "$tmp/view.$r"; continue; fi
        case "$r" in
          files) cp "$tmp/review/review.records" "$tmp/view.$r" ;;
          modules) awk -v rel=modules "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_merge)" "$tmp/review/b/rec.modules" "$tmp/review/a/rec.modules" > "$tmp/view.$r" ;;
          tree)
            graph_review_tree "$tmp/review/a/files" "$sourceRoot" "$prefix" "$repo" "$langs" > "$tmp/tree.a"
            graph_review_tree "$tmp/review/b/files" "$tmp/review/b/src" "$prefix" "$repo" "$langs" > "$tmp/tree.b"
            awk -v rel=tree "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_merge)" "$tmp/tree.b" "$tmp/tree.a" > "$tmp/view.$r" ;;
          changes) graph_collect "$tmp/review/a" changes "$prefix" "$noext" '' 1000 30 2 0 '' "$repo" "$langs" > "$tmp/view.$r" ;;
        esac
      done
      { printf '{"initial":"%s","views":{' "$rel"; local count=0
        for r in files modules changes tree; do
          [ "$count" = 0 ] || printf ','
          printf '"%s":' "$r"
          if [ "$r" = changes ]; then graph_json "${GRAPH_META[@]}" -v rel="$r" "$tmp/view.$r"
          else graph_json "${GRAPH_META[@]}" -v rel="$r" -v diffhead="$analysisScope" -v diffbase="$shortbase" -v diffname="$bname" "$tmp/view.$r"; fi
          count=$((count+1))
        done
        printf '},"review":'; cat "$tmp/review/review.json"
        printf '}\n'; } | graph_html > "$tmp/out" ;;
  esac
  graph_write "$tmp/out" "$out" "$fmt" "$opn" "$fancy" || return 1
  [ "$out" = - ] || { [ "$fmt" != json ] || [ -z "$MACHINE_JSON" ]; } || return 0
  [ "$out" = - ] || { ok "의존 비교 ($(graph_rel_word "$rel")): $bname($bsha) → 작업 트리"; say "  $(tilde "$out")"; say "GRAPH_FILE=$out"; }
  return 0
}

graph_copy_atomic() {
  local stage
  mkdir -p "$(dirname "$2")" 2>/dev/null || die "폴더를 만들지 못했습니다: $2"
  stage=$(mktemp "$(dirname "$2")/.gitch-graph.XXXXXX") || die "쓰지 못했습니다: $2"
  if ! { cat "$1" > "$stage" && mv -f "$stage" "$2"; }; then rm -f "$stage"; die "쓰지 못했습니다: $2"; fi
}

graph_write() {   # $1 만든 파일 $2 쓸 곳(- 는 표준출력) $3 형식 $4 열기(1 · 0 · auto) $5 사람 터미널
  if [ "$2" = - ]; then cat "$1"; return 0; fi
  graph_copy_atomic "$1" "$2"
  if [ "$4" = 1 ] || { [ "$4" = auto ] && [ -n "$5" ] && [ "$3" = html ]; }; then
    if [ "$3" = json ] && [ -n "$MACHINE_JSON" ]; then graph_open "$2" >/dev/null 2>&1
    else graph_open "$2" && dim "  열었습니다. (열지 않으려면 --no-open)"; fi
  fi
  [ "$3" != json ] || [ -z "$MACHINE_JSON" ] || cat "$1"
  return 0
}

graph_repo_name() {   # $1 폴더 $2 저장소 뿌리 — 워크트리여도 본 저장소 이름
  local r
  r=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  case "$r" in */.git) basename "${r%/.git}" ;; *) basename "$2" ;; esac
}

graph_rules_init() {   # $1 규칙 파일 — 예시가 든 파일을 만든다 (있으면 그대로)
  [ -e "$1" ] && die "이미 있습니다: $1"
  mkdir -p "$(dirname "$1")" || die "폴더를 만들지 못했습니다: $(dirname "$1")"
  cat > "$1" <<'RULES'
# gitch graph check 규칙 — 한 줄에 하나, # 뒤는 주석. 확인: gitch graph check
# 패턴: files 는 경로(* 한 마디 · ** 여러 폴더 · 폴더 이름만 쓰면 그 아래 전부), modules 는 모듈 이름(*Feature)

[modules]
# no-cycles                              # 모듈끼리 순환 의존 금지
# forbid  *Feature -> *Feature           # 기능 모듈끼리 서로 기대지 않는다 (같은 모듈 안은 괜찮다)
# layers  *App > *Feature > Domain* > Core*   # 왼쪽이 오른쪽에 기대는 것만 된다

[files]
# no-cycles src/**                       # 그 폴더 안 파일끼리 순환 금지
# forbid  src/ui -> src/db               # 화면 코드가 DB 코드를 바로 쓰지 않는다
# allow   src/ui/debug -> src/db         # 위 규칙의 예외
RULES
  ok "규칙 파일을 만들었습니다: $1"
  dim "  # 를 지우고 저장소에 맞게 고친 뒤: gitch graph check"
}

graph_check_cmd() {   # [--rules 파일] [--base 기준] [--format text|json|html] [--out 파일] [--init] [폴더]
  local rules="" base="" fmt="" out="" opn=auto dir="" init="" a top prefix repo tmp rel rels bsha="" bname="" fancy="" n_rules shown darg
  local n_err=0
  while [ $# -gt 0 ]; do
    a=$1
    case "$a" in
      --rules|-r) shift; rules=${1:-}; [ -n "$rules" ] || die "--rules 뒤에 규칙 파일이 필요합니다." ;;
      --rules=*) rules=${a#*=} ;;
      --base) shift; base=${1:-}; [ -n "$base" ] || die "--base 뒤에 커밋이나 브랜치가 필요합니다." ;;
      --base=*) base=${a#*=} ;;
      --format|-f) shift; fmt=${1:-} ;;
      --format=*) fmt=${a#*=} ;;
      --json) fmt=json ;;
      --out|-o) shift; out=${1:-}; [ -n "$out" ] || die "--out 뒤에 파일 이름이 필요합니다 (- 는 표준출력)." ;;
      --out=*) out=${a#*=} ;;
      --open) opn=1 ;;
      --no-open) opn=0 ;;
      --init) init=1 ;;
      -h|--help) say "$GRAPH_CHECK_USAGE"; return 0 ;;
      -*) die "알 수 없는 옵션: $a"$'\n'"$GRAPH_CHECK_USAGE" ;;
      *) [ -z "$dir" ] || die "폴더는 하나만 줄 수 있습니다: $dir, $a"; dir=$a ;;
    esac
    shift
  done
  darg=$dir; graph_pick_dir "$dir"; dir=$GRAPH_DIR
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && [ -n "$top" ] || die "git 저장소 안의 폴더가 아닙니다: $dir"
  prefix=$(git -C "$dir" rev-parse --show-prefix 2>/dev/null)
  repo=$(graph_repo_name "$dir" "$top")
  rules=$(posix_path "$rules"); out=$(posix_path "$out")   # Windows 의 C:\… · C:/… 도 절대 경로
  case "$rules" in "") rules="$top/$GRAPH_RULES_FILE" ;; /*) ;; *) rules="$PWD/$rules" ;; esac
  if [ -n "$init" ]; then
    if [ "$fmt" = json ]; then
      graph_rules_init "$rules" >&2
      printf '{"schemaVersion":1,"tool":"gitch graph check","file":%s,"initialized":true,"ok":true,"base":null,"violations":[]}\n' "$(json_str "$rules")"
    else graph_rules_init "$rules"; fi
    return 0
  fi
  [ -f "$rules" ] || die "규칙 파일이 없습니다: $(tilde "$rules")"$'\n'"  예시로 시작하기: gitch graph check --init${darg:+ $darg}"
  case "$rules" in "$top"/*) shown=${rules#"$top"/} ;; *) shown=$(tilde "$rules") ;; esac   # 결과에 적는 이름 — 저장소 안이면 상대 경로
  case "$out" in ""|-|/*) ;; *) out="$PWD/$out" ;; esac
  if [ -z "$fmt" ]; then
    case "$(lower "$out")" in
      *.json) fmt=json ;; *.html|*.htm) fmt=html ;; *.txt) fmt=text ;;
      *) if fancy_out; then fmt=text; else fmt=json; fi ;;
    esac
  fi
  fmt=$(lower "$fmt")
  case "$fmt" in text|json|html) ;; *) die "--format 은 text, json, html 중 하나입니다: $fmt" ;; esac
  [ -z "$out" ] && case "$fmt" in html) out="${TMPDIR:-/tmp}"; out="${out%/}/gitch-graph/$repo-check.html" ;; *) out=- ;; esac

  cd "$top" || die "저장소로 이동하지 못했습니다: $top"
  # 규칙 글 검사 — 틀린 줄이 있으면 무엇이 틀렸는지 모두 알리고 멈춘다
  rels=$(awk '{ sub(/#.*/, ""); gsub(/[ \t]/, "") } /^\[[a-z]+\]$/ { s = substr($0, 2, length($0) - 2); next } $0 != "" { u[s == "" ? "files" : s] = 1 } END { for (k in u) print k }' "$rules" | LC_ALL=C sort | tr '\n' ' ')
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/gitch-graph.XXXXXX") || die "임시 폴더를 만들지 못했습니다."
  GRAPH_TMP=$tmp
  trap 'rm -rf "$GRAPH_TMP"' EXIT
  awk -v rules="$rules" -v rel="__syntax__" "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_check)" /dev/null > "$tmp/syntax"
  if grep -q '^X' "$tmp/syntax"; then
    [ -z "$MACHINE_JSON" ] || die "규칙 파일에 틀린 줄이 있습니다: $(tilde "$rules")"$'\n'"$(awk -F'\t' '$1 == "X" { printf "%s번 줄: %s\n", $2, $3 }' "$tmp/syntax")"
    err "규칙 파일에 틀린 줄이 있습니다: $(tilde "$rules")"
    awk -F'\t' '$1 == "X" { printf "  %s번 줄: %s\n", $2, $3 }' "$tmp/syntax" >&2
    exit 1
  fi
  if [ -n "$base" ]; then
    bsha=$(git rev-parse --short "$base^{commit}" 2>/dev/null) || die "커밋이 아닙니다: $base"; bname=$base
  fi
  fancy_out && [ "$fmt" != json ] && fancy=1
  [ -n "$fancy" ] && printf '  %s' "${DIM}의존 규칙 검사하는 중…${RESET}"
  git ls-files -z > "$tmp/files.z" && graph_safe_file_list "$tmp/files.z" "$tmp/files" "$tmp/unsafe-paths.records" || die "추적하는 파일 목록을 읽지 못했습니다 (git ls-files)."
  [ -n "$bsha" ] && { mkdir -p "$tmp/b"; graph_base_extract "$bsha" "$tmp/b" || die "기준 커밋의 파일을 풀지 못했습니다: $bsha"; }
  : > "$tmp/v"
  for rel in $rels; do
    if [ -n "$bsha" ]; then   # 비교할 때는 양쪽을 같은 방법으로
      GITSW_SWIFT_DESCRIBE=0 GITCH_SWIFT_INDEX='' graph_side "$tmp" "$rel" "$prefix" "" "$repo" "" > "$tmp/rec.$rel" || die "그래프를 만들지 못했습니다 ($rel)."
      GITSW_SWIFT_DESCRIBE=0 GITCH_SWIFT_INDEX='' graph_side "$tmp/b" "$rel" "$prefix" "" "$repo" "" "$bsha" > "$tmp/brec.$rel" || die "그래프를 만들지 못했습니다 ($rel, $bsha)."
      awk -v rules="$rules" -v rel="$rel" "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_check)" "$tmp/brec.$rel" | awk -F'\t' -v r="$rel" '$1 == "V" { print r "\t" $4 "\t" $6 "\t" $7 }' > "$tmp/old.$rel"
    else
      graph_side "$tmp" "$rel" "$prefix" "" "$repo" "" > "$tmp/rec.$rel" || die "그래프를 만들지 못했습니다 ($rel)."
      : > "$tmp/old.$rel"
    fi
    # 줄: 관계 세기 줄번호 규칙 종류 시작 끝 상태(new · existing) — 기준에도 있던 위반(같은 규칙 글 · 같은 끝점)은 existing
    awk -v rules="$rules" -v rel="$rel" "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_check)" "$tmp/rec.$rel" | \
      awk -F'\t' -v r="$rel" -v old="$tmp/old.$rel" 'BEGIN { while ((getline l < old) > 0) O[l] = 1 }
        $1 == "V" { print r "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6 "\t" $7 "\t" (((r "\t" $4 "\t" $6 "\t" $7) in O) ? "existing" : "new") }' >> "$tmp/v"
  done
  [ -n "$fancy" ] && printf '\r\033[K'
  n_rules=$(awk -F'\t' '$1 == "R" { n += $2 } END { print n + 0 }' "$tmp/syntax")
  n_err=$(awk -F'\t' '$8 != "existing" && $2 == "error" { e++ } END { print e + 0 }' "$tmp/v")   # 기준에도 있던 위반 · 경고는 실패로 세지 않는다
  case "$fmt" in
    text) graph_check_text "$tmp/v" "$shown" "$n_rules" "$bname" "$bsha" > "$tmp/out" ;;
    json) graph_check_json "$tmp/v" "$shown" "$bsha" "$n_err" > "$tmp/out" ;;
    html)
      { printf '{"initial":"%s","views":{' "${rels%% *}"; a=0
        for rel in $rels; do
          [ $a -gt 0 ] && printf ','
          graph_meta "$rel" "$repo" "$prefix" ""
          printf '"%s":' "$rel"; graph_json "${GRAPH_META[@]}" "$tmp/rec.$rel"; a=$((a + 1))
        done
        printf '},"rules":'; graph_check_json "$tmp/v" "$shown" "$bsha" "$n_err"; printf '}\n'; } | graph_html > "$tmp/out" ;;
  esac
  graph_write "$tmp/out" "$out" "$fmt" "$opn" "$fancy" || return 1
  [ "$out" = - ] || { [ "$fmt" = json ] && [ -n "$MACHINE_JSON" ]; } || { say "  $(tilde "$out")"; say "GRAPH_FILE=$out"; }
  [ "$n_err" -eq 0 ]
}

graph_rules_eval() {   # $1 임시 폴더(rec.files · rec.modules) $2 규칙 파일 → 규칙 결과 JSON (html 분석 창의 「규칙 위반」)
  local rel
  : > "$1/v"
  for rel in files modules; do
    [ -f "$1/rec.$rel" ] || continue
    awk -v rules="$2" -v rel="$rel" "$(graph_awk_lib)$(graph_awk_scc)$(graph_awk_check)" "$1/rec.$rel" | \
      awk -F'\t' -v r="$rel" '$1 == "V" { print r "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6 "\t" $7 "\tnew" }' >> "$1/v"
  done
  graph_check_json "$1/v" "$2" "" "$(awk -F'\t' '$2 == "error" { n++ } END { print n + 0 }' "$1/v")"
}

graph_check_text() {   # $1 위반 줄들 $2 규칙 파일 $3 규칙 수 $4 기준 이름 $5 기준 커밋 → 사람이 읽는 결과
  awk -F'\t' -v rules="$(tilde "$2")" -v nr="$3" -v base="$4" -v bsha="$5" -v green="$GREEN" -v red="$RED" -v yellow="$YELLOW" -v dim="$DIM" -v bold="$BOLD" -v reset="$RESET" '
    function show(x) { gsub("\034", " · ", x); return x }
    { line = sprintf("%s · %s번 줄 「%s」: %s", $1, $3, $4, ($5 == "no-cycles" ? "순환 " show($6) : $6 " → " $7)) }
    $8 == "existing" { O[++no] = line; next }
    $2 == "error" { E[++ne] = line; next }
    { W[++nw] = line }
    END {
      printf "%s의존 규칙 검사%s (%s · 규칙 %d개%s)\n", bold, reset, rules, nr, (bsha != "" ? " · 기준 " base "(" bsha ")" : "")
      for (i = 1; i <= ne; i++) printf "  %s✘ %s%s\n", red, E[i], reset
      for (i = 1; i <= nw; i++) printf "  %s! %s (이름만으로 추정한 연결)%s\n", yellow, W[i], reset
      if (no) { printf "  %s기준에도 있던 위반 %d개 — 실패로 세지 않음%s\n", dim, no, reset; for (i = 1; i <= no && i <= 20; i++) printf "  %s= %s%s\n", dim, O[i], reset }
      if (ne) printf "%s✘ 위반 %d개%s%s\n", red, ne, (nw ? sprintf(" · 경고 %d개", nw) : ""), reset
      else printf "%s✔ 위반 없음%s%s\n", green, (nw ? sprintf(" (경고 %d개)", nw) : ""), reset
    }' "$1"
}

graph_check_json() {   # $1 위반 줄들 $2 규칙 파일 $3 기준 커밋 $4 위반 수 → {"file", "base", "ok", "violations": […]}
  awk -F'\t' -v rules="$2" -v base="$3" -v nerr="$4" "$(graph_awk_lib)"'
    function list(s,   n, a, i, r) { n = split(s, a, "\034"); r = ""; for (i = 1; i <= n; i++) r = r (i > 1 ? "," : "") jstr(a[i]); return r }
    {
      v = "{\"relation\":" jstr($1) ",\"severity\":" jstr($2) ",\"line\":" ($3 + 0) ",\"rule\":" jstr($4) ",\"kind\":" jstr($5)
      if ($5 == "no-cycles") v = v ",\"nodes\":[" list($6) "]"
      else v = v ",\"source\":" jstr($6) ",\"target\":" jstr($7)
      V[++n] = v ",\"existing\":" ($8 == "existing" ? "true" : "false") "}"
    }
    END {
      printf "{\"schemaVersion\":1,\"tool\":\"gitch graph check\",\"file\":%s,\"base\":%s,\"ok\":%s,\"violations\":[", jstr(rules), (base == "" ? "null" : jstr(base)), (nerr + 0 == 0 ? "true" : "false")
      for (i = 1; i <= n; i++) printf "%s\n  %s", (i > 1 ? "," : ""), V[i]
      printf "%s]}\n", (n ? "\n" : "")
    }' "$1"
}

# awk 프로그램은 함수 안 heredoc 에 둔다 — 최상위 변수로 읽으면 gitch 를 부를 때마다(훅 포함) 수십 KB 를 한 글자씩 읽게 된다
graph_awk_lib() {
  graph_languages | awk -F'|' '
    BEGIN { print "BEGIN {" }
    {
      printf "  LANGEXT[\"%s\"] = \"%s\"\n", $1, $3
      n = split($3, a, " "); for (i = 1; i <= n; i++) printf "  EXTLANG[\"%s\"] = \"%s\"\n", a[i], $1
      n = split($5, a, " "); for (i = 1; i <= n; i++) if (a[i] != "") eco[a[i]] = eco[a[i]] (eco[a[i]] == "" ? "" : ",") $1
    }
    END { for (e in eco) printf "  ECOLANG[\"%s\"] = \"%s\"\n", e, eco[e]; print "}" }'
  cat <<'AWKEOF'
function jstr(s) {
  if (s ~ /["\\\001-\037]/) {   # 고칠 글자가 있을 때만 — 노드 · 연결이 수십만 개여도 빠르게
    gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); gsub(/\t/, "\\t", s); gsub(/\r/, "\\r", s); gsub(/\n/, "\\n", s)
    gsub(/[\001-\037]/, "", s)
  }
  return "\"" s "\""
}
function dirof(p) { return match(p, /\/[^\/]*$/) ? substr(p, 1, RSTART - 1) : "" }
function baseof(p) { return match(p, /\/[^\/]*$/) ? substr(p, RSTART + 1) : p }
function extof(p,   b) { b = baseof(p); return match(b, /\.[^.]*$/) && RSTART > 1 ? substr(b, RSTART + 1) : "" }
function stemof(p,   b) { b = baseof(p); return match(b, /\.[^.]*$/) && RSTART > 1 ? substr(b, 1, RSTART - 1) : b }
function joinp(d, f) { return d == "" ? f : (f == "" ? d : d "/" f) }
function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
function inscope(p) { return scope == "" || index(p, scope) == 1 }
function normp(p,   n, a, o, i, k, r) {   # a/./b/../c → a/c, 저장소 밖으로 나가면 "\001"
  n = split(p, a, "/"); k = 0
  for (i = 1; i <= n; i++) {
    if (a[i] == "" || a[i] == ".") continue
    if (a[i] == "..") { if (k == 0) return "\001"; k--; continue }
    o[++k] = a[i]
  }
  r = ""
  for (i = 1; i <= k; i++) r = r (i > 1 ? "/" : "") o[i]
  return r
}
function closeness(a, b,   n, m, x, y, i, c) {   # 두 파일이 같이 가진 위 폴더 수 — 같은 이름 후보 중 가까운 것을 고를 때
  n = split(a, x, "/"); m = split(b, y, "/"); c = 0
  for (i = 1; i < n && i < m; i++) { if (x[i] != y[i]) break; c++ }
  return c
}
function sortkeys(arr, out,   k, n, i, j, t) {   # 배열 키를 정렬해 out[1..n] (작은 배열용)
  n = 0
  for (k in arr) out[++n] = k
  for (i = 2; i <= n; i++) { t = out[i]; for (j = i - 1; j >= 1 && out[j] > t; j--) out[j + 1] = out[j]; out[j + 1] = t }
  return n
}
function clean(s) { gsub(/[\t\r\n]/, " ", s); return s }
function jarr(s,   n, a, i, r) { n = split(s, a, "\034"); r = ""; for (i = 1; i <= n; i++) r = r (i > 1 ? "," : "") jstr(a[i]); return r }   # "a\034b" → "a","b"
function globre(g,   r, i, c, n, br) {   # Tuist glob → 정규식: ** 는 폴더 여럿, * 는 한 마디 안, {a,b} 는 둘 중 하나
  r = ""; n = length(g); br = 0
  for (i = 1; i <= n; i++) {
    c = substr(g, i, 1)
    if (c == "*") {
      if (substr(g, i + 1, 2) == "*/") { r = r "(.*/)?"; i += 2 }
      else if (substr(g, i + 1, 1) == "*") { r = r ".*"; i++ }
      else r = r "[^/]*"
    }
    else if (c == "?") r = r "[^/]"
    else if (c == "{") { r = r "("; br++ }
    else if (c == "}" && br) { r = r ")"; br-- }
    else if (c == "," && br) r = r "|"
    else if (index(".+()^$|[]{}\\", c)) r = r "\\" c
    else r = r c
  }
  return "^" r "$"
}
BEGIN { if (langs != "") { NLS = split(langs, LSA, ","); for (LSI = 1; LSI <= NLS; LSI++) LANGOK[LSA[LSI]] = 1 } }
function langok(p) { return langs == "" || (langof(p) in LANGOK) }   # --lang 으로 고른 언어의 파일인지
function ecook(eco,   n, a, i) {   # 모든 모듈 생태계가 공통 언어 목록을 따른다
  if (langs == "") return 1
  n = split(ECOLANG[eco], a, ",")
  for (i = 1; i <= n; i++) if (a[i] in LANGOK) return 1
  return 0
}
function langof(p,   e, b) {
  b = tolower(baseof(p)); e = tolower(extof(p))
  if (b == "cmakelists.txt") return "cmake"
  if (b ~ /^(gnumakefile|makefile)$/) return "make"
  if (b ~ /^dockerfile($|\.)/) return "docker"
  if (b == "gemfile" || b == "rakefile") return "ruby"
  return (e in EXTLANG) ? EXTLANG[e] : ""
}
# 노드 · 연결 모으기 — 같은 노드는 처음 것, 같은 연결(시작 · 끝 · 종류)은 횟수를 더하고 via(근거)는 다섯 개까지
function addnode(id, kind, label, group, attrs) {
  if (id == "" || (id in NK)) return
  NK[id] = kind; NL[id] = clean(label); NG[id] = group; NA[id] = attrs
}
function addedge(s, t, kind, w, h, via, extra,   k, method, confidence, file, ln, proof) {
  if (s == t || s == "" || t == "") return
  k = s "\034" t "\034" kind
  if (!(k in EW)) { EN++; EKEY[EN] = k; EH[k] = h; EXA[k] = extra }
  else if (!h) EH[k] = 0
  if (!h) PAIR[s "\034" t] = 1
  EW[k] += w
  file = (via in EX) ? via : (s in EX) ? s : ""
