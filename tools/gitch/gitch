  i=0; while [ $i -lt ${#O_RAW[@]} ]; do echo "- 조직 ${O_RAW[$i]} → ${O_ACC[$i]}"; i=$((i+1)); done
  echo ""
  echo "작업 흐름:"
  echo "- 커밋/push 전에 \`gitch preflight\` 를 실행한다. PREFLIGHT=STOP 이면 진행하지 말고 이유를 사용자에게 보고한다. WARN 이면 내용을 확인하고 필요하면 사용자에게 알린다."
  echo "- 커밋: 올릴 파일을 \`git add <파일>\` 로 고른 뒤 \`gitch c -m \"제목\" [-m \"본문\"]\`. 전부 올릴 때만 \`gitch c -a -m \"...\"\`. 커밋 메시지는 변경 내용을 요약해 직접 쓴다."
  echo "- push \`gitch p\` / 커밋+push \`gitch cp -m \"...\"\` / 받기 \`gitch pl\` / 기본 브랜치 따라가기 \`gitch up\` / 상태 \`gitch ck\`."
  case "$(lower "$CFG_AI_PUSH")" in
