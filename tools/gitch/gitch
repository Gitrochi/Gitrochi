}

# tree: "<blob> <크기> <경로>" 줄들 → 폴더 노드(파일 수 · 바이트 · 많은 확장자)와 포함 관계
graph_awk_tree() {
  cat <<'AWKEOF'
BEGIN { root = scope; sub(/\/$/, "", root); RID = (root == "") ? "./" : root "/"; RLABEL = (root == "") ? repo : root; if(safeList!="") { while((getline p < safeList)>0) SAFE[p]=1; close(safeList) } }
{
  if (NF == 2 && $2 == "missing") next
  sz = $2 + 0; p = $0; sub(/^[^ ]+ [^ ]+ /, "", p)
  if(safeList!="" && !(p in SAFE)) next
  if (p == "" || index(p, "\t") || (p in SEEN) || !inscope(p) || !langok(p)) next
  SEEN[p] = 1; NFILES++; TOTAL += sz
  e = tolower(extof(p)); if (e == "") e = "none"
  rel = (root == "") ? p : substr(p, length(root) + 2)
  n = split(rel, seg, "/")
  tnode(RID, RLABEL, 0, root); acc(RID, sz, e)
  par = RID; at = RID; d = root
  lim = (maxd > 0 && n - 1 > maxd) ? maxd : n - 1        # --depth 보다 깊은 폴더는 노드 없이 그 위 폴더에 합쳐 센다
  for (i = 1; i < n; i++) {
    d = joinp(d, seg[i]); id = d "/"
    if (!((par "\034" id) in LINK)) { LINK[par "\034" id] = 1; SUBD[par]++; if (i <= lim) addedge(par, id, "contains", 1, 0, "", "") }
    if (i <= lim) { tnode(id, seg[i], i, d); acc(id, sz, e); at = id }
    par = id
  }
  if (lim == n - 1) {
    HERE[at]++
    if (withfiles) { g = langof(p); if (g == "") g = e; addnode(p, "file", seg[n], g, "\"path\":" jstr(p) ",\"bytes\":" sz); addedge(at, p, "contains", 1, 0, "", "") }
  }
}
END {
  for (i = 1; i <= NT; i++) {
    id = TORD[i]
    addnode(id, "folder", TL[id], "folder", "\"path\":" jstr(TP[id]) ",\"depth\":" TD[id] ",\"files\":" TF[id] ",\"bytes\":" TB[id] ",\"filesHere\":" (HERE[id] + 0) ",\"dirs\":" (SUBD[id] + 0) ",\"exts\":" topext(id))
  }
  emit()
  printf "0\tfiles\t%d\n0\tbytes\t%d\n0\tmaxDepth\t%d\n", NFILES, TOTAL, maxd
  print "0\tnote\t폴더마다 files = 아래 모든 파일 수, bytes = 그 크기 합(" (treeSnapshot ? "선택한 비교 범위의 내용 기준" : "인덱스의 내용 기준") "), filesHere = 바로 아래 파일 수, exts = 많은 확장자 다섯 개."
}
function tnode(id, label, depth, path) { if (id in TD) return; TD[id] = depth; TL[id] = label; TP[id] = (path == "") ? "." : path; NT++; TORD[NT] = id }
function acc(id, sz, e) { TF[id]++; TB[id] += sz; if (!((id "\034" e) in TE)) TEL[id] = TEL[id] "\034" e; TE[id "\034" e]++ }
function topext(id,   n, a, i, j, best, bi, out, used, c) {   # 많은 확장자 다섯 개 → {"ts":12,...}
  n = split(TEL[id], a, "\034"); out = ""
  for (j = 1; j <= 5; j++) {
    best = -1; bi = 0
    for (i = 2; i <= n; i++) {
      if (a[i] in used) continue
      c = TE[id "\034" a[i]]
      if (c > best || (c == best && a[i] "" < a[bi] "")) { best = c; bi = i }
    }
    if (!bi) break
    used[a[bi]] = 1; out = out (out == "" ? "" : ",") jstr(a[bi]) ":" best
  }
  return "{" out "}"
}
AWKEOF
}

