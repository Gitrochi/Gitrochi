g_decide() {   # $1 ask|deny $2 이유 — 더 강한 결정만 반영
  case "$1" in
    deny) [ "$G_DEC" != deny ] && { G_DEC=deny; G_REASON="$2"; } ;;
    ask) [ -z "$G_DEC" ] && { G_DEC=ask; G_REASON="$2"; } ;;
  esac
  return 0
}
g_path() { local p; p=$(posix_path "$(expand_path "$1")"); case "$p" in /*) ;; *) p="$G_CWD/$p" ;; esac; printf '%s' "$p"; }
