  graph_languages | awk -F'|' -v want="$1" '
    { key[$1] = $1; n = split($3 " " $4, a, " "); for (i = 1; i <= n; i++) key[a[i]] = $1 }
    END {
      key["web"] = "ts,js,vue,svelte,astro,html,css,scss,less,mdx"; key["jvm"] = "kotlin,java,scala,groovy"
      n = split(tolower(want), a, ","); out = ""
      for (i = 1; i <= n; i++) { gsub(/^[ \t]+|[ \t]+$/, "", a[i]); if (a[i] == "") continue; if (!(a[i] in key)) exit 1; out = out (out == "" ? "" : ",") key[a[i]] }
