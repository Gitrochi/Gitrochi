  }
  for (i = 1; i <= NPOM; i++) {
    f = POM[i]; id = MVID[f]; if (id == "" || !inscope(f)) continue
    mnode(id, MVGROUP[f] ":" MVART[f], "maven", dirof(f), "project")
    s = xml_drop(xml_drop(xml_drop(MVTEXT[f], "dependencyManagement"), "build"), "profiles"); s = xml_value(s, "dependencies")
