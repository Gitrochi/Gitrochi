        const chk = (h) => { for (let i = 0; i < h.kids.length; i++) { const a = h.kids[i]; if (Math.hypot(a.x - h.x, a.y - h.y) + a.r > h.r + 0.5) bad++; for (let j = i + 1; j < h.kids.length; j++) { const b = h.kids[j]; if (Math.hypot(a.x - b.x, a.y - b.y) < a.r + b.r - 0.5) bad++; } chk(a); } };
        m.pk.roots.forEach(chk); return bad;
      }
      const L = visNodes;
      for (let i = 0; i < L.length; i++) for (let j = i + 1; j < L.length; j++) { const a = L[i], b = L[j]; if (box() ? Math.abs(a.x - b.x) < (a.w + b.w) / 2 - 0.5 && Math.abs(a.y - b.y) < (a.h + b.h) / 2 - 0.5 : Math.hypot(a.x - b.x, a.y - b.y) < a.r + b.r - 0.5) bad++; }
      return bad;
    },
    zoom: (k) => { const c = { x: W / 2, y: H / 2 }; zoomAt(c.x, c.y, k / view.k, 0); return view.k; },
    starDrift: () => { if (vs.layout !== "stars") return 0; const T = targets(); let d = 0; for (const n of m.starMain) if (n && T.has(n)) d = Math.max(d, Math.hypot(T.get(n)[0] - n.x, T.get(n)[1] - n.y)); return Math.round(d); },   // 꼭짓점 별이 지금 설정으로 잡은 자리에서 벗어난 가장 큰 거리
    settle: (n) => { for (let i = 0; i < n; i++) collide(visNodes, 1); return window.gitchGraphTest.overlaps(); },
    pairs: () => { const out = [], L = visNodes; for (let i = 0; i < L.length; i++) for (let j = i + 1; j < L.length; j++) { const a = L[i], b = L[j]; if (Math.abs(a.x - b.x) < (a.w + b.w) / 2 - 0.5 && Math.abs(a.y - b.y) < (a.h + b.h) / 2 - 0.5) out.push([a.id, b.id, +(a.x - b.x).toFixed(1), +(a.y - b.y).toFixed(1), a.w, b.w, a.fx, b.fx]); } return out.slice(0, 5); },
    redraw: (n) => { for (let i = 0; i < (n || 1); i++) { if (tween) tween(performance.now() + 1e4); if (m.pk) m.pk.at = 0; pending = false; frame(performance.now()); } return true; },   // 창이 가려져 그리기가 멈춘 때
  };
})();
</script>
