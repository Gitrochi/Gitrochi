}
function ts_alias(p, s,   d, i, best, bl, pat, pre, suf, t, r, j) {   # tsconfig paths(가장 긴 접두사) → baseUrl
  d = ts_cfg(p)
  if (d == "\001") return ""
  best = 0; bl = -1
  for (i = 1; i <= TSN[d]; i++) {
    pat = TSP[d, i]; j = index(pat, "*")
    if (j) {
      pre = substr(pat, 1, j - 1); suf = substr(pat, j + 1)
      if (length(s) >= length(pre) + length(suf) && substr(s, 1, length(pre)) == pre && (suf == "" || substr(s, length(s) - length(suf) + 1) == suf) && length(pre) > bl) { best = i; bl = length(pre) }
    } else if (s == pat && length(pat) > bl) { best = i; bl = length(pat) }
  }
  if (best) {
    pat = TSP[d, best]; t = TST[d, best]; j = index(pat, "*")
    if (j && index(t, "*")) {
      pre = substr(pat, 1, j - 1); suf = substr(pat, j + 1)
      r = substr(s, length(pre) + 1, length(s) - length(pre) - length(suf))
      t = substr(t, 1, index(t, "*") - 1) r substr(t, index(t, "*") + 1)
    }
    r = normp(joinp(TSB[d, best], t))
    if (r != "\001") { r = ts_try(r); if (r != "") return r }
  }
  if (d in TSBASE) { r = normp(joinp(TSBASE[d], s)); if (r != "\001") { r = ts_try(r); if (r != "") return r } }
  return ""
}

# ----- package.json: JSON 구조로 읽어 들여쓰기·압축 여부와 무관하게 처리 -----
function pj_read(f,   j, key, n, a) {
  if (f in PJREAD) return
  PJREAD[f] = 1; json_read(f); PJN[f] = JV[f, "name"]
  for (j = 1; j <= JN[f]; j++) {
    key = JK[f, j]; n = split(key, a, "\034")
    if (n == 2 && a[1] ~ /^(dependencies|devDependencies|peerDependencies|optionalDependencies)$/) {
      PJDN[f]++; PJD[f, PJDN[f]] = a[2]; PJS[f, PJDN[f]] = a[1]
    } else if ((n == 2 && a[1] == "workspaces") || (n == 3 && a[1] == "workspaces" && a[2] == "packages")) {
      PJWN[f]++; PJW[f, PJWN[f]] = JV[f, key]
    }
  }
}

# ----- Python: import · from (상대 경로 포함) → 모듈 파일 · 패키지(__init__.py) -----
function py_index(   i, f, d, st, n, seg, k, j, key, root) {
  # 모듈 이름 → 파일. a/b/c.py 는 c · b.c · a.b.c 로 찾을 수 있지만, 그 앞 폴더가 패키지(__init__.py)면 시작점이 될 수 없다
  for (i = 1; i <= NALL; i++) {
    f = ALL[i]
    if (f !~ /\.pyi?$/) continue
    d = dirof(f); st = stemof(f)
    n = (d == "") ? 0 : split(d, seg, "/")
    if (st != "__init__") seg[++n] = st
    for (k = 1; k <= n; k++) {
      key = seg[n - k + 1]
      for (j = n - k + 2; j <= n; j++) key = key "." seg[j]
      root = ""
      for (j = 1; j <= n - k; j++) root = root (j > 1 ? "/" : "") seg[j]
      if (k == n || !(root in PYINIT)) PYIDX[key] = PYIDX[key] "\034" f
    }
  }
}
function py_find(k, p,   n, a, i, best, bc, c) {   # 같은 이름 후보 중 가져오는 파일에 가장 가까운 것
  if (!(k in PYIDX)) return ""
  n = split(PYIDX[k], a, "\034"); best = ""; bc = -1
  for (i = 2; i <= n; i++) { c = closeness(a[i], p); if (c > bc) { bc = c; best = a[i] } }
  return best
}
function py_file(b) {
  if ((b ".py") in EX) return b ".py"
  if ((joinp(b, "__init__.py")) in EX) return joinp(b, "__init__.py")
  if ((b ".pyi") in EX) return b ".pyi"
  if ((joinp(b, "__init__.pyi")) in EX) return joinp(b, "__init__.pyi")
  return ""
}
function scan_py(p,   line, q, cont, s) {
  q = ""; cont = 0
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]
    sub(/\r$/, "", line)
    if (q != "") { if (count(line, q) % 2) q = ""; continue }     # 삼중 따옴표 문자열(docstring) 안
    if (cont) {                                                  # from x import ( … ) 가 여러 줄
      s = line; sub(/#.*$/, "", s); PYNAMES = PYNAMES "," s
      if (index(s, ")") || (cont == 2 && s !~ /\\[ \t]*$/)) { cont = 0; py_from(p, PYMOD, PYNAMES) }
      continue
    }
    if (line ~ /^[ \t]*(import|from)[ \t]/) {
      s = line; sub(/#.*$/, "", s); s = trim(s)
      if (s ~ /^import[ \t]/) py_import(p, substr(s, 8))
      else if (match(s, /^from[ \t]+[A-Za-z0-9_.]+[ \t]+import([ \t(]|$)/)) {
        PYMOD = s; sub(/^from[ \t]+/, "", PYMOD); sub(/[ \t].*$/, "", PYMOD)
        PYNAMES = s; sub(/^from[ \t]+[A-Za-z0-9_.]+[ \t]+import/, "", PYNAMES)
        if (index(PYNAMES, "(") && !index(PYNAMES, ")")) cont = 1
        else if (PYNAMES ~ /\\[ \t]*$/) cont = 2
        else py_from(p, PYMOD, PYNAMES)
      }
      continue
    }
    if (index(line, "\"\"\"") && count(line, "\"\"\"") % 2) q = "\"\"\""
    else if (index(line, "'''") && count(line, "'''") % 2) q = "'''"
  }
  close(p)
}
function py_name(s) { s = trim(s); sub(/[ \t]+as[ \t]+.*$/, "", s); return trim(s) }
function py_import(p, s,   n, a, i, m) {
  n = split(s, a, ",")
  for (i = 1; i <= n; i++) { m = py_name(a[i]); if (m ~ /^[A-Za-z_][A-Za-z0-9_.]*$/) py_abs(p, m, m) }
}
function py_abs(p, m, via,   k, t) {   # import a.b.c → a.b.c, 없으면 a.b, a 순서로 / 끝내 없으면 바깥 패키지 a
  k = m
  while (k != "") {
    t = py_find(k, p)
    if (t != "") { fedge(p, t, "import", via); return }
    if (!sub(/\.[^.]*$/, "", k)) break
  }
  k = m; sub(/\..*$/, "", k)
  if (k != "__future__") pedge(p, "pypi", k, "import", via, "")
