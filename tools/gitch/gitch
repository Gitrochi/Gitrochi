  a = "\"path\":" jstr(p) ",\"lang\":" jstr(lg)
  a = a ",\"analysis\":" jstr(swift_indexed(p) ? "compiler-index" : lg ~ /^(swift|kotlin|java|python|go|rust|ts|js|vue|svelte|astro|mdx|c|cpp|objc|objcpp|protobuf|ruby|php|lua|shell|css|scss|less|dart|solidity)$/ ? "static-import" : "file-detection")
  if (p in LINES) a = a ",\"lines\":" LINES[p]
  if (FMOD[p] != "") a = a ",\"modules\":[" jlist(FMOD[p]) "]"
  if (!inscope(p)) a = a ",\"outside\":true"
  addnode(p, "file", baseof(p), lg, a)
}
function fedge(s, t, kind, via) { FREF[t] = 1; addedge(s, t, kind, 1, 0, via, "") }
function unresolved(p, spec, reason) {
  UNRES++
  printf "0\tdiagnostic\t{\"code\":\"UNRESOLVED_IMPORT\",\"severity\":\"warning\",\"file\":%s,\"line\":%s,\"declaration\":%s,\"method\":\"static-import\",\"message\":%s}\n", jstr(p), (SCAN_FILE == p ? SCAN_LINE : "null"), jstr(spec), jstr(reason)
}
