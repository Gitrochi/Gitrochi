  if (noext || name == "") return
  id = "pkg:" eco "/" name
  a = "\"ecosystem\":" jstr(eco) ",\"name\":" jstr(name)
  if (eco == "npm" && (name in NPMDIR)) a = a ",\"local\":" jstr(NPMDIR[name] == "" ? "." : NPMDIR[name])
  addnode(id, "package", name, "package", a)
  addedge(s, id, kind, 1, 0, via, extra)
}
function medge(s, name,   id, a) {   # Swift 의 import 모듈
  if (noext || name == "") return
  id = "module:" name; a = "\"name\":" jstr(name)
  if (name in SRCMOD) a = a ",\"local\":" jstr(SRCMOD[name])
  else if (name in MODDIR) a = a ",\"local\":" jstr(MODDIR[name] == "" ? "." : MODDIR[name])
