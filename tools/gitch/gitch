/* 오른쪽 위: 설정 */
#gear { top: 14px; right: 14px; width: 40px; height: 40px; border-radius: 12px; }
#panel { top: 62px; right: 14px; width: min(300px, calc(100vw - 28px)); max-height: calc(100vh - 140px); overflow: auto; padding: 6px 0; }
details { border-bottom: 1px solid var(--border); }
details:last-child { border-bottom: 0; }
summary { display: flex; align-items: center; gap: 6px; padding: 10px 14px; font-weight: 650; cursor: pointer; list-style: none; user-select: none; }
summary::-webkit-details-marker { display: none; }
summary::before { content: ""; width: 6px; height: 6px; border-right: 1.6px solid var(--muted); border-bottom: 1.6px solid var(--muted); transform: rotate(-45deg); transition: transform .15s; margin-right: 4px; }
details[open] summary::before { transform: rotate(45deg); }
.sec { padding: 0 14px 12px; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 30px; color: var(--text-2); }
.row.col { flex-direction: column; align-items: stretch; gap: 2px; padding: 4px 0; }
.row.col .lab { display: flex; justify-content: space-between; }
.row.col .lab b { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
.row.sub { padding-left: 14px; }
input[type=range] { width: 100%; accent-color: var(--accent); }
.switch { appearance: none; -webkit-appearance: none; flex: none; position: relative; width: 32px; height: 18px; margin: 0; border-radius: 999px; background: var(--border); cursor: pointer; transition: background .15s; }
.switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, .3); transition: transform .15s; }
.switch:checked { background: var(--accent); }
.switch:checked::after { transform: translateX(14px); background: var(--panel-solid); }
.btn { width: 100%; margin-top: 8px; padding: 7px 0; border: 1px solid var(--border); border-radius: 8px; background: var(--hover); color: var(--text); cursor: pointer; }
.btn:hover { border-color: var(--accent); }
#viewName, #savedViews { box-sizing: border-box; width: 100%; padding: 7px 9px; border: 1px solid var(--border); border-radius: 7px; background: var(--hover); color: var(--text); font: inherit; }
.groups { display: grid; gap: 2px; }
.groups button { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border: 0; border-radius: 6px; background: transparent; color: var(--text-2); cursor: pointer; text-align: left; }
.groups button:hover { background: var(--hover); }
.groups button.off { opacity: .38; }
.groups button .n { margin-left: auto; color: var(--muted); font-variant-numeric: tabular-nums; }
/* 아래: 범례 · 단추 */
#legend { bottom: 14px; left: 14px; max-width: calc(100vw - 330px); display: flex; flex-wrap: wrap; align-items: center; gap: 2px 4px; padding: 5px 6px; }
#legend button { display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; border: 0; border-radius: 6px; background: transparent; color: var(--text-2); font-size: 12px; cursor: pointer; }
#legend button:hover { background: var(--hover); }
#legend button.off { opacity: .38; }
.lg { display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; color: var(--text-2); font-size: 12px; }
.lg i { display: inline-block; width: 16px; height: 3px; border-radius: 2px; }
.lg i.dash { background: repeating-linear-gradient(90deg, currentColor 0 4px, transparent 4px 7px) !important; }
.ramp { display: inline-flex; align-items: center; gap: 8px; padding: 2px 8px; color: var(--text-2); font-size: 12px; }
.ramp i { display: inline-block; width: 22px; height: 8px; border-radius: 2px; }
#tools { bottom: 14px; right: 14px; display: flex; gap: 2px; padding: 4px; }
.evidence { width: 100%; font-size: 11px; color: var(--text-2); overflow-wrap: anywhere; }
.evidence summary { cursor: pointer; color: var(--muted); }
.evidence p { margin: 5px 0; line-height: 1.5; }
.evidence a, #info .source-link, #notes a { color: var(--accent); }
#info .rows li:has(.evidence) { flex-wrap: wrap; }
/* 오른쪽: 목록 · 분석 */
.drawer { top: 62px; right: 14px; bottom: 66px; width: min(540px, calc(100vw - 28px)); display: flex; flex-direction: column; }
.drawer .head { display: flex; align-items: center; gap: 8px; padding: 10px 10px 8px 14px; font-weight: 650; }
.drawer .head span { color: var(--muted); font-weight: 400; font-size: 12px; }
.drawer .head .icon-btn { margin-left: auto; width: 26px; height: 26px; }
.drawer .wrap { flex: 1; overflow: auto; padding: 0 8px 10px; }
#table table { width: 100%; border-collapse: collapse; font-size: 12px; }
#table th { position: sticky; top: 0; padding: 6px 8px; background: var(--panel-solid); color: var(--muted); font-weight: 600; text-align: left; cursor: pointer; white-space: nowrap; }
#table th.num, #table td.num { text-align: right; font-variant-numeric: tabular-nums; }
#table td { padding: 5px 8px; border-top: 1px solid var(--border); color: var(--text-2); }
#table td.name { max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text); }
#table td.name small { color: var(--muted); }
#table tbody tr { cursor: pointer; }
#table tbody tr:hover td { background: var(--hover); }
.more { padding: 8px; color: var(--muted); font-size: 12px; }
.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin: 2px 4px 6px; }
.cards > * { padding: 8px 10px; border: 1px solid var(--border); border-radius: 10px; background: var(--hover); text-align: left; }
.cards button { cursor: pointer; }
.cards button:hover { border-color: var(--accent); }
.cards b { display: block; font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
.cards span { color: var(--muted); font-size: 11px; }
.cards .hot b { color: var(--warn); }
.cards .bad b { color: var(--del); }
.sec-note { margin: 0 6px 4px; color: var(--muted); font-size: 11px; }
/* 마우스를 올린 노드 */
#tip { position: fixed; z-index: 3; padding: 6px 10px; border-radius: 9px; background: var(--panel-solid); border: 1px solid var(--border); box-shadow: var(--shadow); pointer-events: none; max-width: 380px; }
#tip b { display: block; font-weight: 600; word-break: break-all; }
#tip span { color: var(--muted); font-size: 12px; }
#empty { position: fixed; inset: 0; z-index: 1; display: grid; place-items: center; align-content: center; gap: 14px; color: var(--muted); font-size: 15px; pointer-events: none; }
#empty .mark { width: 40px; height: 40px; stroke: var(--muted); stroke-width: 1.4; }
/* Keep exploration, graph settings and review in one workspace. */
:root { --left-w: 340px; --right-w: 344px; }
#masthead { position:fixed; top:16px; left:16px; right:16px; height:64px; padding:10px 16px; display:flex; align-items:center; gap:14px; z-index:4; }
#masthead .mark { width:27px; height:27px; flex:none; }
#context { flex:1; min-width:0; color:var(--muted); font-size:11px; }
#context .context-title { display:flex; align-items:center; gap:10px; min-width:0; }
#context b { color:var(--text); font-size:16px; font-weight:650; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#context .branch { padding:2px 7px; border:1px solid var(--border); border-radius:6px; color:var(--text-2); max-width:260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
#context .context-meta { display:block; margin-top:3px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
#phase { color:var(--leaf); font-size:11px; white-space:nowrap; }
#phase::before { content:""; display:inline-block; width:5px; height:5px; margin-right:6px; border-radius:50%; background:currentColor; vertical-align:2px; }
#masthead button, .review button, #empty button, .splitter { border:1px solid var(--border); border-radius:7px; background:var(--hover); color:var(--text-2); padding:6px 10px; cursor:pointer; }
#masthead button[aria-expanded=true] { background:var(--accent-soft); color:var(--text); }
#top { top:96px; bottom:80px; left:16px; width:var(--left-w); display:flex; flex-direction:column; overflow:hidden; padding:0; }
#explore { flex:none; padding:12px 15px; max-height:38%; overflow:auto; border-bottom:1px solid var(--border); }
#top .row1 { display:flex; align-items:center; font-weight:650; font-size:13px; }
#top .tabs { margin-top:12px; }
#top #stats { font-size:11px; }
#top .ctrls { margin-top:10px; gap:5px 8px; }
#top .ctrls select { padding:3px 7px; }
#rightDock { top:96px; bottom:80px; right:16px; width:var(--right-w); display:flex; flex-direction:column; overflow:hidden; }
#dockTabs { flex:none; display:flex; gap:2px; padding:8px; border-bottom:1px solid var(--border); }
#dockTabs button { flex:1; min-width:0; display:flex; justify-content:center; align-items:center; gap:5px; height:40px; padding:3px 5px; border:0; border-radius:7px; background:transparent; color:var(--muted); font-size:12px; font-weight:600; line-height:1.15; white-space:normal; cursor:pointer; }
#dockTabs button[aria-selected=true] { background:var(--accent-soft); color:var(--text); }
#dockTabs button:hover:not(:disabled) { color:var(--text); background:var(--hover); }
#dockTabs button:disabled { opacity:.4; cursor:default; }
#dockTabs svg { flex:none; width:14px; height:14px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; }
#gear { position:static; width:auto; box-shadow:none; }
#dockBody { flex:1; min-height:0; display:flex; flex-direction:column; }
#panel, #info, #reviewPane, .drawer { position:static; width:100%; flex:1; min-height:0; max-height:none; overflow:auto; border:0; border-radius:0; box-shadow:none; background:transparent; backdrop-filter:none; }
#panel { padding:3px 0 10px; }
#panel summary { padding:13px 16px 10px; font-size:12px; }
#panel .sec { padding:0 16px 14px; }
#panel .row { min-height:32px; font-size:12px; }
#panel .row.col { padding:5px 0; gap:5px; }
#panel .seg button { padding:5px 6px; font-size:11px; }
#viewBasics { grid-template-columns:auto minmax(0,1fr) auto minmax(0,1fr); gap:5px 8px; margin:0 0 8px; font-size:11px; }
#viewBasics .line { flex-wrap:wrap; gap:4px; }
#viewBasics .seg button { padding:4px 6px; }
#panel .quick-toggles { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:4px; }
#panel .appearance { border:0; margin-top:4px; }
#panel .appearance summary { padding:7px 0 2px; color:var(--muted); font-size:11px; font-weight:500; }
#info { padding:16px; }
#reviewPane { display:flex; flex-direction:column; overflow:hidden; }
#reviewDetail { flex:1; min-height:0; padding:4px 16px 16px; overflow:auto; }
#reviewExport { flex:none; display:flex; align-items:center; gap:6px; padding:11px 14px; border-top:1px solid var(--border); }
#reviewExport span { margin-right:auto; color:var(--muted); font-size:11px; }
#reviewExport button { border:1px solid var(--border); border-radius:6px; background:var(--hover); padding:5px 8px; font-size:11px; cursor:pointer; }
.drawer .head { padding:14px 16px; }
.drawer .wrap { min-height:0; }
#banner { top:106px; left:calc(var(--left-w) + 32px); max-width:calc(100vw - var(--left-w) - var(--right-w) - 64px); z-index:3; }
#legend { left:calc(var(--left-w) + 32px); bottom:16px; max-width:calc(100vw - var(--left-w) - 432px); height:42px; flex-wrap:nowrap; overflow:auto hidden; scrollbar-width:none; box-shadow:none; }
#legend > * { flex:none; }
#legend .lg { font-size:11px; }
#tools { right:16px; bottom:16px; box-shadow:none; }
#tools button:nth-child(4), #tools button:nth-child(7), #tools button:nth-child(9) { margin-left:5px; }
.review { overflow-wrap:anywhere; }
.review h2 { font-size:15px; margin:12px 0 8px; }
.review h3 { font-size:12px; margin:20px 0 8px; color:var(--text-2); }
.review p { font-size:11px; line-height:1.6; color:var(--muted); margin:7px 0; }
.review label { display:flex; gap:7px; align-items:flex-start; }
.review input[type=checkbox] { accent-color:var(--leaf); flex:none; margin-top:4px; }
.review .change { display:flex; align-items:stretch; margin:3px 0; border:1px solid var(--border); border-radius:8px; }
.review .change:has(input:checked) { background:var(--hover); border-color:var(--leaf-soft); box-shadow:inset 3px 0 var(--leaf); }
.review .change:hover { background:var(--accent-soft); }
.review .change:has(:focus-visible) { outline:2px solid var(--leaf); outline-offset:1px; }
.review .change .change-select { flex:1; min-width:0; min-height:58px; padding:10px; gap:10px; align-items:center; cursor:pointer; user-select:none; }
.review .change input[type=checkbox] { width:20px; height:20px; margin:0; cursor:pointer; }
.review .change label > span { min-width:0; flex:1; display:flex; flex-wrap:wrap; gap:4px 6px; align-items:center; }
.review .change label > span > span { width:100%; min-width:0; }
.review .change .change-open { flex:none; min-width:44px; padding:0 5px; white-space:nowrap; border:0; background:transparent; color:var(--muted); font-size:11px; cursor:pointer; }
.review .change .change-open:hover { background:var(--accent-soft); color:var(--text); }
.review .change .file-name { display:block; overflow-wrap:anywhere; white-space:normal; font-size:13px; line-height:1.5; color:var(--text); font-weight:550; }
.review .change .file-dir { display:none; }
.review .change small { display:block; color:var(--muted); font-size:11px; margin-top:3px; }
.review .change .change-status { margin:0; padding:2px 5px; border-radius:4px; background:var(--accent-soft); font-size:10px; white-space:nowrap; }
.review .change .old-path { grid-column:1 / -1; font-size:10px; }
.review .tag { color:var(--leaf); font-size:11px; }
.review .reason { padding:10px 0 10px 11px; margin:0; border-left:2px solid var(--leaf-soft); border-bottom:1px solid var(--border); font-size:12px; }
.review .reason button[data-file] { display:block; max-width:100%; border:0; background:none; text-align:left; padding:0; line-height:1.5; overflow-wrap:anywhere; color:var(--text); }
.review .reason button[data-file]:hover { color:var(--leaf); }
.review .route { display:block; margin-top:4px; color:var(--muted); font-size:11px; line-height:1.5; }
.review .actions { gap:5px; }
.review .actions button { font-size:11px; padding:5px 7px; }
.review select { max-width:100%; }
#reviewNav { flex:1; min-height:0; display:flex; flex-direction:column; }
#changeHeader { flex:none; display:grid; grid-template-columns:1fr auto; column-gap:8px; padding:14px 15px 12px; border-bottom:1px solid var(--border); }
#changeHeader h2 { display:flex; align-items:center; justify-content:space-between; margin:0; font-size:13px; }
#changeHeading, #showImpact { grid-column:1 / -1; }
#changeHeading { display:flex; align-items:center; gap:7px; }
#changeHeading h2 { flex:1; min-width:0; flex-wrap:wrap; gap:4px; }
#changeHeader #expandChanges { flex:none; padding:5px 6px; font-size:10px; }
#expandChanges[aria-pressed=true] { color:var(--leaf); border-color:var(--leaf-soft); }
#top.changesExpanded #explore { display:none; }
#top.changesExpanded #reviewNav { grid-column:1 / -1; grid-row:1 / -1; }
#changeCount { padding:2px 6px; border-radius:5px; background:var(--hover); color:var(--muted); font-size:10px; font-weight:500; }
#changeHeader .actions { margin:8px 0 0; gap:4px; align-items:center; }
#changeHeader .actions button { padding:4px 5px; font-size:10px; }
#changeHeader .row { align-items:center; color:var(--muted); font-size:11px; }
#changeHeader .row { margin-top:8px; font-size:0; }
#changeHeader .row select { width:96px; padding:4px; font-size:11px; }
#showImpact { margin-top:9px; padding:9px 5px; background:var(--leaf-soft); border-color:transparent; color:var(--leaf); font-size:12px; font-weight:600; }
#changeList { flex:1; min-height:0; overflow:auto; padding:6px; }
#navigatorTabs { grid-column:1 / -1; display:flex; gap:4px; margin-top:10px; padding:3px; border-radius:8px; background:var(--hover); }
#navigatorTabs button { flex:1; border:0; background:transparent; font-size:12px; padding:6px; }
#navigatorTabs button[aria-selected=true] { background:var(--seg-on); color:var(--text); box-shadow:0 1px 3px #0002; }
#folderScope { grid-column:1 / -1; display:flex; flex-wrap:wrap; align-items:center; gap:3px; padding-top:8px; font-size:11px; overflow-wrap:anywhere; }
#folderScope button { border:0; padding:2px 4px; background:none; color:var(--text-2); font-size:11px; text-align:left; overflow-wrap:anywhere; }
#folderScope button:last-of-type { color:var(--leaf); }
#folderScope span { color:var(--muted); }
#top.foldersMode #explore { display:none; }
#top.foldersMode .change-controls { display:none; }
#top.foldersMode #expandChanges { display:none; }
#top.foldersMode #changeHeader { padding-bottom:10px; }
#exploreFolders { flex:1; min-height:0; display:flex; flex-direction:column; overflow:hidden; }
#folderSearchRow { flex:none; display:flex; gap:6px; align-items:center; padding:10px 12px; border-bottom:1px solid var(--border); }
#folderSearch { min-width:0; flex:1; padding:7px 8px; background:var(--hover); border:1px solid var(--border); border-radius:7px; font-size:12px; }
#folders { flex:1; min-height:0; overflow:auto; padding:8px; }
.folder-tree, .folder-tree ul { list-style:none; padding:0; margin:0; }
.folder-tree ul { margin-left:12px; padding-left:8px; border-left:1px solid var(--border); }
.folder-row { display:flex; min-height:36px; align-items:center; border-radius:6px; gap:2px; }
.folder-row.active { background:var(--leaf-soft); }
.folder-row:hover { background:var(--hover); }
#folders button { cursor:pointer; border:0; background:none; color:var(--text-2); }
#folders .folder-toggle { flex:none; padding:6px; width:25px; min-height:34px; color:var(--muted); }
#folders .folder-toggle:disabled { visibility:hidden; }
#folders .folder-scope { flex:1; min-width:0; display:flex; align-items:center; gap:7px; padding:6px 3px; text-align:left; font-size:12px; }
.folder-name { flex:1; overflow-wrap:anywhere; line-height:1.5; }
.folder-icon { flex:none; width:14px; height:12px; border:1px solid var(--muted); border-radius:2px; position:relative; }
.folder-icon::before { content:""; position:absolute; top:-4px; left:0; width:6px; height:3px; border:1px solid var(--muted); border-bottom:0; border-radius:2px 2px 0 0; }
.folder-count { flex:none; color:var(--muted); font-size:10px; font-variant-numeric:tabular-nums; }
.change-group { margin-bottom:12px; }
.change-group-head { display:flex; align-items:center; gap:6px; padding:8px 3px 6px; background:var(--panel-solid); border-bottom:1px solid var(--border); }
.review .change-folder-name { flex:1; min-width:0; text-align:left; font-size:11px; color:var(--text-2); background:none; border:0; padding:3px; overflow-wrap:anywhere; line-height:1.6; }
.change-group-head .folder-count { padding:0 3px; }
.review .path-action, #folders .path-action, #folderScope .path-action { flex:none; width:30px; min-height:34px; padding:0; border:0; background:transparent; color:var(--muted); font-size:20px; cursor:pointer; border-radius:6px; }
.path-action:hover { background:var(--accent-soft) !important; color:var(--text) !important; }
#searchResults button { display:block; width:100%; text-align:left; border:0; background:none; color:var(--text-2); padding:5px 4px; overflow-wrap:anywhere; cursor:pointer; }
#searchResults button:hover { background:var(--hover); }
#searchResults small { display:block; color:var(--muted); }
#searchResults:empty { display:none; }
#edgeLegend { color:var(--muted); font-size:11px; }
#edgeLegend .sec { line-height:1.7; }
#pathMenu { position:fixed; z-index:10; width:min(430px,calc(100vw - 32px)); max-height:calc(100vh - 32px); overflow:auto; padding:14px; background:var(--panel-solid); border:1px solid var(--border); border-radius:12px; box-shadow:var(--shadow); }
#pathMenu .path-menu-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; font-size:13px; }
#pathMenu p { margin:10px 0 3px; color:var(--muted); font-size:11px; }
#pathMenu code { display:block; padding:8px; background:var(--hover); border-radius:6px; overflow-wrap:anywhere; white-space:normal; font-size:12px; user-select:text; }
#pathMenu .path-menu-actions { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
#pathMenu .path-menu-actions button, #pathMenu .path-menu-actions a { border:1px solid var(--border); border-radius:6px; background:var(--hover); padding:7px 9px; color:var(--text-2); text-decoration:none; font-size:12px; cursor:pointer; }
#pathFeedback { min-height:16px; margin-top:9px; color:var(--leaf); font-size:11px; }
.splitter { position:fixed; top:102px; bottom:86px; width:6px; padding:0; z-index:3; cursor:col-resize; opacity:0; transition:opacity .15s; }
.splitter:hover, .splitter:focus-visible { opacity:.6; }
#leftSizer { left:calc(var(--left-w) + 20px); } #rightSizer { right:calc(var(--right-w) + 20px); }
body.leftClosed #top, body.leftClosed #leftSizer, body.rightClosed #rightDock, body.rightClosed #rightSizer { display:none; }
body.leftClosed { --left-w:0px; } body.rightClosed { --right-w:0px; }
#empty { left:calc(var(--left-w) + 30px); right:calc(var(--right-w) + 30px); text-align:center; font-size:13px; padding:20px; }
#empty button { pointer-events:auto; }
@media(max-width:1100px) { :root { --left-w:300px; --right-w:312px; } #masthead { gap:10px; } #phase { display:none; } }
@media(max-width:900px) {
  #masthead { top:12px; left:12px; right:12px; padding:10px 12px; }
  #context .branch { max-width:180px; }
  #masthead button { padding:7px 9px; font-size:11px; }
  #top, #rightDock { top:auto; left:12px; right:12px; bottom:72px; width:auto; height:min(55vh,480px,max(180px,calc(100vh - 320px))); }
  #top { display:none; }
  body.narrowExplore:not(.leftClosed) #top { display:flex; }
  body.narrowExplore #rightDock { display:none; }
  #explore { min-height:0; max-height:140px; }
  #reviewNav { min-height:0; }
  #top .ctrls { grid-template-columns:auto 1fr; gap:6px 8px; }
  #top .tabs button { font-size:11px; }
  #changeHeader { padding:12px; }
  #changeHeader h2 { flex-wrap:wrap; gap:4px; }
  #legend { top:88px; bottom:auto; left:12px; right:12px; max-width:none; max-height:42px; }
  #banner { top:140px; bottom:auto; left:12px; max-width:calc(100vw - 24px); }
  #rightSizer, #leftSizer { display:none; }
  #tools { right:12px; bottom:14px; }
  #empty { left:12px; right:12px; }
}
@media (min-width:600px) and (max-width:900px) {
  #changeHeader { grid-template-columns:minmax(0,1fr) auto auto; column-gap:10px; }
  #changeHeader #showImpact { grid-column:auto; padding:8px 12px; }
}
@media (max-width:900px) and (max-height:650px) { #explore { max-height:80px; } }
@media(max-width:480px) {
  #context .branch { display:none; }
  #masthead .mark { width:22px; height:22px; }
  #context b { font-size:14px; }
  #tools { left:12px; justify-content:space-between; }
  #tools button { width:28px; }
  #tools button:nth-child(n) { margin-left:0; }
  #top .ctrls { grid-template-columns:auto 1fr; }
}

/* Named entry points keep layout and architecture tools discoverable. */
:root { --work-top:152px; }
#quickViews { position:fixed; top:90px; left:16px; right:16px; display:flex; align-items:center; flex-wrap:wrap; gap:6px; padding:7px 9px; z-index:4; }
#quickViews button { border:1px solid var(--border); border-radius:7px; background:var(--hover); color:var(--text-2); padding:7px 11px; cursor:pointer; font-size:12px; font-weight:600; }
#quickViews button[aria-pressed=true] { color:var(--accent); background:var(--accent-soft); border-color:var(--accent); }
#quickViews button:disabled { opacity:.4; cursor:default; }
#activeLayout { margin-left:auto; color:var(--muted); font-size:11px; max-width:260px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#top, #rightDock, .splitter { top:var(--work-top); }
#dockTabs button { min-height:44px; height:auto; }
#dockTabs .dock-label { min-width:0; overflow-wrap:normal; word-break:keep-all; }
#layout { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); grid-auto-flow:row; grid-auto-columns:auto; gap:6px; padding:0; background:transparent; width:100%; }
#layout button { min-height:42px; padding:8px; border:1px solid var(--border); border-radius:7px; background:var(--hover); text-align:left; white-space:normal; font-size:12px; }
#layout button.on { border-color:var(--accent); background:var(--accent-soft); color:var(--text); }
#layoutDescription { color:var(--muted); font-size:11px; line-height:1.6; margin:7px 0 0; }
#architecture { min-height:0; flex:1; display:flex; flex-direction:column; overflow:hidden; }
#architectureHeader { flex:none; padding:14px; border-bottom:1px solid var(--border); }
#architectureHeader h2 { margin:0 0 6px; font-size:15px; }
#architectureScope { color:var(--muted); font-size:11px; overflow-wrap:anywhere; margin-bottom:10px; }
.architecture-controls { display:flex; align-items:center; flex-wrap:wrap; gap:6px; font-size:11px; }
.architecture-controls select, #architectureSearch { border:1px solid var(--border); background:var(--hover); color:var(--text); padding:5px 7px; border-radius:6px; min-width:0; }
#architectureSearch { width:100%; box-sizing:border-box; margin-top:8px; }
#architectureBody { min-height:0; flex:1; overflow:auto; padding:14px; }
.architecture-summary { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; }
.architecture-summary div { padding:10px; border-radius:8px; background:var(--hover); }
.architecture-summary b { display:block; font-size:20px; color:var(--text); }
.architecture-summary span { display:block; margin-top:4px; font-size:10px; line-height:1.5; color:var(--muted); }
.architecture-note { color:var(--muted); font-size:11px; line-height:1.6; margin:8px 0 12px; }
#architectureBody h3 { font-size:13px; margin:20px 0 8px; }
#architectureBody h3 small { color:var(--muted); margin-left:5px; font-weight:400; }
.architecture-group { display:block; width:100%; padding:11px; margin:0 0 8px; border:1px solid var(--border); border-radius:8px; background:var(--hover); color:var(--text); text-align:left; cursor:pointer; }
.architecture-group:hover, .architecture-group.selected { border-color:var(--accent); background:var(--accent-soft); }
.architecture-path { display:block; font-size:12px; font-weight:650; overflow-wrap:anywhere; }
.architecture-counts { display:block; font-size:10px; color:var(--muted); line-height:1.6; margin-top:6px; }
.architecture-ratio { display:flex; justify-content:space-between; gap:8px; font-size:11px; margin-top:9px; color:var(--text-2); }
.architecture-bar { display:block; height:4px; margin-top:5px; border-radius:3px; background:var(--border); overflow:hidden; }
.architecture-bar i { display:block; height:100%; background:var(--accent); }
.cycle-tag { display:inline-block; margin-left:6px; color:var(--warn); font-size:10px; }
.architecture-pair { display:flex; align-items:center; justify-content:space-between; gap:10px; width:100%; margin:0 0 5px; padding:9px; text-align:left; border:1px solid var(--border); border-radius:6px; background:var(--hover); color:var(--text-2); cursor:pointer; font-size:11px; }
.architecture-pair span { min-width:0; overflow-wrap:anywhere; }
.architecture-pair b { flex:none; color:var(--text); }
.architecture-formulas { margin-top:20px; font-size:11px; line-height:1.7; color:var(--muted); }
.architecture-formulas summary { color:var(--text-2); cursor:pointer; }
#architectureMoreAnalysis, #architectureMorePairs { border:1px solid var(--border); border-radius:6px; padding:7px 9px; color:var(--text-2); background:var(--hover); cursor:pointer; font-size:11px; }
@media(max-width:1100px) { #activeLayout { display:none; } }
@media(max-width:900px) {
 #quickViews { left:12px; right:12px; gap:5px; }
 #quickViews button { font-size:11px; padding:7px 9px; }
 #top,#rightDock { top:auto; height:min(52vh,480px,max(160px,calc(100vh - var(--work-top) - 260px))); }
 #architecture { overflow:auto; }
 #architectureBody { flex:none; overflow:visible; }
 #legend { top:var(--work-top); }
 #banner { top:calc(var(--work-top) + 48px); }
}
</style>
</head>
