acc_idx() {   # 계정 → ACC_I
  local i=0
  while [ $i -lt ${#ACC_IDS[@]} ]; do
    [ "${ACC_IDS[$i]}" = "$1" ] && { ACC_I=$i; return 0; }
    i=$((i+1))
  done
  return 1
}
is_account() { [ -n "$1" ] && acc_idx "$1"; }
acc_email() { acc_idx "$1" && printf '%s' "${ACC_EMAIL[$ACC_I]}"; }
acc_name() { acc_idx "$1" && printf '%s' "${ACC_NAME[$ACC_I]}"; }
account_names() { local IFS=,; local s="${ACC_IDS[*]}"; printf '%s' "${s//,/, }"; }
host_label() { printf '%s' "${1%%.*}"; }

add_binding() {   # $1 계정 $2 서버 $3 포트 $4 로그인 계정
  local i=0
  while [ $i -lt ${#B_ACC[@]} ]; do
    if [ "${B_ACC[$i]}" = "$1" ] && [ "${B_HOST[$i]}" = "$2" ]; then
      CFG_ERRORS+=("account.$1: 서버 $2 가 두 번 있습니다"); return 1
    fi
    i=$((i+1))
  done
  B_ACC+=("$1"); B_HOST+=("$2"); B_PORT+=("$3"); B_LOGIN+=("$4"); B_ALIAS+=("$(host_label "$2")-$4")
}

find_binding() {   # $1 계정 $2 서버 → BI
  local i=0
  while [ $i -lt ${#B_ACC[@]} ]; do
    if [ "${B_ACC[$i]}" = "$1" ] && [ "${B_HOST[$i]}" = "$2" ]; then BI=$i; return 0; fi
    i=$((i+1))
  done
  return 1
}

find_alias() {   # $1 별칭 → BI (자기 키를 쓰는 바인딩)
  local a i=0; a=$(lower "$1")
  while [ $i -lt ${#B_ACC[@]} ]; do
    if [ "${B_LOGIN[$i]}" = "${B_ACC[$i]}" ] && [ "$(lower "${B_ALIAS[$i]}")" = "$a" ]; then BI=$i; return 0; fi
    i=$((i+1))
  done
  return 1
}

host_is_managed() { local h; for h in "${B_HOST[@]}"; do [ "$h" = "$1" ] && return 0; done; return 1; }

host_single_account() {   # 그 서버에 계정이 하나뿐이면 HSA
  local i=0 n=0; HSA=""
  while [ $i -lt ${#B_ACC[@]} ]; do
    [ "${B_HOST[$i]}" = "$1" ] && { HSA=${B_ACC[$i]}; n=$((n+1)); }
    i=$((i+1))
  done
  [ $n -eq 1 ]
}

email_is_mine() { local e; for e in "${ACC_EMAIL[@]}"; do [ "$e" = "$1" ] && return 0; done; return 1; }

own_aliases() {   # 자기 키 별칭 목록 (공백 구분)
  local i=0 out=""
  while [ $i -lt ${#B_ACC[@]} ]; do
    [ "${B_LOGIN[$i]}" = "${B_ACC[$i]}" ] && out="$out ${B_ALIAS[$i]}"
    i=$((i+1))
  done
  printf '%s' "${out# }"
}

acc_hosts_desc() {   # 계정의 서버 설명: "github.com, gitlab.x(포트 2222), github.com(로그인 y)"
  local i=0 out="" d
  while [ $i -lt ${#B_ACC[@]} ]; do
    if [ "${B_ACC[$i]}" = "$1" ]; then
      d=${B_HOST[$i]}
      [ "${B_PORT[$i]}" != 22 ] && d="$d(포트 ${B_PORT[$i]})"
      [ "${B_LOGIN[$i]}" != "$1" ] && d="$d(로그인 ${B_LOGIN[$i]})"
      out="$out${out:+, }$d"
    fi
    i=$((i+1))
  done
  printf '%s' "$out"
}

acc_folder() {   # 계정의 첫 기본 폴더 (펼친 경로)
  local i=0
  while [ $i -lt ${#F_ACC[@]} ]; do
    [ "${F_ACC[$i]}" = "$1" ] && { expand_path "${F_RAW[$i]}"; return 0; }
    i=$((i+1))
  done
  return 1
}

load_config() {
  [ -n "$CFG_LOADED" ] && { [ -n "$CFG_EXISTS" ]; return; }
  CFG_LOADED=1
  [ -f "$CFG" ] || return 1
  CFG_EXISTS=1
  local entry key val rest id var hl=() e hv hp kw login extra h p
  while IFS= read -r -d '' entry; do
    key=${entry%%$'\n'*}
    case "$entry" in *$'\n'*) val=${entry#*$'\n'} ;; *) val="" ;; esac
    case "$key" in
      gitsw.scanroot) CFG_SCAN_ROOT="$val" ;;
      gitsw.aipush) CFG_AI_PUSH="$val" ;;
      gitsw.maxfilemb) CFG_MAX_MB="$val" ;;
      gitsw.warnfilemb) CFG_WARN_MB="$val" ;;
      account.*.*)
        rest=${key#account.}; var=${rest##*.}; id=${rest%.*}
        if ! acc_idx "$id"; then
          ACC_IDS+=("$id"); ACC_EMAIL+=(""); ACC_NAME+=("$id"); ACC_TRAILER+=("keep")
          ACC_I=$((${#ACC_IDS[@]} - 1))
        fi
        case "$var" in
          email) ACC_EMAIL[$ACC_I]="$val" ;;
          name) ACC_NAME[$ACC_I]="$val" ;;
          aitrailer) ACC_TRAILER[$ACC_I]=$(lower "$val") ;;
          host) hl+=("$id"$'\t'"$val") ;;
        esac ;;
      folder.*.account) rest=${key#folder.}; F_RAW+=("${rest%.account}"); F_REAL+=(""); F_ACC+=("$val") ;;
      folder.*.allowremote) rest=${key#folder.}; AR_RAW+=("${rest%.allowremote}"); AR_REAL+=(""); AR_PAT+=("$(lower "$val")") ;;
      gitsw.sshstrict) CFG_SSH_STRICT=$(lower "$val") ;;
      org.*.account)
        rest=${key#org.}; rest=${rest%.account}; rest=${rest%/}
        O_RAW+=("$rest"); O_HOST+=("$(lower "${rest%%/*}")"); O_PATH+=("$(lower "${rest#*/}")"); O_ACC+=("$val") ;;
    esac
  done < <(git config -f "$CFG" --list -z 2>/dev/null)

  # 서버 바인딩: 자기 키 먼저, via(다른 계정 로그인 빌려 쓰기)는 나중에
  local b_id=() b_host=() b_port=() b_login=() i
  for e in "${hl[@]}"; do
    id=${e%%$'\t'*}; hv=${e#*$'\t'}
    hp=""; kw=""; login=""; extra=""
    read -r hp kw login extra <<< "$hv"
    if [ -z "$hp" ] || { [ -n "$kw" ] && { [ "$kw" != via ] || [ -z "$login" ] || [ -n "$extra" ]; }; }; then
      CFG_ERRORS+=("account.$id.host = '$hv' — 형식: 서버[:포트] [via 다른계정]"); continue
    fi
    h=$(lower "${hp%%:*}"); p=""
    [ "${hp%%:*}" != "$hp" ] && p=${hp#*:}
    if [ -z "$p" ]; then p=22
    elif ! is_number "$p"; then CFG_ERRORS+=("account.$id.host = '$hv' — 포트는 숫자여야 합니다"); continue; fi
    b_id+=("$id"); b_host+=("$h"); b_port+=("$p"); b_login+=("${login:-$id}")
  done
  i=0
  while [ $i -lt ${#b_id[@]} ]; do
    [ "${b_login[$i]}" = "${b_id[$i]}" ] && add_binding "${b_id[$i]}" "${b_host[$i]}" "${b_port[$i]}" "${b_id[$i]}"
    i=$((i+1))
  done
  i=0
  while [ $i -lt ${#b_id[@]} ]; do
    if [ "${b_login[$i]}" != "${b_id[$i]}" ]; then
      if find_binding "${b_login[$i]}" "${b_host[$i]}" && [ "${B_LOGIN[$BI]}" = "${b_login[$i]}" ]; then
        add_binding "${b_id[$i]}" "${b_host[$i]}" "${B_PORT[$BI]}" "${b_login[$i]}"
      else
        CFG_ERRORS+=("account.${b_id[$i]}: 'via ${b_login[$i]}' — ${b_login[$i]} 계정에 ${b_host[$i]} 서버가 없습니다")
      fi
    fi
    i=$((i+1))
  done
  validate_config
  return 0
}

validate_config() {
  local i=0 id
  while [ $i -lt ${#ACC_IDS[@]} ]; do
    id=${ACC_IDS[$i]}
    case "$id" in
      ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) CFG_ERRORS+=("계정 이름 '$id' 에는 영문/숫자/._- 만 쓸 수 있습니다") ;;
    esac
    [ -z "${ACC_EMAIL[$i]}" ] && CFG_ERRORS+=("account.$id.email 이 없습니다")
    case "${ACC_TRAILER[$i]}" in keep|strip) ;; *) CFG_ERRORS+=("account.$id.aiTrailer 는 keep 또는 strip 입니다 (지금: ${ACC_TRAILER[$i]})") ;; esac
    find_binding_any "$id" || CFG_ERRORS+=("account.$id.host 가 없습니다 (예: host = github.com)")
    i=$((i+1))
  done
  i=0
  while [ $i -lt ${#F_ACC[@]} ]; do
    is_account "${F_ACC[$i]}" || CFG_ERRORS+=("folder \"${F_RAW[$i]}\": 없는 계정 '${F_ACC[$i]}'")
    i=$((i+1))
  done
  i=0
  while [ $i -lt ${#O_ACC[@]} ]; do
    if [ "${O_HOST[$i]}" = "${O_RAW[$i]}" ] || [ -z "${O_PATH[$i]}" ]; then
      CFG_ERRORS+=("org \"${O_RAW[$i]}\": '서버/조직' 형식이어야 합니다 (예: github.com/myorg)")
    elif ! is_account "${O_ACC[$i]}"; then
      CFG_ERRORS+=("org \"${O_RAW[$i]}\": 없는 계정 '${O_ACC[$i]}'")
    elif ! find_binding "${O_ACC[$i]}" "${O_HOST[$i]}"; then
      CFG_ERRORS+=("org \"${O_RAW[$i]}\": ${O_ACC[$i]} 계정에 ${O_HOST[$i]} 서버가 없습니다")
    fi
    i=$((i+1))
  done
  i=0
  while [ $i -lt ${#AR_RAW[@]} ]; do
    [ -z "${AR_PAT[$i]}" ] && CFG_ERRORS+=("folder \"${AR_RAW[$i]}\": allowRemote 가 비어 있습니다 (예: gitlab.example.com/*)")
    i=$((i+1))
  done
  case "$(lower "$CFG_AI_PUSH")" in ask|allow|branch) ;; *) CFG_ERRORS+=("gitsw.aiPush 는 ask, branch, allow 중 하나입니다 (지금: $CFG_AI_PUSH)") ;; esac
  case "$CFG_SSH_STRICT" in ""|true|false|yes|no|on|off|1|0) ;; *) CFG_ERRORS+=("gitsw.sshStrict 는 true 또는 false 입니다") ;; esac
  is_number "$CFG_MAX_MB" || CFG_ERRORS+=("gitsw.maxFileMB 는 숫자여야 합니다")
  is_number "$CFG_WARN_MB" || CFG_ERRORS+=("gitsw.warnFileMB 는 숫자여야 합니다")
}
find_binding_any() { local a; for a in "${B_ACC[@]}"; do [ "$a" = "$1" ] && return 0; done; return 1; }

need_config() {   # 설정이 없거나 틀리면 안내하고 종료
  if ! load_config; then
    [ -n "$MACHINE_JSON" ] && die "설정 파일이 없습니다: $(tilde "$CFG") — 기존 gitch(v1)에서 옮기기: gitch migrate / 새로 만들기: gitch add"
    err "설정 파일이 없습니다: $(tilde "$CFG")"
    err "  기존 gitch(v1)에서 옮기기: gitch migrate   /   새로 만들기: gitch add"
    exit 1
  fi
  if [ ${#CFG_ERRORS[@]} -gt 0 ]; then
    [ -n "$MACHINE_JSON" ] && die "설정 파일에 문제가 있습니다: $(tilde "$CFG") — ${CFG_ERRORS[*]}"
    local e
    err "설정 파일에 문제가 있습니다: $(tilde "$CFG")"
    for e in "${CFG_ERRORS[@]}"; do err "  - $e"; done
    exit 1
  fi
  [ ${#ACC_IDS[@]} -gt 0 ] || die "등록된 계정이 없습니다. gitch add 로 추가하세요."
}

set_account() {   # 계정 → SA_ID SA_EMAIL SA_NAME (번호도 가능)
  local i=0
  if is_number "$1" && [ "$1" -ge 1 ] && [ "$1" -le ${#ACC_IDS[@]} ]; then i=$(($1 - 1))
  elif acc_idx "$1"; then i=$ACC_I
  else err "알 수 없는 계정: '$1' (사용 가능: $(account_names))"; return 1; fi
  SA_ID=${ACC_IDS[$i]}; SA_EMAIL=${ACC_EMAIL[$i]}; SA_NAME=${ACC_NAME[$i]}; SA_ALIAS=""
}

# shellcheck disable=SC2120
select_account() {   # 인자가 없으면 번호로 고르기
  if [ -n "$1" ]; then set_account "$1" || exit 1; return; fi
  can_prompt || die "계정을 지정하세요. (계정: $(account_names))"
  local i=0 n
  echo ""
  echo "어떤 계정을 쓸까요?"
  while [ $i -lt ${#ACC_IDS[@]} ]; do
    echo "  $((i+1))) ${ACC_IDS[$i]}  (${ACC_EMAIL[$i]}, $(acc_hosts_desc "${ACC_IDS[$i]}"))"
    i=$((i+1))
  done
  read -r -p "번호: " n
  set_account "$n" || exit 1
}

# ================= 주소 / 계정 판단 =================

# 주소 → U_HOST(실제 서버) U_ALIAS(별칭 주소면) U_PATH(owner/repo) U_OWNER U_KIND(ssh|https|local)
parse_url() {
  local u="$1" rest hp h="" p=""
  U_HOST=""; U_ALIAS=""; U_PATH=""; U_OWNER=""; U_KIND=""
  case "$u" in
    http://*|https://*)
      rest=${u#*://}; hp=${rest%%/*}; hp=${hp##*@}; h=${hp%%:*}
      case "$rest" in */*) p=${rest#*/} ;; *) p="" ;; esac
      U_KIND=https ;;
    ssh://*|git+ssh://*|ssh+git://*)
      rest=${u#*://}; hp=${rest%%/*}; hp=${hp##*@}; h=${hp%%:*}
      case "$rest" in */*) p=${rest#*/} ;; *) p="" ;; esac
      U_KIND=ssh ;;
    git://*)
      rest=${u#git://}; hp=${rest%%/*}; h=${hp%%:*}
      case "$rest" in */*) p=${rest#*/} ;; *) p="" ;; esac
      U_KIND=git ;;
    /*|./*|../*|file://*|"") U_KIND=local; return 1 ;;
    *:*)
      hp=${u%%:*}
      case "$hp" in */*) U_KIND=local; return 1 ;; esac
      h=${hp##*@}; p=${u#*:}; U_KIND=ssh ;;
    *) U_KIND=local; return 1 ;;
  esac
  p=${p#/}; p=${p%/}; p=${p%.git}
  h=$(lower "$h")
  [ -z "$h" ] && { U_KIND=local; return 1; }
  if find_alias "$h"; then U_ALIAS=${B_ALIAS[$BI]}; U_HOST=${B_HOST[$BI]}; else U_HOST=$h; fi
  U_PATH=$p; U_OWNER=${p%%/*}
  return 0
}

folder_account() {   # $1 폴더 → FA (가장 깊게 맞는 기본 폴더의 계정)
  local d i=0 best="" bl=0 p
  FA=""
  d=$(real_dir "${1:-.}") || return 1
  while [ $i -lt ${#F_RAW[@]} ]; do
    if [ -z "${F_REAL[$i]}" ]; then F_REAL[$i]=$(real_dir "$(expand_path "${F_RAW[$i]}")"); [ -z "${F_REAL[$i]}" ] && F_REAL[$i]="-"; fi
    p=${F_REAL[$i]}
    if [ "$p" != "-" ]; then
      case "$d/" in "$p/"*) [ ${#p} -gt $bl ] && { best=${F_ACC[$i]}; bl=${#p}; } ;; esac
    fi
    i=$((i+1))
  done
  FA=$best
  [ -n "$FA" ]
}

folder_allow() {   # $1 폴더 → FAP (그 폴더에 허용된 push 대상 패턴, 줄바꿈 구분), FAP_DIR
  local d i=0 bl=0 p best=""
  FAP=""; FAP_DIR=""
  [ ${#AR_RAW[@]} -eq 0 ] && return 1
  d=$(real_dir "${1:-.}") || return 1
  while [ $i -lt ${#AR_RAW[@]} ]; do
    if [ -z "${AR_REAL[$i]}" ]; then AR_REAL[$i]=$(real_dir "$(expand_path "${AR_RAW[$i]}")"); [ -z "${AR_REAL[$i]}" ] && AR_REAL[$i]="-"; fi
    p=${AR_REAL[$i]}
    if [ "$p" != "-" ]; then
      case "$d/" in "$p/"*) [ ${#p} -gt $bl ] && { best=${AR_RAW[$i]}; bl=${#p}; } ;; esac
    fi
    i=$((i+1))
  done
  [ -z "$best" ] && return 1
  FAP_DIR=$best
  i=0
  while [ $i -lt ${#AR_RAW[@]} ]; do
    [ "${AR_RAW[$i]}" = "$best" ] && FAP="$FAP${AR_PAT[$i]}"$'\n'
    i=$((i+1))
  done
  return 0
}

org_account() {   # $1 서버 $2 경로 → OA, OKEY (가장 긴 조직 경로)
  local h="$1" p i=0 best="" bk="" bl=0 op
  OA=""; OKEY=""
  p=$(lower "$2")
  while [ $i -lt ${#O_RAW[@]} ]; do
    if [ "${O_HOST[$i]}" = "$h" ]; then
      op=${O_PATH[$i]}
      case "$p/" in "$op/"*) [ ${#op} -gt $bl ] && { best=${O_ACC[$i]}; bk=${O_RAW[$i]}; bl=${#op}; } ;; esac
    fi
    i=$((i+1))
  done
  OA=$best; OKEY=$bk
  [ -n "$OA" ]
}

alias_fits() {   # $1 계정: 주소가 별칭이면 그 계정의 별칭과 같은지
  [ -z "$U_ALIAS" ] && return 0
  find_binding "$1" "$U_HOST" && [ "$(lower "${B_ALIAS[$BI]}")" = "$(lower "$U_ALIAS")" ]
}

# 주소(U_*)와 폴더로 계정 추측 → D_ACC D_SRC D_NOTE
derive_account() {
  local dir="$1" a ol
  D_ACC=""; D_SRC=""; D_NOTE=""
  if [ "$U_HOST" = github.com ] && [ -n "$U_OWNER" ]; then
    ol=$(lower "$U_OWNER")
    for a in "${ACC_IDS[@]}"; do
      if [ "$(lower "$a")" = "$ol" ] && find_binding "$a" github.com && [ "${B_LOGIN[$BI]}" = "$a" ] && alias_fits "$a"; then
        D_ACC=$a; D_SRC=owner; D_NOTE="소유자 $U_OWNER"; return 0
      fi
    done
  fi
  if org_account "$U_HOST" "$U_PATH"; then   # 조직 규칙은 사용자가 정한 것이라 주소 별칭보다 우선
    D_ACC=$OA; D_SRC=org; D_NOTE="조직 규칙 $OKEY"; return 0
  fi
  if folder_account "$dir" && find_binding "$FA" "$U_HOST" && alias_fits "$FA"; then
    D_ACC=$FA; D_SRC=folder; D_NOTE="폴더 기본"; return 0
  fi
  if [ -n "$U_ALIAS" ] && find_alias "$U_ALIAS"; then
    D_ACC=${B_ACC[$BI]}; D_SRC="alias"; D_NOTE="주소 별칭 $U_ALIAS"; return 0
  fi
  if [ "$U_HOST" != github.com ] && host_single_account "$U_HOST"; then
    D_ACC=$HSA; D_SRC=host; D_NOTE="$U_HOST 의 유일한 계정"; return 0
  fi
  return 1
}

# 저장소 → R_ACC(쓸 계정) R_SRC R_NOTE R_LOCK R_DERIVED R_DERIVED_SRC R_HOST R_PATH R_URL R_URL_ALIAS
#          R_ALIAS(기대 push 별칭) R_LOGIN(로그인 계정) R_IGNORED R_LOCK_UNKNOWN
resolve_repo() {   # $1 폴더 [$2 fast — 훅용: 잠금이 있으면 규칙 계산 생략]
  local dir="${1:-.}" line k v want_rules=1
  R_ACC=""; R_SRC=""; R_NOTE=""; R_LOCK=""; R_DERIVED=""; R_DERIVED_SRC=""; R_DERIVED_NOTE=""
  R_HOST=""; R_PATH=""; R_URL=""; R_ALIAS=""; R_LOGIN=""; R_IGNORED=""; R_LOCK_UNKNOWN=""; R_URL_KIND=""
  while IFS= read -r line; do
    k=${line%% *}; v=${line#* }; [ "$v" = "$line" ] && v=""
    case "$k" in
      gitswitch.account) R_LOCK=$v ;;
      gitswitch.ignore) case "$(lower "$v")" in true|yes|on|1) R_IGNORED=1 ;; esac ;;
      remote.origin.url) R_URL=$v ;;
    esac
  done < <(git -C "$dir" config --get-regexp '^(gitswitch\.(account|ignore)|remote\.origin\.url)$' 2>/dev/null)
  [ "${2:-}" = fast ] && [ -n "$R_LOCK" ] && is_account "$R_LOCK" && want_rules=""

  if [ -n "$R_URL" ] && parse_url "$R_URL"; then
    R_HOST=$U_HOST; R_PATH=$U_PATH; R_URL_KIND=$U_KIND
    [ -n "$want_rules" ] && derive_account "$dir" && { R_DERIVED=$D_ACC; R_DERIVED_SRC=$D_SRC; R_DERIVED_NOTE=$D_NOTE; }
  elif [ -z "$R_URL" ]; then
    [ -n "$want_rules" ] && folder_account "$dir" && { R_DERIVED=$FA; R_DERIVED_SRC=folder; R_DERIVED_NOTE="폴더 기본"; }
  else
    R_URL_KIND=local
  fi

  if [ -n "$R_LOCK" ]; then
    if is_account "$R_LOCK"; then R_ACC=$R_LOCK; R_SRC=lock; R_NOTE="잠금"
    else R_LOCK_UNKNOWN=1; fi
  fi
  if [ -z "$R_ACC" ] && [ -n "$R_DERIVED" ]; then R_ACC=$R_DERIVED; R_SRC=$R_DERIVED_SRC; R_NOTE=$R_DERIVED_NOTE; fi
  if [ -n "$R_ACC" ] && [ -n "$R_HOST" ] && find_binding "$R_ACC" "$R_HOST"; then
    R_ALIAS=${B_ALIAS[$BI]}; R_LOGIN=${B_LOGIN[$BI]}
  fi
  return 0
}


push_url_alias() {   # $1 폴더 → PU_URL(실제 push 주소) PU_ALIAS
  PU_URL=$(git -C "${1:-.}" remote get-url --push origin 2>/dev/null)
  PU_ALIAS=""
  [ -n "$PU_URL" ] && parse_url "$PU_URL" && PU_ALIAS=$U_ALIAS
  return 0
}


# ================= 백업 / 기록 =================

BACKUP_SESSION=""
backup_file() {   # 고치기 전에 한 번 백업 (~/.local/state/gitsw/backups/<시각>/) — 마지막 백업과 내용이 같으면 건너뜀
  local f="$1" name dest d
  [ -f "$f" ] || return 0
  name=$(printf '%s' "${f#"$HOME"/}" | tr '/' '_')
  [ -n "$BACKUP_SESSION" ] && [ -f "$BACKUP_SESSION/$name" ] && return 0
  for d in $(ls -1d "$BACKUP_DIR"/[0-9]*-[0-9]*-[0-9]*/ 2>/dev/null | sort -r); do
    if [ -f "$d$name" ]; then cmp -s "$f" "$d$name" && return 0; break; fi
  done
  if [ -z "$BACKUP_SESSION" ]; then
    BACKUP_SESSION="$BACKUP_DIR/$(date +%Y%m%d-%H%M%S)-$$"
    mkdir -p "$BACKUP_SESSION" 2>/dev/null || return 0
    prune_backup_dirs
  fi
  dest="$BACKUP_SESSION/$name"
  cp -p "$f" "$dest" 2>/dev/null
  return 0
}
prune_backup_dirs() {   # <날짜>-<시각>-<번호> 모양 폴더는 최근 30개만 남김 (다른 이름의 폴더는 그대로)
  local d n=0
  for d in $(ls -1d "$BACKUP_DIR"/[0-9]*-[0-9]*-[0-9]*/ 2>/dev/null | sort -r); do
    n=$((n+1)); [ $n -gt 30 ] && rm -rf "$d"
  done
}
global_gitconfig() { printf '%s' "${GIT_CONFIG_GLOBAL:-$HOME/.gitconfig}"; }
backup_global() { backup_file "$(global_gitconfig)"; backup_file "${XDG_CONFIG_HOME:-$HOME/.config}/git/config"; }

log_action() {   # $1 이벤트, 나머지 key=value — ~/.local/state/gitsw/actions.jsonl (훅에서도 불리므로 가볍게)
  [ -n "${GITSW_INTERNAL:-}" ] && return 0
  local ev="$1" kv line top
  shift
  [ -d "$STATE_DIR" ] || mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  top=${LOG_TOP:-$(repo_top)}
  json_esc "$(now_iso)"; line="{\"ts\":$JE"
  json_esc "$ev"; line="$line,\"event\":$JE"
  json_esc "$ACTOR"; line="$line,\"actor\":$JE"
  json_esc "$top"; line="$line,\"repo\":$JE"
  for kv in "$@"; do
    json_esc "${kv%%=*}"; line="$line,$JE"
    json_esc "${kv#*=}"; line="$line:$JE"
  done
  line="$line}"
  if [ $((RANDOM % 64)) -eq 0 ] && [ -f "$ACTION_LOG" ] && [ "$(wc -c < "$ACTION_LOG" | tr -d ' ')" -gt 5242880 ]; then
    mv -f "$ACTION_LOG" "$ACTION_LOG.1" 2>/dev/null
  fi
  printf '%s\n' "$line" >> "$ACTION_LOG" 2>/dev/null
  return 0
}

# 위험한 작업 전 현재 상태를 refs/gitsw/backup/ 에 남김 (gitch rescue 로 복구)
backup_ref() {
  has_head || return 0
  local ts name n=1 wip
  ts=$(date +%Y%m%d-%H%M%S)
  name="refs/gitsw/backup/$ts-$1"
  while git show-ref -q --verify "$name"; do name="refs/gitsw/backup/$ts-$1-$n"; n=$((n+1)); done
  git update-ref -m "gitch backup ($1)" "$name" HEAD 2>/dev/null || return 0
  wip=$(git stash create 2>/dev/null)
  [ -n "$wip" ] && git update-ref -m "gitch backup wip ($1)" "$name-wip" "$wip" 2>/dev/null
  local refs r i=0
  refs=$(git for-each-ref --sort=-refname --format='%(refname)' refs/gitsw/backup/ | grep -v -- '-wip$')
  for r in $refs; do
    i=$((i+1))
    if [ $i -gt 30 ]; then git update-ref -d "$r" 2>/dev/null; git update-ref -d "$r-wip" 2>/dev/null; fi
  done
  return 0
}

# ================= 잠금 =================

sign_enabled() { [ "$(git config --global --get gitswitch.sign)" = "true" ]; }

apply_sign() {   # 저장소 서명 설정 (SA_ID 기준)
  local dir="$1" key="$SSH_DIR/id_ed25519_$SA_ID.pub"
  if sign_enabled && [ -f "$key" ]; then
    git -C "$dir" config gpg.format ssh
    git -C "$dir" config user.signingkey "$key"
    git -C "$dir" config commit.gpgsign true
    git -C "$dir" config tag.gpgsign true
    git -C "$dir" config gitswitch.signed true
  elif [ "$(git -C "$dir" config --get gitswitch.signed)" = "true" ]; then
    git -C "$dir" config --unset gpg.format
    git -C "$dir" config --unset user.signingkey
    git -C "$dir" config --unset commit.gpgsign
    git -C "$dir" config --unset tag.gpgsign
    git -C "$dir" config --unset gitswitch.signed
  fi
}

repo_hooks_dir() {   # 저장소의 실제 훅 폴더 (워크트리여도 공용 폴더)
  local hd
  hd=$(git -C "$1" rev-parse --git-path hooks 2>/dev/null) || return 1
  case "$hd" in /*|[A-Za-z]:/*) ;; *) hd="$(real_dir "$1")/$hd" ;; esac   # Windows 의 git 은 C:/… 로 준다
  printf '%s' "$hd"
}

repo_hook_script() {   # 보조 훅 내용 (Apple git 처럼 전역 훅을 모르는 git 용)
  local ev="$1" g miss=":"; g=$(gitsw_cmd_path)
  # gitch 가 없으면 커밋·push 때만 한 줄로 알린다 (전역 훅이 있으면 그쪽이 이미 알림)
  case "$ev" in pre-commit|pre-push) miss="echo \"$(missing_gitch_msg "$g")\" >&2" ;; esac
  # 이 git 이 전역 훅(gitsw-<이벤트>)을 이미 실행했으면 gitch 검사는 건너뛰고 기존 훅(.local)만 이어서 실행
  if [ "$ev" = pre-push ]; then
    cat <<EOF
#!/bin/sh
# gitswitch-lock — gitch 보조 훅 (gitch 가 관리, 새 git 은 전역 훅이 먼저 검사)
g="$g"
if [ ! -x "\$g" ] || git hook list $ev 2>/dev/null | grep -qx gitsw-$ev; then
  [ -x "\$g" ] || git hook list $ev 2>/dev/null | grep -qx gitsw-$ev || $miss
  if [ -x "\$0.local" ]; then exec "\$0.local" "\$@"; fi
  cat > /dev/null
  exit 0
fi
t=\$(mktemp "\${TMPDIR:-/tmp}/gitsw-push.XXXXXX") || exit 1
cat > "\$t"
"\$g" _hook --fallback $ev "\$@" < "\$t" || { rc=\$?; rm -f "\$t"; exit \$rc; }
if [ -x "\$0.local" ]; then "\$0.local" "\$@" < "\$t"; rc=\$?; rm -f "\$t"; exit \$rc; fi
rm -f "\$t"
exit 0
EOF
  else
    cat <<EOF
#!/bin/sh
# gitswitch-lock — gitch 보조 훅 (gitch 가 관리, 새 git 은 전역 훅이 먼저 검사)
g="$g"
if ! git hook list $ev 2>/dev/null | grep -qx gitsw-$ev; then
  if [ -x "\$g" ]; then "\$g" _hook --fallback $ev "\$@" || exit \$?; else $miss; fi
fi
if [ -x "\$0.local" ]; then exec "\$0.local" "\$@"; fi
exit 0
EOF
  fi
}

install_repo_hooks() {   # $1 저장소 — 보조 훅 설치 (기존 훅은 .local 로 옮겨 이어서 실행)
  local dir="$1" hp hd ev f
  hp=$(git -C "$dir" config --get core.hooksPath)
  if [ -n "$hp" ]; then
    if config_hooks_supported; then
      REPO_HOOK_NOTE="core.hooksPath 저장소 — 전역 훅이 검사합니다"
    else
      REPO_HOOK_NOTE="core.hooksPath($hp) 저장소라 보조 훅을 설치하지 못했습니다"
    fi
    return 0
  fi
  hd=$(repo_hooks_dir "$dir") || return 1
  mkdir -p "$hd" || return 1
  for ev in $HOOK_EVENTS; do
    f="$hd/$ev"
    if [ -f "$f" ] && ! grep -q "gitswitch-lock" "$f"; then mv "$f" "$f.local"; fi
    repo_hook_script "$ev" > "$f" && chmod +x "$f"
  done
  REPO_HOOK_NOTE=""
  return 0
}

repo_hooks_ok() {   # 보조 훅이 최신으로 깔려 있는지
  local hd ev
  [ -n "$(git -C "$1" config --get core.hooksPath)" ] && return 0
  hd=$(repo_hooks_dir "$1") || return 1
  for ev in $HOOK_EVENTS; do grep -q "_hook --fallback" "$hd/$ev" 2>/dev/null || return 1; done
  return 0
}

remove_repo_hooks() {   # gitch 보조 훅 제거 (.local 이 있으면 되돌림)
  local hd ev f
  hd=$(repo_hooks_dir "$1") || return 0
  for ev in $HOOK_EVENTS; do
    f="$hd/$ev"
    if [ -f "$f" ] && grep -q "gitswitch-lock" "$f"; then
      rm -f "$f"
      [ -f "$f.local" ] && mv "$f.local" "$f"
    fi
  done
}

lock_repo() {   # $1 폴더 — SA_* 계정으로 작성자 설정 + 잠금
  local dir="$1" prev
  prev=$(git -C "$dir" config --get gitswitch.account)
  git -C "$dir" config user.name "$SA_NAME"
  git -C "$dir" config user.email "$SA_EMAIL"
  git -C "$dir" config gitswitch.account "$SA_ID"
  git -C "$dir" config gitswitch.email "$SA_EMAIL"
  if [ -n "$SA_ALIAS" ]; then git -C "$dir" config gitswitch.alias "$SA_ALIAS"
  else git -C "$dir" config --unset gitswitch.alias 2>/dev/null; fi
  apply_sign "$dir"
  install_repo_hooks "$dir"
  [ -n "$REPO_HOOK_NOTE" ] && dim "  ($REPO_HOOK_NOTE)"
  if [ -n "$prev" ] && [ "$prev" != "$SA_ID" ]; then
    say "  ${YELLOW}🔒 잠금 계정 변경: $prev → $SA_ID${RESET}"
  else
    say "  🔒 이 저장소는 이제 ${BOLD}$SA_ID${RESET} 계정으로만 commit/push 됩니다."
  fi
}

# ================= use / unlock / ignore / protect =================

use_cmd() {
  need_config
  local acc="$1"
  in_repo || die "저장소 안에서 실행하세요. (전역 작성자는 쓰지 않습니다 — 폴더/주소 규칙으로 자동 지정됩니다)"
  resolve_repo .
  if [ -z "$acc" ]; then
    if [ -n "$R_LOCK" ] && [ -z "$R_LOCK_UNKNOWN" ]; then acc=$R_LOCK; say "ℹ 잠금 계정 다시 적용: $acc"
    elif [ -n "$R_DERIVED" ]; then acc=$R_DERIVED; say "ℹ 계정 자동 선택: $acc ($R_DERIVED_NOTE)"
    else die "계정을 자동으로 정할 수 없습니다. gitch use <계정>  (계정: $(account_names))"; fi
  fi
  set_account "$acc" || exit 1
  local url path up upath
  url=$R_URL
  if [ -n "$url" ] && parse_url "$url"; then
    find_binding "$SA_ID" "$U_HOST" || die "✘ $SA_ID 계정에는 $U_HOST 서버가 없습니다 (이 저장소: $U_HOST). 계정을 다시 확인하세요."
    SA_ALIAS=${B_ALIAS[$BI]}
    path=$U_PATH
    git remote set-url origin "git@$SA_ALIAS:$path.git"
    if [ -n "$(git config --get remote.origin.pushurl)" ]; then
      git config --unset-all remote.origin.pushurl
      git config remote.origin.pushurl "git@$SA_ALIAS:$path.git"
    fi
    up=$(git config --get remote.upstream.url)
    if [ -n "$up" ] && parse_url "$up" && [ "$U_HOST" = "${B_HOST[$BI]}" ]; then
      upath=$U_PATH
      git remote set-url upstream "git@$SA_ALIAS:$upath.git"
    fi
    ok "이 저장소를 $SA_ID 계정으로 전환했습니다."
    say "  remote: git@$SA_ALIAS:$path.git$( [ "${B_LOGIN[$BI]}" != "$SA_ID" ] && printf '  (로그인: %s)' "${B_LOGIN[$BI]}")"
  elif [ -n "$url" ]; then
    ok "이 저장소의 커밋 작성자를 $SA_ID 으로 설정했습니다. (원격이 로컬 경로: $url)"
  else
    ok "이 저장소의 커밋 작성자를 $SA_ID 으로 설정했습니다. (origin 없음)"
  fi
  lock_repo .
  say "  커밋 작성자: $SA_NAME <$SA_EMAIL>"
  log_action use "account=$SA_ID"
}

unlock_cmd() {
  require_repo
  local yes=""; [ "$1" = --yes ] && yes=1
  confirm "이 저장소의 계정 잠금을 풉니다. 계속할까요?" "$yes" "gitch unlock --yes"
  git config --unset gitswitch.account 2>/dev/null
  git config --unset gitswitch.email 2>/dev/null
  git config --unset gitswitch.alias 2>/dev/null
  say "🔓 잠금을 해제했습니다. (작성자 설정은 그대로입니다)"
  log_action unlock
}

ignore_cmd() {   # gitch 관리에서 이 저장소 빼기/되돌리기
  require_repo
  local off="" yes="" a
  for a in "$@"; do case "$a" in --off) off=1 ;; --yes) yes=1 ;; *) die "사용법: gitch ignore [--off]" ;; esac; done
  if [ -n "$off" ]; then
    git config --unset gitswitch.ignore 2>/dev/null
    ok "이 저장소를 다시 gitch 가 관리합니다."
  else
    confirm "이 저장소를 gitch 검사에서 뺍니다 (작성자/비밀값/push 검사 안 함). 계속할까요?" "$yes" "gitch ignore --yes"
    git config gitswitch.ignore true
    ok "이 저장소는 이제 gitch 검사를 하지 않습니다. (되돌리기: gitch ignore --off)"
  fi
}

protect_cmd() {   # 보호 브랜치 (직접 push 금지)
  require_repo
  local rm="" b list
  if [ $# -eq 0 ] || [ "$1" = --list ]; then
    list=$(git config --get-all gitswitch.protect)
    if [ -n "$list" ]; then say "보호 브랜치 (직접 push 금지):"; printf '%s\n' "$list" | sed 's/^/  /'
    else say "보호 브랜치가 없습니다. (추가: gitch protect main)"; fi
    return 0
  fi
  [ "$1" = --rm ] && { rm=1; shift; }
  [ $# -gt 0 ] || die "사용법: gitch protect <브랜치>...  /  gitch protect --rm <브랜치>"
  for b in "$@"; do
    case "$b" in --yes) continue ;; esac
    if [ -n "$rm" ]; then
      git config --fixed-value --unset-all gitswitch.protect "$b" 2>/dev/null && ok "보호 해제: $b"
    else
      git config --get-all gitswitch.protect | grep -qx -- "$b" || git config --add gitswitch.protect "$b"
      ok "보호 브랜치: $b (직접 push 금지 → 다른 브랜치에서 gitch pr)"
    fi
  done
}
is_protected() { git config --get-all gitswitch.protect 2>/dev/null | grep -qx -- "$1"; }

default_branch() {   # $1 원격 → 기본 브랜치 이름
  local r="${1:-origin}" d
  d=$(git symbolic-ref --short "refs/remotes/$r/HEAD" 2>/dev/null)
  if [ -n "$d" ]; then printf '%s' "${d#"$r"/}"; return 0; fi
  for d in main master develop; do
    git show-ref -q --verify "refs/remotes/$r/$d" && { printf '%s' "$d"; return 0; }
  done
  printf 'main'
}

# ================= clone / fork / sync =================

clone_cmd() {   # [계정] <저장소|주소> [폴더]
  need_config
  local acc="" input target host="" path name dest fdir
  if is_account "$1"; then acc="$1"; shift; fi
  input="$1"; target="$2"
  if [ -z "$input" ]; then
    can_prompt || die "사용법: gitch clone [계정] <저장소|주소> [폴더]"
    read -r -p "저장소 (예: owner/repo 또는 주소): " input
  fi
  [ -z "$input" ] && die "저장소가 비어 있습니다."

  if parse_url "$input"; then
    host=$U_HOST; path=$U_PATH
    if [ -z "$acc" ]; then
      derive_account . && acc=$D_ACC
      [ -n "$acc" ] && say "ℹ 계정 자동 선택: $acc ($D_NOTE)"
    fi
  else
    path=${input%.git}; path=${path%/}
    if [ -z "$acc" ]; then
      U_HOST=github.com; U_ALIAS=""; U_PATH=$path; U_OWNER=${path%%/*}
      if [ "$path" != "${path#*/}" ] && derive_account .; then acc=$D_ACC; say "ℹ 계정 자동 선택: $acc ($D_NOTE)"
      elif folder_account .; then acc=$FA; say "ℹ 계정 자동 선택: $acc (폴더 기본)"; fi
    fi
  fi
  [ -z "$acc" ] && die "계정을 정할 수 없습니다. gitch clone <계정> $input  (계정: $(account_names))"
  set_account "$acc" || exit 1

  if [ -z "$host" ]; then
    if find_binding "$SA_ID" github.com; then host=github.com
    else local i=0; while [ $i -lt ${#B_ACC[@]} ]; do [ "${B_ACC[$i]}" = "$SA_ID" ] && { host=${B_HOST[$i]}; break; }; i=$((i+1)); done; fi
  fi
  find_binding "$SA_ID" "$host" || die "✘ $SA_ID 계정에는 $host 서버가 없습니다. 계정을 다시 확인하세요."
  SA_ALIAS=${B_ALIAS[$BI]}
  [[ "$path" != */* ]] && path="${B_LOGIN[$BI]}/$path"
  name=$(basename "$path")

  if [ -n "$target" ]; then dest="$target"
  else
    fdir=$(acc_folder "$SA_ID")
    if in_repo; then
      [ -n "$fdir" ] || die "지금 폴더가 다른 저장소 안입니다. 받을 폴더를 지정하세요: gitch clone $SA_ID $input <폴더>"
      dest="$fdir/$name"; say "ℹ 다른 저장소 안이라 계정 기본 폴더에 받습니다: $(tilde "$dest")"
    elif [ -n "$fdir" ] && ! { folder_account . && [ "$FA" = "$SA_ID" ]; }; then
      dest="$fdir/$name"; say "ℹ $SA_ID 기본 폴더에 받습니다: $(tilde "$dest")"
    else
      dest="$name"
    fi
  fi
  [ -e "$dest" ] && die "이미 있습니다: $dest"
  mkdir -p "$(dirname "$dest")" || die "폴더를 만들 수 없습니다: $(dirname "$dest")"
  net_env
  say "→ git clone git@$SA_ALIAS:$path.git $(tilde "$dest")"
  if git clone "git@$SA_ALIAS:$path.git" "$dest"; then
    ok "'$(tilde "$dest")' 를 $SA_ID 계정으로 clone 했습니다."
    lock_repo "$dest"
    CLONED_DIR="$dest"
    (cd "$dest" && log_action clone "account=$SA_ID" "url=git@$SA_ALIAS:$path.git")
  else
    die "clone 실패. 'gitch doctor' 로 연결 상태를 확인하거나, 저장소 경로와 접근 권한을 확인하세요."
  fi
}

gh_token() {   # $1 GitHub 로그인 계정 → 토큰 (gh 전역 계정을 바꾸지 않음)
  command -v gh >/dev/null 2>&1 || return 1
  gh auth token --hostname github.com --user "$1" 2>/dev/null
}

fork_cmd() {   # [계정] <원본> [폴더]
  need_config
  local acc="" src target path owner name made="" tok login
  if is_account "$1"; then acc="$1"; shift; fi
  src="$1"; target="$2"
  [ -z "$src" ] && die "사용법: gitch fork [계정] <원본 owner/repo|주소> [폴더]"
  if [ -z "$acc" ]; then folder_account . && acc=$FA; fi
  [ -z "$acc" ] && die "계정을 정할 수 없습니다. gitch fork <계정> $src  (계정: $(account_names))"
  set_account "$acc" || exit 1
  find_binding "$SA_ID" github.com || die "fork 는 GitHub 계정만 지원합니다. ($SA_ID 계정에 github.com 이 없습니다)"
  login=${B_LOGIN[$BI]}
  if parse_url "$src"; then
    [ "$U_HOST" = github.com ] || die "GitHub 저장소 주소를 넣어주세요."
    path=$U_PATH
  else path=${src%.git}; fi
  [[ "$path" != */* ]] && die "원본은 owner/repo 또는 주소로 입력하세요. (예: myorg/app)"
  owner=${path%%/*}; name=$(basename "$path")
  [ "$(lower "$owner")" = "$(lower "$login")" ] && die "$login 자신의 저장소입니다. fork 대신 gitch clone 을 쓰세요."

  say "${BOLD}1) $login 계정에 $path 포크 준비${RESET}"
  if tok=$(gh_token "$login") && [ -n "$tok" ]; then
    GH_TOKEN="$tok" gh repo fork "$path" --clone=false --remote=false >/dev/null 2>&1
    GH_TOKEN="$tok" gh repo view "$login/$name" >/dev/null 2>&1 && made=1
  fi
  if [ -n "$made" ]; then ok "포크 준비됨: $login/$name"
  elif can_prompt; then
    say "  ${YELLOW}브라우저가 $login 계정으로 로그인됐는지 확인하고 'Create fork' 를 누르세요.${RESET}"
    read -r -p "  준비되면 Enter (페이지가 열립니다)..."
    browse "https://github.com/$path/fork"
    read -r -p "  포크를 만들었으면 Enter..."
  else
    die "포크를 자동으로 만들 수 없습니다 (gh 에 $login 로그인 필요: 사용자가 'gh auth login'). 또는 사용자에게 https://github.com/$path/fork 에서 $login 계정으로 포크를 만들어 달라고 요청하세요."
  fi

  say "${BOLD}2) 포크 clone${RESET}"
  clone_cmd "$SA_ID" "$login/$name" "$target"
  git -C "$CLONED_DIR" remote add upstream "git@$SA_ALIAS:$path.git" 2>/dev/null
  (cd "$CLONED_DIR" && net_env && git fetch -q upstream 2>/dev/null)
  ok "upstream(원본) 연결: $path"
  echo ""
  echo "작업 흐름:"
  echo "  cd $(tilde "$CLONED_DIR")"
  echo "  gitch b 작업브랜치  →  gitch c -m '...'  →  gitch pr"
  echo "  원본 최신 내용 받기: gitch sync"
}

sync_cmd() {   # 포크를 원본 최신으로
  require_repo
  git config --get remote.upstream.url >/dev/null || die "upstream(원본) 이 없습니다. fork 로 받은 저장소에서 쓰세요."
  local br def
  br=$(cur_branch) || die "브랜치 위에서 실행하세요."
  net_env
  git fetch upstream || die "upstream 을 받지 못했습니다."
  git remote set-head upstream -a >/dev/null 2>&1
  def=$(default_branch upstream)
  backup_ref sync
  if git rev-parse -q --verify "upstream/$br" >/dev/null; then
    if git merge --ff-only "upstream/$br"; then ok "$br 를 원본(upstream/$br) 최신으로 맞췄습니다."
    else die "원본과 갈라져서 fast-forward 할 수 없습니다. 'git rebase upstream/$br' 또는 'git merge upstream/$br' 로 직접 합치세요."; fi
  elif [ -n "$def" ]; then
    say "원본에 '$br' 브랜치가 없어 upstream/$def 를 합칩니다."
    GIT_EDITOR=true git merge --no-edit "upstream/$def" || die "합치다가 충돌이 났습니다. 'gitch ck' 로 확인 → 고친 뒤 gitch continue (취소: gitch abort)"
    ok "upstream/$def 를 합쳤습니다."
  fi
}

# ================= fix: 잘못된 작성자 고치기 =================

fix_cmd() {
  require_repo
  need_config
  local yes="" commits c bad=0 total first
  [ "$1" = --yes ] && yes=1
  resolve_repo .
  [ -z "$R_ACC" ] && die "이 저장소의 계정을 알 수 없습니다. 먼저 'gitch use <계정>' 을 하세요."
  set_account "$R_ACC" || exit 1
  commits=$(git rev-list --reverse HEAD --not --remotes 2>/dev/null)
  if [ -z "$commits" ]; then
    say "push 안 한 커밋이 없습니다. (이미 push 된 커밋은 고치지 않습니다)"; return 0
  fi
  total=$(printf '%s\n' "$commits" | grep -c .)
  for c in $commits; do
    if [ "$(git log -1 --format=%ae "$c")" != "$SA_EMAIL" ] || [ "$(git log -1 --format=%ce "$c")" != "$SA_EMAIL" ]; then
      bad=$((bad+1))
      say "  ${RED}✘${RESET} $(git log -1 --format='%h  %an <%ae>  %s' "$c")"
    fi
  done
  if [ "$bad" -eq 0 ]; then ok "push 안 한 커밋 ${total}개 모두 $SA_ID 으로 되어 있습니다."; return 0; fi
  say "위 ${bad}개 커밋의 작성자를 $SA_NAME <$SA_EMAIL> 로 고칩니다. (push 안 한 커밋만, 내용은 그대로)"
  confirm "진행할까요?" "$yes" "gitch fix --yes"
  git config user.name "$SA_NAME"; git config user.email "$SA_EMAIL"
  backup_ref fix
  first=$(printf '%s\n' "$commits" | head -1)
  local exec_cmd="git commit --amend --no-edit --no-verify --allow-empty --author='$SA_NAME <$SA_EMAIL>'"
  local base=(--root)
  git rev-parse -q --verify "$first^" >/dev/null && base=("$first^")
  if GITSW_INTERNAL=1 GIT_SEQUENCE_EDITOR=: GIT_EDITOR=true git rebase -q -r --autostash --exec "$exec_cmd" "${base[@]}" >/dev/null; then
    ok "${bad}개 커밋의 작성자를 고쳤습니다. (되돌리기: gitch rescue)"
    log_action fix "account=$SA_ID" "count=$bad"
  else
    err "고치는 중 문제가 생겼습니다. 'git rebase --abort' 로 되돌리거나 gitch rescue 를 쓰세요."
    return 1
  fi
}


# ================= auto: 주소/폴더/조직 자동 규칙 =================

sync_include_file() {   # $1 계정 → ~/.gitconfig-<계정> (작성자 + 서명)
  local id="$1" f key
  f="$HOME/.gitconfig-$id"; key="$SSH_DIR/id_ed25519_$id.pub"
  git config -f "$f" user.name "$(acc_name "$id")"
  git config -f "$f" user.email "$(acc_email "$id")"
  if sign_enabled && [ -f "$key" ]; then
    git config -f "$f" gpg.format ssh
    git config -f "$f" user.signingkey "$key"
    git config -f "$f" commit.gpgsign true
    git config -f "$f" tag.gpgsign true
  else
    git config -f "$f" --unset gpg.format 2>/dev/null
    git config -f "$f" --unset user.signingkey 2>/dev/null
    git config -f "$f" --unset commit.gpgsign 2>/dev/null
    git config -f "$f" --unset tag.gpgsign 2>/dev/null
  fi
}

remove_section_spellings() {   # $1 하위 이름 $2.. 섹션 이름 후보 — --remove-section 은 섹션 이름 대소문자를 구분하므로 후보를 모두 시도
  local sub="$1" name n
  shift
  for name in "$@"; do
    n=0
    while [ $n -lt 5 ] && git config --global --remove-section "$name.$sub" 2>/dev/null; do n=$((n+1)); done
  done
}

remove_managed_rules() {   # $1 계정 목록(공백 구분) — 그 계정들의 insteadOf/includeIf 섹션 삭제
  local ids="$1" entry k v sub al id s secs=""
  while IFS= read -r -d '' entry; do
    k=${entry%%$'\n'*}
    sub=${k#url.}; sub=${sub%.insteadof}
    case "$sub" in
      git@*:*)
        al=${sub#git@}; al=${al%%:*}
        for id in $ids; do case "$al" in *-"$id") secs="$secs"$'\n'"url"$'\t'"$sub"; break ;; esac; done ;;
    esac
  done < <(git config --global -z --get-regexp '^url\..*\.insteadof$' 2>/dev/null)
  while IFS= read -r -d '' entry; do
    k=${entry%%$'\n'*}; v=${entry#*$'\n'}
    case "$v" in
      */.gitconfig-*)
        id=${v##*/.gitconfig-}
        sub=${k#includeif.}; sub=${sub%.path}
        in_list "$id" "$ids" && secs="$secs"$'\n'"inc"$'\t'"$sub" ;;
    esac
  done < <(git config --global -z --get-regexp '^includeif\..*\.path$' 2>/dev/null)
  while IFS=$'\t' read -r k s; do
    [ -n "$s" ] || continue
    if [ "$k" = url ]; then remove_section_spellings "$s" url URL Url
    else remove_section_spellings "$s" includeIf includeif IncludeIf INCLUDEIF; fi
  done < <(printf '%s\n' "$secs" | sort -u)
  return 0
}

install_auto_rules() {
  git_version_ok || die "git 2.36 이상이 필요합니다. 지금: git $GIT_VER ($(install_hint git Git.Git))"
  need_config
  backup_global
  local i id h al f base pat p desc o oacc ohost opath
  remove_managed_rules "${ACC_IDS[*]}"
  for id in "${ACC_IDS[@]}"; do sync_include_file "$id"; done

  # 1) 폴더 규칙 (가장 약함 → 먼저)
  i=0
  while [ $i -lt ${#F_RAW[@]} ]; do
    p=$(expand_path "${F_RAW[$i]}"); p=${p%/}
    mkdir -p "$p" 2>/dev/null
    git config --global "includeIf.gitdir:$p/.path" "$HOME/.gitconfig-${F_ACC[$i]}"
    say "  ${GREEN}✔${RESET} ${F_ACC[$i]} ← 폴더 ${F_RAW[$i]}"
    i=$((i+1))
  done
  # 2) 계정 주소 규칙 (자기 키를 쓰는 서버만)
  i=0
  while [ $i -lt ${#B_ACC[@]} ]; do
    if [ "${B_LOGIN[$i]}" = "${B_ACC[$i]}" ]; then
      id=${B_ACC[$i]}; h=${B_HOST[$i]}; al=${B_ALIAS[$i]}; f="$HOME/.gitconfig-$id"
      if [ "$h" = github.com ]; then
        base="git@$al:$id/"
        git config --global --add "url.$base.insteadOf" "https://github.com/$id/"
        git config --global --add "url.$base.insteadOf" "git@github.com:$id/"
        git config --global --add "url.$base.insteadOf" "ssh://git@github.com/$id/"
        for pat in "https://github.com/$id/**" "git@github.com:$id/**" "ssh://git@github.com/$id/**"; do
          git config --global "includeIf.hasconfig:remote.*.url:$pat.path" "$f"
        done
        git config --global "includeIf.hasconfig:remote.*.url:git@$al:**.path" "$f"
        desc="github.com/$id/..."
      else
        base="git@$al:"
        git config --global --add "url.$base.insteadOf" "https://$h/"
        git config --global --add "url.$base.insteadOf" "git@$h:"
        git config --global --add "url.$base.insteadOf" "ssh://git@$h/"
        [ "${B_PORT[$i]}" != 22 ] && git config --global --add "url.$base.insteadOf" "ssh://git@$h:${B_PORT[$i]}/"
        for pat in "git@$al:**" "https://$h/**" "git@$h:**" "ssh://git@$h/**" "ssh://git@$h:${B_PORT[$i]}/**"; do
          git config --global "includeIf.hasconfig:remote.*.url:$pat.path" "$f"
        done
        desc="$h 의 모든 저장소"
      fi
      say "  ${GREEN}✔${RESET} $id ← $desc"
    fi
    i=$((i+1))
  done
  # 3) 조직 규칙 (가장 강함 → 마지막)
  i=0
  while [ $i -lt ${#O_RAW[@]} ]; do
    oacc=${O_ACC[$i]}; ohost=${O_HOST[$i]}; o=${O_RAW[$i]}; opath=${o#*/}
    if find_binding "$oacc" "$ohost"; then
      al=${B_ALIAS[$BI]}; f="$HOME/.gitconfig-$oacc"
      base="git@$al:$opath/"
      git config --global --add "url.$base.insteadOf" "https://$ohost/$opath/"
      git config --global --add "url.$base.insteadOf" "git@$ohost:$opath/"
      git config --global --add "url.$base.insteadOf" "ssh://git@$ohost/$opath/"
      for pat in "git@$al:$opath/**" "https://$ohost/$opath/**" "git@$ohost:$opath/**" "ssh://git@$ohost/$opath/**"; do
        git config --global "includeIf.hasconfig:remote.*.url:$pat.path" "$f"
      done
      say "  ${GREEN}✔${RESET} $oacc ← 조직 $o"
    fi
    i=$((i+1))
  done
  dim "  (주소/폴더/조직에 맞는 계정이 자동으로 쓰입니다. 그 외 저장소는 gitch clone/use 로 지정)"
}

auto_rules_ok() {   # 계정 주소 규칙이 깔려 있는지
  local i=0 rules
  rules=$(git config --global --get-regexp '^url\..*\.insteadof$' 2>/dev/null)
  while [ $i -lt ${#B_ACC[@]} ]; do
    if [ "${B_LOGIN[$i]}" = "${B_ACC[$i]}" ]; then
      printf '%s\n' "$rules" | grep -q "^url\.git@${B_ALIAS[$i]}:" || return 1
    fi
    i=$((i+1))
  done
  return 0
}

# ================= 전역 안전 설정 / 훅 =================

apply_safety_settings() {
  # 작성자가 설정 안 된 저장소에서 'me@컴퓨터이름' 같은 엉뚱한 작성자로 커밋되지 않게
  [ "$(git config --global --get user.useConfigOnly)" = true ] || git config --global user.useConfigOnly true
}

missing_gitch_msg() {   # $1 gitch 경로 — 훅이 gitch 를 못 찾았을 때 한 줄 (따옴표·$ 없이: 훅 스크립트의 echo 안에 들어간다)
  printf '%s' "[gitch] $(tilde "$1") 를 찾을 수 없어 검사를 건너뜁니다 — Gitrochi 설정 > CLI 에서 다시 설치하세요"
}

dispatcher_text() {   # $1 gitch 경로 → 전역 훅 연결 스크립트 내용
  cat <<EOF
#!/bin/sh
# gitch 훅 연결 (gitch install 이 관리) — gitch 가 없으면 막지 않고, 커밋·push 때 한 줄로 알린다
g="$1"
if [ ! -x "\$g" ]; then
  case "\$1" in pre-commit|pre-push) echo "$(missing_gitch_msg "$1")" >&2 ;; esac
  exit 0
fi
exec "\$g" _hook "\$@"
EOF
}

write_dispatcher() {   # 임시 파일에 쓰고 바꿔 넣는다 — 다른 git 이 읽는 중이어도 반쯤 쓴 내용을 보지 않게
  local t
  mkdir -p "$DATA_DIR" || return 1
  t=$(mktemp "$DATA_DIR/hook.XXXXXX") || return 1
  if dispatcher_text "$(gitsw_cmd_path)" > "$t" && chmod +x "$t" && mv -f "$t" "$HOOK_DISPATCHER"; then return 0; fi
  rm -f "$t"; return 1
}

hook_command() {   # $1 이벤트 → 전역 훅 명령. Windows 는 C:/… 로 적는다 — MSYS 가 git 에 넘길 때 /c/… 를 바꿔 저장해 다시 비교하면 달라 보이므로
  local d="$HOOK_DISPATCHER"
  [ -n "$IS_WINDOWS" ] && d=$(cygpath -m "$d" 2>/dev/null || printf '%s' "$d")
  printf '"%s" %s' "$d" "$1"
}

install_global_hooks() {   # git 설정 기반 훅 등록 (모든 저장소/워크트리/husky 저장소에 적용)
  local ev
  write_dispatcher || return 1
  for ev in $HOOK_EVENTS; do git config --global --remove-section "hook.gitsw-$ev" 2>/dev/null; done
  config_hooks_supported || return 1
  for ev in $HOOK_EVENTS; do
    git config --global "hook.gitsw-$ev.event" "$ev"
    git config --global "hook.gitsw-$ev.command" "$(hook_command "$ev")"
  done
  return 0
}

global_hooks_ok() {
  local ev
  [ -x "$HOOK_DISPATCHER" ] && grep -q "$(gitsw_cmd_path)" "$HOOK_DISPATCHER" 2>/dev/null || return 1
  config_hooks_supported || return 1
  for ev in $HOOK_EVENTS; do
    [ "$(git config --global --get "hook.gitsw-$ev.command")" = "$(hook_command "$ev")" ] || return 1
  done
  return 0
}

ssh_strict_on() { case "$CFG_SSH_STRICT" in true|yes|on|1) return 0 ;; esac; return 1; }

apply_ssh_strict() {   # 별칭 없는 github.com 등으로는 키 인증을 안 하게 (선택 기능)
  local block="" hosts="" i=0 h
  while [ $i -lt ${#B_ACC[@]} ]; do
    h=${B_HOST[$i]}; in_list "$h" "$hosts" || hosts="$hosts $h"
    i=$((i+1))
  done
  if ssh_strict_on; then
    block="# >>> gitsw strict >>>  ('gitch install' 이 관리 — 별칭 없는 주소로는 키 인증 안 함)"
    for h in $hosts; do
      block="$block"$'\n'"Host $h"$'\n'"    PubkeyAuthentication no"$'\n'"    IdentitiesOnly yes"
    done
    block="$block"$'\n'"# <<< gitsw strict <<<"
    backup_file "$SSH_CONFIG"
    update_marked_block "$SSH_CONFIG" "# >>> gitsw strict >>>" "# <<< gitsw strict <<<" "$block"
    chmod 600 "$SSH_CONFIG"
    return 0
  fi
  if grep -q '^# >>> gitsw strict >>>' "$SSH_CONFIG" 2>/dev/null; then
    backup_file "$SSH_CONFIG"
    remove_marked_block "$SSH_CONFIG" "# >>> gitsw strict >>>" "# <<< gitsw strict <<<"
  fi
  return 0
}

# 표시된 블록을 파일 끝에 넣거나 교체 ($1 파일 $2 시작표시 $3 끝표시 $4 내용 $5 지울 옛 제목 $6 지울 한 줄)
update_marked_block() {
  local f="$1" tmp
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || : > "$f"
  tmp=$(mktemp "${TMPDIR:-/tmp}/gitsw.XXXXXX") || return 1
  awk -v b="$2" -v e="$3" -v old="$5" -v drop="$6" '
    skip { if (index($0, e) == 1) skip = 0; next }
    index($0, b) == 1 { skip = 1; next }
    (old != "" && $0 == old) { inold = 1; next }
    inold { if ($0 ~ /^#{1,2} /) inold = 0; else next }
    (drop != "" && $0 == drop) { next }
    /^[[:space:]]*$/ { blank++; next }
    { while (blank > 0) { print ""; blank-- } print }
  ' "$f" > "$tmp"
  if [ -s "$tmp" ]; then printf '\n%s\n' "$4" >> "$tmp"; else printf '%s\n' "$4" >> "$tmp"; fi
  cat "$tmp" > "$f"
  rm -f "$tmp"
}

remove_marked_block() {   # $1 파일 $2 시작표시 $3 끝표시
  local f="$1" tmp
  [ -f "$f" ] || return 0
  tmp=$(mktemp "${TMPDIR:-/tmp}/gitsw.XXXXXX") || return 1
  awk -v b="$2" -v e="$3" '
    skip { if (index($0, e) == 1) skip = 0; next }
    index($0, b) == 1 { skip = 1; next }
    /^[[:space:]]*$/ { blank++; next }
    { while (blank > 0) { print ""; blank-- } print }
  ' "$f" > "$tmp"
  cat "$tmp" > "$f"
  rm -f "$tmp"
}

# ================= _hook: git 이 부르는 검사 =================

hook_skip() { case ",${GITSW_SKIP:-}," in *",$1,"*|*",all,"*) return 0 ;; esac; return 1; }

hook_footer() {
  if [ "$ACTOR" = human ]; then
    err "  (정말 필요하면 터미널에서 직접: GITSW_SKIP=<identity|secrets|bigfile|force|protect|remote|flow> git ...)"
  else
    err "  → AI 는 이 검사를 우회하지 말고, 위 메시지를 사용자에게 그대로 보고하세요."
  fi
}

hook_main() {   # [--fallback] <이벤트> [인자...] — 보조 훅 스크립트가 전역 훅과의 중복은 미리 걸러서 부름
  local ev
  [ "$1" = --fallback ] && shift
  ev="$1"; shift
  # 앱을 업데이트하면 gitch 만 바뀌고 연결 스크립트는 그대로라, 내용이 다르면 여기서 새로 쓴다 (못 쓰면 그대로 둔다)
  if [ -f "$HOOK_DISPATCHER" ] && [ "$(cat "$HOOK_DISPATCHER" 2>/dev/null)" != "$(dispatcher_text "$(gitsw_cmd_path)")" ]; then
    write_dispatcher 2>/dev/null
  fi
  if hook_skip all || ! load_config || [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = true ]; then
    [ "$ev" = pre-push ] && cat >/dev/null
    return 0
  fi
  if [ ${#CFG_ERRORS[@]} -gt 0 ]; then
    err "⚠ [gitch] 설정 파일에 문제가 있어 검사를 건너뜁니다 → gitch doctor"
    [ "$ev" = pre-push ] && cat >/dev/null
    return 0
  fi
  case "$ev" in
    pre-commit) hook_pre_commit ;;
    commit-msg) hook_commit_msg "$1" ;;
    pre-push) hook_pre_push "$1" "$2" ;;
    post-commit) hook_post_commit ;;
    *) return 0 ;;
  esac
}

hook_pre_commit() {
  local rc=0
  resolve_repo . fast
  [ -n "$R_IGNORED" ] && return 0
  hook_skip identity || hook_check_identity || rc=1
  hook_skip secrets || hook_check_secrets || rc=1
  hook_skip bigfile || hook_check_sizes || rc=1
  [ $rc -ne 0 ] && hook_footer
  return $rc
}

hook_check_identity() {
  local ai ci ae ce want
  if ! ai=$(git var GIT_AUTHOR_IDENT 2>/dev/null); then
    err "✘ [gitch] 커밋 작성자가 설정되지 않았습니다."
    if [ -n "$R_ACC" ]; then err "  해결: gitch use $R_ACC"; else err "  해결: gitch use <계정>  (계정: $(account_names))"; fi
    return 1
  fi
  ci=$(git var GIT_COMMITTER_IDENT 2>/dev/null)
  ae=$(ident_email "$ai"); ce=$(ident_email "$ci")
  if [ -n "$R_ACC" ]; then
    want=$(acc_email "$R_ACC")
    if [ "$ae" != "$want" ] || [ "$ce" != "$want" ]; then
      err "✘ [gitch] 이 저장소는 $R_ACC 계정 전용입니다. ($R_NOTE)"
      if [ "$ce" != "$ae" ]; then err "  현재 작성자: $ae / 커미터: $ce  (필요: $want)"
      else err "  현재 작성자: $ae  (필요: $want)"; fi
      err "  해결: gitch use $R_ACC"
      return 1
    fi
  elif [ -n "$R_HOST" ] && host_is_managed "$R_HOST"; then
    err "✘ [gitch] 이 저장소($R_HOST/$R_PATH)는 어느 계정으로 커밋할지 정해지지 않았습니다."
    err "  해결: gitch use <계정>  (계정: $(account_names))"
    return 1
  fi
  return 0
}

sensitive_name() {   # $1 경로 → SN_REASON(막을 이유), 해당 없으면 1
  local b="${1##*/}"
  SN_REASON=""
  case "$b" in
    *.pub) return 1 ;;
    .env.example|.env.sample|.env.template|.env.dist|.env.defaults|.env.schema) return 1 ;;
    .env.*.example|.env.*.sample|.env.*.template) return 1 ;;
    .env|.env.*) SN_REASON=".env 파일 (환경변수/비밀값)" ;;
    *.p12|*.pfx) SN_REASON="인증서 개인키 파일" ;;
    *.jks|*.keystore) SN_REASON="서명 키스토어" ;;
    *.p8) SN_REASON="Apple/서비스 인증 키(.p8)" ;;
    id_rsa|id_dsa|id_ecdsa|id_ed25519|id_rsa_*|id_ecdsa_*|id_ed25519_*) SN_REASON="SSH 개인키" ;;
    *) return 1 ;;
  esac
  return 0
}

read -r -d '' SECRET_AWK <<'AWKEOF'
function mask(s) { if (length(s) <= 10) return substr(s, 1, 3) "…"; return substr(s, 1, 8) "…(" length(s) "자)" }
function okb(l) { return RSTART == 1 || substr(l, RSTART - 1, 1) !~ /[A-Za-z0-9_]/ }
BEGIN { file = ""; skip = 0; ln = 0 }
/^\+\+\+ / { f = substr($0, 5); if (substr(f, 1, 2) == "b/") f = substr(f, 3); file = f; skip = (file ~ ENVIRON["GITSW_LOCKRE"]); next }
/^--- / { next }
/^@@/ { s = $0; sub(/^@@ -[0-9]+(,[0-9]+)? \+/, "", s); sub(/[^0-9].*$/, "", s); ln = s + 0; next }
/^\+/ {
  if (skip) { ln++; next }
  line = substr($0, 2)
  if (index(line, "gitch:allow") > 0 || index(line, "gitsw:allow") > 0) { ln++; next }
  kind = ""
  if (match(line, /-----BEGIN [A-Z0-9 ]*PRIVATE KEY/)) kind = "개인키"
  else if (match(line, /gh[pousr]_[A-Za-z0-9]{36}/) && okb(line)) kind = "GitHub 토큰"
  else if (match(line, /github_pat_[A-Za-z0-9_]{40,}/) && okb(line)) kind = "GitHub 토큰"
  else if (match(line, /gl(pat|dt|rt|ptt|cbt|ft|imt|agent|oas|soat)-[A-Za-z0-9_-]{20,}/) && okb(line)) kind = "GitLab 토큰"
  else if (match(line, /(AKIA|ASIA)[0-9A-Z]{16}/) && okb(line) && substr(line, RSTART + RLENGTH, 1) !~ /[0-9A-Z]/) kind = "AWS 키"
  else if (match(line, /xox[baprs]-[A-Za-z0-9-]{10,}/) && okb(line)) kind = "Slack 토큰"
  else if (match(line, /hooks\.slack\.com\/services\/T[A-Za-z0-9]+\/B[A-Za-z0-9]+\/[A-Za-z0-9]+/)) kind = "Slack 웹훅"
  else if (match(line, /sk-ant-[A-Za-z0-9_-]{20,}/) && okb(line)) kind = "Anthropic 키"
  else if (match(line, /sk-(proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,}/) && okb(line)) kind = "OpenAI 키"
  else if (match(line, /[sr]k_live_[0-9A-Za-z]{24,}/) && okb(line)) kind = "Stripe 키"
  else if (match(line, /npm_[A-Za-z0-9]{36}/) && okb(line)) kind = "npm 토큰"
  if (kind != "") print file ":" ln "  " kind "  " mask(substr(line, RSTART, RLENGTH))
  ln++
  next
}
AWKEOF

run_gitleaks() {   # gitleaks 가 설치돼 있으면 스테이지 내용을 한 번 더 검사 (발견 내용 출력)
  command -v gitleaks >/dev/null 2>&1 || return 0
  local out rc
  out=$(gitleaks git --pre-commit --staged --redact --no-banner --exit-code 9 2>&1); rc=$?
  if [ $rc -ne 0 ] && [ $rc -ne 9 ] && printf '%s' "$out" | grep -qiE 'unknown (command|flag|shorthand)'; then
    out=$(gitleaks protect --staged --redact --no-banner --exit-code 9 2>&1); rc=$?
  fi
  [ $rc -eq 9 ] && printf '%s\n' "$out" | grep -E '^(RuleID|File|Line|Finding):' | head -20 | sed 's/^/gitleaks /'
  return 0
}

hook_check_secrets() {
  local out bad="" f gl
  out=$(git -c core.quotepath=off diff --cached --no-color --no-ext-diff --no-textconv -U0 --diff-filter=ACMR 2>/dev/null | GITSW_LOCKRE="$LOCKFILE_RE" awk "$SECRET_AWK")
  while IFS= read -r -d '' f; do
    [ -z "$f" ] && continue
    sensitive_name "$f" && bad="$bad  $f  — $SN_REASON"$'\n'
  done < <(git diff --cached --name-only -z --diff-filter=ACR 2>/dev/null)
  gl=$(run_gitleaks)
  if [ -n "$out" ] || [ -n "$bad" ] || [ -n "$gl" ]; then
    err "✘ [gitch] 비밀값으로 보이는 내용이 있어 커밋을 막았습니다:"
    [ -n "$bad" ] && printf '%s' "$bad" >&2
    [ -n "$out" ] && printf '%s\n' "$out" | sed 's/^/  /' >&2
    [ -n "$gl" ] && printf '%s\n' "$gl" | sed 's/^/  /' >&2
    err "  해결: 그 파일/줄을 커밋에서 빼세요 (git restore --staged <파일>, .gitignore 에 추가)."
    err "  일부러 넣는 예시 값이면 그 줄에 'gitch:allow' 주석을 붙이세요. (예전 이름 gitsw:allow 도 됩니다)"
    return 1
  fi
  return 0
}

human_size() { local b=$1; if [ "$b" -ge 1048576 ]; then echo "$((b/1048576))MB"; elif [ "$b" -ge 1024 ]; then echo "$((b/1024))KB"; else echo "${b}B"; fi; }

hook_check_sizes() {
  local raw list sizes paths max warnb s p big="" warned=""
  raw=$(git -c core.quotepath=off diff --cached --raw --no-abbrev --diff-filter=AM 2>/dev/null)
  [ -z "$raw" ] && return 0
  max=$((CFG_MAX_MB * 1048576)); warnb=$((CFG_WARN_MB * 1048576))
  list=$(printf '%s\n' "$raw" | awk -F'\t' '{ split($1, m, " "); if (m[2] != "160000" && m[4] != "") print m[4] "\t" $2 }')
  [ -z "$list" ] && return 0
  sizes=$(printf '%s\n' "$list" | cut -f1 | git cat-file --batch-check='%(objectsize)' 2>/dev/null)
  paths=$(printf '%s\n' "$list" | cut -f2-)
  while IFS=$'\t' read -r s p; do
    is_number "$s" || continue
    if [ "$max" -gt 0 ] && [ "$s" -ge "$max" ]; then big="$big  $p  ($(human_size "$s"))"$'\n'
    elif [ "$warnb" -gt 0 ] && [ "$s" -ge "$warnb" ]; then warned="$warned  $p  ($(human_size "$s"))"$'\n'; fi
  done < <(paste <(printf '%s\n' "$sizes") <(printf '%s\n' "$paths"))
  if [ -n "$warned" ]; then err "⚠ [gitch] 큰 파일이 있습니다 (${CFG_WARN_MB}MB 이상):"; printf '%s' "$warned" >&2; fi
  if [ -n "$big" ]; then
    err "✘ [gitch] ${CFG_MAX_MB}MB 이상 파일은 커밋할 수 없습니다:"
    printf '%s' "$big" >&2
    err "  해결: 커밋에서 빼거나(git restore --staged <파일>) Git LFS 를 쓰세요."
    return 1
  fi
  return 0
}

hook_commit_msg() {   # 계정 정책 aiTrailer=strip 이면 AI 표기 줄 제거
  local f="$1" tmp t any=""
  { [ -n "$f" ] && [ -f "$f" ]; } || return 0
  for t in "${ACC_TRAILER[@]}"; do [ "$t" = strip ] && any=1; done
  [ -n "$any" ] || return 0
  resolve_repo . fast
  [ -n "$R_IGNORED" ] && return 0
  { [ -n "$R_ACC" ] && acc_idx "$R_ACC"; } || return 0
  [ "${ACC_TRAILER[$ACC_I]}" = strip ] || return 0
  grep -qiE "$AI_TRAILER_RE" "$f" || return 0
  tmp="$f.gitch.$$"
  grep -viE "$AI_TRAILER_RE" "$f" > "$tmp"
  cat "$tmp" > "$f"
  rm -f "$tmp"
  err "ℹ [gitch] $R_ACC 계정 정책(aiTrailer=strip)에 따라 AI 표기 줄을 뺐습니다."
  return 0
}

hook_pre_push() {   # $1 원격 이름 $2 주소, 표준입력: <local ref> <local sha> <remote ref> <remote sha>
  local remote="$1" url="$2" refs rc=0 managed="" uk="" uh="" up="" ua="" target pat okp=""
  refs=$(cat)
  resolve_repo . fast
  [ -n "$R_IGNORED" ] && return 0
  [ -z "$url" ] && url=$(git remote get-url --push "$remote" 2>/dev/null)
  if parse_url "$url"; then
    uk=$U_KIND; uh=$U_HOST; up=$U_PATH; ua=$U_ALIAS
    host_is_managed "$uh" && managed=1
  else
    uk=local
  fi
  # 폴더별 push 허용 목록 (예: 회사 폴더 코드는 회사 서버로만)
  if ! hook_skip remote && folder_allow .; then
    if [ "$uk" = local ]; then target=$(lower "$url"); else target=$(lower "$uh/$up"); fi
    while IFS= read -r pat; do
      [ -z "$pat" ] && continue
      # shellcheck disable=SC2254
      case "$target" in $pat) okp=1; break ;; esac
    done <<< "$FAP"
    if [ -z "$okp" ]; then
      err "✘ [gitch] $FAP_DIR 폴더의 저장소는 이 곳으로 push 할 수 없습니다: $target"
      err "  허용된 곳: $(printf '%s' "$FAP" | tr '\n' ' ')"
      rc=1
    fi
  fi
  if [ -n "$managed" ] && ! hook_skip identity; then hook_check_target "$url" "$uh" "$ua" || rc=1; fi
  if [ -n "$refs" ]; then hook_check_refs "$remote" "$refs" "$managed" || rc=1; fi
  # 흐름 게이트(켠 저장소만): 같은 커밋의 서명된 통과 기록이 없으면 pre-push 흐름을 돌린다
  if [ $rc -eq 0 ] && [ -n "$refs" ] && ! hook_skip flow; then hook_flow_gate || rc=1; fi
  # gitch p 로 한 push 는 결과를 보고 gitch 가 직접 기록하므로 여기서는 건너뜀 (중복 기록 방지)
  if [ $rc -eq 0 ]; then [ "${GITSW_NOLOG_PUSH:-}" = 1 ] || log_action push "remote=$remote" "url=$url" "account=${R_ACC:-}"
  else hook_footer; fi
  return $rc
}

hook_check_target() {   # $1 주소 $2 서버 $3 주소 별칭
  local url="$1" h="$2" ua="$3" want
  if [ -z "$R_ACC" ]; then
    err "✘ [gitch] 이 저장소는 push 계정이 정해지지 않았습니다. ($h)"
    err "  해결: gitch use <계정>  (계정: $(account_names))"
    return 1
  fi
  if ! find_binding "$R_ACC" "$h"; then
    err "✘ [gitch] $R_ACC 계정에는 $h 서버가 없습니다. (push 주소: $url)"
    err "  해결: 계정을 확인하고 gitch use <계정>"
    return 1
  fi
  want=${B_ALIAS[$BI]}
  if [ -z "$ua" ]; then
    err "✘ [gitch] 별칭 없는 주소로는 push 할 수 없습니다: $url"
    err "  이 저장소는 $R_ACC 계정(git@$want:...)으로 push 합니다. 해결: gitch use $R_ACC"
    return 1
  fi
  if [ "$(lower "$ua")" != "$(lower "$want")" ]; then
    err "✘ [gitch] 이 저장소는 $R_ACC 계정 전용입니다. ($R_NOTE)"
    err "  push 주소: $url  (필요: git@$want:...)"
    err "  해결: gitch use $R_ACC"
    return 1
  fi
  return 0
}

hook_check_refs() {   # $1 원격 $2 ref 줄들 $3 관리 서버 여부
  local remote="$1" refs="$2" managed="$3" _lref lsha rref rsha br def rc=0
  def=$(default_branch "$remote")
  while read -r _lref lsha rref rsha; do
    [ -z "$rref" ] && continue
    br=""
    case "$rref" in refs/heads/*) br=${rref#refs/heads/} ;; esac
    if is_zero_sha "$lsha"; then
      if [ -n "$br" ] && { [ "$br" = "$def" ] || is_protected "$br"; } && ! hook_skip protect; then
        err "✘ [gitch] 기본/보호 브랜치 삭제를 막았습니다: $br"
        rc=1
      fi
      continue
    fi
    if ! is_zero_sha "$rsha"; then
      if ! git cat-file -e "$rsha^{commit}" 2>/dev/null || ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
        if [ "${GITSW_ALLOW_FORCE:-}" != 1 ] && ! hook_skip force; then
          err "✘ [gitch] 강제 push(원격의 기존 커밋 덮어쓰기)를 막았습니다: ${br:-$rref}"
          err "  원격에 새 커밋이 있으면: gitch pl 로 받은 뒤 다시 push"
          err "  정말 덮어써야 하면 사용자가 직접: gitch p --force"
          rc=1
        fi
      fi
    fi
    if [ -n "$br" ] && is_protected "$br" && ! hook_skip protect; then
      err "✘ [gitch] 보호된 브랜치($br)에는 직접 push 할 수 없습니다 → 다른 브랜치에서 gitch pr"
      rc=1
    fi
    if [ -n "$managed" ] && [ -n "$R_ACC" ] && ! hook_skip identity; then
      hook_check_new_commits "$lsha" || rc=1
    fi
  done <<< "$refs"
  return $rc
}

hook_check_new_commits() {   # push 할 새 커밋들의 작성자 검사
  local want h ae ce s n=0 bad=""
  want=$(acc_email "$R_ACC")
  while IFS=$'\t' read -r h ae ce s; do
    [ -z "$h" ] && continue
    if [ "$ce" != "$want" ] || { [ "$ae" != "$want" ] && email_is_mine "$ae"; }; then
      n=$((n+1))
      [ $n -le 10 ] && bad="$bad    $h  작성자 $ae / 커미터 $ce  $s"$'\n'
    fi
  done < <(git log --format='%h%x09%ae%x09%ce%x09%s' "$1" --not --remotes 2>/dev/null)
  if [ $n -gt 0 ]; then
    err "✘ [gitch] push 할 커밋 중 ${n}개의 작성자가 $R_ACC($want) 가 아닙니다:"
    printf '%s' "$bad" >&2
    err "  해결: gitch fix --yes  (push 안 한 커밋의 작성자를 고침, 사용자 동의 필요)"
    return 1
  fi
  return 0
}

hook_post_commit() {   # 기록 + (--no-verify 등으로) 잘못된 작성자 커밋이 생기면 경고
  local paths top rm ra info sha ae subj want
  resolve_repo . fast
  [ -n "$R_IGNORED" ] && return 0
  paths=$(git rev-parse --show-toplevel --git-path rebase-merge --git-path rebase-apply 2>/dev/null) || return 0
  top=$(printf '%s\n' "$paths" | sed -n 1p); rm=$(printf '%s\n' "$paths" | sed -n 2p); ra=$(printf '%s\n' "$paths" | sed -n 3p)
  { [ -d "$rm" ] || [ -d "$ra" ]; } && return 0
  info=$(git log -1 --format='%h%x09%ae%x09%s' HEAD 2>/dev/null) || return 0
  IFS=$'\t' read -r sha ae subj <<< "$info"
  if [ -n "$R_ACC" ]; then
    want=$(acc_email "$R_ACC")
    [ "$ae" != "$want" ] && err "⚠ [gitch] 방금 커밋($sha)의 작성자($ae)가 $R_ACC($want) 가 아닙니다 → push 전에 gitch fix"
  fi
  LOG_TOP=$top log_action commit "sha=$sha" "branch=$(cur_branch)" "account=${R_ACC:-}" "subject=$subj"
  return 0
}


# ================= 상태 / 점검 =================

global_author_desc() {
  local n e
  n=$(git config --global user.name); e=$(git config --global user.email)
  if [ -n "$e" ]; then printf '%s <%s>' "$n" "$e"
  else
    printf '없음 — 폴더/주소/조직 규칙으로 자동 지정'
    [ "$(git config --global --get user.useConfigOnly)" = true ] && printf ' (규칙 밖 저장소는 커밋이 막힘)'
  fi
}

repo_state() {   # RS_OP(rebase|merge|cherry-pick|revert|am|bisect|"") RS_CONFLICT_FILES RS_CONFLICTS
  local paths rm ra bl
  RS_OP=""
  paths=$(git rev-parse --git-path rebase-merge --git-path rebase-apply --git-path BISECT_LOG 2>/dev/null)
  rm=$(printf '%s\n' "$paths" | sed -n 1p); ra=$(printf '%s\n' "$paths" | sed -n 2p); bl=$(printf '%s\n' "$paths" | sed -n 3p)
  if [ -d "$rm" ]; then RS_OP=rebase
  elif [ -d "$ra" ]; then if [ -f "$ra/applying" ]; then RS_OP=am; else RS_OP=rebase; fi
  elif git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then RS_OP=merge
  elif git rev-parse -q --verify CHERRY_PICK_HEAD >/dev/null 2>&1; then RS_OP=cherry-pick
  elif git rev-parse -q --verify REVERT_HEAD >/dev/null 2>&1; then RS_OP=revert
  elif [ -f "$bl" ]; then RS_OP=bisect; fi
  RS_CONFLICT_FILES=$(git -c core.quotepath=off diff --name-only --diff-filter=U 2>/dev/null)
  RS_CONFLICTS=$(printf '%s' "$RS_CONFLICT_FILES" | grep -c .)
}

op_word() {
  case "$1" in rebase) echo "rebase" ;; merge) echo "merge(합치기)" ;; cherry-pick) echo "cherry-pick" ;;
    revert) echo "revert" ;; am) echo "패치 적용(am)" ;; bisect) echo "bisect" ;; *) echo "$1" ;; esac
}

maybe_fetch() {   # $1 force|auto|never → 0 받음/최근에 받음, 1 실패, 2 건너뜀
  local fh age
  [ "$1" = never ] && return 2
  git remote get-url origin >/dev/null 2>&1 || return 2
  fh=$(git rev-parse --git-path FETCH_HEAD 2>/dev/null)
  if [ "$1" = auto ] && [ -f "$fh" ]; then
    age=$(( $(date +%s) - $(file_mtime "$fh") ))
    [ "$age" -lt "${GITSW_FETCH_TTL:-60}" ] && return 0
  fi
  GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=5}" GIT_TERMINAL_PROMPT=0 git fetch -q --no-tags origin 2>/dev/null
}

status_cmd() {
  local json="" strict="" ssh="" a
  for a in "$@"; do
    case "$a" in --json) json=1 ;; --strict) strict=1 ;; --ssh) ssh=1 ;; *) die "사용법: gitch status [--json] [--strict] [--ssh]" ;; esac
  done
  load_config >/dev/null 2>&1
  if ! in_repo; then
    if [ -n "$json" ]; then
      folder_account . && printf '{"schemaVersion":1,"inRepo":false,"folderAccount":%s}\n' "$(json_str "$FA")" || printf '{"schemaVersion":1,"inRepo":false,"folderAccount":null}\n'
      return 0
    fi
    say "${BOLD}[전역 작성자]${RESET} $(global_author_desc)"
    say "  (git 저장소 밖입니다)"
    folder_account . && say "  이 폴더의 기본 계정: $FA  (gitch clone <저장소> 로 계정 생략 가능)"
    [ -n "$ssh" ] && status_ssh
    return 0
  fi
  resolve_repo .
  push_url_alias .
  local name email top push_acc="" want up unpushed warns=() w fold signed=""
  name=$(git config user.name); email=$(git config user.email)
  top=$(repo_top); up=$(git config --get remote.upstream.url)
  unpushed=$(git rev-list --count HEAD --not --remotes 2>/dev/null || echo 0)
  [ "$(git config --get commit.gpgsign)" = true ] && signed=1
  folder_account . && fold=$FA
  if [ -n "$R_ACC" ] && [ -n "$R_ALIAS" ] && [ -n "$PU_ALIAS" ] && [ "$(lower "$PU_ALIAS")" = "$(lower "$R_ALIAS")" ]; then push_acc=$R_ACC; fi
  if [ -n "$R_ACC" ]; then
    want=$(acc_email "$R_ACC")
    [ "$email" != "$want" ] && warns+=("커밋 작성자(${email:-없음})가 $R_ACC($want)와 다릅니다 → gitch use $R_ACC")
    if [ -n "$PU_URL" ] && [ -z "$push_acc" ] && [ "$R_URL_KIND" != local ]; then
      if [ -z "$R_ALIAS" ]; then warns+=("$R_ACC 계정에는 ${R_HOST:-이 서버} 가 없습니다 → 계정을 확인하고 gitch use <계정>")
      else warns+=("push 주소($PU_URL)가 $R_ACC 계정 주소(git@$R_ALIAS:...)가 아닙니다 → gitch use $R_ACC"); fi
    fi
  fi
  [ -n "$R_LOCK_UNKNOWN" ] && warns+=("잠금 계정 '$R_LOCK' 이 설정에 없습니다 → gitch use <계정>")
  if [ -n "$R_LOCK" ] && [ -n "$R_DERIVED" ] && [ "$R_DERIVED" != "$R_LOCK" ] && [ "$R_DERIVED_SRC" != folder ]; then
    warns+=("잠금($R_LOCK)과 규칙($R_DERIVED — $R_DERIVED_NOTE)이 다릅니다. 의도가 아니면 gitch use $R_DERIVED")
  fi

  if [ -n "$json" ]; then
    local wj="" first=1
    for w in "${warns[@]}"; do [ -n "$first" ] || wj="$wj,"; wj="$wj$(json_str "$w")"; first=""; done
    printf '{"schemaVersion":1,"inRepo":true,"repo":%s,"path":%s,"branch":%s,"author":{"name":%s,"email":%s},"remote":%s,"pushUrl":%s,"upstream":%s,"lockedAccount":%s,"account":%s,"accountSource":%s,"derivedAccount":%s,"folderAccount":%s,"pushAccount":%s,"pushLogin":%s,"unpushedCommits":%s,"signing":%s,"ignored":%s,"warnings":[%s]}\n' \
      "$(json_str "$(basename "$top")")" "$(json_str "$top")" "$(json_str "$(cur_branch)")" "$(json_str "$name")" "$(json_str "$email")" \
      "$(json_str "$R_URL")" "$(json_str "$PU_URL")" "$(json_str "$up")" "$(json_str "$R_LOCK")" "$(json_str "$R_ACC")" "$(json_str "$R_SRC")" \
      "$(json_str "$R_DERIVED")" "$(json_str "$fold")" "$(json_str "${push_acc:-unknown}")" "$(json_str "$R_LOGIN")" \
      "$(json_num "$unpushed")" "$(json_bool "$signed")" "$(json_bool "$R_IGNORED")" "$wj"
  else
    say "${BOLD}[전역 작성자]${RESET} $(global_author_desc)"
    say "${BOLD}[현재 저장소]${RESET} $(basename "$top")"
    say "  커밋 작성자 : ${name:-없음} <${email:-없음}>"
    say "  remote      : ${R_URL:-없음}"
    [ -n "$PU_URL" ] && [ "$R_URL" != "$PU_URL" ] && say "  실제 push   : $PU_URL"
    [ -n "$up" ] && say "  upstream    : $up"
    if [ -n "$R_LOCK" ]; then say "  🔒 잠금     : ${BOLD}$R_LOCK${RESET} 전용"; else say "  🔓 잠금     : 없음"; fi
    [ -n "$R_DERIVED" ] && say "  계정 규칙   : $R_DERIVED ($R_DERIVED_NOTE)"
    [ -n "$fold" ] && say "  폴더 기본   : $fold"
    [ -n "$signed" ] && say "  서명        : 켜짐"
    [ -n "$R_IGNORED" ] && say "  관리 제외   : 예 (gitch ignore --off 로 되돌림)"
    if [ -n "$push_acc" ]; then
      say "  ${GREEN}push 계정   : $push_acc${RESET}$( [ -n "$R_LOGIN" ] && [ "$R_LOGIN" != "$push_acc" ] && printf '  (로그인 %s)' "$R_LOGIN")"
    elif [ -z "$PU_URL" ]; then
      say "  push 계정   : 원격 없음${R_ACC:+ (커밋 계정 $R_ACC)}"
    else
      say "  ${YELLOW}push 계정   : 정해지지 않음 → 사용자에게 계정을 확인한 뒤 'gitch use <계정>'${RESET}"
    fi
    for w in "${warns[@]}"; do say "  ${YELLOW}⚠ $w${RESET}"; done
    say "PUSH_ACCOUNT=${push_acc:-unknown}"
    say "PUSH_LOGIN=${R_LOGIN:-none}"
    say "REPO_ACCOUNT=${R_ACC:-unknown}"
    say "LOCKED_ACCOUNT=${R_LOCK:-none}"
    say "UNPUSHED_COMMITS=$unpushed"
    say "WARNINGS=${#warns[@]}"
    [ -n "$ssh" ] && status_ssh
  fi
  if [ -n "$strict" ] && { [ -z "$push_acc" ] || [ ${#warns[@]} -gt 0 ]; }; then return 1; fi
  return 0
}

test_ssh() {   # $1 별칭 $2 아이디
  local out
  out=$("$SSH_BIN" -T -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new "git@$1" 2>&1)
  if printf '%s' "$out" | grep -qE "Hi $2[!,]|@$2[!,]|Welcome to GitLab, @$2"; then
    say "  ${GREEN}✔ $1 → $2 연결 OK${RESET}"; return 0
  fi
  say "  ${RED}✘ $1 연결 실패${RESET}: $(printf '%s' "$out" | head -2 | tr '\n' ' ')"; return 1
}

status_ssh() {
  local i=0
  say "${BOLD}[SSH 연결]${RESET}"
  while [ $i -lt ${#B_ACC[@]} ]; do
    [ "${B_LOGIN[$i]}" = "${B_ACC[$i]}" ] && test_ssh "${B_ALIAS[$i]}" "${B_ACC[$i]}"
    i=$((i+1))
  done
}

preflight_cmd() {   # 작업/커밋/push 전 한 번에 점검 → PREFLIGHT=OK|WARN|STOP
  local json="" nofetch="" a
  for a in "$@"; do case "$a" in --json) json=1 ;; --no-fetch) nofetch=1 ;; *) die "사용법: gitch preflight [--json] [--no-fetch]" ;; esac; done
  PF_ITEMS=(); PF_LEVEL=OK
  local br="" want ae ce push_acc="" fetched="" behind=0 ahead=0
  if ! in_repo; then pf_add STOP not_repo "git 저장소 밖입니다."; pf_print "$json"; return 1; fi
  if ! load_config; then pf_add STOP no_config "gitch 설정 파일이 없습니다 → gitch migrate 또는 gitch add"; pf_print "$json"; return 1; fi
  if [ ${#CFG_ERRORS[@]} -gt 0 ]; then pf_add STOP bad_config "gitch 설정 파일에 문제가 있습니다 → gitch doctor"; pf_print "$json"; return 1; fi
  resolve_repo .
  push_url_alias .
  br=$(cur_branch)
  [ -n "$R_IGNORED" ] && pf_add WARN ignored "gitch 관리 제외 저장소입니다 (검사 안 함)."
  if [ -z "$R_ACC" ]; then
    pf_add STOP no_account "이 저장소의 계정이 정해지지 않았습니다 → 사용자에게 계정을 확인한 뒤 gitch use <계정>"
  else
    want=$(acc_email "$R_ACC")
    ae=$(ident_email "$(git var GIT_AUTHOR_IDENT 2>/dev/null)")
    ce=$(ident_email "$(git var GIT_COMMITTER_IDENT 2>/dev/null)")
    if [ "$ae" != "$want" ] || [ "$ce" != "$want" ]; then
      pf_add STOP identity "커밋 작성자(${ae:-없음})가 $R_ACC($want)가 아닙니다 → gitch use $R_ACC"
    else
      pf_add OK identity "커밋 작성자: $R_ACC <$want> ($R_NOTE)"
    fi
    if [ -z "$PU_URL" ]; then pf_add WARN no_remote "origin 원격이 없습니다 (push 불가)."
    elif [ "$R_URL_KIND" = local ]; then pf_add OK remote "원격이 로컬 경로입니다: $PU_URL"
    elif [ -z "$R_ALIAS" ]; then pf_add STOP no_binding "$R_ACC 계정에는 $R_HOST 서버가 없습니다 → 계정을 확인하세요."
    elif [ -z "$PU_ALIAS" ] || [ "$(lower "$PU_ALIAS")" != "$(lower "$R_ALIAS")" ]; then
      pf_add STOP push_url "push 주소($PU_URL)가 $R_ACC 계정 주소(git@$R_ALIAS:...)가 아닙니다 → gitch use $R_ACC"
    else
      push_acc=$R_ACC
      pf_add OK remote "push 계정: $R_ACC ($PU_URL)"
    fi
    if [ -n "$R_LOCK" ] && [ -n "$R_DERIVED" ] && [ "$R_DERIVED" != "$R_LOCK" ] && [ "$R_DERIVED_SRC" != folder ]; then
      pf_add WARN rule_mismatch "잠금($R_LOCK)과 규칙($R_DERIVED — $R_DERIVED_NOTE)이 다릅니다. 사용자에게 확인하세요."
    fi
  fi
  [ -n "$R_LOCK_UNKNOWN" ] && pf_add STOP lock_unknown "잠금 계정 '$R_LOCK' 이 설정에 없습니다 → 사용자에게 확인"
  repo_state
  if [ -n "$RS_OP" ]; then
    if [ "$RS_CONFLICTS" -gt 0 ]; then pf_add STOP in_progress "$(op_word "$RS_OP") 진행 중, 충돌 파일 ${RS_CONFLICTS}개 → 고친 뒤 git add → gitch continue (취소: gitch abort)"
    else pf_add STOP in_progress "$(op_word "$RS_OP") 진행 중 → gitch continue 또는 gitch abort"; fi
  elif [ "$RS_CONFLICTS" -gt 0 ]; then
    pf_add STOP conflicts "충돌 표시가 남은 파일이 ${RS_CONFLICTS}개 있습니다."
  fi
  [ -z "$br" ] && has_head && pf_add WARN detached "브랜치가 아닌 커밋 위(detached HEAD)입니다 → gitch b <브랜치>"
  if [ -n "$br" ] && [ -n "$PU_URL" ]; then
    if [ -n "$nofetch" ]; then fetched=skip
    elif maybe_fetch auto; then fetched=1
    else fetched=0; pf_add WARN offline "원격 정보를 받지 못했습니다 (오프라인/연결 문제 — 마지막 정보 기준)."; fi
    if has_upstream; then
      read -r behind ahead <<< "$(git rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)"
      behind=${behind:-0}; ahead=${ahead:-0}
      if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then pf_add WARN diverged "원격과 갈라졌습니다 (받을 ${behind}개 / 보낼 ${ahead}개) → gitch pl"
      elif [ "$behind" -gt 0 ]; then pf_add WARN behind "원격에 받을 커밋이 ${behind}개 있습니다 → gitch pl"; fi
    elif has_head; then
      ahead=$(git rev-list --count HEAD --not --remotes 2>/dev/null || echo 0)
    fi
  fi
  if ! global_hooks_ok && ! repo_hooks_ok .; then pf_add WARN no_guard "gitch 검사 훅이 없습니다 → gitch install (또는 gitch use)"; fi
  PF_ACC=$R_ACC; PF_PUSH=$push_acc; PF_BR=$br; PF_AHEAD=$ahead; PF_BEHIND=$behind
  pf_print "$json"
  [ "$PF_LEVEL" = STOP ] && return 1
  return 0
}
pf_add() {
  PF_ITEMS+=("$1|$2|$3")
  case "$1" in STOP) PF_LEVEL=STOP ;; WARN) [ "$PF_LEVEL" = OK ] && PF_LEVEL=WARN ;; esac
}
pf_print() {
  local it lv code msg icon first=1 cj="" fl=""
  if [ -n "$1" ]; then
    for it in "${PF_ITEMS[@]}"; do
      lv=${it%%|*}; code=${it#*|}; msg=${code#*|}; code=${code%%|*}
      [ -n "$first" ] || cj="$cj,"; first=""
      cj="$cj{\"level\":$(json_str "$lv"),\"code\":$(json_str "$code"),\"message\":$(json_str "$msg")}"
    done
    fl=$(flow_preflight_line)
    printf '{"schemaVersion":1,"result":%s,"account":%s,"pushAccount":%s,"branch":%s,"ahead":%s,"behind":%s,"checks":[%s],"flow":%s}\n' \
      "$(json_str "$PF_LEVEL")" "$(json_str "${PF_ACC:-}")" "$(json_str "${PF_PUSH:-unknown}")" "$(json_str "${PF_BR:-}")" \
      "$(json_num "${PF_AHEAD:-0}")" "$(json_num "${PF_BEHIND:-0}")" "$cj" "$(if [ -n "$fl" ]; then json_str "$fl"; else printf null; fi)"
    return
  fi
  for it in "${PF_ITEMS[@]}"; do
    lv=${it%%|*}; code=${it#*|}; msg=${code#*|}
    case "$lv" in OK) icon="${GREEN}✔${RESET}" ;; WARN) icon="${YELLOW}⚠${RESET}" ;; *) icon="${RED}✘${RESET}" ;; esac
    say "  $icon $msg"
  done
  say "PREFLIGHT=$PF_LEVEL"
  say "REPO_ACCOUNT=${PF_ACC:-unknown} PUSH_ACCOUNT=${PF_PUSH:-unknown} BRANCH=${PF_BR:-none} AHEAD=${PF_AHEAD:-0} BEHIND=${PF_BEHIND:-0}"
  fl=$(flow_preflight_line)
  [ -z "$fl" ] || say "FLOW=$fl"
}

st_word() {
  case "$1" in
    A*) echo "추가" ;; M*) echo "수정" ;; D*) echo "삭제" ;; R*) echo "이름변경" ;;
    C*) echo "복사" ;; T*) echo "형식변경" ;; U*) echo "충돌" ;; "??") echo "새 파일" ;; *) echo "$1" ;;
  esac
}

check_diff_files() {   # diff -z → CF_JSON CF_TEXT CF_COUNT (경로의 탭·줄바꿈도 한 파일)
  local s f display
  CF_JSON=""; CF_TEXT=""; CF_COUNT=0
  while IFS= read -r -d '' s && IFS= read -r -d '' f; do
    case "$s" in R*|C*) IFS= read -r -d '' f || break ;; esac
    [ "$CF_COUNT" -eq 0 ] || CF_JSON="$CF_JSON,"
    CF_JSON="$CF_JSON{\"status\":$(json_str "$(st_word "$s")"),\"path\":$(json_str "$f")}"
    printf -v display '%q' "$f"
    CF_TEXT="$CF_TEXT$s"$'\t'"$display"$'\n'
    CF_COUNT=$((CF_COUNT+1))
  done < <(git diff "$@" --name-status -z 2>/dev/null)
  CF_JSON="[$CF_JSON]"
}
check_path_files() {   # NUL 구분 경로 → CP_JSON CP_TEXT CP_COUNT
  local f display
  CP_JSON=""; CP_TEXT=""; CP_COUNT=0
  while IFS= read -r -d '' f; do
    [ "$CP_COUNT" -eq 0 ] || CP_JSON="$CP_JSON,"
    CP_JSON="$CP_JSON$(json_str "$f")"
    printf -v display '%q' "$f"
    CP_TEXT="$CP_TEXT$display"$'\n'
    CP_COUNT=$((CP_COUNT+1))
  done
  CP_JSON="[$CP_JSON]"
}
json_lines() {   # 줄들 → ["..",".."]
  local l out="" first=1
  while IFS= read -r l; do
    [ -z "$l" ] && continue
    [ -n "$first" ] || out="$out,"; first=""
    out="$out$(json_str "$l")"
  done <<< "$1"
  printf '[%s]' "$out"
}

check_cmd() {   # gitch ck
  require_repo
  local json="" fmode=auto a br acc lock staged unstaged untracked ahead=0 behind=0 stash fetched=1 n_s n_u n_n
  local staged_json unstaged_json untracked_json conflicts_json
  for a in "$@"; do
    case "$a" in --json) json=1 ;; --fetch) fmode=force ;; --no-fetch) fmode=never ;; *) die "사용법: gitch ck [--json] [--fetch|--no-fetch]" ;; esac
  done
  load_config >/dev/null 2>&1
  br=$(cur_branch)
  maybe_fetch "$fmode"; case $? in 1) fetched=0 ;; 2) fetched=skip ;; esac
  check_diff_files --cached; staged=$CF_TEXT; staged_json=$CF_JSON; n_s=$CF_COUNT
  check_diff_files; unstaged=$CF_TEXT; unstaged_json=$CF_JSON; n_u=$CF_COUNT
  check_path_files < <(git ls-files --others --exclude-standard -z)
  untracked=$CP_TEXT; untracked_json=$CP_JSON; n_n=$CP_COUNT
  stash=$(git stash list 2>/dev/null | grep -c .)
  resolve_repo .
  lock=$R_LOCK; acc=$R_ACC
  repo_state
  check_path_files < <(git diff --name-only --diff-filter=U -z 2>/dev/null)
  conflicts_json=$CP_JSON
  if has_upstream; then
    read -r behind ahead <<< "$(git rev-list --left-right --count '@{u}...HEAD' 2>/dev/null)"
    behind=${behind:-0}; ahead=${ahead:-0}
  elif has_head; then
    ahead=$(git rev-list --count HEAD --not --remotes 2>/dev/null || echo 0)
  fi

  if [ -n "$json" ]; then
    printf '{"schemaVersion":1,"repo":%s,"branch":%s,"account":%s,"locked":%s,"fetched":%s,"hasUpstream":%s,"ahead":%s,"behind":%s,"staged":%s,"unstaged":%s,"untracked":%s,"stash":%s,"inProgress":%s,"conflicts":%s}\n' \
      "$(json_str "$(basename "$(repo_top)")")" "$(json_str "$br")" "$(json_str "$acc")" "$(json_bool "$lock")" \
      "$( [ "$fetched" = 1 ] && echo true || echo false)" "$(has_upstream && echo true || echo false)" \
      "$(json_num "$ahead")" "$(json_num "$behind")" "$staged_json" "$unstaged_json" \
      "$untracked_json" "$(json_num "$stash")" \
      "$( [ -n "$RS_OP" ] && json_str "$RS_OP" || echo null)" "$conflicts_json"
    return 0
  fi

  say "${BOLD}$(basename "$(repo_top)")${RESET}  브랜치: ${BOLD}${br:-(detached HEAD)}${RESET}  계정: ${acc:-?}${lock:+ 🔒}"
  if [ -n "$RS_OP" ]; then
    say "  ${RED}⚠ $(op_word "$RS_OP") 진행 중${RESET}$( [ "$RS_CONFLICTS" -gt 0 ] && printf ' — 충돌 파일 %s개' "$RS_CONFLICTS")"
    [ "$RS_CONFLICTS" -gt 0 ] && printf '%s\n' "$RS_CONFLICT_FILES" | head -15 | sed 's/^/    /'
    if [ "$RS_CONFLICTS" -gt 0 ]; then say "    → 파일을 고친 뒤 git add <파일> → gitch continue   (취소: gitch abort)"
    else say "    → 계속: gitch continue   /   취소: gitch abort"; fi
  fi
  if has_upstream; then
    if [ "$ahead" = 0 ] && [ "$behind" = 0 ]; then say "  원격    : ${GREEN}같음${RESET}"
    else
      [ "$ahead" != 0 ] && say "  원격    : ${YELLOW}push 안 한 커밋 ${ahead}개${RESET} → gitch p"
      [ "$behind" != 0 ] && say "  원격    : ${YELLOW}받을 커밋 ${behind}개${RESET} → gitch pl"
    fi
  elif has_head; then
    say "  원격    : ${YELLOW}아직 push 안 한 브랜치 (커밋 ${ahead}개)${RESET} → gitch p"
  else
    say "  원격    : 아직 커밋 없음"
  fi
  [ "$fetched" = 0 ] && dim "  (원격 확인 실패: 오프라인이거나 연결 문제 — 마지막으로 받은 정보 기준)"
  if [ "$ahead" != 0 ] && has_head; then
    say "  push 안 한 커밋:"
    if has_upstream; then git --no-pager log --format='    %h %s' '@{u}..HEAD' | head -10
    else git --no-pager log --format='    %h %s' HEAD --not --remotes | head -10; fi
  fi
  if [ $((n_s + n_u + n_n)) -eq 0 ]; then
    say "  작업내용: ${GREEN}수정 없음 (깨끗함)${RESET}"
  else
    if [ "$n_s" -gt 0 ]; then
      say "  ${GREEN}커밋 준비됨 ${n_s}개${RESET}"
      printf '%s\n' "$staged" | head -15 | while IFS=$'\t' read -r s f g; do say "    $(st_word "$s")  ${g:-$f}"; done
    fi
    if [ "$n_u" -gt 0 ]; then
      say "  ${YELLOW}수정됨 ${n_u}개${RESET}"
      printf '%s\n' "$unstaged" | head -15 | while IFS=$'\t' read -r s f g; do say "    $(st_word "$s")  ${g:-$f}"; done
    fi
    if [ "$n_n" -gt 0 ]; then
      say "  ${YELLOW}새 파일 ${n_n}개${RESET}"
      printf '%s\n' "$untracked" | head -15 | sed 's/^/    /'
    fi
    say "  → 커밋: gitch c -m \"메시지\" (준비된 것만) / gitch c -a -m \"메시지\" (전부)  /  커밋+push: gitch cp ..."
  fi
  [ "$stash" -gt 0 ] && say "  임시저장(stash) ${stash}개"
  say "CHANGES=$((n_s + n_u + n_n)) STAGED=$n_s UNSTAGED=$n_u UNTRACKED=$n_n AHEAD=$ahead BEHIND=$behind IN_PROGRESS=${RS_OP:-none} CONFLICTS=$RS_CONFLICTS ACCOUNT=${acc:-unknown}"
}

# ================= 커밋 / push / pull =================

auto_msg() {   # 메시지를 안 줬을 때 (스테이지된 파일 기준)
  local list n kinds word first
  list=$(git -c core.quotepath=off diff --cached --name-status)
  n=$(printf '%s\n' "$list" | grep -c .)
  kinds=$(printf '%s\n' "$list" | cut -c1 | sort -u | tr -d '\n')
  case "$kinds" in A) word="추가" ;; D) word="삭제" ;; R) word="이름변경" ;; *) word="수정" ;; esac
  first=$(printf '%s\n' "$list" | awk -F'\t' '{print $NF}' | head -3 | while IFS= read -r p; do basename "$p"; done | paste -sd, - | sed 's/,/, /g')
  if [ "$n" -le 3 ]; then echo "$word: $first"; else echo "$word: $first 외 $((n-3))개"; fi
}

commit_cmd() {   # [-a] [-m 메시지]... [-F 파일] [--trailer "키: 값"]... [메시지...]
  require_repo
  local all=0 msgs=() words=() file="" trailers=() m t files
  local merging=""
  [ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && merging=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -a|--all) all=1 ;;
      -am) all=1; shift; [ $# -gt 0 ] || die "-m 뒤에 메시지가 필요합니다."; msgs+=("$1") ;;
      -m|--message) shift; [ $# -gt 0 ] || die "-m 뒤에 메시지가 필요합니다."; msgs+=("$1") ;;
      --message=*) msgs+=("${1#--message=}") ;;
      -m?*) msgs+=("${1#-m}") ;;
      -F|--file) shift; [ -f "$1" ] || die "메시지 파일이 없습니다: $1"; file="$1" ;;
      --file=*) file="${1#--file=}"; [ -f "$file" ] || die "메시지 파일이 없습니다: $file" ;;
      --trailer) shift; [ $# -gt 0 ] || die "--trailer 뒤에 '키: 값' 이 필요합니다."; trailers+=("$1") ;;
      --trailer=*) trailers+=("${1#--trailer=}") ;;
      -n|--no-verify) die "--no-verify 는 쓸 수 없습니다. (gitch 검사를 우회하지 않습니다)" ;;
      --) shift; words+=("$@"); break ;;
      -*) die "알 수 없는 옵션: $1  (사용법: gitch c [-a] -m \"메시지\" [-m \"본문\"] [-F 파일] [--trailer \"키: 값\"])" ;;
      *) words+=("$1") ;;
    esac
    shift
  done
  if [ ${#msgs[@]} -gt 0 ] && [ ${#words[@]} -gt 0 ]; then
    die "메시지는 -m 으로만 주거나 그냥 글자로만 주세요. (예: gitch c -m \"제목\" -m \"본문\")"
  fi
  if [ "$all" = 1 ]; then
    git add -A || die "git add 실패"
  elif [ -z "$merging" ] && git diff --cached --quiet 2>/dev/null; then
    if [ -n "$(git status --porcelain)" ]; then
      if can_prompt; then
        dim "ℹ 스테이지된 파일이 없어 변경사항 전체를 올립니다 (git add -A)"
        git add -A || die "git add 실패"
      else
        err "스테이지된 파일이 없습니다. 올릴 파일을 'git add <파일>' 로 고르거나, 전부 올리려면 'gitch c -a -m \"...\"' 를 쓰세요."
        git -c core.quotepath=off status --short | head -20 | sed 's/^/  /' >&2
        return 4
      fi
    fi
  fi
  if [ -z "$merging" ] && git diff --cached --quiet 2>/dev/null; then say "커밋할 변경사항이 없습니다."; return 3; fi
  local args=(-q)
  if [ ${#msgs[@]} -gt 0 ]; then
    for m in "${msgs[@]}"; do args+=(-m "$m"); done
  elif [ -n "$file" ]; then
    args+=(-F "$file")
  elif [ ${#words[@]} -gt 0 ]; then
    args+=(-m "${words[*]}")
  elif [ -n "$merging" ]; then
    args+=(--no-edit)
  else
    m=""
    can_prompt && read -r -p "커밋 메시지 (Enter = 자동 생성): " m
    [ -z "$m" ] && m=$(auto_msg)
    args+=(-m "$m")
  fi
  for t in "${trailers[@]}"; do args+=(--trailer "$t"); done
  files=$(git diff --cached --name-only | grep -c .)
  git commit "${args[@]}" || { err "커밋 실패 (위의 [gitch] 메시지를 확인하세요)"; return 1; }
  ok "커밋 $(git log -1 --format=%h) \"$(git log -1 --format=%s)\"  (파일 ${files}개, $(git log -1 --format=%an))"
}

push_cmd() {   # [--force [--yes]] [--dry-run] [--tags]
  require_repo
  local force="" yes="" dry="" tags="" a br rc
  for a in "$@"; do
    case "$a" in
      -f|--force|--force-with-lease) force=1 ;;
      -y|--yes) yes=1 ;;
      -n|--dry-run) dry=1 ;;
      --tags|--follow-tags) tags=1 ;;
      --no-verify) die "--no-verify 는 쓸 수 없습니다." ;;
      *) die "알 수 없는 옵션: $a  (사용법: gitch p [--force] [--dry-run] [--tags])" ;;
    esac
  done
  br=$(cur_branch) || die "브랜치 위에서 실행하세요. (detached HEAD)"
  git remote get-url --push origin >/dev/null 2>&1 || die "origin 원격 저장소가 없습니다."
  need_config
  resolve_repo .
  push_url_alias .
  if [ "$R_URL_KIND" != local ]; then
    [ -z "$R_ACC" ] && die "push 계정이 정해지지 않았습니다. 사용자에게 계정을 확인한 뒤 'gitch use <계정>' 후 다시 하세요."
    if [ -z "$R_ALIAS" ] || [ "$(lower "$PU_ALIAS")" != "$(lower "$R_ALIAS")" ]; then
      die "push 주소($PU_URL)가 $R_ACC 계정 주소가 아닙니다. 'gitch use $R_ACC' 후 다시 하세요."
    fi
  fi
  has_head || { say "push 할 커밋이 없습니다."; return 0; }
  local args=(push -q)
  [ -n "$dry" ] && args+=(--dry-run)
  [ -n "$tags" ] && args+=(--follow-tags)
  if [ -n "$force" ]; then
    confirm "$br 브랜치를 강제 push(원격의 기존 커밋 덮어쓰기) 합니다. 계속할까요?" "$yes" "gitch p --force --yes"
    args+=(--force-with-lease)
  fi
  net_env
  if has_upstream; then
    if [ -z "$force" ] && [ -z "$tags" ] && [ "$(git rev-list --count '@{u}..HEAD')" = 0 ]; then say "이미 최신입니다. (push 할 커밋 없음)"; return 0; fi
    if [ -n "$force" ]; then GITSW_NOLOG_PUSH=1 GITSW_ALLOW_FORCE=1 git "${args[@]}"; else GITSW_NOLOG_PUSH=1 git "${args[@]}"; fi
  else
    if [ -n "$force" ]; then GITSW_NOLOG_PUSH=1 GITSW_ALLOW_FORCE=1 git "${args[@]}" -u origin "$br"; else GITSW_NOLOG_PUSH=1 git "${args[@]}" -u origin "$br"; fi
  fi
  rc=$?
  if [ $rc -eq 0 ]; then
    ok "push $br → origin  (${R_ACC:-로컬})$( [ -n "$dry" ] && printf ' [연습 실행]')"
    [ -z "$dry" ] && log_action push "remote=origin" "branch=$br" "account=${R_ACC:-}" "force=${force:-0}"
  else
    err "push 실패. 원격에 새 커밋이 있으면 'gitch pl' 로 받은 뒤 다시 'gitch p' 하세요. ([gitch] 메시지가 있으면 그 내용을 확인)"
  fi
  return $rc
}

commit_push_cmd() {
  local rc
  commit_cmd "$@"; rc=$?
  case $rc in 0|3) ;; *) return $rc ;; esac
  push_cmd
}

pull_cmd() {
  require_repo
  local br before out rc
  br=$(cur_branch) || die "브랜치 위에서 실행하세요."
  repo_state
  [ -n "$RS_OP" ] && die "$(op_word "$RS_OP") 진행 중입니다. 먼저 끝내거나(gitch continue) 취소하세요(gitch abort)."
  net_env
  if ! has_upstream; then
    git fetch -q origin 2>/dev/null || die "origin 을 받지 못했습니다. (gitch doctor)"
    if ! git show-ref -q --verify "refs/remotes/origin/$br"; then say "원격에 '$br' 브랜치가 아직 없습니다. (첫 push: gitch p)"; return 0; fi
  fi
  backup_ref pull
  before=$(git rev-parse -q --verify HEAD)
  if has_upstream; then out=$(GIT_EDITOR=true git pull --rebase --autostash -q 2>&1)
  else out=$(GIT_EDITOR=true git pull --rebase --autostash -q origin "$br" 2>&1); fi
  rc=$?
  if [ $rc -eq 0 ]; then
    if [ "$before" = "$(git rev-parse -q --verify HEAD)" ]; then say "이미 최신입니다."
    else ok "pull — $br 를 최신으로 맞췄습니다. $(git log -1 --format='(%h %s)')"; fi
    log_action pull "branch=$br"
  else
    printf '%s\n' "$out" | grep -viE 'autostash' >&2
    repo_state
    if [ -n "$RS_OP" ]; then err "pull 중 충돌이 났습니다. 'gitch ck' 로 충돌 파일 확인 → 고친 뒤 git add <파일> → gitch continue  (취소: gitch abort)"
    else err "pull 실패. 연결/권한을 확인하세요. (gitch doctor)"; fi
  fi
  return $rc
}

up_cmd() {   # 기본 브랜치 최신을 따라가기
  require_repo
  local br def
  br=$(cur_branch) || die "브랜치 위에서 실행하세요."
  repo_state
  [ -n "$RS_OP" ] && die "$(op_word "$RS_OP") 진행 중입니다. 먼저 끝내거나(gitch continue) 취소하세요(gitch abort)."
  net_env
  git fetch -q origin || die "origin 을 받지 못했습니다. (gitch doctor)"
  git rev-parse -q --verify refs/remotes/origin/HEAD >/dev/null || git remote set-head origin -a >/dev/null 2>&1
  def=$(default_branch origin)
  git rev-parse -q --verify "refs/remotes/origin/$def" >/dev/null || die "origin/$def 브랜치를 찾을 수 없습니다."
  if [ "$br" = "$def" ]; then pull_cmd; return $?; fi
  backup_ref up
  if git show-ref -q --verify "refs/heads/$def"; then
    git fetch -q origin "$def:$def" 2>/dev/null || dim "  (로컬 $def 는 원격과 갈라져서 그대로 둡니다)"
  fi
  if has_upstream && git rev-parse -q --verify '@{u}' >/dev/null; then
    # 이미 push 한 브랜치는 rebase 하면 강제 push 가 필요해지므로 merge
    if GIT_EDITOR=true git merge -q --no-edit "origin/$def"; then ok "origin/$def 를 $br 에 합쳤습니다. (push 한 브랜치라 merge)"
    else err "합치는 중 충돌 → 고친 뒤 git add <파일> → gitch continue  (취소: gitch abort)"; return 1; fi
  else
    if GIT_EDITOR=true git rebase -q --autostash "origin/$def"; then ok "$br 를 최신 origin/$def 위로 옮겼습니다."
    else err "rebase 중 충돌 → 고친 뒤 git add <파일> → gitch continue  (취소: gitch abort)"; return 1; fi
  fi
  log_action up "branch=$br" "base=origin/$def"
}

log_cmd() {
  require_repo
  has_head || { say "아직 커밋이 없습니다."; return 0; }
  local n="${1:-15}"
  is_number "$n" || die "사용법: gitch l [개수]"
  git --no-pager log --graph -n "$n" --format='%C(yellow)%h%C(reset) %s %C(dim)— %an, %ar%C(reset)%C(auto)%d'
  echo ""
}

diff_cmd() {
  require_repo
  if has_head; then git --no-pager diff HEAD "$@"; else git --no-pager diff --cached "$@"; fi
  local u; u=$(git -c core.quotepath=off ls-files --others --exclude-standard)
  if [ -n "$u" ]; then echo ""; echo "새 파일 (diff 에는 안 나옴):"; printf '%s\n' "$u" | sed 's/^/  /'; fi
}

branch_cmd() {
  require_repo
  if [ -z "$1" ]; then
    git --no-pager branch --sort=-committerdate --format='%(if)%(HEAD)%(then)* %(else)  %(end)%(color:yellow)%(refname:short)%(color:reset) %(color:dim)%(committerdate:relative)%(color:reset) %(upstream:track)'
    dim "새 브랜치/이동: gitch b 이름"
    return 0
  fi
  if git show-ref --verify -q "refs/heads/$1"; then
    git switch -q "$1" && ok "$1 브랜치로 이동"
  elif git show-ref --verify -q "refs/remotes/origin/$1"; then
    git switch -q --track "origin/$1" && ok "원격 $1 브랜치를 받아서 이동"
  else
    git switch -q -c "$1" && ok "새 브랜치 $1 만들고 이동 (첫 push: gitch p)"
  fi
}

undo_cmd() {
  require_repo
  has_head || { say "되돌릴 커밋이 없습니다."; return 1; }
  head_pushed && die "마지막 커밋은 이미 push 됐습니다. 되돌리면 다른 사람과 꼬일 수 있어 막았습니다. (필요하면 git revert HEAD)"
  local info; info=$(git log -1 --format='%h "%s"')
  backup_ref undo
  if git rev-parse -q --verify HEAD~1 >/dev/null; then git reset -q --soft HEAD~1
  else git update-ref -d HEAD; fi
  ok "마지막 커밋 $info 를 취소했습니다. 변경 내용은 그대로 '커밋 준비됨' 상태로 남아 있습니다. (되돌리기: gitch rescue)"
  log_action undo
}

amend_cmd() {   # [-m 메시지 | 메시지...]
  require_repo
  has_head || die "고칠 커밋이 없습니다."
  head_pushed && die "마지막 커밋은 이미 push 됐습니다. 새 커밋으로 올려주세요 (gitch c)."
  local msg=""
  if [ "$1" = -m ] || [ "$1" = --message ]; then shift; msg="$*"; else msg="$*"; fi
  if git diff --cached --quiet && [ -n "$(git status --porcelain)" ]; then
    if can_prompt; then git add -A
    else dim "ℹ 스테이지된 파일이 없어 메시지만 고칩니다. (내용도 넣으려면 먼저 git add <파일>)"; fi
  fi
  backup_ref amend
  if [ -n "$msg" ]; then git commit -q --amend -m "$msg"
  else git commit -q --amend --no-edit; fi || { err "고치지 못했습니다."; return 1; }
  ok "마지막 커밋을 고쳤습니다: $(git log -1 --format='%h "%s"')  (되돌리기: gitch rescue)"
  log_action amend
}

abort_cmd() {
  require_repo
  repo_state
  local yes=""; [ "$1" = --yes ] && yes=1
  [ -z "$RS_OP" ] && { say "진행 중인 작업이 없습니다."; return 0; }
  confirm "진행 중인 $(op_word "$RS_OP") 를 취소합니다 (고치던 충돌 내용은 사라짐). 계속할까요?" "$yes" "gitch abort --yes"
  case "$RS_OP" in
    rebase) git rebase --abort ;; merge) git merge --abort ;; cherry-pick) git cherry-pick --abort ;;
    revert) git revert --abort ;; am) git am --abort ;; bisect) git bisect reset ;;
  esac && ok "$(op_word "$RS_OP") 를 취소했습니다."
}

continue_cmd() {
  require_repo
  repo_state
  [ -z "$RS_OP" ] && { say "진행 중인 작업이 없습니다."; return 0; }
  if [ "$RS_CONFLICTS" -gt 0 ]; then
    err "아직 충돌이 남은 파일이 있습니다:"; printf '%s\n' "$RS_CONFLICT_FILES" | sed 's/^/  /' >&2
    die "파일을 고친 뒤 git add <파일> 하고 다시 gitch continue"
  fi
  case "$RS_OP" in
    rebase) GIT_EDITOR=true git rebase --continue ;;
    merge) GIT_EDITOR=true git merge --continue ;;
    cherry-pick) GIT_EDITOR=true git cherry-pick --continue ;;
    revert) GIT_EDITOR=true git revert --continue ;;
    am) git am --continue ;;
    bisect) say "bisect 는 git bisect good/bad 로 진행하세요."; return 0 ;;
  esac || { err "계속하지 못했습니다. gitch ck 로 상태를 확인하세요."; return 1; }
  repo_state
  if [ -n "$RS_OP" ]; then say "다음 단계에서 또 멈췄습니다. gitch ck 로 확인하세요."; else ok "완료했습니다."; fi
}

open_url() { if can_prompt; then browse "$1"; fi; return 0; }

web_url() {   # origin → 웹 주소
  local raw
  raw=$(git config --get remote.origin.url) || return 1
  parse_url "$raw" || return 1
  [ -n "$U_HOST" ] && [ -n "$U_PATH" ] || return 1
  printf 'https://%s/%s' "$U_HOST" "$U_PATH"
}

open_cmd() {
  require_repo
  need_config
  local u; u=$(web_url) || die "웹 주소를 알 수 없습니다."
  say "$u"; open_url "$u"
}

# ================= 백업 복구 / 정리 / 워크트리 =================

rescue_line() {   # $1 번호 $2 ref
  local r="$2" n ts reason sha subj wip=""
  n=${r#refs/gitsw/backup/}; ts=${n:0:15}; reason=${n:16}
  sha=$(git rev-parse --short "$r" 2>/dev/null); subj=$(git log -1 --format=%s "$r" 2>/dev/null)
  git show-ref -q --verify "$r-wip" && wip="  ${DIM}(+수정 중이던 파일)${RESET}"
  printf '  %2s) %s-%s-%s %s:%s:%s  %-8s %s %s%s\n' "$1" "${ts:0:4}" "${ts:4:2}" "${ts:6:2}" "${ts:9:2}" "${ts:11:2}" "${ts:13:2}" "$reason" "$sha" "$subj" "$wip"
}

rescue_cmd() {   # [번호] [--branch 이름 | --restore [--yes]]
  require_repo
  local refs=() r i=0 pick="" restore="" branch="" yes=""
  while IFS= read -r r; do [ -n "$r" ] && refs+=("$r"); done < <(git for-each-ref --sort=-refname --format='%(refname)' refs/gitsw/backup/ 2>/dev/null | grep -v -- '-wip$')
  while [ $# -gt 0 ]; do
    case "$1" in
      --restore) restore=1 ;; --yes) yes=1 ;;
      --branch) shift; branch="$1"; [ -n "$branch" ] || die "--branch 뒤에 이름이 필요합니다." ;;
      *) is_number "$1" || die "사용법: gitch rescue [번호] [--branch 이름 | --restore]"; pick=$1 ;;
    esac
    shift
  done
  if [ ${#refs[@]} -eq 0 ]; then say "백업이 없습니다. (gitch pl/up/sync/fix/undo/amend 전에 자동으로 만들어집니다)"; return 0; fi
  if [ -z "$pick" ]; then
    say "${BOLD}백업 목록${RESET} (최근 순, 30개까지 보관)"
    for r in "${refs[@]}"; do i=$((i+1)); rescue_line "$i" "$r"; done
    say ""
    say "자세히: gitch rescue <번호>  /  새 브랜치로 꺼내기: gitch rescue <번호> --branch 이름  /  되돌리기: gitch rescue <번호> --restore"
    return 0
  fi
  { [ "$pick" -ge 1 ] && [ "$pick" -le ${#refs[@]} ]; } || die "번호가 맞지 않습니다: $pick (1~${#refs[@]})"
  r=${refs[$((pick-1))]}
  if [ -n "$branch" ]; then
    git branch "$branch" "$r" && ok "백업 $pick 을 새 브랜치 '$branch' 로 꺼냈습니다."
    return
  fi
  if [ -n "$restore" ]; then
    confirm "현재 브랜치를 백업 $pick 시점으로 되돌립니다 (지금 상태도 먼저 백업). 계속할까요?" "$yes" "gitch rescue $pick --restore --yes"
    backup_ref rescue
    git reset -q --keep "$r" || die "되돌리지 못했습니다 (수정 중인 파일과 겹침). 수정 내용을 커밋하거나 stash 한 뒤 다시 하세요."
    if git show-ref -q --verify "$r-wip"; then
      if git stash apply -q "$r-wip" 2>/dev/null; then say "  수정 중이던 파일 내용도 되살렸습니다."
      else warn "수정 중이던 파일 내용은 충돌로 되살리지 못했습니다: git stash apply $r-wip"; fi
    fi
    ok "백업 $pick 시점으로 되돌렸습니다. (방금 전 상태로 다시: gitch rescue 1 --restore)"
    log_action rescue "ref=$r"
    return 0
  fi
  rescue_line "$pick" "$r"
  echo ""
  git --no-pager log --oneline -5 "$r"
  echo ""
  say "지금(HEAD)과의 차이:"
  git --no-pager diff --stat HEAD "$r" | tail -8
}

prune_cmd() {   # 합쳐진 브랜치 정리 [--gone] [--yes]
  require_repo
  local yes="" gone="" a def cur b track base merged=() goneb=()
  for a in "$@"; do case "$a" in --yes) yes=1 ;; --gone) gone=1 ;; *) die "사용법: gitch prune [--gone] [--yes]" ;; esac; done
  net_env
  git fetch -q --prune origin 2>/dev/null || warn "원격 정보를 새로 받지 못했습니다 (마지막 정보 기준)"
  def=$(default_branch origin); cur=$(cur_branch)
  base="origin/$def"; git rev-parse -q --verify "$base" >/dev/null || base="$def"
  while IFS= read -r b; do
    [ -z "$b" ] && continue
    if [ "$b" = "$def" ] || [ "$b" = "$cur" ] || is_protected "$b"; then continue; fi
    merged+=("$b")
  done < <(git branch --format='%(refname:short)' --merged "$base" 2>/dev/null)
  if [ -n "$gone" ]; then
    while read -r b track; do
      [ "$track" = "[gone]" ] || continue
      if [ "$b" = "$def" ] || [ "$b" = "$cur" ] || is_protected "$b" || in_list "$b" "${merged[*]}"; then continue; fi
      goneb+=("$b")
    done < <(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads)
  fi
  if [ ${#merged[@]} -eq 0 ] && [ ${#goneb[@]} -eq 0 ]; then say "정리할 브랜치가 없습니다."; return 0; fi
  [ ${#merged[@]} -gt 0 ] && { say "합쳐진 브랜치 (${base} 에 포함):"; for b in "${merged[@]}"; do say "  $b"; done; }
  [ ${#goneb[@]} -gt 0 ] && { say "원격에서 지워진 브랜치 (squash 머지 등 — 합쳐졌는지 확인 필요):"; for b in "${goneb[@]}"; do say "  $b"; done; }
  if [ -z "$yes" ] && ! can_prompt; then say "지우려면: gitch prune${gone:+ --gone} --yes"; return 0; fi
  confirm "위 브랜치를 로컬에서 지울까요? (원격은 그대로)" "$yes" "gitch prune${gone:+ --gone} --yes"
  for b in "${merged[@]}"; do git branch -q -d "$b" && say "  지움: $b"; done
  for b in "${goneb[@]}"; do git branch -q -D "$b" && say "  지움: $b"; done
  log_action prune "count=$(( ${#merged[@]} + ${#goneb[@]} ))"
}

wt_cmd() {   # 워크트리: ls | new <브랜치> [폴더] | rm <폴더> [--force] | prune
  require_repo
  local sub="${1:-ls}" b p force="" common mainroot name
  [ $# -gt 0 ] && shift
  case "$sub" in
    ls|list) git worktree list ;;
    new|add)
      b="$1"; p="$2"
      [ -z "$b" ] && die "사용법: gitch wt new <브랜치> [폴더]"
      common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
      mainroot=${common%/.git}; name=$(basename "$mainroot")
      [ -z "$p" ] && p="$(dirname "$mainroot")/$name.worktrees/$(printf '%s' "$b" | tr '/' '-')"
      [ -e "$p" ] && die "이미 있습니다: $p"
      if git show-ref -q --verify "refs/heads/$b"; then git worktree add -q "$p" "$b"
      elif git show-ref -q --verify "refs/remotes/origin/$b"; then git worktree add -q --track -b "$b" "$p" "origin/$b"
      else git worktree add -q -b "$b" "$p"; fi || die "워크트리를 만들지 못했습니다."
      ok "워크트리: $(tilde "$p")  (브랜치 $b — 계정/잠금은 그대로 이어집니다)"
      say "  cd $(tilde "$p")" ;;
    rm|remove)
      p="$1"; [ "$2" = --force ] && force=--force
      [ -z "$p" ] && die "사용법: gitch wt rm <폴더> [--force]"
      git worktree remove $force "$p" && ok "워크트리를 지웠습니다: $p" ;;
    prune) git worktree prune && ok "사라진 워크트리 정보를 정리했습니다." ;;
    *) die "사용법: gitch wt [ls | new <브랜치> [폴더] | rm <폴더> [--force] | prune]" ;;
  esac
}

# ================= PR / MR / CI =================

oneline() { printf '%s' "$1" | tr '\r\n' '  ' | sed 's/  */ /g'; }
urlenc() { printf '%s' "$1" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/&/%26/g' -e 's/#/%23/g' -e 's/+/%2B/g' -e 's/?/%3F/g'; }

pr_target() {   # PR 대상 → PT_REPO PT_HEAD PT_BASE_REMOTE
  local up
  PT_REPO=$R_PATH; PT_HEAD=$1; PT_BASE_REMOTE=origin
  up=$(git config --get remote.upstream.url)
  if [ -n "$up" ] && parse_url "$up" && [ "$U_HOST" = "$R_HOST" ] && [ "$U_PATH" != "$R_PATH" ]; then
    PT_REPO=$U_PATH; PT_BASE_REMOTE=upstream
    [ "$R_HOST" = github.com ] && PT_HEAD="${R_PATH%%/*}:$1"
  fi
}

pr_cmd() {
  require_repo
  need_config
  case "${1:-}" in
    status|view) shift; pr_status_cmd "$@"; return $? ;;
    create) shift ;;
    ""|-*) ;;
    *) die "사용법: gitch pr [--title 제목] [--body 내용 | --body-file 파일] [--base 브랜치] [--draft] [--web]  /  gitch pr status" ;;
  esac
  local title="" body="" bodyfile="" base="" draft="" web="" br
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--title) shift; title="$1" ;;
      --title=*) title="${1#--title=}" ;;
      -b|--body) shift; body="$1" ;;
      --body=*) body="${1#--body=}" ;;
      -F|--body-file) shift; bodyfile="$1" ;;
      --base|-B) shift; base="$1" ;;
      --base=*) base="${1#--base=}" ;;
      -d|--draft) draft=1 ;;
      -w|--web) web=1 ;;
      *) die "알 수 없는 옵션: $1" ;;
    esac
    shift
  done
  if [ -n "$bodyfile" ]; then [ -f "$bodyfile" ] || die "파일이 없습니다: $bodyfile"; body=$(cat "$bodyfile"); fi
  br=$(cur_branch) || die "브랜치 위에서 실행하세요."
  resolve_repo .
  [ -n "$R_HOST" ] || die "원격 저장소 주소를 알 수 없습니다."
  [ -n "$R_ACC" ] || die "계정이 정해지지 않았습니다 → 사용자에게 확인 후 gitch use <계정>"
  pr_target "$br"
  [ -z "$base" ] && base=$(default_branch "$PT_BASE_REMOTE")
  [ "$br" = "$base" ] && [ "$PT_BASE_REMOTE" = origin ] && die "기본 브랜치($base)에서는 PR/MR 을 만들 수 없습니다. 새 브랜치에서 작업하세요: gitch b 작업브랜치"
  if [ "$R_HOST" = github.com ]; then pr_github "$br" "$base" "$title" "$body" "$draft" "$web"
  else pr_gitlab "$br" "$base" "$title" "$body" "$draft" "$web"; fi
}

pr_github() {   # $1 브랜치 $2 base $3 제목 $4 본문 $5 draft $6 web
  local br="$1" base="$2" title="$3" body="$4" draft="$5" web="$6" tok out rc url newurl
  if ! has_upstream || [ "$(git rev-list --count '@{u}..HEAD' 2>/dev/null)" != 0 ]; then
    say "먼저 push 합니다."; push_cmd || return 1
  fi
  newurl="https://github.com/$PT_REPO/compare/$(urlenc "$base")...$(urlenc "$PT_HEAD")?expand=1"
  if [ -n "$web" ]; then say "$newurl"; open_url "$newurl"; return 0; fi
  tok=$(gh_token "$R_LOGIN")
  if [ -z "$tok" ]; then
    err "gh 에 $R_LOGIN 계정 로그인이 필요합니다. 사용자가 터미널에서: gh auth login --hostname github.com  ($R_LOGIN 계정으로)"
    say "웹에서 만들기: $newurl"
    return 1
  fi
  local args=(pr create -R "$PT_REPO" --head "$PT_HEAD" --base "$base")
  if [ -n "$title" ]; then args+=(--title "$title" --body "$body"); else args+=(--fill); fi
  [ -n "$draft" ] && args+=(--draft)
  out=$(GH_TOKEN="$tok" gh "${args[@]}" 2>&1); rc=$?
  url=$(printf '%s\n' "$out" | grep -oE 'https://github\.com/[^ ]+/pull/[0-9]+' | tail -1)
  if [ $rc -eq 0 ] && [ -n "$url" ]; then ok "PR 을 만들었습니다: $url"; log_action pr "url=$url" "account=$R_ACC"; return 0; fi
  if [ -n "$url" ] && printf '%s' "$out" | grep -qi 'already exists'; then ok "이미 PR 이 있습니다: $url"; return 0; fi
  err "PR 을 만들지 못했습니다:"; printf '%s\n' "$out" | sed 's/^/  /' >&2
  say "웹에서 만들기: $newurl"
  return 1
}

pr_gitlab() {   # push 옵션으로 MR 생성 (토큰/glab 불필요)
  local br="$1" base="$2" title="$3" body="$4" draft="$5" web="$6" weburl newurl out rc url
  weburl="https://$R_HOST/$PT_REPO"
  newurl="$weburl/-/merge_requests/new?merge_request%5Bsource_branch%5D=$(urlenc "$br")&merge_request%5Btarget_branch%5D=$(urlenc "$base")"
  if [ -n "$web" ]; then say "$newurl"; open_url "$newurl"; return 0; fi
  if [ "$PT_BASE_REMOTE" != origin ]; then
    say "포크에서 원본으로 가는 MR 은 웹에서 만드세요: $newurl"; return 0
  fi
  if has_upstream && [ "$(git rev-list --count '@{u}..HEAD' 2>/dev/null)" = 0 ]; then
    say "push 할 새 커밋이 없어서 push 옵션으로는 MR 을 만들 수 없습니다."
    say "웹에서 만들기 (이미 있으면 그 MR 이 보입니다): $newurl"
    return 0
  fi
  local opts=(-o merge_request.create -o "merge_request.target=$base" -o merge_request.remove_source_branch)
  [ -n "$title" ] && opts+=(-o "merge_request.title=$(oneline "$title")")
  [ -n "$body" ] && opts+=(-o "merge_request.description=$(oneline "$body")")
  [ -n "$draft" ] && opts+=(-o merge_request.draft)
  need_config; resolve_repo .
  net_env
  out=$(git push -u origin "$br" "${opts[@]}" 2>&1); rc=$?
  printf '%s\n' "$out" | grep -vE '^remote: *$|^To |^ \* \[new branch\]|^branch .* set up to track' | sed 's/^remote: //' | grep -v '^$' | head -20
  url=$(printf '%s\n' "$out" | grep -oE 'https?://[^ ]+/-/merge_requests/[0-9]+' | tail -1)
  if [ $rc -ne 0 ]; then err "push/MR 생성에 실패했습니다. 웹에서 만들기: $newurl"; return 1; fi
  if [ -n "$url" ]; then ok "MR: $url"; log_action pr "url=$url" "account=$R_ACC"
  else say "MR 주소를 받지 못했습니다. 웹에서 확인: $newurl"; fi
  return 0
}

pr_status_cmd() {   # [--json]
  local json="" br tok out
  [ "$1" = --json ] && json=1
  br=$(cur_branch) || die "브랜치 위에서 실행하세요."
  resolve_repo .
  [ -n "$R_HOST" ] || die "원격 저장소 주소를 알 수 없습니다."
  pr_target "$br"
  if [ "$R_HOST" != github.com ]; then
    say "MR 목록: https://$R_HOST/$PT_REPO/-/merge_requests?scope=all&state=all&source_branch=$(urlenc "$br")"
    say "CI(파이프라인): https://$R_HOST/$PT_REPO/-/pipelines?ref=$(urlenc "$br")"
    return 0
  fi
  tok=$(gh_token "$R_LOGIN") || tok=""
  [ -n "$tok" ] || die "gh 에 $R_LOGIN 계정 로그인이 필요합니다. 사용자가 터미널에서: gh auth login --hostname github.com"
  out=$(GH_TOKEN="$tok" gh pr view "$PT_HEAD" -R "$PT_REPO" --json number,url,state,title,isDraft,mergeable,reviewDecision,statusCheckRollup 2>&1) || {
    say "이 브랜치($br)의 PR 이 없습니다. 만들기: gitch pr --title \"...\""; return 0; }
  if [ -n "$json" ]; then
    printf '%s\n' "$out" | awk '!added && /^[ \t]*\{/ { sub(/\{/, "{\"schemaVersion\":1,"); added = 1 } { print }'
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then printf '%s\n' "$out"; return 0; fi
  printf '%s' "$out" | jq -r '"PR #\(.number) \(.title)\n  상태: \(.state)\(if .isDraft then " (초안)" else "" end)  머지 가능: \(.mergeable)  리뷰: \(.reviewDecision // "없음")\n  \(.url)\n  CI: " + ((.statusCheckRollup // []) | if length == 0 then "없음" else (group_by(.conclusion // .status) | map("\(.[0].conclusion // .[0].status)=\(length)") | join(", ")) end)'
}

ci_cmd() {
  require_repo
  need_config
  local br tok
  br=$(cur_branch) || die "브랜치 위에서 실행하세요."
  resolve_repo .
  [ -n "$R_HOST" ] || die "원격 저장소 주소를 알 수 없습니다."
  pr_target "$br"
  if [ "$R_HOST" != github.com ]; then
    say "CI(파이프라인): https://$R_HOST/$PT_REPO/-/pipelines?ref=$(urlenc "$br")"
    return 0
  fi
  tok=$(gh_token "$R_LOGIN") || tok=""
  [ -n "$tok" ] || die "gh 에 $R_LOGIN 계정 로그인이 필요합니다. 사용자가 터미널에서: gh auth login --hostname github.com"
  if GH_TOKEN="$tok" gh pr view "$PT_HEAD" -R "$PT_REPO" --json number >/dev/null 2>&1; then
    GH_TOKEN="$tok" gh pr checks "$PT_HEAD" -R "$PT_REPO"
  else
    GH_TOKEN="$tok" gh run list -R "$PT_REPO" --branch "$br" --limit 5
  fi
}

publish_cmd() {   # [이름] [--public] [--description 설명] [--yes] — 원격 저장소를 새로 만들고 첫 push
  require_repo
  need_config
  local name="" vis=private desc="" yes="" host="" login al url tok i args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --public) vis=public ;;
      --private) vis=private ;;
      -d|--description) shift; desc="$1" ;;
      --description=*) desc="${1#--description=}" ;;
      -y|--yes) yes=1 ;;
      -*) die "사용법: gitch publish [이름] [--public] [--description 설명]" ;;
      *) name="$1" ;;
    esac
    shift
  done
  git remote get-url origin >/dev/null 2>&1 && die "이미 origin 이 있습니다: $(git remote get-url origin)  (push 는 gitch p)"
  has_head || die "커밋이 없습니다. 먼저 gitch c 로 커밋하세요."
  cur_branch >/dev/null || die "브랜치 위에서 실행하세요."
  resolve_repo .
  [ -n "$R_ACC" ] || die "이 저장소의 계정이 정해지지 않았습니다. 먼저 사용자에게 계정을 확인한 뒤 gitch use <계정>"
  [ -n "$name" ] || name=$(basename "$(repo_top)")
  case "$name" in */*|""|.*) die "저장소 이름이 올바르지 않습니다: $name" ;; esac
  if find_binding "$R_ACC" github.com; then host=github.com
  else
    i=0
    while [ $i -lt ${#B_ACC[@]} ]; do [ "${B_ACC[$i]}" = "$R_ACC" ] && { host=${B_HOST[$i]}; break; }; i=$((i+1)); done
    find_binding "$R_ACC" "$host" || die "$R_ACC 계정에 서버가 없습니다."
  fi
  login=${B_LOGIN[$BI]}; al=${B_ALIAS[$BI]}
  url="git@$al:$login/$name.git"
  confirm "$host 에 $vis 저장소 $login/$name 을 만들고 push 합니다. 계속할까요?" "$yes" "gitch publish $name${desc:+ --description \"$desc\"}$( [ "$vis" = public ] && printf ' --public') --yes"
  if [ "$host" = github.com ]; then
    tok=$(gh_token "$login")
    [ -n "$tok" ] || die "gh 에 $login 계정 로그인이 필요합니다. 사용자가 터미널에서: gh auth login --hostname github.com  ($login 계정으로)"
    if GH_TOKEN="$tok" gh repo view "$login/$name" >/dev/null 2>&1; then
      die "GitHub 에 이미 $login/$name 저장소가 있습니다. 다른 이름을 주거나, 그 저장소에 올리려면: git remote add origin $url → gitch use $R_ACC → gitch p"
    fi
    args=(repo create "$login/$name" "--$vis")
    [ -n "$desc" ] && args+=(--description "$desc")
    GH_TOKEN="$tok" gh "${args[@]}" >/dev/null || die "GitHub 저장소를 만들지 못했습니다."
    ok "GitHub 저장소를 만들었습니다: https://github.com/$login/$name ($vis)"
  else
    # GitLab 은 없는 프로젝트로 push 하면 비공개 프로젝트가 만들어짐 (push to create)
    [ "$vis" = public ] && warn "GitLab 은 push 로 만들면 비공개로 생깁니다. 공개는 웹 설정에서 바꾸세요."
  fi
  git remote add origin "$url" || die "origin 을 추가하지 못했습니다."
  set_account "$R_ACC" || exit 1
  SA_ALIAS=$al
  lock_repo . >/dev/null
  log_action publish "url=$url" "account=$R_ACC" "visibility=$vis"
  push_cmd
}


# ================= scan / audit =================

find_repos() {
  local root; root=$(expand_path "${1:-$CFG_SCAN_ROOT}")
  find "$root" -maxdepth 6 \
    \( -name node_modules -o -name Pods -o -name .build -o -name DerivedData -o -name vendor -o -name .gradle -o -name .venv -o -name .next -o -name .terraform \) -prune \
    -o -name .git -print -prune 2>/dev/null | sed 's#/\.git$##' | sort
}

scan_cmd() {   # [폴더] [--fix] [--json]
  local root="" fix="" json="" a d rel state sug note n=0 okc=0 prob=0 fixable=0 hk gh_ok="" wt email want first=1 jl="" icon line
  for a in "$@"; do
    case "$a" in --fix) fix=1 ;; --json) json=1 ;; --yes) ;; -*) die "사용법: gitch scan [폴더] [--fix] [--json]" ;; *) root="$a" ;; esac
  done
  need_config
  root=$(expand_path "${root:-$CFG_SCAN_ROOT}")
  [ -d "$root" ] || die "폴더가 없습니다: $root"
  root=$(real_dir "$root")
  global_hooks_ok && gh_ok=1
  [ -z "$json" ] && say "${BOLD}저장소 점검: $(tilde "$root")${RESET}"
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    n=$((n+1)); rel=${d#"$root"/}; [ "$d" = "$root" ] && rel="."
    resolve_repo "$d"
    email=$(git -C "$d" config user.email)
    wt=""; [ -f "$d/.git" ] && wt=1
    sug=""; note=""; hk=1
    if [ -n "$R_IGNORED" ]; then state=ignored
    elif [ -n "$R_LOCK_UNKNOWN" ]; then state=badlock; note="잠금 계정 '$R_LOCK' 이 설정에 없음"
    elif [ -n "$R_LOCK" ]; then
      want=$(acc_email "$R_LOCK")
      push_url_alias "$d"
      if [ "$email" = "$want" ] && { [ -z "$R_URL" ] || [ "$R_URL_KIND" = local ] || { [ -n "$R_ALIAS" ] && [ "$(lower "$PU_ALIAS")" = "$(lower "$R_ALIAS")" ]; }; }; then
        state=ok
        if [ -n "$R_DERIVED" ] && [ "$R_DERIVED" != "$R_LOCK" ]; then
          if [ "$R_DERIVED_SRC" = folder ]; then note="폴더 기본은 $R_DERIVED"
          else state=rule; note="규칙은 $R_DERIVED ($R_DERIVED_NOTE)"; fi
        fi
      else state=mismatch; sug=$R_LOCK; fi
    elif [ -n "$R_DERIVED" ]; then state=unlocked; sug=$R_DERIVED
    elif [ -z "$R_URL" ]; then state=noremote
    else state=unlocked; fi
    if [ -z "$gh_ok" ] && [ "$state" != ignored ] && [ -n "$R_LOCK" ] && ! repo_hooks_ok "$d"; then hk=""; fi

    if [ -n "$fix" ]; then
      if { [ "$state" = mismatch ] || [ "$state" = unlocked ]; } && [ -n "$sug" ]; then
        if (cd "$d" && use_cmd "$sug") >/dev/null 2>&1 </dev/null; then note="고침: $sug 로 잠금"; state=ok; hk=1
        else note="자동으로 못 고침 — 폴더에서 gitch use <계정>"; fi
      elif [ -z "$hk" ] && [ "$state" = ok ]; then
        install_repo_hooks "$d" >/dev/null 2>&1 && repo_hooks_ok "$d" && { hk=1; note="${note:+$note, }보조 훅 설치"; }
      fi
    fi
    case "$state" in
      ok) if [ -n "$hk" ]; then okc=$((okc+1)); else prob=$((prob+1)); fi ;;
      rule|mismatch|unlocked|badlock) prob=$((prob+1)) ;;
    esac
    { [ -n "$sug" ] && [ "$state" != ok ]; } && fixable=$((fixable+1))
    if [ -n "$json" ]; then
      [ -n "$first" ] || jl="$jl,"; first=""
      jl="$jl{\"path\":$(json_str "$rel"),\"state\":$(json_str "$state"),\"lock\":$(json_str "$R_LOCK"),\"account\":$(json_str "$R_ACC"),\"suggest\":$(json_str "$sug"),\"note\":$(json_str "$note"),\"worktree\":$(json_bool "$wt"),\"hooks\":$(json_bool "$hk")}"
      continue
    fi
    line=""
    case "$state" in
      ok)       if [ -n "$hk" ]; then icon="${GREEN}✔${RESET}"; else icon="${YELLOW}⚠${RESET}"; note="${note:+$note, }검사 훅 없음 → gitch scan --fix"; fi
                line="$icon $(printf '%-14s' "[$R_LOCK]") $rel" ;;
      rule)     line="${YELLOW}⚠${RESET} $(printf '%-14s' "[$R_LOCK]") $rel — 잠금과 규칙이 다름 → 의도가 아니면 그 폴더에서 gitch use $R_DERIVED" ;;
      mismatch) line="${RED}✘${RESET} [$R_LOCK] 작성자/주소가 잠금과 다름   $rel" ;;
      unlocked) if [ -n "$sug" ]; then line="${YELLOW}⚠${RESET} 잠금 없음 → 제안: $sug   $rel"
                else line="${YELLOW}⚠${RESET} 잠금 없음, 계정 판단 불가 → gitch use <계정>   $rel"; fi ;;
      badlock)  line="${RED}✘${RESET} [?] $rel" ;;
      noremote) line="${DIM}· 원격 저장소 없음   $rel${RESET}" ;;
      ignored)  line="${DIM}· 관리 제외 (gitch ignore)   $rel${RESET}" ;;
    esac
    [ -n "$wt" ] && line="$line ${DIM}(워크트리)${RESET}"
    [ -n "$note" ] && line="$line ${DIM}($note)${RESET}"
    say "  $line"
  done < <(find_repos "$root")
  if [ -n "$json" ]; then
    printf '{"schemaVersion":1,"root":%s,"total":%s,"ok":%s,"problems":%s,"repos":[%s]}\n' "$(json_str "$root")" "$n" "$okc" "$prob" "$jl"
  else
    echo ""
    say "저장소 ${n}개: 정상 ${okc}, 문제 ${prob}"
    [ "$fixable" -gt 0 ] && [ -z "$fix" ] && say "제안대로 한 번에 고치기: gitch scan --fix"
    say "SCAN_OK=$okc SCAN_PROBLEMS=$prob"
  fi
  [ "$prob" -eq 0 ]
}

audit_cmd() {   # 이미 push 된 커밋 중 '다른 내 계정' 이메일로 된 것 보고 (고치지 않음)
  local root="" since="90 days ago" json="" a d rel want e others hits cnt total=0 first=1 jl="" repos
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) shift; since="$1" ;; --since=*) since="${1#--since=}" ;; --json) json=1 ;;
      -*) die "사용법: gitch audit [폴더|.] [--since '90 days ago'] [--json]" ;; *) root="$1" ;;
    esac
    shift
  done
  need_config
  if [ "$root" = "." ] || { [ -z "$root" ] && in_repo; }; then repos=$(repo_top); [ -n "$repos" ] || die "git 저장소 안에서 실행하세요."
  else repos=$(find_repos "${root:-$CFG_SCAN_ROOT}"); fi
  [ -z "$json" ] && say "${BOLD}push 된 커밋 작성자 점검 (since: $since)${RESET}"
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    resolve_repo "$d"
    [ -n "$R_IGNORED" ] && continue
    [ -n "$R_ACC" ] || continue
    want=$(acc_email "$R_ACC"); others=""
    for e in "${ACC_EMAIL[@]}"; do [ "$e" != "$want" ] && others="$others|$e"; done
    [ -z "$others" ] && continue
    hits=$(git -C "$d" log --remotes --since="$since" --date=short --format='%h%x09%ae%x09%ce%x09%ad%x09%s' 2>/dev/null | \
      awk -F'\t' -v o="${others#|}" 'BEGIN { n = split(o, arr, "|"); for (i = 1; i <= n; i++) bad[arr[i]] = 1 } ($2 in bad) || ($3 in bad)')
    cnt=$(printf '%s' "$hits" | grep -c .)
    [ "$cnt" -eq 0 ] && continue
    total=$((total + cnt))
    rel=$(tilde "$d")
    if [ -n "$json" ]; then
      [ -n "$first" ] || jl="$jl,"; first=""
      jl="$jl{\"repo\":$(json_str "$rel"),\"account\":$(json_str "$R_ACC"),\"count\":$cnt,\"commits\":$(json_lines "$hits")}"
    else
      say "  ${YELLOW}⚠${RESET} $rel [$R_ACC]: 다른 내 계정 이메일로 된 push 된 커밋 ${cnt}개"
      printf '%s\n' "$hits" | head -5 | awk -F'\t' '{ printf "      %s %s  %s  %s\n", $1, $4, $2, $5 }'
    fi
  done <<< "$repos"
  if [ -n "$json" ]; then printf '{"schemaVersion":1,"since":%s,"findings":%s,"repos":[%s]}\n' "$(json_str "$since")" "$total" "$jl"
  else
    [ "$total" -eq 0 ] && say "  ${GREEN}✔${RESET} 문제 없음"
    [ "$total" -gt 0 ] && dim "  (이미 push 된 커밋은 고치지 않습니다. 앞으로는 gitch 검사가 막아 줍니다)"
    say "AUDIT_FINDINGS=$total"
  fi
  return 0
}

# ================= doctor =================

DR_ITEMS=(); DR_PROBLEMS=0
dr() {   # $1 섹션 $2 OK|WARN|FAIL|INFO $3 메시지
  DR_ITEMS+=("$1|$2|$3")
  case "$2" in WARN|FAIL) DR_PROBLEMS=$((DR_PROBLEMS+1)) ;; esac
}

ssh_host_sync() {   # $1 별칭 $2 서버 $3 포트 — 이미 있는 Host 블록의 Port 가 계정 설정과 다르면 고친다 (고쳤으면 0)
  local al="$1" h="$2" port="$3" cur tmp
  # 블록 경계는 Host/Match 줄 (ssh 처럼 대소문자·들여쓰기 무시). Port 줄이 없으면 ssh 기본값 22 로 본다
  cur=$(awk -v host="$al" '
    { k = tolower($1) }
    k == "host" || k == "match" { inb = (k == "host" && $2 == host && NF == 2); next }
    inb { if (k == "hostname" && hn == "") hn = $2; else if (k == "port" && p == "") p = $2 }
    END { print hn " " (p == "" ? 22 : p) }' "$SSH_CONFIG")
  # HostName 이 계정 서버와 다르면 사용자가 일부러 바꾼 것(예: ssh.github.com:443 우회)이라 두고 넘어간다
  [ "${cur% *}" = "$h" ] || return 1
  [ "${cur##* }" = "$port" ] && return 1
  backup_file "$SSH_CONFIG"
  tmp=$(mktemp "${TMPDIR:-/tmp}/gitsw.XXXXXX") || die "임시 파일을 만들 수 없습니다."
  # 블록의 Port 줄을 지우고 첫 HostName 줄 바로 뒤에 새 Port 를 둔다 (ssh 는 처음 나온 값만 쓰므로)
  awk -v host="$al" -v port="$port" '
    { k = tolower($1) }
    k == "host" || k == "match" { inb = (k == "host" && $2 == host && NF == 2); print; next }
    inb && k == "port" { next }
    inb && k == "hostname" && !done { print; print "    Port " port; done = 1; next }
    { print }' "$SSH_CONFIG" > "$tmp" && cat "$tmp" > "$SSH_CONFIG"
  rm -f "$tmp"
  return 0
}

ssh_orphans() {   # gitch 가 만든 모양의 SSH Host 중 지금 설정에 없는 별칭
  [ -f "$SSH_CONFIG" ] || return 0
  local own h
  own=" $(own_aliases) "
  awk '/^Host[ \t]+/ { h = $2; next } /^[ \t]*IdentityFile[ \t]+/ { if (h != "" && $2 ~ /id_ed25519_/) print h; h = "" }' "$SSH_CONFIG" | \
  while IFS= read -r h; do
    case "$h" in *-*) ;; *) continue ;; esac
    case "$own" in *" $h "*) ;; *) printf '%s\n' "$h" ;; esac
  done
}

doctor_cmd() {   # [--json] [--no-net]
  local json="" nonet="" a i id h al tok emails e repos d missing v1 orphans f kept
  for a in "$@"; do case "$a" in --json) json=1 ;; --no-net|--offline) nonet=1 ;; *) die "사용법: gitch doctor [--json] [--no-net]" ;; esac; done
  DR_ITEMS=(); DR_PROBLEMS=0
  # [기본]
  if git_version_ok; then dr 기본 OK "git $GIT_VER ($(command -v git))"; else dr 기본 FAIL "git ${GIT_VER:-?} — 2.36 이상 필요 → $(install_hint git Git.Git)"; fi
  if config_hooks_supported; then dr 기본 OK "이 git 은 전역 검사 훅(hook.<이름>.command)을 지원"
  else dr 기본 INFO "이 git 은 전역 훅을 지원하지 않아 저장소별 보조 훅으로 검사합니다"; fi
  if [ -x /usr/bin/git ] && [ "$(command -v git)" != /usr/bin/git ]; then
    dr 기본 INFO "Apple git(/usr/bin/git)으로 커밋하면 저장소별 보조 훅이 검사합니다"
  fi
  if [ "$(resolve_link "$BIN_LINK" 2>/dev/null)" = "$(self_path)" ]; then dr 기본 OK "gitch 명령 → $(tilde "$(self_path)") (v$GITSW_VERSION)"
  else dr 기본 WARN "~/bin/gitch 가 이 파일을 가리키지 않습니다 → $(tilde "$(self_path)") install"; fi
  if is_link "$SHIM_LINK" && [ "$(resolve_link "$SHIM_LINK")" != "$(self_path)" ]; then
    dr 기본 WARN "~/bin/gitsw(예전 이름)가 다른 파일을 가리킵니다: $(tilde "$(resolve_link "$SHIM_LINK")") → $(tilde "$(self_path)") install"
  fi
  if grep -q '# >>> gitsw >>>' "$SHELL_RC" 2>/dev/null; then dr 기본 OK "터미널 연동($(tilde "$SHELL_RC"))"; else dr 기본 WARN "터미널 연동 없음 → gitch install"; fi
  if [ -n "$IS_WINDOWS" ]; then
    if [ -f "$BIN_LINK.cmd" ]; then dr 기본 OK "PowerShell · cmd 에서 부르는 명령(~/bin/gitch.cmd)"; else dr 기본 WARN "~/bin/gitch.cmd 없음 — PowerShell · cmd 에서 gitch 를 못 부릅니다 → gitch install"; fi
  fi
  command -v jq >/dev/null 2>&1 && dr 기본 OK "jq 있음" || dr 기본 WARN "jq 없음 — Claude 훅/PR 상태 요약에 필요 → $(install_hint jq jqlang.jq)"
  command -v gh >/dev/null 2>&1 && dr 기본 OK "gh 있음 ($(gh --version 2>/dev/null | head -1 | awk '{print $3}'))" || dr 기본 WARN "gh 없음 — GitHub PR 자동화에 필요 → $(install_hint gh GitHub.cli)"

  # [설정]
  if ! load_config; then
    dr 설정 FAIL "설정 파일 없음: $(tilde "$CFG") → gitch migrate (v1 에서 옮기기) 또는 gitch add"
    doctor_print "$json"; return 1
  fi
  if [ ${#CFG_ERRORS[@]} -gt 0 ]; then
    for e in "${CFG_ERRORS[@]}"; do dr 설정 FAIL "$e"; done
    doctor_print "$json"; return 1
  fi
  dr 설정 OK "$(tilde "$CFG") — 계정 ${#ACC_IDS[@]}개, 폴더 ${#F_RAW[@]}개, 조직 ${#O_RAW[@]}개"

  # [계정]
  i=0
  while [ $i -lt ${#B_ACC[@]} ]; do
    id=${B_ACC[$i]}; h=${B_HOST[$i]}; al=${B_ALIAS[$i]}
    if [ "${B_LOGIN[$i]}" != "$id" ]; then
      dr 계정 OK "$id ($h) — ${B_LOGIN[$i]} 로그인으로 접속"
    elif [ ! -f "$SSH_DIR/id_ed25519_$id" ] || ! grep -q "^Host $al\$" "$SSH_CONFIG" 2>/dev/null; then
      dr 계정 FAIL "$id ($h): SSH 키/설정 없음 → 사용자가 터미널에서 gitch setup"
    elif [ -n "$nonet" ]; then
      dr 계정 OK "$id ($h): SSH 키/설정 있음 (연결 확인 생략)"
    elif test_ssh "$al" "$id" >/dev/null 2>&1; then
      dr 계정 OK "$id ($h) 연결 OK"
    else
      dr 계정 FAIL "$id ($h) 연결 실패 → gitch setup (키 등록), 포트/회사망(VPN) 확인"
    fi
    i=$((i+1))
  done
  auto_rules_ok && dr 계정 OK "주소/폴더/조직 자동 규칙" || dr 계정 WARN "자동 규칙이 빠졌습니다 → gitch auto"

  # [안전장치]
  if config_hooks_supported; then
    global_hooks_ok && dr 안전장치 OK "전역 검사 훅 (작성자/비밀값/큰 파일/강제 push)" || dr 안전장치 FAIL "전역 검사 훅 없음 → gitch install"
  fi
  [ "$(git config --global --get user.useConfigOnly)" = true ] && dr 안전장치 OK "규칙 밖 저장소는 작성자 없음으로 커밋이 막힘 (useConfigOnly)" || dr 안전장치 WARN "user.useConfigOnly 꺼짐 → gitch install"
  missing=0; v1=0
  repos=$(find_repos)
  while IFS= read -r d; do
    [ -z "$d" ] && continue
    [ -n "$(git -C "$d" config --get gitswitch.account)" ] || continue
    [ "$(git -C "$d" config --get gitswitch.ignore)" = true ] && continue
    if ! repo_hooks_ok "$d"; then
      missing=$((missing+1))
      f=$(repo_hooks_dir "$d")/pre-commit
      grep -q gitswitch-lock "$f" 2>/dev/null && v1=$((v1+1))
    fi
  done <<< "$repos"
  if [ "$missing" -gt 0 ]; then
    if [ "$v1" -gt 0 ]; then dr 안전장치 WARN "예전(v1) 저장소 훅 ${v1}개 → gitch install 로 새 보조 훅으로 교체"
    else dr 안전장치 WARN "보조 훅이 없는 잠긴 저장소 ${missing}개 → gitch scan --fix"; fi
  else dr 안전장치 OK "잠긴 저장소 보조 훅 (Apple git 등 대비)"; fi
  ssh_strict_on && dr 안전장치 OK "별칭 없는 주소 SSH 인증 막기 (sshStrict) 켜짐" || dr 안전장치 INFO "sshStrict 꺼짐 — 별칭 없는 git@github.com 은 기본 키로 접속 (push 는 검사 훅이 막음)"

  # [AI]
  for f in "$CLAUDE_DIR/CLAUDE.md" "$CODEX_DIR/AGENTS.md"; do
    grep -q 'gitsw:begin' "$f" 2>/dev/null && dr AI OK "규칙: $(tilde "$f")" || dr AI WARN "$(tilde "$f") 에 규칙 없음 → gitch ai"
  done
  [ -d "$CLAUDE_DIR" ] && { [ -f "$CLAUDE_DIR/skills/gitch/SKILL.md" ] && dr AI OK "Claude 스킬" || dr AI WARN "Claude 스킬 없음 → gitch ai"; }
  [ -d "$CODEX_DIR" ] && { [ -f "$CODEX_DIR/skills/gitch/SKILL.md" ] && dr AI OK "Codex 스킬" || dr AI WARN "Codex 스킬 없음 → gitch ai"; }
  if [ -d "$CLAUDE_DIR" ]; then
    if grep -q 'guard --claude' "$CLAUDE_DIR/settings.json" 2>/dev/null; then dr AI OK "Claude Code 명령 검사 훅 (~/.claude/settings.json)"
    else dr AI WARN "Claude Code 명령 검사 훅 없음 → gitch ai"; fi
    case "$(lower "$CFG_AI_PUSH")" in
      branch) dr AI INFO "Claude push 정책: 작업 브랜치는 자동, main/보호 브랜치 push 와 PR 생성만 확인 (gitsw.aiPush=branch)" ;;
      allow) dr AI INFO "Claude push 정책: 확인 없음 (gitsw.aiPush=allow) — 검사 훅은 그대로" ;;
      *) dr AI INFO "Claude push 정책: 매번 확인 (gitsw.aiPush=ask) — 작업 브랜치 자동: gitch config set gitsw.aiPush branch" ;;
    esac
  fi

  # [GitHub CLI]
  if command -v gh >/dev/null 2>&1; then
    kept=""
    i=0
    while [ $i -lt ${#B_ACC[@]} ]; do
      if [ "${B_HOST[$i]}" = github.com ] && ! in_list "${B_LOGIN[$i]}" "$kept"; then
        id=${B_LOGIN[$i]}; kept="$kept $id"
        if tok=$(gh_token "$id") && [ -n "$tok" ]; then
          dr GitHub OK "gh 로그인: $id"
          if [ -z "$nonet" ]; then
            # 토큰에 user 권한이 없으면 GitHub 이 404 를 주고 gh 가 오류 본문을 출력하므로, 성공했을 때의 메일 줄만 씀
            emails=$(GH_TOKEN="$tok" gh api user/emails --jq '.[] | select(.verified) | .email' 2>/dev/null) || emails=""
            emails=$(printf '%s\n' "$emails" | grep -E '^[^[:space:]{}"]+@[^[:space:]{}"]+$')
            if [ -z "$emails" ]; then
              dr GitHub INFO "$id: 커밋 이메일 인증 확인은 건너뜀 (gh 토큰에 user 권한 없음 — 확인하려면: gh auth refresh -h github.com -s user)"
            else
              local j=0
              while [ $j -lt ${#B_ACC[@]} ]; do
                if [ "${B_HOST[$j]}" = github.com ] && [ "${B_LOGIN[$j]}" = "$id" ]; then
                  e=$(acc_email "${B_ACC[$j]}")
                  printf '%s\n' "$emails" | grep -qixF "$e" || dr GitHub WARN "GitHub $id 계정에 $e 가 인증돼 있지 않아 커밋이 프로필에 연결되지 않습니다 (GitHub Settings → Emails)"
                fi
                j=$((j+1))
              done
            fi
          fi
        else
          dr GitHub WARN "gh 에 $id 로그인 안 됨 → 사용자가 터미널에서 gh auth login --hostname github.com ($id 계정) — PR 자동화에 필요"
        fi
      fi
      i=$((i+1))
    done
  fi

  # [정리 대상]
  orphans=$(ssh_orphans)
  [ -n "$orphans" ] && dr 정리 WARN "쓰지 않는 SSH 설정: $(printf '%s' "$orphans" | tr '\n' ' ')→ gitch ssh prune"
  for f in "$HOME"/.gitconfig-*; do
    [ -f "$f" ] || continue
    id=${f##*/.gitconfig-}
    is_account "$id" || dr 정리 WARN "쓰지 않는 파일: $(tilde "$f") (계정 '$id' 없음)"
  done
  [ "$(printf '%s' "$orphans" | grep -c .)" -eq 0 ] && dr 정리 OK "정리할 것 없음"

  # [서명]
  sign_enabled && dr 서명 INFO "커밋 서명 켜짐 (끄기: gitch sign off)" || dr 서명 INFO "커밋 서명 꺼짐 (켜기: gitch sign on)"

  doctor_print "$json"
  [ "$DR_PROBLEMS" -eq 0 ]
}

doctor_print() {
  local it sec lv msg last="" first=1 jl="" icon
  if [ -n "$1" ]; then
    for it in "${DR_ITEMS[@]}"; do
      sec=${it%%|*}; lv=${it#*|}; msg=${lv#*|}; lv=${lv%%|*}
      [ -n "$first" ] || jl="$jl,"; first=""
      jl="$jl{\"section\":$(json_str "$sec"),\"level\":$(json_str "$lv"),\"message\":$(json_str "$msg")}"
    done
    printf '{"schemaVersion":1,"version":%s,"problems":%s,"items":[%s]}\n' "$(json_str "$GITSW_VERSION")" "$DR_PROBLEMS" "$jl"
    return
  fi
  for it in "${DR_ITEMS[@]}"; do
    sec=${it%%|*}; lv=${it#*|}; msg=${lv#*|}; lv=${lv%%|*}
    [ "$sec" != "$last" ] && { say "${BOLD}[$sec]${RESET}"; last=$sec; }
    case "$lv" in OK) icon="${GREEN}✔${RESET}" ;; WARN) icon="${YELLOW}⚠${RESET}" ;; FAIL) icon="${RED}✘${RESET}" ;; *) icon="${DIM}·${RESET}" ;; esac
    say "  $icon $msg"
  done
  if in_repo && load_config && [ ${#CFG_ERRORS[@]} -eq 0 ]; then echo ""; status_cmd; fi
  echo ""
  if [ "$DR_PROBLEMS" -eq 0 ]; then say "${GREEN}문제 없음${RESET}"; else say "${YELLOW}확인할 항목 ${DR_PROBLEMS}개${RESET}"; fi
  say "DOCTOR_PROBLEMS=$DR_PROBLEMS"
}

# ================= 계정 목록 / 추가 / 삭제 / 조직 / 설정 =================

list_cmd() {   # [--check] [--json]
  local check="" json="" a i id cur="" key conn folders j first=1 jl=""
  for a in "$@"; do case "$a" in --check) check=1 ;; --json) json=1 ;; *) die "사용법: gitch list [--check] [--json]" ;; esac; done
  need_config
  if in_repo; then resolve_repo .; cur=$R_ACC; fi
  [ -z "$json" ] && say "${BOLD}등록된 계정 (${#ACC_IDS[@]}개)${RESET}"
  i=0
  while [ $i -lt ${#ACC_IDS[@]} ]; do
    id=${ACC_IDS[$i]}
    folders=""; j=0
    while [ $j -lt ${#F_RAW[@]} ]; do [ "${F_ACC[$j]}" = "$id" ] && folders="$folders${folders:+, }${F_RAW[$j]}"; j=$((j+1)); done
    j=0
    while [ $j -lt ${#O_RAW[@]} ]; do [ "${O_ACC[$j]}" = "$id" ] && folders="$folders${folders:+, }조직 ${O_RAW[$j]}"; j=$((j+1)); done
    key="✘ 없음 (gitch setup)"; [ -f "$SSH_DIR/id_ed25519_$id" ] && key="✔"
    if [ -n "$json" ]; then
      [ -n "$first" ] || jl="$jl,"; first=""
      jl="$jl{\"id\":$(json_str "$id"),\"email\":$(json_str "${ACC_EMAIL[$i]}"),\"hosts\":$(json_str "$(acc_hosts_desc "$id")"),\"rules\":$(json_str "$folders"),\"sshKey\":$(json_bool "$( [ -f "$SSH_DIR/id_ed25519_$id" ] && echo 1)"),\"current\":$(json_bool "$( [ "$id" = "$cur" ] && echo 1)")}"
      i=$((i+1)); continue
    fi
    echo ""
    if [ "$id" = "$cur" ]; then say "▶ ${BOLD}$((i+1))) $id${RESET}"; else say "  ${BOLD}$((i+1))) $id${RESET}"; fi
    say "     이메일   : ${ACC_EMAIL[$i]}"
    say "     서버     : $(acc_hosts_desc "$id")"
    say "     자동규칙 : ${folders:-없음}"
    say "     SSH 키   : $key"
    [ "${ACC_TRAILER[$i]}" = strip ] && say "     AI 표기  : 커밋에서 뺌 (aiTrailer=strip)"
    if [ -n "$check" ]; then
      j=0
      while [ $j -lt ${#B_ACC[@]} ]; do
        if [ "${B_ACC[$j]}" = "$id" ] && [ "${B_LOGIN[$j]}" = "$id" ]; then
          if test_ssh "${B_ALIAS[$j]}" "$id" >/dev/null 2>&1; then conn="${GREEN}✔ 연결 OK${RESET}"; else conn="${RED}✘ 연결 실패${RESET} → gitch setup"; fi
          say "     연결     : ${B_HOST[$j]} $conn"
        fi
        j=$((j+1))
      done
    fi
    i=$((i+1))
  done
  if [ -n "$json" ]; then printf '{"schemaVersion":1,"accounts":[%s]}\n' "$jl"; return 0; fi
  echo ""
  [ -n "$cur" ] && say "▶ = 현재 저장소 계정"
  [ -z "$check" ] && say "실제 연결까지 확인: gitch list --check"
  say "계정 추가: gitch add  /  삭제: gitch remove <아이디>  /  조직 규칙: gitch org"
}

cfg_header() {
  cat <<'EOF'
# gitch 설정 파일 (git config 형식) — 'gitch config set|add|unset' 으로 고치거나 사용자가 직접 편집
#
# [gitsw]
#     scanRoot = ~/Develop          # gitch scan 기본 폴더
#     aiPush = ask                  # Claude Code push 확인: ask 매번 | branch 기본/보호 브랜치와 PR 만 | allow 안 함
#     maxFileMB = 50                # 이 크기 이상 파일은 커밋 막기
# [account "아이디"]
#     email = 메일
#     host = github.com             # 서버[:포트] — 여러 개 가능, 'host = github.com via 다른계정' 은 그 계정의 SSH 로그인을 빌려 씀
#     aiTrailer = keep              # strip 이면 이 계정 커밋에서 Co-Authored-By: Claude 같은 AI 표기 줄을 뺌
# [folder "~/Develop/아이디"]
#     account = 아이디              # 이 폴더 안 저장소의 기본 계정
#     allowRemote = github.com/*    # (선택) 이 폴더 저장소가 push 할 수 있는 곳 — 여러 개 가능
# [org "github.com/조직"]
#     account = 아이디              # 이 조직 저장소는 이 계정
EOF
}

reset_config_state() {
  CFG_LOADED=""; CFG_EXISTS=""
  ACC_IDS=(); ACC_EMAIL=(); ACC_NAME=(); ACC_TRAILER=()
  B_ACC=(); B_HOST=(); B_PORT=(); B_LOGIN=(); B_ALIAS=()
  F_RAW=(); F_REAL=(); F_ACC=(); O_RAW=(); O_HOST=(); O_PATH=(); O_ACC=(); AR_RAW=(); AR_REAL=(); AR_PAT=()
  CFG_SCAN_ROOT="~/Develop"; CFG_AI_PUSH="ask"; CFG_MAX_MB=50; CFG_WARN_MB=10; CFG_SSH_STRICT=""
  CFG_ERRORS=()
}

cfg_begin() {   # 설정을 바꾸기 전: 파일이 없으면 만들고, 되돌릴 사본을 CFG_BAK 에
  mkdir -p "$(dirname "$CFG")" || die "설정 폴더를 만들 수 없습니다."
  [ -f "$CFG" ] || cfg_header > "$CFG"
  backup_file "$CFG"
  CFG_BAK=$(mktemp "${TMPDIR:-/tmp}/gitsw-cfg.XXXXXX") || die "임시 파일을 만들 수 없습니다."
  cp -p "$CFG" "$CFG_BAK"
}

cfg_end() {   # $1 git config 의 종료 코드 $2 무엇을 바꿨나 — 실패했거나 바꾼 뒤 검사가 틀리면 되돌림
  if [ "$1" -ne 0 ]; then cp -p "$CFG_BAK" "$CFG"; rm -f "$CFG_BAK"; die "설정을 바꾸지 못했습니다: $2"; fi
  if ! GITSW_CONFIG="$CFG" "$(self_path)" config check >/dev/null 2>&1; then
    [ -n "$MACHINE_JSON" ] || GITSW_CONFIG="$CFG" "$(self_path)" config check 2>&1 | sed 's/^/  /' >&2
    cp -p "$CFG_BAK" "$CFG"; rm -f "$CFG_BAK"
    die "설정이 올바르지 않아 되돌렸습니다."
  fi
  rm -f "$CFG_BAK"
  reset_config_state
  load_config
  return 0
}

cfg_change() {   # $1 set|add|unset|unset-all|remove-section $2 키 [$3 값] — 바꾼 뒤 검사, 틀리면 되돌림
  local op="$1" key="$2" val="$3" rc=0
  cfg_begin
  case "$op" in
    set) git config -f "$CFG" "$key" "$val" || rc=$? ;;
    add) git config -f "$CFG" --add "$key" "$val" || rc=$? ;;
    unset) if [ -n "$val" ]; then git config -f "$CFG" --fixed-value --unset "$key" "$val" || rc=$?
           else git config -f "$CFG" --unset "$key" || rc=$?; fi ;;
    unset-all) git config -f "$CFG" --unset-all "$key" || rc=$? ;;
    remove-section) git config -f "$CFG" --remove-section "$key" || rc=$? ;;
    *) rm -f "$CFG_BAK"; die "알 수 없는 설정 명령: $op" ;;
  esac
  cfg_end "$rc" "$op $key"
}

cfg_add_account() {   # $1 아이디 $2 이메일 $3 host 값 [$4 기본 폴더] — 계정은 email 과 host 가 함께 있어야 맞으니 모두 쓴 뒤 한 번 검사
  local rc=0
  cfg_begin
  git config -f "$CFG" "account.$1.email" "$2" || rc=$?
  [ $rc -eq 0 ] && { git config -f "$CFG" --add "account.$1.host" "$3" || rc=$?; }
  [ $rc -eq 0 ] && [ -n "${4:-}" ] && { git config -f "$CFG" "folder.$4.account" "$1" || rc=$?; }
  cfg_end "$rc" "account.$1"
}

after_config_change() {   # 계정/폴더/조직/push 정책이 바뀌면 규칙과 AI 안내를 다시 만듦
  install_auto_rules >/dev/null
  apply_ssh_strict
  write_ai_rules >/dev/null
  write_skills >/dev/null
  write_claude_settings >/dev/null
  ok "자동 규칙과 AI 안내를 갱신했습니다."
}

config_cmd() {   # path | show | get <키> | check | set|add|unset|unset-all <키> [값] [--yes] | edit
  local sub="${1:-show}" yes="" args=() a
  [ $# -gt 0 ] && shift
  for a in "$@"; do if [ "$a" = --yes ]; then yes=1; else args+=("$a"); fi; done
  case "$sub" in
    path) say "$CFG" ;;
    show|cat) [ -f "$CFG" ] || die "설정 파일이 없습니다: $(tilde "$CFG") → gitch migrate 또는 gitch add"; cat "$CFG" ;;
    get) [ ${#args[@]} -ge 1 ] || die "사용법: gitch config get <키>"; git config -f "$CFG" --get-all "${args[0]}" ;;
    check)
      load_config || die "설정 파일이 없습니다: $CFG"
      if [ ${#CFG_ERRORS[@]} -gt 0 ]; then for a in "${CFG_ERRORS[@]}"; do err "- $a"; done; exit 1; fi
      ok "설정 정상: 계정 ${#ACC_IDS[@]}개" ;;
    set|add|unset|unset-all)
      [ ${#args[@]} -ge 1 ] || die "사용법: gitch config $sub <키> [값]"
      { [ "$sub" = set ] || [ "$sub" = add ]; } && [ ${#args[@]} -lt 2 ] && die "사용법: gitch config $sub <키> <값>"
      confirm "gitch 설정 변경: $sub ${args[*]}" "$yes" "gitch config $sub ${args[*]} --yes"
      cfg_change "$sub" "${args[0]}" "${args[1]}"
      ok "설정을 바꿨습니다: $sub ${args[*]}"
      case "$(lower "${args[0]}")" in account.*|folder.*|org.*|gitsw.sshstrict|gitsw.aipush) after_config_change ;; esac ;;
    edit)
      can_prompt || die "설정 편집은 사용자가 터미널에서 직접 하세요: gitch config edit"
      mkdir -p "$(dirname "$CFG")"; [ -f "$CFG" ] || cfg_header > "$CFG"
      backup_file "$CFG"
      "${EDITOR:-vi}" "$CFG"
      reset_config_state
      need_config
      after_config_change ;;
    *) die "사용법: gitch config [path | show | get <키> | check | set|add|unset <키> [값] | edit]" ;;
  esac
}

org_key_norm() {   # 입력 → "서버/조직"
  local s="$1"
  s=${s#http://}; s=${s#https://}; s=${s#ssh://}; s=${s#git@}
  s=${s/://}; s=${s%/}; s=${s%.git}
  printf '%s' "$s"
}

org_cmd() {   # list | add <서버/조직> <계정> | rm <서버/조직>
  local sub="${1:-list}" yes="" args=() a key acc i
  [ $# -gt 0 ] && shift
  for a in "$@"; do if [ "$a" = --yes ]; then yes=1; else args+=("$a"); fi; done
  case "$sub" in
    list|ls)
      need_config
      [ ${#O_RAW[@]} -eq 0 ] && { say "조직 규칙이 없습니다. (추가: gitch org add github.com/조직 계정)"; return 0; }
      say "조직 규칙 (이 조직 저장소는 이 계정):"
      i=0; while [ $i -lt ${#O_RAW[@]} ]; do say "  ${O_RAW[$i]} → ${O_ACC[$i]}"; i=$((i+1)); done ;;
    add)
      [ ${#args[@]} -eq 2 ] || die "사용법: gitch org add <서버/조직> <계정>  (예: gitch org add github.com/myorg alice)"
      need_config
      key=$(org_key_norm "${args[0]}"); acc=${args[1]}
      case "$key" in */*) ;; *) die "'서버/조직' 형식으로 입력하세요. (예: github.com/myorg)" ;; esac
      is_account "$acc" || die "없는 계정: $acc (계정: $(account_names))"
      confirm "조직 규칙 추가: $key → $acc" "$yes" "gitch org add $key $acc --yes"
      cfg_change set "org.$key.account" "$acc"
      ok "조직 규칙: $key → $acc"
      after_config_change ;;
    rm|remove)
      [ ${#args[@]} -eq 1 ] || die "사용법: gitch org rm <서버/조직>"
      need_config
      key=$(org_key_norm "${args[0]}")
      git config -f "$CFG" --get "org.$key.account" >/dev/null || die "그런 조직 규칙이 없습니다: $key"
      confirm "조직 규칙 삭제: $key" "$yes" "gitch org rm $key --yes"
      cfg_change remove-section "org.$key"
      ok "조직 규칙을 지웠습니다: $key"
      after_config_change ;;
    *) die "사용법: gitch org [list | add <서버/조직> <계정> | rm <서버/조직>]" ;;
  esac
}

# ================= GitHub 브라우저 로그인 (앱용) =================
login_error() { machine_error "$1" "$2" "$3"; return "$2"; }
login_gh() {
  LOGIN_GH="${GITCH_GH:-${GH_PATH:-}}"
  if [ -n "$LOGIN_GH" ]; then
    case "$LOGIN_GH" in */*|*\\*) ;; *) LOGIN_GH=$(command -v "$LOGIN_GH" 2>/dev/null) || LOGIN_GH="" ;; esac
    [ -f "$LOGIN_GH" ] && [ -x "$LOGIN_GH" ] || { login_error GITHUB_CLI_MISSING 1 "GitHub CLI 실행 파일을 찾을 수 없습니다. https://cli.github.com/ 에서 설치하세요."; return 1; }
  else
    LOGIN_GH=$(command -v gh 2>/dev/null) || { login_error GITHUB_CLI_MISSING 1 "GitHub CLI가 필요합니다. https://cli.github.com/ 에서 설치하세요."; return 1; }
  fi
}
login_session() {
  local id=$1
  [[ "$id" =~ ^github-[A-Za-z0-9]{10}$ ]] || { login_error LOGIN_SESSION_INVALID 1 "로그인 세션 식별자가 올바르지 않습니다."; return 1; }
  LOGIN_ROOT="$STATE_DIR/logins"; LOGIN_DIR="$LOGIN_ROOT/$id"
  [ -d "$LOGIN_ROOT" ] && [ ! -L "$LOGIN_ROOT" ] && [ -d "$LOGIN_DIR" ] && [ ! -L "$LOGIN_DIR" ] && [ -O "$LOGIN_DIR" ] || { login_error LOGIN_SESSION_INVALID 1 "로그인 세션을 찾을 수 없습니다."; return 1; }
  local file
  for file in created auth-started result.json auth.log cancel gh-path browser result.lock capability expected-login; do
    [ ! -L "$LOGIN_DIR/$file" ] || { login_error LOGIN_SESSION_INVALID 1 "로그인 세션 파일이 올바르지 않습니다."; return 1; }
  done
}
login_code() {
  # gh의 clipboard 설정이 켜져 있으면 같은 코드를 괄호 안에 출력한다.
  # 두 공식 안내 문장만 읽어 다른 로그에 우연히 나온 문자열은 전달하지 않는다.
  LC_ALL=C sed -nE \
    -e 's/.*[Ff]irst copy your one-time code: ([A-Z0-9]{4}-[A-Z0-9]{4})[[:space:]]*$/\1/p' \
    -e 's/.*[Oo]ne-time code \(([A-Z0-9]{4}-[A-Z0-9]{4})\) copied to clipboard[[:space:]]*$/\1/p' \
    "$LOGIN_DIR/auth.log" 2>/dev/null | head -1
}
login_nullable() { if [ -n "$1" ]; then json_str "$1"; else printf null; fi; }
login_email_valid() {
  case "$1" in ''|*[$'\001'-$'\040']*|*[[:space:]]*) return 1 ;; ?*@?*) return 0 ;; *) return 1 ;; esac
}
login_result() {
  local session=$1 state=$2 code=${3:-} user=${4:-} email=${5:-} message=$6 phase=""
  if [ "$state" = pending ]; then
    if [ -n "$code" ]; then phase=approval; message="브라우저에서 GitHub 로그인을 계속하세요."
    elif [ -f "$LOGIN_DIR/auth-started" ] || [ ! -d "$LOGIN_ROOT/active.lock" ]; then phase=preparing; message="GitHub 로그인 코드를 준비하고 있습니다."
    else phase=queued; message="다른 GitHub 로그인 작업이 끝나기를 기다립니다."; fi
  fi
  printf '{"schemaVersion":1,"tool":"gitch login","session":%s,"state":%s,"deviceCode":%s,"verificationURL":"https://github.com/login/device","login":%s,"email":%s,"message":%s' \
    "$(json_str "$session")" "$(json_str "$state")" "$(login_nullable "$code")" "$(login_nullable "$user")" "$(login_nullable "$email")" "$(json_str "$message")"
  [ -z "$phase" ] || printf ',"phase":%s' "$(json_str "$phase")"
  printf '}\n'
}
login_finish() {
  local state=$1 user=${2:-} email=${3:-} message=$4
  login_result_lock || return 1
  if [ -f "$LOGIN_DIR/result.json" ]; then rmdir "$LOGIN_DIR/result.lock"; return 0; fi
  login_created
  if [ -f "$LOGIN_DIR/cancel" ]; then state=cancelled; user=""; email=""; message="로그인을 취소했습니다."
  elif [ "$(( $(date +%s) - LOGIN_CREATED ))" -ge 900 ]; then state=failed; user=""; email=""; message="로그인 시간이 초과되었습니다. 다시 시작하세요."; fi
  login_result "$LOGIN_ID" "$state" "" "$user" "$email" "$message" > "$LOGIN_DIR/result.tmp"
  chmod 600 "$LOGIN_DIR/result.tmp"
  mv "$LOGIN_DIR/result.tmp" "$LOGIN_DIR/result.json"
  rmdir "$LOGIN_DIR/result.lock"
}
login_result_lock() {
  local attempt=0
  while ! mkdir "$LOGIN_DIR/result.lock" 2>/dev/null; do
    attempt=$((attempt + 1)); [ "$attempt" -lt 30 ] || return 1; sleep 0.1
  done
}
login_active_recover() {
  local lock="$LOGIN_ROOT/active.lock" owner path created now age
  [ -d "$lock" ] && [ ! -L "$lock" ] || return 0
  now=$(date +%s)
  for path in "$lock"/github-*; do
    [ -d "$path" ] && [ ! -L "$path" ] || continue
    owner=${path##*/}
    [[ "$owner" =~ ^github-[A-Za-z0-9]{10}$ ]] || continue
    [ -d "$LOGIN_ROOT/$owner" ] && [ ! -L "$LOGIN_ROOT/$owner" ] && [ ! -L "$LOGIN_ROOT/$owner/created" ] || continue
    created=$(cat "$LOGIN_ROOT/$owner/created" 2>/dev/null)
    case "$created" in ''|*[!0-9]*) continue ;; esac
    [ "${#created}" -le 12 ] || continue
    age=$((now - created))
    if [ "$age" -ge 910 ] || { [ -f "$LOGIN_ROOT/$owner/result.json" ] && [ ! -L "$LOGIN_ROOT/$owner/result.json" ]; }; then
      # 소유자 자식 폴더를 지운 경우에만 바깥 잠금을 지운다. 이전 worker도 같은 규칙을
      # 따라 새 세션이 획득한 잠금을 뒤늦게 지울 수 없다. 저장된 PID는 사용하지 않는다.
      if rmdir "$path" 2>/dev/null; then rmdir "$lock" 2>/dev/null || :; fi
    fi
  done
  # mkdir 직후 소유자 기록 전 비정상 종료한 빈 잠금도 기한이 지난 뒤 회복한다.
  [ -d "$lock" ] || return 0
  created=$(stat -c %Y "$lock" 2>/dev/null) || created=$(stat -f %m "$lock" 2>/dev/null)
  case "$created" in ''|*[!0-9]*) return 0 ;; esac
  [ "$((now - created))" -lt 910 ] || rmdir "$lock" 2>/dev/null || :
}
login_active_lock() {
  while ! mkdir "$LOGIN_ROOT/active.lock" 2>/dev/null; do
    login_active_recover
    [ ! -f "$LOGIN_DIR/cancel" ] || return 125
    login_created
    [ "$(( $(date +%s) - LOGIN_CREATED ))" -lt 900 ] || return 124
    sleep 1
  done
  mkdir "$LOGIN_ROOT/active.lock/$LOGIN_ID" || { rmdir "$LOGIN_ROOT/active.lock" 2>/dev/null; return 1; }
  trap 'if rmdir "$LOGIN_ROOT/active.lock/$LOGIN_ID" 2>/dev/null; then rmdir "$LOGIN_ROOT/active.lock" 2>/dev/null || :; fi' EXIT
}
# shellcheck disable=SC2089,SC2090  # GH_BROWSER is a shlex command string consumed by the official GitHub CLI.
login_browser_launcher() {
  local shell_path="${BASH:-/bin/bash}" browser_path="$LOGIN_DIR/browser" value
  if [ -n "$IS_WINDOWS" ]; then
    shell_path=$(cygpath -m "$shell_path") || return 1
    browser_path=$(cygpath -m "$browser_path") || return 1
  fi
  # GitHub CLI는 GH_BROWSER를 google/shlex로 나눈다. 네이티브 Windows에서도
  # .sh를 직접 실행하지 않고 이 worker와 같은 Bash로 스텁을 실행한다.
  value=$shell_path; value=${value//\\/\\\\}; value=${value//\"/\\\"}
  GH_BROWSER="\"$value\""
  value=$browser_path; value=${value//\\/\\\\}; value=${value//\"/\\\"}
  GH_BROWSER="$GH_BROWSER \"$value\""; BROWSER=$GH_BROWSER
  export GH_BROWSER BROWSER
}
login_created() {
  LOGIN_CREATED=$(cat "$LOGIN_DIR/created" 2>/dev/null)
  case "$LOGIN_CREATED" in ''|*[!0-9]*) LOGIN_CREATED=0 ;; esac
  [ "${#LOGIN_CREATED}" -le 12 ] || LOGIN_CREATED=0
}
login_wait() {
  # 이 worker가 직접 만든 자식만 중단한다. 저장된 PID를 신뢰해 kill하지 않는다.
  local child rc=0 started auth_started code_expired
  [ ! -f "$LOGIN_DIR/cancel" ] || return 125
  login_created
  [ "$(( $(date +%s) - LOGIN_CREATED ))" -lt 900 ] || return 124
  "$@" &
  child=$!
  while kill -0 "$child" 2>/dev/null; do
    login_created
    started=$(date +%s)
    code_expired=""
    if [ -n "${LOGIN_WAIT_FOR_CODE:-}" ]; then
      auth_started=$(cat "$LOGIN_DIR/auth-started" 2>/dev/null)
      case "$auth_started" in ''|*[!0-9]*) auth_started=$started ;; esac
      [ "${#auth_started}" -le 12 ] || auth_started=$started
      if [ "$((started - auth_started))" -ge 60 ] && [ -z "$(login_code)" ]; then code_expired=1; fi
    fi
    if [ -f "$LOGIN_DIR/cancel" ] || [ "$((started - LOGIN_CREATED))" -ge 900 ] || [ -n "$code_expired" ]; then
      kill "$child" 2>/dev/null || :
      sleep 1
      kill -KILL "$child" 2>/dev/null || :
      wait "$child" 2>/dev/null || :
      [ ! -f "$LOGIN_DIR/cancel" ] || return 125
      [ -z "$code_expired" ] || return 123
      return 124
    fi
    sleep 1
  done
  wait "$child" 2>/dev/null || rc=$?
  return "$rc"
}
login_worker() (
  umask 077
  LOGIN_ID=${1:-}; login_session "$LOGIN_ID" || exit 1
  unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GH_HOST
  login_browser_launcher || { login_finish failed "" "" "브라우저 로그인 도우미를 준비하지 못했습니다."; exit 0; }
  export GH_PROMPT_DISABLED=1 NO_COLOR=1 CLICOLOR=0 TERM=dumb
  local gh user token actual email uid rc=0 capability expected scopes
  capability=$(cat "$LOGIN_DIR/capability" 2>/dev/null); capability=${capability:-standard}
  expected=$(cat "$LOGIN_DIR/expected-login" 2>/dev/null)
  scopes=read:user,user:email,repo,read:org,workflow,admin:public_key
  case "$capability" in
    standard) ;;
    projects)
      [[ "$expected" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]] || { login_finish failed "" "" "프로젝트 접근을 연결할 GitHub 계정이 올바르지 않습니다."; exit 0; }
      scopes="$scopes,project" ;;
    *) login_finish failed "" "" "지원하지 않는 GitHub 로그인 권한입니다."; exit 0 ;;
  esac
  # GitHub CLI 계정 저장은 전역 파일을 공유하므로 서로 다른 세션의 저장을 순서대로 실행한다.
  login_active_lock || rc=$?
  case "$rc" in
    0) ;;
    125) login_finish cancelled "" "" "로그인을 취소했습니다."; exit 0 ;;
    124) login_finish failed "" "" "로그인 시간이 초과되었습니다. 다시 시작하세요."; exit 0 ;;
    *) login_finish failed "" "" "다른 로그인 작업의 상태를 확인할 수 없습니다. 다시 시작하세요."; exit 0 ;;
  esac
  gh=$(cat "$LOGIN_DIR/gh-path")
  date +%s > "$LOGIN_DIR/auth-started"
  LOGIN_WAIT_FOR_CODE=1 login_wait "$gh" auth login --web --hostname github.com --skip-ssh-key --scopes "$scopes" > "$LOGIN_DIR/auth.log" 2>&1 || rc=$?
  case "$rc" in
    125) login_finish cancelled "" "" "로그인을 취소했습니다."; exit 0 ;;
    124) login_finish failed "" "" "로그인 시간이 초과되었습니다. 다시 시작하세요."; exit 0 ;;
    123) login_finish failed "" "" "GitHub 로그인 코드를 준비하지 못했습니다. 네트워크 연결을 확인하고 다시 시도하세요."; exit 0 ;;
    0) ;;
    *) login_finish failed "" "" "GitHub 로그인이 완료되지 않았습니다. 다시 시도하세요."; exit 0 ;;
  esac
  [ ! -f "$LOGIN_DIR/cancel" ] || { login_finish cancelled "" "" "로그인을 취소했습니다."; exit 0; }
  user=$(LC_ALL=C sed -nE 's/.*Logged in as ([A-Za-z0-9][A-Za-z0-9-]{0,38})[[:space:]]*$/\1/p' "$LOGIN_DIR/auth.log" | tail -1)
  [ -n "$user" ] || { login_finish failed "" "" "로그인한 GitHub 계정을 확인할 수 없습니다. GitHub CLI를 업데이트하고 다시 시도하세요."; exit 0; }
  # 추가 권한은 사용자가 선택한 계정에만 가져온다. 다른 계정으로 승인해도 앱에 연결하지 않는다.
  if [ -n "$expected" ] && [ "$(lower "$user")" != "$(lower "$expected")" ]; then
    login_finish failed "" "" "선택한 GitHub 계정과 승인한 계정이 다릅니다. 선택한 계정으로 다시 승인하세요."; exit 0
  fi
  # 기존 활성 계정과 섞이지 않도록 완료 로그에 나온 사용자 전용 자격 증명으로 조회한다.
  rc=0; token=$(login_wait "$gh" auth token --hostname github.com --user "$user" 2>/dev/null) || rc=$?
  if [ "$rc" -ne 0 ]; then
    case "$rc" in 125) login_finish cancelled "" "" "로그인을 취소했습니다." ;; 124) login_finish failed "" "" "로그인 시간이 초과되었습니다. 다시 시작하세요." ;; *) login_finish failed "" "" "로그인 자격 증명을 확인할 수 없습니다." ;; esac
    exit 0
  fi
  [ -n "$token" ] || { login_finish failed "" "" "로그인 자격 증명을 확인할 수 없습니다."; exit 0; }
  rc=0; GH_TOKEN="$token" login_wait "$gh" api --hostname github.com user --jq '[.login, (.id|tostring)] | .[]' > "$LOGIN_DIR/identity.tmp" 2>/dev/null || rc=$?
  actual=$(sed -n '1p' "$LOGIN_DIR/identity.tmp"); uid=$(sed -n '2p' "$LOGIN_DIR/identity.tmp")
  if [ "$rc" -ne 0 ] || [ "$actual" != "$user" ]; then
    token=""
    case "$rc" in 125) login_finish cancelled "" "" "로그인을 취소했습니다." ;; 124) login_finish failed "" "" "로그인 시간이 초과되었습니다. 다시 시작하세요." ;; *) login_finish failed "" "" "로그인 계정이 자격 증명과 일치하지 않습니다. 다시 시도하세요." ;; esac
    exit 0
  fi
  rc=0; GH_TOKEN="$token" login_wait "$gh" api --hostname github.com user/emails --jq '[.[] | select(.primary == true and .verified == true) | .email][0] // ""' > "$LOGIN_DIR/email.tmp" 2>/dev/null || rc=$?
  token=""
  case "$rc" in 125) login_finish cancelled "" "" "로그인을 취소했습니다."; exit 0 ;; 124) login_finish failed "" "" "로그인 시간이 초과되었습니다. 다시 시작하세요."; exit 0 ;; esac
  email=$(head -1 "$LOGIN_DIR/email.tmp")
  if [ "$rc" -ne 0 ] || ! login_email_valid "$email"; then
    case "$uid" in ''|*[!0-9]*) email="$user@users.noreply.github.com" ;; *) email="$uid+$user@users.noreply.github.com" ;; esac
  fi
  [ ! -f "$LOGIN_DIR/cancel" ] || { login_finish cancelled "" "" "로그인을 취소했습니다."; exit 0; }
  login_finish complete "$user" "$email" "GitHub 로그인을 완료했습니다."
)
login_cleanup() {
  local d count=0 now created
  login_active_recover   # 소유 세션을 지우기 전에 완료/만료 잠금부터 회복한다.
  now=$(date +%s)
  for d in "$LOGIN_ROOT"/github-*; do
    [ "$count" -lt 32 ] || break
    [ -d "$d" ] && [ ! -L "$d" ] && [ -O "$d" ] || continue
    [[ "${d##*/}" =~ ^github-[A-Za-z0-9]{10}$ ]] || continue
    count=$((count + 1)); [ ! -L "$d/created" ] || continue
    created=$(cat "$d/created" 2>/dev/null)
    case "$created" in ''|*[!0-9]*) continue ;; esac
    [ "${#created}" -le 12 ] || continue
    [ "$((now - created))" -gt 86400 ] && [ -f "$d/result.json" ] && [ ! -L "$d/result.json" ] || continue
    rm -rf -- "$d"
  done
}
login_cmd() (
  local mode="" session="" yes="" code="" self capability=standard expected="" scoped="" identified=""
  [ "${1:-}" = github ] || { login_error LOGIN_ARGUMENT 1 "사용법: gitch login github --start|--status SESSION|--cancel SESSION --json"; return 1; }
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --start) [ -z "$mode" ] || { login_error LOGIN_ARGUMENT 1 "로그인 작업을 하나만 선택하세요."; return 1; }; mode=start ;;
      --status|--cancel) [ -z "$mode" ] && [ $# -ge 2 ] || { login_error LOGIN_ARGUMENT 1 "세션 식별자가 필요합니다."; return 1; }; mode=${1#--}; session=$2; shift ;;
      --yes|-y) yes=1 ;;
      --capability) [ $# -ge 2 ] && [ -z "$scoped" ] || { login_error LOGIN_ARGUMENT 1 "로그인 권한을 하나만 선택하세요."; return 1; }; capability=$2; scoped=1; shift ;;
      --expected-login) [ $# -ge 2 ] && [ -z "$identified" ] || { login_error LOGIN_ARGUMENT 1 "연결할 GitHub 계정을 하나만 지정하세요."; return 1; }; expected=$2; identified=1; shift ;;
      --json) ;;
      *) login_error LOGIN_ARGUMENT 1 "알 수 없는 로그인 옵션입니다."; return 1 ;;
    esac
    shift
  done
  case "$capability" in standard|projects) ;; *) login_error LOGIN_ARGUMENT 1 "지원하지 않는 GitHub 로그인 권한입니다."; return 1 ;; esac
  if [ -n "$identified" ] && ! [[ "$expected" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]]; then login_error LOGIN_ARGUMENT 1 "연결할 GitHub 계정이 올바르지 않습니다."; return 1; fi
  if [ "$mode" != start ] && { [ -n "$scoped" ] || [ -n "$identified" ]; }; then login_error LOGIN_ARGUMENT 1 "로그인 권한과 계정은 시작할 때만 지정하세요."; return 1; fi
  if [ "$capability" = projects ] && [ -z "$expected" ]; then login_error LOGIN_ARGUMENT 1 "프로젝트 접근을 연결할 GitHub 계정을 지정하세요."; return 1; fi
  case "$mode" in
    start)
      [ -n "$yes" ] || { login_error CONFIRMATION_REQUIRED 2 "GitHub 브라우저 로그인은 앱의 로그인 버튼이나 --yes 확인이 필요합니다."; return 2; }
      login_gh || return 1
      umask 077
      LOGIN_ROOT="$STATE_DIR/logins"
      [ ! -L "$LOGIN_ROOT" ] || { login_error LOGIN_STATE_INVALID 1 "로그인 상태 폴더가 심볼릭 링크입니다."; return 1; }
      mkdir -p "$LOGIN_ROOT" && chmod 700 "$LOGIN_ROOT" || { login_error LOGIN_STATE_INVALID 1 "로그인 상태 폴더를 만들 수 없습니다."; return 1; }
      login_cleanup
      LOGIN_DIR=$(mktemp -d "$LOGIN_ROOT/github-XXXXXXXXXX") || return 1
      chmod 700 "$LOGIN_DIR"; session=${LOGIN_DIR##*/}
      date +%s > "$LOGIN_DIR/created"
      printf '%s\n' "$LOGIN_GH" > "$LOGIN_DIR/gh-path"
      printf '%s\n' "$capability" > "$LOGIN_DIR/capability"
      [ -z "$expected" ] || printf '%s\n' "$expected" > "$LOGIN_DIR/expected-login"
      printf '#!/bin/sh\nexit 0\n' > "$LOGIN_DIR/browser"; chmod 700 "$LOGIN_DIR/browser"
      : > "$LOGIN_DIR/auth.log"; : > "$LOGIN_DIR/worker.log"
      self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")
      nohup "${BASH:-/bin/bash}" "$self" _login-worker "$session" < /dev/null > "$LOGIN_DIR/worker.log" 2>&1 &
      login_result "$session" pending "" "" "" "브라우저에서 GitHub 로그인을 계속하세요."
      ;;
    status|cancel)
      login_session "$session" || return 1
      if [ -f "$LOGIN_DIR/result.json" ]; then cat "$LOGIN_DIR/result.json"; return 0; fi
      if [ "$mode" = cancel ]; then
        login_result_lock || { login_error LOGIN_BUSY 1 "로그인 결과를 저장 중입니다. 다시 시도하세요."; return 1; }
        if [ -f "$LOGIN_DIR/result.json" ]; then cat "$LOGIN_DIR/result.json"; rmdir "$LOGIN_DIR/result.lock"; return 0; fi
        umask 077; : > "$LOGIN_DIR/cancel"
        rmdir "$LOGIN_DIR/result.lock"
        login_result "$session" cancelled "" "" "" "로그인을 취소했습니다."
      elif [ -f "$LOGIN_DIR/cancel" ]; then login_result "$session" cancelled "" "" "" "로그인을 취소했습니다."
      else
        login_created
        if [ "$(( $(date +%s) - LOGIN_CREATED ))" -ge 900 ]; then
          login_result "$session" failed "" "" "" "로그인 시간이 초과되었습니다. 다시 시작하세요."
        else code=$(login_code); login_result "$session" pending "$code" "" "" "브라우저에서 GitHub 로그인을 계속하세요."
        fi
      fi
      ;;
    *) login_error LOGIN_ARGUMENT 1 "로그인 작업을 선택하세요: --start, --status, --cancel"; return 1 ;;
  esac
)

account_pick_binding() {
  local i=0
  while [ "$i" -lt "${#B_ACC[@]}" ]; do
    if [ "${B_ACC[$i]}" = "$1" ]; then ACCOUNT_BI=$i; return 0; fi
    i=$((i + 1))
  done
  die "계정의 SSH 서버 설정이 없습니다: $1"
}
account_alias_exists() {
  [ -f "$SSH_CONFIG" ] || return 1
  awk -v alias="$1" 'tolower($1) == "host" { for (i=2; i<=NF; i++) if (tolower($i) == tolower(alias)) found=1 } END { exit !found }' "$SSH_CONFIG"
}
account_public_key() {
  [ -f "$1" ] || return 0
  head -n 1 "$1" | awk '$1 ~ /^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)$/ && $2 ~ /^[A-Za-z0-9+\/]+=*$/ { print; exit }'
}
account_machine_result() {
  local id=$1 created=$2 authenticated=$3 protection=$4 message=$5 i host port alias owner key pub exists="" configured="" folder="" via="" profile sshmeta
  account_pick_binding "$id"; i=$ACCOUNT_BI
  host=${B_HOST[$i]}; port=${B_PORT[$i]}; alias=${B_ALIAS[$i]}; owner=${B_LOGIN[$i]}
  port=$(printf '%s' "$port" | awk '{ print $0 + 0 }')
  key="$SSH_DIR/id_ed25519_$owner"; pub=$(account_public_key "$key.pub")
  [ ! -f "$key" ] || exists=1
  account_alias_exists "$alias" && configured=1
  [ -n "$exists" ] || protection=missing
  [ "$owner" = "$id" ] || via=$owner
  i=0
  while [ "$i" -lt "${#F_ACC[@]}" ]; do
    if [ "${F_ACC[$i]}" = "$id" ]; then folder=${F_RAW[$i]}; break; fi
    i=$((i + 1))
  done
  profile=$(printf '{"id":%s,"email":%s,"host":%s,"port":%s,"folder":%s,"via":%s}' "$(json_str "$id")" "$(json_str "$(acc_email "$id")")" "$(json_str "$host")" "$port" "$( [ -z "$folder" ] && printf null || json_str "$folder" )" "$( [ -z "$via" ] && printf null || json_str "$via" )")
  sshmeta=$(printf '{"alias":%s,"keyExists":%s,"aliasConfigured":%s,"publicKey":%s,"publicKeyPath":%s,"registrationURL":%s,"authenticated":%s,"keyProtection":%s,"message":%s}' "$(json_str "$alias")" "$(json_bool "$exists")" "$(json_bool "$configured")" "$(json_str "$pub")" "$(json_str "$key.pub")" "$(json_str "$(ssh_keys_page "$host")")" "$authenticated" "$(json_str "$protection")" "$(json_str "$message")")
  printf '{"schemaVersion":1,"tool":"gitch account setup","created":%s,"account":%s,"ssh":%s,"id":%s,"email":%s,"host":%s,"port":%s,"alias":%s,"keyExists":%s,"aliasConfigured":%s,"publicKey":%s,"publicKeyPath":%s,"registrationURL":%s,"authenticated":%s,"keyProtection":%s,"message":%s}\n' "$(json_bool "$created")" "$profile" "$sshmeta" "$(json_str "$id")" "$(json_str "$(acc_email "$id")")" "$(json_str "$host")" "$port" "$(json_str "$alias")" "$(json_bool "$exists")" "$(json_bool "$configured")" "$(json_str "$pub")" "$(json_str "$key.pub")" "$(json_str "$(ssh_keys_page "$host")")" "$authenticated" "$(json_str "$protection")" "$(json_str "$message")"
}
account_folder_path() {
  local path ancestor suffix=""
  path=$(expand_path "$1"); path=$(posix_path "$path")
  case "$path" in /*) ;; *) die "기본 폴더는 절대 경로나 ~/ 경로여야 합니다." ;; esac
  path=$(printf '%s' "$path" | awk -F/ '{ n=0; for(i=1;i<=NF;i++) { if($i=="" || $i==".") continue; if($i=="..") { if(n>0)n--; } else a[++n]=$i } out=""; for(i=1;i<=n;i++)out=out "/" a[i]; print (out=="" ? "/" : out) }')
  ancestor=$path
  while [ ! -d "$ancestor" ] && [ "$ancestor" != / ]; do suffix="/${ancestor##*/}$suffix"; ancestor=${ancestor%/*}; [ -n "$ancestor" ] || ancestor=/; done
  path="$(real_dir "$ancestor")$suffix"
  [ -z "$IS_WINDOWS" ] || path=$(lower "$path")
  printf '%s' "$path"
}
account_folder_validate() {
  local folder=$1 id=$2 candidate existing i=0
  [ -n "$folder" ] || return 0
  case "$folder" in *[$'\001'-$'\037']*) die "기본 폴더에 제어 문자를 쓸 수 없습니다." ;; esac
  candidate=$(account_folder_path "$folder") || return 1
  [ "$candidate" != / ] || die "루트 폴더는 계정 기본 폴더로 지정하지 마세요."
  while [ "$i" -lt "${#F_RAW[@]}" ]; do
    existing=$(account_folder_path "${F_RAW[$i]}") || return 1
    if [ "$existing" = "$candidate" ] && [ "${F_ACC[$i]}" != "$id" ]; then die "이 기본 폴더는 이미 ${F_ACC[$i]} 계정에 연결되어 있습니다."; fi
    i=$((i + 1))
  done
}
add_machine_cmd() (
  local id="" email="" host=github.com port=22 via="" folder="" folder_set="" no_folder="" yes="" lock="" option hv
  trap '[ -z "$lock" ] || rmdir "$lock" 2>/dev/null' EXIT
  while [ "$#" -gt 0 ]; do
    option=$1
    case "$option" in
      --id|--email|--host|--port|--folder|--via)
        shift; [ -n "${1:-}" ] || die "$option 뒤에 값이 필요합니다."
        case "$option" in --id) id=$1 ;; --email) email=$1 ;; --host) host=$1 ;; --port) port=$1 ;; --folder) folder=$1; folder_set=1 ;; --via) via=$1 ;; esac ;;
      --no-folder) no_folder=1 ;; --no-setup|--json) ;; --yes) yes=1 ;;
      *) die "알 수 없는 계정 추가 옵션: $option" ;;
    esac
    shift
  done
  case "$id" in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) die "아이디는 영문/숫자로 시작하고 영문/숫자/._- 만 쓸 수 있습니다." ;; esac
  case "$email" in ""|*[$'\001'-$'\040']*|*[[:space:]]*) die "이메일 형식이 아닙니다." ;; esac
  case "$email" in ?*@?*) ;; *) die "이메일 형식이 아닙니다." ;; esac
  case "$host" in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9.-]*|*..*|*.) die "서버에는 호스트 이름만 입력하세요. 포트는 --port 로 지정합니다." ;; esac
  host=$(lower "$host")
  printf '%s' "$host" | awk -F. '{ for(i=1;i<=NF;i++) if($i !~ /^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$/) exit 1 }' || die "서버 호스트 이름이 올바르지 않습니다."
  is_number "$port" && [ "${#port}" -le 5 ] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "포트는 1~65535 사이 숫자입니다."
  port=$((10#$port))
  [ -z "$folder_set" ] || [ -z "$no_folder" ] || die "--folder 와 --no-folder 는 함께 쓸 수 없습니다."
  [ -n "$folder_set" ] || folder="~/Develop/$id"; [ -z "$no_folder" ] || folder=""
  load_config >/dev/null 2>&1
  [ "${#CFG_ERRORS[@]}" -eq 0 ] || die "기존 설정이 올바르지 않습니다: ${CFG_ERRORS[*]}"
  is_account "$id" && die "이미 있는 계정입니다: $id"
  account_folder_validate "$folder" "$id" || exit 1
  if [ -n "$via" ]; then
    find_binding "$via" "$host" || die "$via 계정에 $host 서버가 없습니다."
    [ "${B_PORT[$BI]}" = "$port" ] || die "공유할 계정의 SSH 포트와 다릅니다."
  fi
  confirm "새 계정을 추가합니다: $id" "$yes" "Gitrochi 계정 설정에서 추가하거나 gitch add 를 실행하세요"
  mkdir -p "$(dirname "$CFG")" || die "설정 폴더를 만들 수 없습니다."
  option="$CFG.gitch-account.lock"
  mkdir "$option" 2>/dev/null || die "다른 계정 설정 작업이 진행 중입니다. 잠시 뒤 다시 시도하세요."
  lock=$option
  reset_config_state; load_config >/dev/null 2>&1
  [ "${#CFG_ERRORS[@]}" -eq 0 ] || die "기존 설정이 올바르지 않습니다: ${CFG_ERRORS[*]}"
  is_account "$id" && die "이미 있는 계정입니다: $id"
  account_folder_validate "$folder" "$id" || exit 1
  if [ -n "$via" ]; then find_binding "$via" "$host" || die "공유할 계정을 찾지 못했습니다."; [ "${B_PORT[$BI]}" = "$port" ] || die "공유할 계정의 SSH 포트와 다릅니다."; fi
  hv=$host; [ "$port" = 22 ] || hv="$host:$port"; [ -z "$via" ] || hv="$hv via $via"
  cfg_add_account "$id" "$email" "$hv" "$folder"
  account_machine_result "$id" 1 null existing "계정을 추가했습니다. SSH 키 생성과 서버 등록은 별도 단계입니다."
)
setup_machine_cmd() (
  local id="" mode="" yes="" option i owner alias host key created="" protection=existing lock="" config_lock="" candidate tmp="" ssh_tmp="" output authenticated=false rc=1 ssh_pid="" watchdog_pid="" ssh_rc
  trap '[ -z "$watchdog_pid" ] || kill "$watchdog_pid" 2>/dev/null; [ -z "$ssh_pid" ] || kill "$ssh_pid" 2>/dev/null; [ -z "$tmp" ] || rm -rf "$tmp"; [ -z "$lock" ] || rmdir "$lock" 2>/dev/null; [ -z "$config_lock" ] || rmdir "$config_lock" 2>/dev/null; [ -z "$ssh_tmp" ] || rm -f "$ssh_tmp"' EXIT
  while [ "$#" -gt 0 ]; do
    option=$1
    case "$option" in
      --inspect|--generate|--check) [ -z "$mode" ] || die "SSH 작업은 하나만 지정하세요."; mode=${option#--} ;;
      --json) ;; --yes) yes=1 ;;
      -*) die "알 수 없는 SSH 설정 옵션: $option" ;;
      *) [ -z "$id" ] || die "계정은 하나만 지정하세요."; id=$option ;;
    esac
    shift
  done
  [ -n "$id" ] && [ -n "$mode" ] || die "사용법: gitch setup ID --inspect|--generate|--check --json [--yes]"
  need_config; is_account "$id" || die "없는 계정입니다: $id"
  account_pick_binding "$id"; i=$ACCOUNT_BI
  owner=${B_LOGIN[$i]}; alias=${B_ALIAS[$i]}; host=${B_HOST[$i]}; key="$SSH_DIR/id_ed25519_$owner"
  case "$mode" in
    inspect) account_machine_result "$id" "" null existing "공개키를 서버에 등록한 뒤 연결 확인을 실행하세요."; return 0 ;;
    check)
      tmp=$(mktemp -d "${TMPDIR:-/tmp}/gitch-ssh-check.XXXXXX") || die "SSH 점검 임시 폴더를 만들지 못했습니다."
      "$SSH_BIN" -T -o BatchMode=yes -o ConnectTimeout=8 -o ConnectionAttempts=1 -o StrictHostKeyChecking=accept-new "git@$alias" > "$tmp/output" 2>&1 &
      ssh_pid=$!
      (
        timer_child=""
        trap '[ -z "$timer_child" ] || kill "$timer_child" 2>/dev/null; exit 0' TERM INT
        sleep 12 & timer_child=$!; wait "$timer_child"; timer_child=""
        if kill -0 "$ssh_pid" 2>/dev/null; then
          printf '\nSSH 연결 점검 시간이 초과되었습니다.\n' >> "$tmp/output"
          kill "$ssh_pid" 2>/dev/null
          sleep 1 & timer_child=$!; wait "$timer_child"; timer_child=""
          kill -KILL "$ssh_pid" 2>/dev/null
        fi
      ) >/dev/null 2>&1 &
      watchdog_pid=$!
      wait "$ssh_pid" 2>/dev/null; ssh_rc=$?; ssh_pid=""
      kill "$watchdog_pid" 2>/dev/null; wait "$watchdog_pid" 2>/dev/null; watchdog_pid=""
      output=$(head -n 4 "$tmp/output")
      if [ "$ssh_rc" -le 1 ] && printf '%s' "$output" | grep -qF -e "Hi ${owner}!" -e "Hi ${owner}," -e "@${owner}!" -e "@${owner},"; then authenticated=true; rc=0; fi
      output=$(printf '%s' "$output" | head -n 4)
      account_machine_result "$id" "" "$authenticated" existing "${output:-SSH 인증 응답이 없습니다.}"
      return "$rc" ;;
    generate)
      confirm "암호 없는 전용 Ed25519 SSH 키를 생성합니다: $id" "$yes" "Gitrochi 계정 설정에서 SSH 키 생성을 확인하세요"
      [ "$owner" = "$id" ] || die "이 계정은 $owner 의 SSH 키를 공유합니다. 원본 계정에서 키를 설정하세요."
      command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen 이 필요합니다."
      mkdir -p "$SSH_DIR" && chmod 700 "$SSH_DIR" || die "SSH 폴더를 준비하지 못했습니다."
      candidate="$SSH_DIR/.gitch-key-$id.lock"
      mkdir "$candidate" 2>/dev/null || die "이 계정의 SSH 설정이 진행 중입니다."
      lock=$candidate
      candidate="$SSH_DIR/.gitch-config.lock"
      mkdir "$candidate" 2>/dev/null || die "다른 SSH 설정 작업이 진행 중입니다. 잠시 뒤 다시 시도하세요."
      config_lock=$candidate
      if [ -e "$key" ] || [ -L "$key" ]; then
        [ -f "$key" ] || die "기존 SSH 키 경로가 일반 파일이 아닙니다. 덮어쓰지 않았습니다."
      else
        [ ! -e "$key.pub" ] && [ ! -L "$key.pub" ] || die "기존 공개키가 있어 덮어쓰지 않았습니다: $key.pub"
        tmp=$(mktemp -d "$SSH_DIR/.gitch-key.XXXXXX") || die "SSH 키 임시 폴더를 만들지 못했습니다."
        ssh-keygen -t ed25519 -C "$(acc_email "$id")" -f "$tmp/key" -N "" -q </dev/null || die "SSH 키를 생성하지 못했습니다."
        chmod 600 "$tmp/key" && chmod 644 "$tmp/key.pub" || die "SSH 키 권한을 설정하지 못했습니다."
        ln "$tmp/key" "$key" 2>/dev/null || die "SSH 키가 이미 생성되어 덮어쓰지 않았습니다."
        if ! ln "$tmp/key.pub" "$key.pub" 2>/dev/null; then [ ! "$key" -ef "$tmp/key" ] || rm -f "$key"; die "공개키를 보존하지 못했습니다. 기존 파일을 덮어쓰지 않았습니다."; fi
        created=1; protection=none
      fi
      if ! account_alias_exists "$alias"; then
        [ ! -L "$SSH_CONFIG" ] && { [ ! -e "$SSH_CONFIG" ] || [ -f "$SSH_CONFIG" ]; } || die "SSH config 가 링크나 폴더여서 자동으로 바꾸지 않았습니다."
        ssh_tmp=$(mktemp "$SSH_DIR/.gitch-config.XXXXXX") || die "SSH 설정 임시 파일을 만들지 못했습니다."
        [ ! -f "$SSH_CONFIG" ] || cat "$SSH_CONFIG" > "$ssh_tmp"
        printf '\nHost %s\n    HostName %s\n    Port %s\n    User git\n    IdentityFile "%s"\n    IdentitiesOnly yes\n    AddKeysToAgent yes\n' "$alias" "$host" "${B_PORT[$i]}" "$key" >> "$ssh_tmp"
        [ -n "$IS_WINDOWS" ] || printf '    UseKeychain yes\n' >> "$ssh_tmp"
        chmod 600 "$ssh_tmp" || die "SSH 설정 권한을 설정하지 못했습니다."
        [ ! -f "$SSH_CONFIG" ] || backup_file "$SSH_CONFIG"
        mv -f "$ssh_tmp" "$SSH_CONFIG" || die "SSH 설정을 저장하지 못했습니다."
        ssh_tmp=""
      fi
      account_machine_result "$id" "$created" null "$protection" "공개키를 복사해 서버에 등록하세요. 기존 SSH 키와 별칭은 덮어쓰지 않습니다."
      ;;
  esac
)

add_cmd() {
  if [ "$#" -gt 0 ]; then add_machine_cmd "$@"; return $?; fi
  can_prompt || die "계정 추가는 사용자가 터미널에서 직접 'gitch add' 를 실행해야 합니다."
  load_config >/dev/null 2>&1
  local id email host port via folder hv
  say "${BOLD}새 계정 추가${RESET}"
  read -r -p "아이디 (GitHub/GitLab 사용자명): " id
  case "$id" in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) die "아이디는 영문/숫자/._- 만 쓸 수 있습니다." ;; esac
  is_account "$id" && die "이미 있는 계정입니다: $id"
  read -r -p "이메일: " email
  case "$email" in *@*) ;; *) die "이메일 형식이 아닙니다." ;; esac
  read -r -p "서버 (Enter = github.com, 회사면 gitlab 주소): " host
  host=$(printf '%s' "${host:-github.com}" | sed -E 's#^[a-z]+://##; s#/.*$##'); host=$(lower "$host")
  port=22
  if [ "$host" != github.com ]; then read -r -p "SSH 포트 (Enter = 22): " port; port="${port:-22}"; is_number "$port" || die "포트는 숫자입니다."; fi
  via=""
  read -r -p "이 서버에 다른 계정의 SSH 로그인을 빌려 쓰나요? (Enter = 아니오, 빌릴 계정 아이디): " via
  if [ -n "$via" ]; then find_binding "$via" "$host" || die "$via 계정에 $host 서버가 없습니다."; fi
  read -r -p "기본 폴더 (Enter = ~/Develop/$id, - = 없음): " folder
  folder="${folder:-~/Develop/$id}"
  hv="$host"; [ "$port" != 22 ] && hv="$host:$port"; [ -n "$via" ] && hv="$hv via $via"
  if [ "$folder" = "-" ]; then folder=""; else mkdir -p "$(expand_path "$folder")"; fi
  cfg_add_account "$id" "$email" "$hv" "$folder"   # 하나씩 쓰면 이메일만 쓴 직후 검사가 「host 가 없다」로 되돌린다
  ok "$id 를 계정 목록에 추가했습니다. 이어서 SSH 키 등록과 규칙 갱신을 합니다."
  [ -z "$via" ] && setup_cmd "$id"
  install_auto_rules
  write_ai_rules; write_skills
}

remove_cmd() {
  local id="$1" i keys=() k
  [ -z "$id" ] && die "사용법: gitch remove <아이디>"
  can_prompt || die "계정 삭제는 사용자가 터미널에서 직접 실행해야 합니다."
  need_config
  is_account "$id" || die "없는 계정입니다: $id"
  i=0; while [ $i -lt ${#B_ACC[@]} ]; do
    [ "${B_LOGIN[$i]}" = "$id" ] && [ "${B_ACC[$i]}" != "$id" ] && die "${B_ACC[$i]} 계정이 $id 로그인을 빌려 씁니다 (via). 먼저 그 설정을 고치세요."
    i=$((i+1)); done
  confirm "$id 계정을 목록에서 지울까요? (SSH 키 파일과 잠긴 저장소는 그대로 둡니다)" "" ""
  remove_managed_rules "$id"
  rm -f "$HOME/.gitconfig-$id"
  i=0; while [ $i -lt ${#F_ACC[@]} ]; do [ "${F_ACC[$i]}" = "$id" ] && keys+=("folder.${F_RAW[$i]}"); i=$((i+1)); done
  i=0; while [ $i -lt ${#O_ACC[@]} ]; do [ "${O_ACC[$i]}" = "$id" ] && keys+=("org.${O_RAW[$i]}"); i=$((i+1)); done
  backup_file "$CFG"
  for k in "${keys[@]}"; do git config -f "$CFG" --remove-section "$k" 2>/dev/null; done
  git config -f "$CFG" --remove-section "account.$id" 2>/dev/null
  reset_config_state; load_config
  ok "$id 를 지웠습니다. (~/.ssh 의 키와 Host 설정은 남아 있습니다 — 정리: gitch ssh prune)"
  install_auto_rules >/dev/null
  write_ai_rules >/dev/null; write_skills >/dev/null
}

# ================= setup: SSH 키 / sign: 커밋 서명 =================

ssh_keys_page() { if [ "$1" = github.com ]; then echo "https://github.com/settings/ssh/new"; else echo "https://$1/-/user_settings/ssh_keys"; fi; }

setup_cmd() {   # [계정]
  if [ "$#" -gt 1 ]; then setup_machine_cmd "$@"; return $?; fi
  need_config
  local only="$1" i id h al key y
  [ -n "$only" ] && { is_account "$only" || die "없는 계정: $only"; }
  mkdir -p "$SSH_DIR"; chmod 700 "$SSH_DIR"
  [ -f "$SSH_CONFIG" ] || : > "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
  i=0
  while [ $i -lt ${#B_ACC[@]} ]; do
    id=${B_ACC[$i]}; h=${B_HOST[$i]}; al=${B_ALIAS[$i]}
    if [ "${B_LOGIN[$i]}" != "$id" ] || { [ -n "$only" ] && [ "$only" != "$id" ]; }; then i=$((i+1)); continue; fi
    key="$SSH_DIR/id_ed25519_$id"
    echo ""
    say "${BOLD}===== $id ($h) =====${RESET}"
    if [ -f "$key" ]; then say "  SSH 키가 이미 있습니다: $(tilde "$key")"
    else
      y=n
      if [ -n "$IS_WINDOWS" ]; then
        can_prompt && read -r -p "  SSH 키에 암호를 걸까요? (ssh-agent 가 켜져 있어야 매번 묻지 않음) (y/N) " y
      else
        can_prompt && read -r -p "  SSH 키에 암호를 걸까요? (macOS 키체인에 저장되어 매번 묻지 않음) (y/N) " y
      fi

      case "$y" in
        y|Y) ssh-keygen -t ed25519 -C "$(acc_email "$id")" -f "$key" -q && { ssh-add --apple-use-keychain "$key" 2>/dev/null || ssh-add "$key" 2>/dev/null; } ;;
        *) ssh-keygen -t ed25519 -C "$(acc_email "$id")" -f "$key" -N "" -q ;;
      esac
      say "  SSH 키 생성: $(tilde "$key")"
    fi
    if grep -q "^Host $al\$" "$SSH_CONFIG"; then
      if ssh_host_sync "$al" "$h" "${B_PORT[$i]}"; then say "  ~/.ssh/config 의 $al 을 고침 (Port ${B_PORT[$i]})"
      else say "  ~/.ssh/config 에 이미 등록됨 ($al)"; fi
    else
      backup_file "$SSH_CONFIG"
      cat >> "$SSH_CONFIG" <<EOF2

Host $al
    HostName $h
    Port ${B_PORT[$i]}
    User git
    IdentityFile $key
    IdentitiesOnly yes
    AddKeysToAgent yes
$([ -n "$IS_WINDOWS" ] || echo "    UseKeychain yes")
EOF2
      say "  ~/.ssh/config 에 $al 추가"
    fi
    if test_ssh "$al" "$id" >/dev/null 2>&1; then ok "이미 등록되어 있습니다."; i=$((i+1)); continue; fi
    if ! can_prompt; then err "  키 등록은 사용자가 직접 터미널에서 'gitch setup' 을 실행해야 합니다."; i=$((i+1)); continue; fi
    to_clipboard < "$key.pub"
    say "  ${YELLOW}공개키를 클립보드에 복사했습니다.${RESET}"
    say "  ${YELLOW}브라우저가 ${BOLD}$h${RESET}${YELLOW} 에 ${BOLD}$id${RESET}${YELLOW} 로 로그인됐는지 확인하고, Key 칸에 붙여넣기(⌘V) → 추가${RESET}"
    [ "$h" != github.com ] && say "  (페이지가 안 열리면: 오른쪽 위 프로필 → Preferences → SSH Keys)"
    read -r -p "  준비되면 Enter (페이지가 열립니다)..."
    browse "$(ssh_keys_page "$h")"
    read -r -p "  등록을 마쳤으면 Enter..."
    test_ssh "$al" "$id"
    i=$((i+1))
  done
  echo ""
  ok "SSH 설정 완료"
}

sign_cmd() {   # on | off | (상태)
  local d acc id y
  case "$1" in
    on|off)
      can_prompt || [ "$2" = --yes ] || die "서명 설정은 사용자가 터미널에서 직접 'gitch sign $1' 을 실행해야 합니다."
      need_config
      if [ "$1" = on ]; then git config --global gitswitch.sign true; else git config --global --unset gitswitch.sign 2>/dev/null; fi
      for id in "${ACC_IDS[@]}"; do sync_include_file "$id"; done
      while IFS= read -r d; do
        acc=$(git -C "$d" config --get gitswitch.account)
        [ -n "$acc" ] && is_account "$acc" && { set_account "$acc"; apply_sign "$d"; }
      done < <(find_repos)
      if [ "$1" = off ]; then say "커밋 서명을 껐습니다."; return 0; fi
      ok "커밋 서명을 켰습니다. 각 계정의 SSH 키로 서명합니다."
      for id in "${ACC_IDS[@]}"; do
        if find_binding "$id" github.com && [ "${B_LOGIN[$BI]}" = "$id" ]; then
          say "${BOLD}$id${RESET}: GitHub 에 '서명용 키'를 따로 한 번 등록해야 Verified 가 붙습니다."
          if can_prompt; then
            read -r -p "  지금 등록할까요? (y/N) " y
            case "$y" in y|Y)
              to_clipboard < "$SSH_DIR/id_ed25519_$id.pub"
              say "  ${YELLOW}공개키 복사 완료. $id 로 로그인된 브라우저에서 Key type 을 'Signing Key' 로 바꾸고 붙여넣기 → Add${RESET}"
              browse "https://github.com/settings/ssh/new"
              read -r -p "  등록을 마쳤으면 Enter..." ;;
            esac
          fi
        else
          say "${BOLD}$id${RESET}: GitLab 키가 'Authentication & Signing' 이면 추가 등록 필요 없음"
        fi
      done ;;
    *) if sign_enabled; then say "커밋 서명: 켜짐 (끄기: gitch sign off)"; else say "커밋 서명: 꺼짐 (켜기: gitch sign on)"; fi ;;
  esac
}

ssh_cmd() {   # prune [--yes]
  local sub="$1" yes="" orphans h tmp
  [ "$2" = --yes ] && yes=1
  case "$sub" in
    prune)
      need_config
      orphans=$(ssh_orphans)
      [ -z "$orphans" ] && { say "정리할 SSH 설정이 없습니다."; return 0; }
      say "지금 계정 설정에서 쓰지 않는 SSH Host:"; printf '%s\n' "$orphans" | sed 's/^/  /'
      confirm "위 Host 설정을 ~/.ssh/config 에서 지울까요? (키 파일은 그대로, 백업 남김)" "$yes" "gitch ssh prune --yes"
      backup_file "$SSH_CONFIG"
      for h in $orphans; do
        tmp=$(mktemp "${TMPDIR:-/tmp}/gitsw.XXXXXX") || die "임시 파일을 만들 수 없습니다."
        awk -v host="$h" '
          /^(Host|Match)[ \t]/ { skip = ($1 == "Host" && $2 == host && NF == 2) }
          skip { next }
          /^[[:space:]]*$/ { blank++; next }
          { while (blank > 0) { print ""; blank-- } print }
        ' "$SSH_CONFIG" > "$tmp" && cat "$tmp" > "$SSH_CONFIG"
        rm -f "$tmp"
        say "  지움: Host $h"
      done
      ok "정리했습니다. (백업: $(tilde "$BACKUP_SESSION"))" ;;
    *) die "사용법: gitch ssh prune [--yes]" ;;
  esac
}


