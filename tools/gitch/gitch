  return s
}
function json_value(f, path, depth,   c, key, i, start, value) {
  if (depth > 64) return
  json_space(); c = substr(JTEXT, JPOS, 1)
  if (c == "{" || c == "[") {
    JPOS++; i = 0; json_space()
    while (JPOS <= length(JTEXT) && substr(JTEXT, JPOS, 1) != (c == "{" ? "}" : "]")) {
      start = JPOS
      if (c == "{") { if (substr(JTEXT, JPOS, 1) != "\"") break; key = json_string(); json_space(); if (substr(JTEXT, JPOS++, 1) != ":") break }
      else key = ++i
      json_value(f, path == "" ? key : path "\034" key, depth + 1); json_space()
      if (substr(JTEXT, JPOS, 1) == ",") { JPOS++; json_space() } else break
      if (JPOS <= start) break
    }
    JPOS++
  } else {
    if (c == "\"") value = json_string()
    else { start = JPOS; while (JPOS <= length(JTEXT) && substr(JTEXT, JPOS, 1) !~ /[ \t\r\n,}\]]/) JPOS++; value = substr(JTEXT, start, JPOS - start) }
    JV[f, path] = value; JK[f, ++JN[f]] = path
  }
}
