}
function maven_modules(   i, f, s, own, par, props, tag, val, id, block, group, art, sc, t) {
  for (i = 1; i <= NPOM; i++) {
    f = POM[i]; s = xml_text(f); MVTEXT[f] = s; par = xml_value(s, "parent")
    own = xml_drop(xml_drop(xml_drop(xml_drop(xml_drop(s, "parent"), "dependencies"), "dependencyManagement"), "build"), "profiles")
    MVGROUP[f] = xml_value(own, "groupId"); if (MVGROUP[f] == "") MVGROUP[f] = xml_value(par, "groupId")
    MVART[f] = xml_value(own, "artifactId"); props = xml_value(s, "properties")
    while (match(props, /<[A-Za-z_][A-Za-z0-9_.-]*>/)) { tag = substr(props, RSTART + 1, RLENGTH - 2); val = xml_value(props, tag); MVPROP[f, tag] = val; props = xml_drop(props, tag) }
    MVGROUP[f] = maven_expand(f, MVGROUP[f]); MVART[f] = maven_expand(f, MVART[f])
    id = MVGROUP[f] ":" MVART[f]
    if (MVART[f] == "" || id ~ /\$\{/) continue
