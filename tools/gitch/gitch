      # 흉내 내지 못하게 합니다. 분석 결과는 검토할 수 있도록 보존합니다.
      awk '
        { extra="{\"code\":\"INPUT_CHANGED\",\"severity\":\"warning\",\"message\":\"Tracked files or repository state changed during analysis; rerun the audit.\"}"
          marker="\"diagnostics\":["; p=index($0, marker)+length(marker)
          if (p>length(marker)) $0=substr($0,1,p-1) extra (substr($0,p,1)=="]" ? "" : ",") substr($0,p)
          sub(/"incomplete":false/, "\"incomplete\":true")
