}
function cargo_modules(   i, f, j, nm, id, p, t, root, d) {
  for (i = 1; i <= NCARGO; i++) { f = CARGO[i]; cargo_read(f); CBY[dirof(f)] = f }
  for (i = 1; i <= NCARGO; i++) {
    f = CARGO[i]
    if (!inscope(f) || CN[f] == "") continue
