function swift_modcount(   i, n, seen) { n = 0; for (i = 1; i <= MODN; i++) if (!(MODNAME[i] in seen)) { seen[MODNAME[i]] = 1; n++ }; return n }
function jlist(s,   n, a, i, r) { n = split(s, a, "\034"); r = ""; for (i = 2; i <= n; i++) r = r (r != "" ? "," : "") jstr(a[i]); return r }   # "\034A\034B" → "A","B"
function swift_reach(p, t, w,   n, a, i) {   # 3 같은 모듈 · 2 t 의 모듈을 import(공개 선언이거나 @testable) · 1 t 의 모듈을 모름 · 0 닿을 수 없음
