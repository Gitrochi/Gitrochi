      match(m, /["'][^"']*["']/); q = substr(m, RSTART + 1, RLENGTH - 2); if (q !~ /^:/) q = ":" q
      m = substr(m, index(m, "=") + 1); path = ""
      while (match(m, /["'][^"']*["']/)) { path = substr(m, RSTART + 1, RLENGTH - 2); m = substr(m, RSTART + RLENGTH) }
      if (path != "") { path = normp(joinp(d, path)); if (path != "\001") GDIR[i, q] = path }
    }
    GN[i] = n; GROOT[i] = rname
    for (k = 1; k <= n; k++) { q = GMOD[i, k]; GACC[i, gradle_key(substr(q, 2), ":")] = q }
    for (k = 1; k <= n; k++) {
      q = GMOD[i, k]; path = GDIR[i, q]
      if (!inscope(path "/")) continue
      GVIS[path] = 1; id = gradle_id(d, q); mnode(id, q, "gradle", path, "project")
      bf = joinp(path, "build.gradle.kts"); if (!(bf in EX)) bf = joinp(path, "build.gradle")
      if (bf in EX) gradle_deps(bf, id, i, d)
    }
    bf = joinp(d, "build.gradle.kts"); if (!(bf in EX)) bf = joinp(d, "build.gradle")      # 루트 프로젝트는 의존이 있을 때만
    if (inscope(joinp(d, "x"))) { GVIS[d] = 1; mnode(gradle_id(d, ":"), rname, "gradle", d, "root"); if (bf in EX) gradle_deps(bf, gradle_id(d, ":"), i, d) }
  }
  for (i = 1; i <= NGBUILD; i++) {
    f = GBUILD[i]; d = dirof(f); if ((d in GVIS) || !inscope(f)) continue
    GVIS[d] = 1; id = gradle_id(d, ":"); mnode(id, d == "" ? repo : d, "gradle", d, "project"); gradle_deps(f, id, 0, d)
  }
}
function gradle_id(d, q) { return "gradle:" (d == "" ? "" : d) q }
function gradle_key(s, sep) { s = tolower(s); gsub(/[-_]/, "", s); gsub(sep, ".", s); return s }
function gradle_deps(f, id, si, sd,   line, indep, depth, conf, s, m, q, k) {
  indep = 0; depth = 0
  while ((getline line < f) > 0) {
    sub(/\r$/, "", line); if (line ~ /^[ \t]*\/\//) continue; sub(/[ \t]\/\/.*$/, "", line)
    if (!indep) { if (line ~ /^[ \t]*dependencies[ \t]*\{/) { indep = 1; depth = 0 } else continue }
    depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
    conf = line; sub(/^[ \t]*/, "", conf); if (match(conf, /^[A-Za-z]+/)) conf = substr(conf, 1, RLENGTH); else conf = ""
    s = line
    while (match(s, /project[ \t]*\([ \t]*(path[ \t]*[:=][ \t]*)?["'][^"']*["']/)) {       # project(":core:data")
      m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
      match(m, /["'][^"']*["']/); q = substr(m, RSTART + 1, RLENGTH - 2); if (q !~ /^:/) q = ":" q
      dep(id, gradle_id(sd, q), conf, "")
    }
    s = line
    while (match(s, /projects\.[A-Za-z0-9_.]+/)) {                                     # projects.core.data (타입 안전 접근자)
      m = substr(s, RSTART + 9, RLENGTH - 9); s = substr(s, RSTART + RLENGTH)
      k = gradle_key(m, "\\.")
      if ((si, k) in GACC) dep(id, gradle_id(sd, GACC[si, k]), conf, "")
    }
    if (conf != "" && conf != "project" && match(line, /["'][A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+(:[^"']*)?["']/)) {   # "group:artifact:version"
      m = substr(line, RSTART + 1, RLENGTH - 2); sub(/:[^:]*$/, "", m); if (index(m, ":") == 0) m = substr(line, RSTART + 1, RLENGTH - 2)
      xdep(id, "maven", m, conf, "")
    }
    if (conf != "" && match(line, /libs\.[A-Za-z0-9_.]+/) && line !~ /libs\.(plugins|versions)\./) xdep(id, "gradle", substr(line, RSTART, RLENGTH), conf, "")
    if (depth <= 0) indep = 0
  }
  close(f)
}

# ----- Swift 매니페스트 읽기 도우미 (주석을 지운 한 덩어리 · 괄호 짝 · 맨 위 쉼표로 나누기) -----
function swift_text(f,   line, all, i, c, n, q, out, cm) {
  all = ""; cm = 0
  while ((getline line < f) > 0) {
    sub(/\r$/, "", line)
    if (!cm && !index(line, "/")) { all = all " " line; continue }
    out = ""; q = 0; n = length(line)
    for (i = 1; i <= n; i++) {
      c = substr(line, i, 1)
      if (cm) { if (c == "*" && substr(line, i + 1, 1) == "/") { cm = 0; i++ }; continue }
      if (q) { out = out c; if (c == "\\") { i++; out = out substr(line, i, 1) } else if (c == "\"") q = 0; continue }
      if (c == "\"") { q = 1; out = out c; continue }
      if (c == "/" && substr(line, i + 1, 1) == "/") break
      if (c == "/" && substr(line, i + 1, 1) == "*") { cm = 1; i++; continue }
      out = out c
    }
    all = all " " out
  }
  close(f)
  return all
}
function balanced(s, i,   d, n, c, q) {   # s 의 i 번째 여는 괄호와 짝인 닫는 괄호 위치 (문자열 안은 세지 않음)
  d = 0; n = length(s); q = 0
  for (; i <= n; i++) {
    c = substr(s, i, 1)
    if (q) { if (c == "\\") i++; else if (c == "\"") q = 0; continue }
    if (c == "\"") q = 1
    else if (c == "(" || c == "[" || c == "{") d++
    else if (c == ")" || c == "]" || c == "}") { d--; if (d == 0) return i }
  }
  return n
}
function items(s, arr,   n, i, d, c, q, st, len) {   # 맨 위 쉼표로 나눈 조각 → arr[1..n]
  n = 0; d = 0; q = 0; st = 1; len = length(s)
  for (i = 1; i <= len; i++) {
    c = substr(s, i, 1)
    if (q) { if (c == "\\") i++; else if (c == "\"") q = 0; continue }
    if (c == "\"") q = 1
    else if (c == "(" || c == "[" || c == "{") d++
    else if (c == ")" || c == "]" || c == "}") d--
    else if (c == "," && d == 0) { arr[++n] = trim(substr(s, st, i - st)); st = i + 1 }
  }
  if (trim(substr(s, st)) != "") arr[++n] = trim(substr(s, st))
  return n
}
function argval(it, key,   v) {   # 조각 "key: 값" 이면 값
  if (!match(it, "^" key "[ \t]*:")) return "\001"
  v = trim(substr(it, RLENGTH + 1))
  return v
}
function strarg(s, key,   m) {   # s 안의 key: "값"
  if (!match(s, "(^|[^A-Za-z0-9_])" key "[ \t]*:[ \t]*\"[^\"]*\"")) return ""
  m = substr(s, RSTART, RLENGTH); sub(/^[^"]*"/, "", m); sub(/"$/, "", m)
  return m
}
function inner(v) { sub(/^[ \t]*\[/, "", v); sub(/\][ \t]*$/, "", v); return v }

# ----- SwiftPM: swift package describe 의 JSON(있으면) 또는 Package.swift 를 직접 -----
function spm_modules(   line, a, i, f, d, j, n, D, k, nm, pk, id) {
  while ((getline line < spm) > 0) { split(line, a, "\t"); SPMJ[a[1]] = a[2] }
  close(spm)
  for (i = 1; i <= NSPM; i++) {
    f = SPM[i]; d = dirof(f)
    if (!inscope(f)) continue
    if (d in SPMJ) spm_json(SPMJ[d], d); else spm_manifest(f, d)
  }
  for (i = 1; i <= SPN; i++) {
    id = "swift:" SPNAME[i]
    mnode(id, SPNAME[i], "swift", joinp(SPDIR[i], SPPATH[i]), SPTYPE[i])
    n = split(SPDEPS[i], D, "\034")
    for (j = 2; j <= n; j++) {
      k = substr(D[j], 1, 1); nm = substr(D[j], 3); pk = ""
      if (k == "p" && index(nm, "\035")) { pk = substr(nm, index(nm, "\035") + 1); nm = substr(nm, 1, index(nm, "\035") - 1) }
      if (k == "t" || (nm in SPLOCAL)) dep(id, "swift:" nm, (k == "p" ? "product" : "target"), "")
      else xdep(id, "swiftpm", nm, "product", pk)
    }
  }
}
function spm_add(d, name, path, typ, deps) {
  SPN++; SPNAME[SPN] = name; SPPATH[SPN] = path; SPTYPE[SPN] = typ; SPDEPS[SPN] = deps; SPDIR[SPN] = d; SPLOCAL[name] = 1
}
function spm_json(f, d,   line, intg, arr, name, path, typ, deps, v) {   # 정렬된 키 · 두 칸 들여쓰기 모양
  intg = 0; arr = ""
  while ((getline line < f) > 0) {
    if (line ~ /^  "targets" : \[/) { intg = 1; continue }
    if (!intg) continue
    if (line ~ /^  \]/) { intg = 0; continue }
    if (line ~ /^    \{/) { name = ""; path = ""; typ = ""; deps = ""; arr = ""; continue }
    if (line ~ /^    \}/) { if (name != "") spm_add(d, name, path, typ, deps); continue }
    v = line; sub(/^[^:]*:[ \t]*"?/, "", v); sub(/"?,?[ \t]*$/, "", v)
    if (line ~ /^      "name" : "/) name = v
    else if (line ~ /^      "path" : "/) path = v
    else if (line ~ /^      "type" : "/) typ = v
    else if (line ~ /^      "target_dependencies" : \[/) arr = "t"
    else if (line ~ /^      "product_dependencies" : \[/) arr = "p"
    else if (line ~ /^      "/) arr = ""
    else if (arr != "" && line ~ /^        "/) { v = line; sub(/^[ \t]*"/, "", v); sub(/",?[ \t]*$/, "", v); deps = deps "\034" arr ":" v }
  }
  close(f)
}
function spm_manifest(f, d,   s, fn, i, e, args, n, IT, j, v, name, path, typ, deps, m, DI, k, x, pk) {
  s = swift_text(f)
  while (match(s, /\.(target|executableTarget|testTarget|macro|plugin|binaryTarget|systemLibrary)[ \t]*\(/)) {
    fn = substr(s, RSTART + 1, RLENGTH - 1); sub(/[ \t]*\($/, "", fn)
    i = RSTART + RLENGTH - 1; e = balanced(s, i)
    args = substr(s, i + 1, e - i - 1); s = substr(s, e + 1)       # 안의 .target(name:) 참조는 건너뛴다
    if (args ~ /(^|[^A-Za-z0-9_])targets[ \t]*:/) continue               # products 의 .plugin(name:targets:) 은 타깃이 아니다
    name = ""; path = ""; deps = ""
    n = items(args, IT)
    for (j = 1; j <= n; j++) {
      if ((v = argval(IT[j], "name")) != "\001") name = unquote(v)
      else if ((v = argval(IT[j], "path")) != "\001") path = unquote(v)
      else if ((v = argval(IT[j], "dependencies")) != "\001") {
        m = items(inner(v), DI)
        for (k = 1; k <= m; k++) {
          x = DI[k]
          if (x ~ /^"/) deps = deps "\034b:" unquote(x)
          else if (x ~ /^\.target[ \t]*\(/) deps = deps "\034t:" strarg(x, "name")
          else if (x ~ /^\.product[ \t]*\(/) { pk = strarg(x, "package"); deps = deps "\034p:" strarg(x, "name") (pk != "" ? "\035" pk : "") }
          else if (x ~ /^\.byName[ \t]*\(/) deps = deps "\034b:" strarg(x, "name")
        }
      }
    }
    if (name == "") continue
    typ = (fn == "target") ? "library" : (fn == "executableTarget") ? "executable" : (fn == "testTarget") ? "test" : (fn == "binaryTarget") ? "binary" : (fn == "systemLibrary") ? "system-target" : fn
    if (path == "") path = ((fn == "testTarget") ? "Tests/" : (fn == "plugin") ? "Plugins/" : "Sources/") name
    spm_add(d, name, path, typ, deps)
  }
  # 이름만 쓴 의존("X")은 같은 매니페스트의 타깃이면 타깃, 아니면 제품
}

# ----- Tuist Project.swift: Target 선언(product · bundleId 가 있는 것)과 의존 -----
function tuist_modules(   i, f, d, s, all, proj, e, j, args, n, IT, v, name, typ, deps, m, DI, k, x, found, id, D, nd, t, kk) {
  for (i = 1; i <= NTUIST; i++) {
    f = TUIST[i]; d = dirof(f)
    if (!inscope(f)) continue
    all = swift_text(f); s = all; proj = ""; found = 0
    if (match(s, /Project[ \t]*(\.[A-Za-z_][A-Za-z0-9_]*)?[ \t]*\(/)) proj = strarg(substr(s, RSTART), "name")   # Project( 또는 도우미 Project.module(
    while (match(s, /(\.target|[^A-Za-z0-9_.]Target(\.target)?)[ \t]*\(/)) {
      j = RSTART + RLENGTH - 1; e = balanced(s, j)
      args = substr(s, j + 1, e - j - 1); s = substr(s, e + 1)
      if (args !~ /(product|bundleId|destinations|platform|sources)[ \t]*:/) continue      # .target(name:) 는 의존 참조
      name = ""; typ = ""; deps = ""
      n = items(args, IT)
      for (k = 1; k <= n; k++) {
        if ((v = argval(IT[k], "name")) != "\001") name = unquote(v)
        else if ((v = argval(IT[k], "product")) != "\001") { typ = v; sub(/^\./, "", typ) }
        else if ((v = argval(IT[k], "dependencies")) != "\001") deps = tuist_deps(inner(v))
      }
      if (name == "") continue
      found++; tuist_node(name, d, typ, deps)
    }
    if (!found && proj != "") tuist_node(proj, d, "project", tuist_deps(all))   # 도우미 함수로 만든 매니페스트 — 파일 안의 참조를 모은다
  }
  for (i = 1; i <= TUN; i++) {
    id = "tuist:" TUNAME[i]
    nd = split(TUDEPS[i], D, "\034")
    for (j = 2; j <= nd; j++) {
      t = substr(D[j], 1, 1); x = substr(D[j], 3)
      if (t == "t") dep(id, "tuist:" x, "target", "")
      else if (t == "j") dep(id, "tuist:" x, "project", "")
      else xdep(id, (t == "s") ? "sdk" : (t == "f") ? "framework" : "swiftpm", x, (t == "s") ? "sdk" : (t == "f") ? "framework" : "external", "")
    }
  }
}
function tuist_node(name, d, typ, deps) { TUN++; TUNAME[TUN] = name; TUDEPS[TUN] = deps; mnode("tuist:" name, name, "tuist", d, typ) }
function tuist_deps(s,   out, m, x, k, n, DI, b) {
  out = ""
  n = items(s, DI)
  if (n == 1 && DI[1] !~ /^\./) { n = 0 }
  for (k = 1; k <= n; k++) {
    x = DI[k]
    if (x ~ /^\.target[ \t]*\(/) out = out "\034t:" strarg(x, "name")
    else if (x ~ /^\.project[ \t]*\(/) out = out "\034j:" strarg(x, "target")
    else if (x ~ /^\.external[ \t]*\(/) out = out "\034e:" strarg(x, "name")
    else if (x ~ /^\.package[ \t]*\(/) out = out "\034e:" strarg(x, "product")
    else if (x ~ /^\.sdk[ \t]*\(/) out = out "\034s:" strarg(x, "name")
    else if (x ~ /^\.(framework|xcframework|library)[ \t]*\(/) { b = baseof(strarg(x, "path")); sub(/\.[A-Za-z]+$/, "", b); if (b != "") out = out "\034f:" b }
  }
  if (out != "" || n > 1) return out
  while (match(s, /\.(target|project|external)[ \t]*\([^()]*\)/)) {          # 도우미 매니페스트: 파일 전체에서 참조를 찾는다
    x = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
    if (x ~ /^\.project/) out = out "\034j:" strarg(x, "target")
    else if (x ~ /^\.external/) out = out "\034e:" strarg(x, "name")
    else if (x !~ /(product|bundleId)[ \t]*:/) out = out "\034t:" strarg(x, "name")
  }
  return out
}
