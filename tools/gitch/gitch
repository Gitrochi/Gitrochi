<script id="graph-data" type="application/json">
HTMLEOF
  sed 's/</\\u003c/g'
  printf '</script>\n<script id="graph-languages" type="application/json">\n'
  graph_languages | awk -F'|' 'BEGIN { printf "[" } { printf "%s[\"%s\",\"%s\",\"%s\",\"%s\"]", (NR > 1 ? "," : ""), $1, $2, $3, $5 } END { print "]" }'
  printf '</script>\n<script id="graph-ui-locale" type="application/json">\n'
  printf '{"language":%s,"systemLanguage":%s}\n' "$(json_str "${GITCH_GRAPH_LANG:-}")" "$(json_str "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}")" | sed 's/</\\u003c/g'
  cat <<'HTMLEOF'
</script>
<script id="graph-ui-messages" type="application/json">
{
  "en": {
