#!/bin/bash
# ==========================================================
#  gitch — 여러 Git 계정(GitHub + 회사 GitLab) 관리 도구 (예전 이름 gitsw — ~/bin/gitsw 로 불러도 같다)
#  전체 명령 보기: gitch help
#  설정 파일: ~/.config/gitsw/config  (위치 확인: gitch config path)
#  macOS 기본 bash 3.2 에서 동작하도록 작성 (연관 배열 등 bash 4 기능 사용 안 함)
#  Gitrochi 와 함께 배포(tools/gitch, 앱 안 Contents/Resources/gitch) · MIT 라이선스(저장소 LICENSE) · © 2026 jjunhaa0211
# ==========================================================

# shellcheck disable=SC2088,SC2016  # 화면 표시용 ~ 와 $HOME 문자열은 일부러 펼치지 않음
GITSW_VERSION="0.3.12"
GITCH_VERSION_SCHEME="gitrochi"
# shellcheck disable=SC2034  # 앱이 이 선언을 실행하지 않고 파일 머리에서 읽는다.
GITCH_GRAPH_API="1"
# shellcheck disable=SC2034  # 설치기/업데이터가 받은 파일을 실행하지 않고 배포 방식 표식을 읽는다.
GITCH_HELPER_API="1"
# shellcheck disable=SC2034  # 앱이 실행하지 않고 읽는 표식: 흐름 엔진(gitch-flow) 계약 버전.
GITCH_FLOW_API="1"
# 파서가 옵션을 거부해도 기계 출력 요청은 먼저 알아야 한다. 사람용 색/도움말이 JSON 오류에 섞이지 않게.
MACHINE_JSON=""
_gitch_expect_format=""
for _gitch_argument in "$@"; do
  [ -n "$_gitch_expect_format" ] && { [ "$_gitch_argument" = json ] && MACHINE_JSON=1; _gitch_expect_format=""; }
  case "$_gitch_argument" in --json|--format=json) MACHINE_JSON=1 ;; --format) _gitch_expect_format=1 ;; esac
done
unset _gitch_expect_format _gitch_argument

# ----- 경로 -----
CFG="${GITSW_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/gitsw/config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gitsw"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/gitsw"
HOOK_DISPATCHER="$DATA_DIR/hook"
ACTION_LOG="$STATE_DIR/actions.jsonl"
BACKUP_DIR="$STATE_DIR/backups"
SSH_DIR="$HOME/.ssh"
SSH_CONFIG="$SSH_DIR/config"
# Windows(Git for Windows 의 Git Bash · MSYS2 · Cygwin): ln -s 가 링크 대신 복사본을 만들어 ~/bin/gitch 는 연결 스크립트로,
# 터미널 연동은 Git Bash 의 ~/.bashrc 로, 클립보드·브라우저는 clip · url.dll 로 한다 (uname 대신 OSTYPE — 훅마다 프로세스를 띄우지 않게)
case "${GITSW_OS:-${OSTYPE:-}}" in msys*|cygwin*|win*) IS_WINDOWS=1 ;; *) IS_WINDOWS="" ;; esac
if [ -n "$IS_WINDOWS" ]; then SHELL_RC="$HOME/.bashrc"; else SHELL_RC="${ZDOTDIR:-$HOME}/.zshrc"; fi
BIN_LINK="$HOME/bin/gitch"
SHIM_LINK="$HOME/bin/gitsw"   # 예전 이름 — gitsw 로 부르는 AI 규칙·스크립트가 계속 되게 같은 파일을 가리킨다
SSH_BIN="${GITSW_SSH:-ssh}"
CLAUDE_DIR="$HOME/.claude"
CODEX_DIR="$HOME/.codex"
GEMINI_DIR="$HOME/.gemini"
HOOK_EVENTS="pre-commit commit-msg pre-push post-commit"
LOCKFILE_RE='(^|/)(package-lock\.json|npm-shrinkwrap\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|Podfile\.lock|Package\.resolved|Gemfile\.lock|Cargo\.lock|composer\.lock|poetry\.lock|uv\.lock|go\.sum|flake\.lock)$'
AI_TRAILER_RE='^[[:space:]]*(co-authored-by:.*(claude|anthropic|codex|openai|chatgpt|copilot|gemini|cursor|devin|aider)|.*generated (with|by) .*(claude|codex|copilot|gemini|cursor|chatgpt))'

# ----- 실행 주체 (사람/AI) -----
detect_actor() {
  if [ -n "${GITSW_ACTOR:-}" ]; then ACTOR="$GITSW_ACTOR"
  elif [ -t 0 ] || [ -t 2 ]; then ACTOR=human
  elif [ -n "${CLAUDECODE:-}" ]; then ACTOR=claude
  elif [ -n "${CODEX_SANDBOX:-}${CODEX_SANDBOX_NETWORK_DISABLED:-}${CODEX_THREAD_ID:-}${CODEX_CI:-}" ]; then ACTOR=codex
  elif [ -n "${CURSOR_AGENT:-}${CURSOR_TRACE_ID:-}" ]; then ACTOR=cursor
  elif [ -n "${GEMINI_CLI:-}" ]; then ACTOR=gemini
  elif [ -n "${AI_AGENT:-}" ]; then ACTOR=ai
  else ACTOR=script; fi
}
can_prompt() { [ -t 0 ] && [ -t 2 ]; }

# ----- 출력 -----
setup_colors() {
  local c="${GITSW_COLOR:-auto}"
  if [ "$c" = always ] || { [ "$c" = auto ] && [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; }; then
    GREEN=$'\033[32m'; RED=$'\033[31m'; YELLOW=$'\033[33m'; BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
    # 앱 아이콘 색: 로고는 은색 → 파랑, 강조는 파랑, 점은 초록 노드. 24비트 색이 안 되면 256색 근사, 그것도 안 되면 기본색
    case "${COLORTERM:-}:${TERM:-}" in
      truecolor:*|24bit:*)
        ACCENT=$'\033[38;2;127;164;255m'; LEAF=$'\033[38;2;107;229;154m'
        LOGO_PAL=($'\033[38;2;247;248;250m' $'\033[38;2;227;234;251m' $'\033[38;2;207;220;252m' $'\033[38;2;187;206;252m'
                  $'\033[38;2;167;192;253m' $'\033[38;2;147;178;254m' $'\033[38;2;127;164;255m') ;;
      *256color*)
        ACCENT=$'\033[38;5;111m'; LEAF=$'\033[38;5;78m'
        LOGO_PAL=($'\033[38;5;231m' $'\033[38;5;255m' $'\033[38;5;189m' $'\033[38;5;153m' $'\033[38;5;147m' $'\033[38;5;111m' $'\033[38;5;111m') ;;
      *) ACCENT=$'\033[34m'; LEAF="$GREEN"; LOGO_PAL=() ;;
    esac
  else
    GREEN=""; RED=""; YELLOW=""; BOLD=""; DIM=""; RESET=""; ACCENT=""; LEAF=""; LOGO_PAL=()
  fi
}
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s\n' "${GREEN}✔${RESET} $*"; }
warn() { printf '%s\n' "${YELLOW}⚠ $*${RESET}"; }
dim()  { printf '%s\n' "${DIM}$*${RESET}"; }
err()  { printf '%s\n' "${RED}$*${RESET}" >&2; }
machine_error() {   # $1 안정적인 코드 $2 종료 코드 $3 메시지 — 오류는 표준오류, 결과는 표준출력
  printf '{"schemaVersion":1,"error":{"code":%s,"message":%s,"exitCode":%s}}\n' "$(json_str "$1")" "$(json_str "$3")" "$2" >&2
}
die()  { if [ -n "$MACHINE_JSON" ]; then machine_error GITCH_ERROR 1 "$*"; else err "$@"; fi; exit 1; }
browse() {   # 기본 브라우저로 주소 열기 (맥 open, Windows url.dll)
  if [ -n "$IS_WINDOWS" ]; then rundll32 url.dll,FileProtocolHandler "$1" >/dev/null 2>&1; else open "$1" 2>/dev/null; fi
}
to_clipboard() { if [ -n "$IS_WINDOWS" ]; then clip; else pbcopy; fi; }   # 표준 입력 → 클립보드

# 로고: 앱 아이콘의 두 눈(점자 한 칸 = 2×4 점). 큰 것은 그대로, 중간·작은 것은 점을 줄여 두 눈을 나란히 놓았다.
LOGO_L=(
  '  ⣠⣤⣤⣀'
  ' ⣴⣿⣿⣿⣿⣷⣄'
  '⣸⣿⣿⣿⣿⣿⣿⣿⡷           '
  '⣿⣿⣿⣿⣿⣿⣿⡟            '
  '⣿⣿⣿⣿⣿⣿⡿'
  '⢻⣿⣿⣿⣿⣿⡇    ⢀⡆'
  ' ⢻⣿⣿⣿⣿⡇   ⢀⣾⡇'
  '  ⠙⢿⣿⣿⣷⣄⣀⣤⣾⣿⡇                          ⣀⡀'
  '    ⠉⠛⠿⣿⣿⣿⣿⠟                   ⣠     ⢸⣿⣿⣿⣿⣿⣿⣶⣆'
  '        ⠈⠉                 ⢀⣠⣶⡿⠁     ⣾⣿⣿⣿⣿⣿⣿⣿⡿'
  '                         ⢀⣴⣿⣿⣿⠁    ⢀⣼⣿⣿⣿⣿⣿⣿⣿⡿⠁'
  '                        ⢰⣿⣿⣿⣿⡇    ⣠⣾⣿⣿⣿⣿⣿⣿⣿⠟⠁'
  '                        ⠘⠿⣿⣿⣿⣷⣤⣤⣴⣾⣿⣿⣿⣿⣿⣿⠿⠛⠁'
  '                           ⠉⠛⠛⠻⠿⠿⠿⠿⠿⠛⠛⠉'
)
LOGO_M=(
  '⣠⣿⣿⣦⡀                  '
  '⣿⣿⣿⡿⠁                  '
  '⢿⣿⣿⡇ ⢀⡆      ⢀⣠  ⢀⣿⣿⣿⣶⡄'
  '⠈⠻⣿⣧⣤⣾⠇    ⢀⣴⣿⠃ ⢀⣼⣿⣿⣿⠟ '
  '   ⠉⠛⠁     ⠘⠻⢿⣶⣶⣿⣿⠿⠛⠁  '
)
LOGO_S=(
  '⣼⣿⣦             '
  '⣿⣿⠃⢀⡄    ⣠⡔ ⢠⣿⣿⡶'
  '⠈⠻⢦⡾⠃   ⠸⢿⣥⣴⣿⠿⠋ '
)

term_size() {   # 터미널 크기 → TW(칸) TH(줄). 모르면 80×24
  local s
  s=$( { stty size </dev/tty; } 2>/dev/null)
  TW="${COLUMNS:-}"; TH="${LINES:-}"
  is_number "$TW" || TW="${s##* }"; is_number "$TH" || TH="${s%% *}"
  is_number "$TW" || TW=80; is_number "$TH" || TH=24
}

fancy_out() {   # 사람이 보는 터미널이면 로고·진행 표시를 그린다 (GITSW_BANNER=always|never 로 강제)
  case "${GITSW_BANNER:-auto}" in always) return 0 ;; never) return 1 ;; esac
  [ -t 1 ] && [ "$ACTOR" = human ]
}

banner() {   # 터미널 크기에 맞는 로고 + 이름: 넓고 높으면 큰 것, 낮으면 중간, 좁으면 작은 것, 아주 좁으면 글자만
  local t1 t2 i n at=-9 below="" line
  local -a rows
  t1="${LEAF}●${RESET} ${BOLD}gitch${RESET} ${DIM}v$GITSW_VERSION${RESET}"
  t2="${DIM}여러 Git 계정을 섞이지 않게${RESET}"
  term_size
  if [ "$TW" -ge 60 ] && [ "$TH" -ge 30 ]; then rows=("${LOGO_L[@]}"); at=2
  elif [ "$TW" -ge 58 ] && [ "$TH" -ge 16 ]; then rows=("${LOGO_M[@]}"); at=1
  elif [ "$TW" -ge 50 ]; then rows=("${LOGO_S[@]}"); at=0
  elif [ "$TW" -ge 30 ]; then rows=("${LOGO_S[@]}"); below=1
  else printf '\n  %s\n  %s\n' "$t1" "$t2"; return 0; fi
  n=${#rows[@]}
  echo ""
  for ((i = 0; i < n; i++)); do
    line="  ${LOGO_PAL[$((i * 6 / (n - 1)))]}${rows[$i]}${RESET}"
    if [ "$i" -eq "$at" ]; then line="$line   $t1"; elif [ "$i" -eq $((at + 1)) ]; then line="$line   $t2"; fi
    printf '%s\n' "$line"
    [ "${GITSW_ANIM:-1}" = 0 ] || sleep 0.02
  done
  [ -n "$below" ] && printf '\n  %s\n  %s\n' "$t1" "$t2"
  return 0
}

step() {   # 여러 단계 명령의 단계 제목: ◆ 제목  번호/전체
  printf '\n%s\n' "${ACCENT}◆${RESET} ${BOLD}$2${RESET}  ${DIM}$1/$3${RESET}"
}

rule() {   # 구분선 (터미널 너비에 맞춰 최대 52칸)
  local w i r=""
  term_size; w=$((TW - 2)); [ "$w" -gt 52 ] && w=52
  for ((i = 0; i < w; i++)); do r="$r━"; done
  printf '%s\n' "${ACCENT}${r}${RESET}"
}

# 확인: 터미널이면 y/N 질문, 아니면 --yes 가 있어야 진행 (없으면 종료코드 2)
confirm() {   # $1 질문  $2 yes(1이면 통과)  $3 비대화형일 때 안내할 명령
  [ "$2" = 1 ] && return 0
  if can_prompt; then
    local y; read -r -p "$1 (y/N) " y
    case "$y" in y|Y|yes|YES) return 0 ;; esac
    say "취소했습니다."; exit 0
  fi
  if [ -n "$MACHINE_JSON" ]; then machine_error GITCH_CONFIRMATION_REQUIRED 2 "확인이 필요합니다. 사용자 동의를 받은 뒤 '$3' 로 실행하세요."
  else err "확인이 필요합니다. 사용자 동의를 받은 뒤 '$3' 로 실행하세요."; fi
  exit 2
}

# ----- 문자열/경로 도우미 -----
lower() { case "$1" in *[A-Z]*) printf '%s' "$1" | tr '[:upper:]' '[:lower:]' ;; *) printf '%s' "$1" ;; esac; }
expand_path() {
  case "$1" in
    "~") printf '%s' "$HOME" ;;
    "~/"*) printf '%s' "$HOME/${1#"~/"}" ;;
    '$HOME') printf '%s' "$HOME" ;;
    '$HOME/'*) printf '%s' "$HOME/${1#'$HOME/'}" ;;
    '${HOME}/'*) printf '%s' "$HOME/${1#'${HOME}/'}" ;;
    *) printf '%s' "$1" ;;
  esac
}
tilde() { case "$1" in "$HOME") printf '~' ;; "$HOME"/*) printf '%s' "~/${1#"$HOME"/}" ;; *) printf '%s' "$1" ;; esac; }
real_dir() { (cd "$1" 2>/dev/null && pwd -P); }
in_list() { case " $2 " in *" $1 "*) return 0 ;; esac; return 1; }
is_number() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }
ident_email() { local x="${1#*<}"; printf '%s' "${x%%>*}"; }
# GNU stat 의 -f 는 파일 시스템 정보를 내고도 실패하므로(출력이 섞인다) -c 를 먼저 — BSD(맥) stat 은 -c 를 모른다
file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
now_iso() { date '+%Y-%m-%dT%H:%M:%S%z'; }

# Windows 의 ~/bin/gitch · ~/bin/gitsw: 심볼릭 링크 대신 이 표시 줄과 exec 한 줄로 된 연결 스크립트
LINK_MARK="# gitch-link: "
link_target() {   # $1 이 심볼릭 링크나 연결 스크립트면 가리키는 경로 → LT (아니면 거짓)
  LT=""
  if [ -L "$1" ]; then LT=$(readlink "$1"); return 0; fi
  [ -n "$IS_WINDOWS" ] && [ -f "$1" ] || return 1
  local l1="" l2=""
  { IFS= read -r l1; IFS= read -r l2; } < "$1" 2>/dev/null
  [ "$l1" = "#!/bin/sh" ] && case "$l2" in "$LINK_MARK"?*) LT="${l2#"$LINK_MARK"}"; return 0 ;; esac
  return 1
}
is_link() { link_target "$1"; }
make_link() {   # $1 대상 $2 링크 — 맥·리눅스는 ln -s, Windows 는 연결 스크립트(임시 파일 → mv)
  if [ -z "$IS_WINDOWS" ]; then ln -sfn "$1" "$2"; return; fi
  local t
  t=$(mktemp "$2.XXXXXX") || return 1
  if printf '#!/bin/sh\n%s%s\nexec "%s" "$@"\n' "$LINK_MARK" "$1" "$1" > "$t" && chmod +x "$t" && mv -f "$t" "$2"; then return 0; fi
  rm -f "$t"; return 1
}

resolve_link() {   # 심볼릭 링크(Windows 는 연결 스크립트도)를 끝까지 따라간 실제 경로
  local p="$1" n=0
  while [ $n -lt 20 ] && link_target "$p"; do
    case "$LT" in /*) p="$LT" ;; *) p="$(dirname "$p")/$LT" ;; esac
    n=$((n+1))
  done
  printf '%s' "$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)/$(basename "$p")"
}
self_path() { resolve_link "${BASH_SOURCE[0]}"; }
gitsw_cmd_path() {   # 훅/설정에 적을 gitch 경로 (~/bin/gitch 가 이 파일을 가리키면 그 경로)
  if is_link "$BIN_LINK" && [ "$(resolve_link "$BIN_LINK")" = "$(self_path)" ]; then printf '%s' "$BIN_LINK"
  else self_path; fi
}

json_esc() {   # 문자열 → JE (따옴표 포함 JSON 문자열) — 서브셸 없이
  local s="$1" code oct ch escaped
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}; s=${s//$'\r'/\\r}; s=${s//$'\t'/\\t}
  case "$s" in *[$'\001'-$'\037']*)
    for ((code=1; code<32; code++)); do
      printf -v oct '%03o' "$code"; printf -v ch '%b' "\\$oct"
      printf -v escaped '\\u%04x' "$code"
      s=${s//"$ch"/"$escaped"}
    done ;;
  esac
  JE="\"$s\""
}
json_str() { json_esc "$1"; printf '%s' "$JE"; }
json_bool() { if [ -n "$1" ] && [ "$1" != 0 ]; then printf true; else printf false; fi; }
json_num() { if is_number "$1"; then printf '%s' "$1"; else printf 0; fi; }

# ----- git 도우미 -----
in_repo() { git rev-parse --is-inside-work-tree >/dev/null 2>&1; }
require_repo() { in_repo || die "git 저장소 안에서 실행하세요."; }
cur_branch() { git symbolic-ref --short HEAD 2>/dev/null; }
has_upstream() { git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; }
has_head() { git rev-parse -q --verify HEAD >/dev/null 2>&1; }
head_pushed() { has_head && [ -n "$(git branch -r --contains HEAD 2>/dev/null)" ]; }
is_zero_sha() { case "$1" in *[!0]*|"") return 1 ;; esac; return 0; }
repo_top() { git rev-parse --show-toplevel 2>/dev/null; }

git_version_ok() {   # includeIf hasconfig 때문에 2.36 이상 필요
  local v maj min
  v=$(git --version 2>/dev/null | sed -E 's/[^0-9]*([0-9]+)\.([0-9]+).*/\1 \2/')
  read -r maj min <<< "$v"
  GIT_VER="$maj.$min"
  is_number "$maj" && is_number "$min" || return 1
  [ "$maj" -gt 2 ] || { [ "$maj" -eq 2 ] && [ "$min" -ge 36 ]; }
}

_CH_SUP=""
config_hooks_supported() {   # git 설정 기반 훅(hook.<이름>.command) 지원 여부
  if [ -z "$_CH_SUP" ]; then
    local t; t=$(mktemp -d "${TMPDIR:-/tmp}/gitsw-probe.XXXXXX" 2>/dev/null) || { _CH_SUP=0; return 1; }
    if git -C "$t" init -q 2>/dev/null && \
       git -C "$t" -c hook.gitswprobe.event=pre-commit -c hook.gitswprobe.command=true hook list pre-commit 2>/dev/null | grep -qx gitswprobe; then
      _CH_SUP=1
    else
      _CH_SUP=0
    fi
    rm -rf "$t"
  fi
  [ "$_CH_SUP" = 1 ]
}

# 비대화형(AI 등)에서는 ssh 가 암호를 묻느라 멈추지 않게 BatchMode + 시간 제한
net_env() {
  if ! can_prompt && [ -z "${GIT_SSH_COMMAND:-}" ] && [ -z "$(git config --get core.sshCommand 2>/dev/null)" ]; then
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10"
  fi
  export GIT_TERMINAL_PROMPT=0
}

