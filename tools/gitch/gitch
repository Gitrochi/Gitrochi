# ----- Kotlin / Java: package + import → 그 이름을 선언한 파일, 같은 패키지 타입은 이름으로 추정 -----
function scan_jvm(p, ins,   line, inc, s, pkg) {
  inc = 0; pkg = ""; JCUR = ""
  while ((getline line < p) > 0) {
    LINES[p]++; SCAN_FILE = p; SCAN_LINE = LINES[p]
    sub(/\r$/, "", line)
    if (inc) { if (index(line, "*/")) inc = 0; continue }
    if (line ~ /^[ \t]*\/\*/) { if (!index(substr(line, index(line, "/*") + 2), "*/")) inc = 1; continue }
    if (line ~ /^[ \t]*\/\//) continue
    if (pkg == "" && line ~ /^[ \t]*package[ \t]+[A-Za-z_]/) { s = line; sub(/^[ \t]*package[ \t]+/, "", s); sub(/[^A-Za-z0-9_.].*$/, "", s); pkg = s; JCUR = s; continue }
    if (line ~ /^[ \t]*import[ \t]+/) {
      if (ins) { s = line; sub(/^[ \t]*import[ \t]+(static[ \t]+)?/, "", s); sub(/[ \t]+as[ \t].*$/, "", s); sub(/[^A-Za-z0-9_.*].*$/, "", s); if (s != "") JIMP[p] = JIMP[p] "\034" s; JIMPL[p, s] = LINES[p] }
      continue
    }
    if (line ~ /^[A-Za-z@]/) jvm_decl(p, line)       # 들여쓰기 없는 줄 = 최상위 선언
    if (ins) refs(p, line)
  }
  close(p)
  JPKG[p] = pkg; JPF[pkg] = JPF[pkg] "\034" p
  if (p ~ /\.java$/) jvm_index(p, stemof(p))
}
function jvm_decl(p, line,   s, priv, kw, nm) {
  s = line; priv = 0
  while (match(s, /^(@[A-Za-z_][A-Za-z0-9_.]*(\([^)]*\))?|public|private|protected|internal|open|abstract|final|sealed|non-sealed|data|inner|value|inline|expect|actual|external|tailrec|operator|infix|suspend|lateinit|override|static|strictfp)[ \t]+/)) {
    if (s ~ /^private[ \t]/) priv = 1
    s = substr(s, RLENGTH + 1)
  }
  if (!match(s, /^(enum[ \t]+class|annotation[ \t]+class|fun[ \t]+interface|const[ \t]+val|class|interface|object|typealias|fun|val|var|enum|record|@interface)[ \t]+/)) return
  kw = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
  if (kw ~ /^(fun|val|var|const)[ \t]/ && kw !~ /^fun[ \t]+interface/) {
    sub(/^<[^>]*>[ \t]*/, "", s)
    if (!match(s, /^[A-Za-z_][A-Za-z0-9_.]*/)) return
    nm = substr(s, 1, RLENGTH); sub(/^.*\./, "", nm)
  } else {
    if (!match(s, /^[A-Za-z_][A-Za-z0-9_]*/)) return
    nm = substr(s, 1, RLENGTH)
  }
  if (!priv) jvm_index(p, nm)                        # private 최상위 선언은 그 파일 안에서만 보인다
}
function jvm_index(p, nm,   k) {
  k = (JCUR == "") ? nm : JCUR "." nm
  if (!(k in JFQ)) JFQ[k] = p
  if (index(UPPER, substr(nm, 1, 1)) && !((JCUR "\034" nm) in JPT)) JPT[JCUR "\034" nm] = p
}
function jvm_find(imp,   k) { k = imp; while (index(k, ".")) { if (k in JFQ) return JFQ[k]; sub(/\.[^.]*$/, "", k) }; return "" }
function jvm_pkgname(s,   n, a, i, r) {   # 바깥 import → 패키지 이름(대문자로 시작하는 마디 앞, 세 마디까지)
  n = split(s, a, "."); r = ""
  for (i = 1; i <= n && i <= 3; i++) { if (index(UPPER, substr(a[i], 1, 1)) || a[i] == "*") break; r = r (i > 1 ? "." : "") a[i] }
  return r == "" ? s : r
}
function jvm_resolve(   i, p, n, a, j, imp, t, k, m, b, w, pk) {
  for (i = 1; i <= NSRC; i++) {
    p = SRC[i]
    if ((LANG[p] != "kotlin" && LANG[p] != "java") || !inscope(p)) continue
    n = split(JIMP[p], a, "\034")
    for (j = 2; j <= n; j++) {
      imp = a[j]
      if (imp ~ /\.\*$/) {
        pk = substr(imp, 1, length(imp) - 2)
        if (pk in JPF) { m = split(JPF[pk], b, "\034"); for (k = 2; k <= m; k++) fedge(p, b[k], "import", imp); continue }
        t = jvm_find(pk)
      } else t = jvm_find(imp)
      if (t != "") fedge(p, t, "import", imp); else pedge(p, "maven", jvm_pkgname(imp), "import", imp, "")
    }
    pk = JPKG[p]; n = split(REF[p], a, "\034")
    for (j = 2; j <= n; j++) { w = a[j]; k = pk "\034" w; if ((k in JPT) && JPT[k] != p) heur(p, JPT[k], w, "jvm", 1) }
  }
