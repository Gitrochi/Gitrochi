{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gitrochi/Gitrochi/tools/gitch-flow/schema/flow-v1.schema.json",
  "title": "gitch flow file (.gitch/flow.yml) version 1",
  "description": "Composable test and CI flows. Unknown keys are errors except keys that start with x-.",
  "type": "object",
  "required": ["version"],
  "patternProperties": {"^x-": {}},
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "project": {"type": "object", "properties": {"name": {"type": "string"}, "description": {"type": "string"}, "detected": {"type": "array"}}, "additionalProperties": false},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {"$ref": "#/$defs/duration"},
        "env": {"type": "array", "items": {"type": "string"}, "description": "Host environment variables passed to steps (also allowed when they look secret)."},
        "envPolicy": {"enum": ["inherit", "allowlist"]},
        "shell": {"$ref": "#/$defs/shell"},
        "jobs": {"type": "integer", "minimum": 1}
      }
    },
    "environments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/environment"}},
    "services": {"type": "object", "additionalProperties": {"$ref": "#/$defs/service"}},
    "suites": {"type": "object", "additionalProperties": {"$ref": "#/$defs/suite"}},
    "flows": {"type": "object", "additionalProperties": {"$ref": "#/$defs/flow"}},
    "packs": {"type": "object"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "duration": {"oneOf": [{"type": "number"}, {"type": "string", "pattern": "^([0-9.]+(ms|s|m|h))+$|^[0-9]+$"}]},
    "shell": {"enum": ["bash", "sh", "pwsh", "powershell", "cmd"]},
    "stringMap": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "strings": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "retry": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 5}, {"type": "object", "additionalProperties": false, "properties": {"max": {"type": "integer", "minimum": 0, "maximum": 5}, "flaky": {"enum": ["fail", "warn"]}}}]},
    "expect": {
      "type": "object",
      "properties": {
        "minTests": {"type": "integer", "minimum": 0},
        "passRate": {"type": "number", "minimum": 0, "maximum": 1},
        "result": {"enum": ["required", "optional"]},
        "output": {"type": "string"},
        "exit": {"oneOf": [{"type": "integer"}, {"type": "array", "items": {"type": "integer"}}]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {"enum": ["dev", "local", "development", "sandbox", "test", "staging", "verify", "stage", "prod", "production"]},
        "executor": {"type": "string"},
        "connection": {"type": "string"},
        "vars": {"$ref": "#/$defs/stringMap"},
        "description": {"type": "string"}
      }
    },
    "service": {
      "type": "object",
      "required": ["use"],
      "additionalProperties": false,
      "properties": {
        "use": {"enum": ["process.service", "docker.service", "compose.up"]},
        "with": {"type": "object"},
        "needs": {"$ref": "#/$defs/strings"},
        "description": {"type": "string"}
      }
    },
    "suite": {
      "type": "object",
      "required": ["use"],
      "additionalProperties": false,
      "properties": {
        "use": {"type": "string"},
        "with": {"type": "object"},
        "select": {"type": "object", "additionalProperties": false, "properties": {"affected": {"type": "boolean"}, "tags": {"$ref": "#/$defs/strings"}, "paths": {"$ref": "#/$defs/strings"}}},
        "expect": {"$ref": "#/$defs/expect"},
        "retry": {"$ref": "#/$defs/retry"},
        "services": {"$ref": "#/$defs/strings"},
        "tags": {"$ref": "#/$defs/strings"},
        "paths": {"$ref": "#/$defs/strings"},
        "timeout": {"$ref": "#/$defs/duration"},
        "alwaysRun": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "node": {
      "oneOf": [
        {"type": "string", "description": "Shorthand for { run: <command> }."},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "use": {"type": "string"},
            "run": {"type": "string"},
            "suite": {"type": "string"},
            "flow": {"type": "string"},
            "needs": {"$ref": "#/$defs/strings"},
            "if": {"type": "string"},
            "with": {"type": "object"},
            "env": {"$ref": "#/$defs/stringMap"},
            "secrets": {"$ref": "#/$defs/stringMap"},
            "services": {"$ref": "#/$defs/strings"},
            "executor": {"type": "string"},
            "timeout": {"$ref": "#/$defs/duration"},
            "retry": {"$ref": "#/$defs/retry"},
            "cache": {"oneOf": [{"type": "boolean"}, {"type": "object", "additionalProperties": false, "properties": {"inputs": {"$ref": "#/$defs/strings"}, "key": {"$ref": "#/$defs/strings"}}}]},
            "expect": {"$ref": "#/$defs/expect"},
            "outputs": {"$ref": "#/$defs/stringMap"},
            "locks": {"$ref": "#/$defs/strings"},
            "optional": {"type": "boolean"},
            "on-failure": {"type": "object", "additionalProperties": {"$ref": "#/$defs/node"}},
            "shell": {"$ref": "#/$defs/shell"},
            "cwd": {"type": "string"},
            "weight": {"type": "integer", "minimum": 1},
            "description": {"type": "string"},
            "name": {"type": "string"},
            "matrix": {"type": "object", "description": "One node per combination, for example { node: [20, 22] }; read values with ${{ matrix.node }} (also in executor). needs: [this] waits for every combination. At most 64.",
                       "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": ["string", "number", "boolean"]}}},
            "undo": {
              "description": "Run nodes only. Reverses the command when the flow fails or is cancelled (rollback). It also runs when the command failed half-way, so it must be safe when nothing changed. With always: true it is a cleanup step that runs at the end of every run.",
              "oneOf": [
                {"type": "string"},
                {"type": "object", "additionalProperties": false, "required": ["run"], "properties": {"run": {"type": "string"}, "check": {"type": "string"}, "timeout": {"$ref": "#/$defs/duration"}, "always": {"type": "boolean"}}}
              ]
            }
          },
          "oneOf": [{"required": ["use"]}, {"required": ["run"]}, {"required": ["suite"]}, {"required": ["flow"]}]
        }
      ]
    },
    "flow": {
      "type": "object",
      "required": ["nodes"],
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string"},
        "trigger": {"type": "array", "items": {"enum": ["manual", "pre-push", "post-commit", "watch", "ci", "schedule"]}},
        "env": {"type": "string"},
        "failFast": {"type": "boolean"},
        "concurrency": {"enum": ["reject", "queue", "cancel-previous", "parallel"]},
        "rollback": {"type": "object", "additionalProperties": false, "properties": {"scope": {"enum": ["node", "flow"], "description": "node (default): undo only what the failed nodes changed. flow: undo every changed node in reverse."}, "onCheckFailure": {"type": "boolean", "description": "With scope flow: also roll back when only a node that changes nothing (a smoke check) failed."}, "timeout": {"$ref": "#/$defs/duration", "description": "Budget for the whole rollback (default 10m)."}}},
        "timeout": {"$ref": "#/$defs/duration"},
        "notify": {
          "type": "array",
          "description": "Notifications sent when the run ends. They never change the result.",
          "items": {"type": "object", "additionalProperties": false, "properties": {
            "on": {"oneOf": [{"enum": ["success", "failure", "cancelled", "always"]}, {"type": "array", "items": {"enum": ["success", "failure", "cancelled", "always"]}}], "default": "failure"},
            "webhook": {"type": "string", "description": "Connection name (kind webhook) or an https address."},
            "desktop": {"type": "boolean"},
            "message": {"type": "string"}}}
        },
        "nodes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/node"}}
      }
    }
  }
}
