  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.4.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
