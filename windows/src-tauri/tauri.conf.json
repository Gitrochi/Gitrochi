{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitrochi",
  "version": "0.3.13",
  "identifier": "io.github.chomnseong.gitrochi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gitrochi",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ChoMnSeong",
    "copyright": "© 2026 조문성 (ChoMnSeong), jjunhaa0211 · Community Use v1.0 proposed (not in effect)",
    "category": "DeveloperTool",
    "shortDescription": "Git client with a commit graph, worktrees, PRs, Claude Code agents and a terminal",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../tools/gitch-flow/THIRD_PARTY_NOTICES.txt": "gitch-flow-THIRD-PARTY-NOTICES.txt",
      "../../tools/gitch/gitch": "gitch",
      "../../tools/gitch/gitch-scip-index": "gitch-scip-index",
      "../../tools/gitch/gitch-graph-watch": "gitch-graph-watch",
      "../../tools/gitrochi-mcp/server.mjs": "gitrochi-mcp.mjs",
      "generated/gitch-core.exe": "gitch-core.exe",
      "generated/gitrochi-index.exe": "gitrochi-index.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5NDM1NjRENkZGQzE5RjkKUldUNUdmeHZUVlpEZWNqRzZqdTFKTmRSUmZVc3hKTkYxanB2Y09xQTJ0OVU1Q3lYVGxlNW5LOGsK",
      "endpoints": [
        "https://github.com/Gitrochi/Gitrochi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
